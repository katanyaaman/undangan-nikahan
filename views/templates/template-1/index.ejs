<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title || 'Stardew Valley Wedding Quest — ' + fv(event?.groom_name, 'David') + ' & ' + fv(event?.bride_name, 'Sarah') %></title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --sdv-wood-dark: #4a2108;
            --sdv-wood-mid: #854214;
            --sdv-wood-light: #c67d38;
            --sdv-wood-trim: #f3c26b;
            --sdv-parchment: #fce8b8;
            --sdv-parchment-card: #fff4d6;
            --sdv-ink: #381a08;
            --sdv-ink-muted: #693818;
            --sdv-green: #2d7a31;
            --sdv-gold: #f5b700;
            --sdv-red: #d9383a;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background-color: #16261c !important;
            background-image:
                radial-gradient(circle at 20% 20%, rgba(243, 194, 107, 0.12) 0%, transparent 45%),
                radial-gradient(circle at 80% 75%, rgba(72, 176, 77, 0.14) 0%, transparent 50%),
                repeating-linear-gradient(0deg, rgba(0,0,0,0.08) 0px, rgba(0,0,0,0.08) 2px, transparent 2px, transparent 4px) !important;
            color: var(--sdv-ink) !important;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif !important;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--sdv-ink);
        }

        section, #doa, #hadiah {
            scroll-margin-top: 96px;
        }
        .sdv-dock-label {
            font-size: 10px;
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -0.01em;
            color: #381a08;
        }

        .font-pixel {
            font-family: 'Press Start 2P', 'Courier New', monospace !important;
            line-height: 1.45;
            letter-spacing: 0.02em;
        }

        .font-vt {
            font-family: 'VT323', 'Courier New', monospace !important;
            letter-spacing: 0.04em;
        }

        .phone-container {
            width: 100% !important;
            max-width: 440px !important;
            margin-left: auto !important;
            margin-right: auto !important;
            background: linear-gradient(180deg, #1e3c64 0%, #3d78a8 18%, #77b588 38%, #4d8a47 65%, #376934 100%) !important;
            min-height: 100vh;
            position: relative;
            box-shadow: 0 0 50px rgba(0, 0, 0, 0.75);
            border-left: 4px solid var(--sdv-wood-dark);
            border-right: 4px solid var(--sdv-wood-dark);
        }

        /* Stardew Wooden Dialog Box Frame */
        .sdv-box {
            background-color: var(--sdv-parchment) !important;
            background-image: radial-gradient(rgba(198, 125, 56, 0.09) 1px, transparent 0) !important;
            background-size: 12px 12px !important;
            border: 4px solid var(--sdv-wood-dark) !important;
            box-shadow:
                inset 0 0 0 3px var(--sdv-wood-light),
                inset 0 0 0 5px var(--sdv-wood-trim),
                0 6px 0 rgba(35, 16, 4, 0.45),
                0 10px 20px rgba(0, 0, 0, 0.35) !important;
            border-radius: 12px !important;
            position: relative;
            color: var(--sdv-ink) !important;
        }

        .sdv-box::before,
        .sdv-box::after {
            content: '';
            position: absolute;
            width: 8px;
            height: 8px;
            background: var(--sdv-wood-dark);
            border: 1px solid var(--sdv-wood-trim);
            z-index: 2;
            pointer-events: none;
        }
        .sdv-box::before { top: 6px; left: 6px; }
        .sdv-box::after { bottom: 6px; right: 6px; }

        .sdv-card-inner {
            background-color: var(--sdv-parchment-card) !important;
            border: 3px solid #9c5a25 !important;
            box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.65), 0 3px 0 rgba(74, 33, 8, 0.18) !important;
            border-radius: 10px !important;
            color: var(--sdv-ink) !important;
        }

        .sdv-subcard {
            background-color: #fce8b8 !important;
            border: 2px solid #9c5a25 !important;
            border-radius: 10px !important;
            padding: 12px !important;
            color: var(--sdv-ink) !important;
        }

        .sdv-quest-gate {
            background-color: #f7dca0 !important;
            border: 3px dashed #854214 !important;
            border-radius: 10px !important;
            padding: 14px !important;
            color: var(--sdv-ink) !important;
        }

        .sdv-wood-banner {
            background: linear-gradient(180deg, #b56c2b 0%, #854214 55%, #632f0b 100%) !important;
            border: 3px solid var(--sdv-wood-dark) !important;
            box-shadow: inset 0 2px 0 #e6a964, 0 4px 0 rgba(0,0,0,0.35) !important;
            color: #fff8e7 !important;
            border-radius: 8px !important;
            text-shadow: 1px 2px 0 #381a08;
        }

        /* Explicit Semantic Badges */
        .sdv-badge-red {
            display: inline-block;
            background-color: #d9383a !important;
            color: #ffffff !important;
            border: 2px solid #5c1112 !important;
            padding: 3px 8px !important;
            border-radius: 6px !important;
            font-weight: 800 !important;
            text-shadow: 1px 1px 0 #5c1112;
        }

        .sdv-badge-green {
            display: inline-block;
            background-color: #2d7a31 !important;
            color: #ffffff !important;
            border: 2px solid #144016 !important;
            padding: 3px 8px !important;
            border-radius: 6px !important;
            font-weight: 800 !important;
            text-shadow: 1px 1px 0 #144016;
        }

        .sdv-badge-gold {
            display: inline-block;
            background-color: #f5b700 !important;
            color: #381a08 !important;
            border: 2px solid #5c3304 !important;
            padding: 3px 9px !important;
            border-radius: 6px !important;
            font-weight: 800 !important;
        }

        .sdv-badge-dark {
            display: inline-block;
            background-color: rgba(42, 20, 6, 0.92) !important;
            color: #ffe9a6 !important;
            border: 2px solid #f3c26b !important;
            padding: 4px 10px !important;
            border-radius: 6px !important;
            font-weight: 700 !important;
        }

        /* Progress Bar */
        .sdv-progress-track {
            width: 100%;
            height: 12px;
            background-color: #d1ad70 !important;
            border: 2px solid #4a2108 !important;
            border-radius: 999px;
            overflow: hidden;
            box-shadow: inset 0 2px 3px rgba(0,0,0,0.3);
        }
        .sdv-progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #2d7a31 0%, #5ec454 55%, #f5b700 100%) !important;
            transition: width 0.4s ease;
        }

        /* Mermaid's Pendant Box */
        .sdv-pendant-frame {
            width: 90px;
            height: 90px;
            margin: 0 auto 18px auto;
            border-radius: 16px;
            background: radial-gradient(circle, #2b5885 0%, #152c4a 100%) !important;
            border: 4px solid #5c2c0c !important;
            box-shadow: inset 0 2px 8px rgba(0,0,0,0.55), 0 4px 0 rgba(0,0,0,0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        /* Photo Frame */
        .sdv-photo-frame {
            width: 118px;
            height: 118px;
            margin: 10px auto 12px auto;
            border-radius: 16px;
            padding: 6px;
            background-color: #854214 !important;
            border: 3px solid #381a08 !important;
            box-shadow: 0 4px 0 rgba(56,26,8,0.3);
            cursor: pointer;
        }
        .sdv-photo-inner {
            width: 100%;
            height: 100%;
            border-radius: 10px;
            overflow: hidden;
            background-color: #fce8b8 !important;
        }

        /* Gallery Frame */
        .sdv-gallery-frame {
            padding: 6px;
            border-radius: 12px;
            background-color: #854214 !important;
            border: 3px solid #381a08 !important;
            box-shadow: 0 4px 0 rgba(56,26,8,0.3);
            cursor: pointer;
        }

        /* Form Inputs */
        .sdv-input {
            width: 100%;
            min-height: 44px;
            padding: 10px 14px;
            border-radius: 8px !important;
            background-color: #fce8b8 !important;
            border: 2px solid #854214 !important;
            color: #381a08 !important;
            font-size: 13px !important;
            font-weight: 600 !important;
        }
        .sdv-input:focus {
            outline: none !important;
            border-color: #2d7a31 !important;
            background-color: #fff8e7 !important;
        }

        /* Buttons with 44px+ touch target */
        .sdv-btn {
            min-height: 46px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 16px;
            background: linear-gradient(180deg, #5ec454 0%, #389830 55%, #287521 100%) !important;
            border: 3px solid #194714 !important;
            box-shadow: inset 0 2px 0 #95e88c, 0 4px 0 #194714 !important;
            color: #ffffff !important;
            font-weight: 700 !important;
            border-radius: 8px !important;
            cursor: pointer;
            transition: transform 0.12s ease, filter 0.15s ease, box-shadow 0.12s ease;
            text-shadow: 1px 1px 0 #194714;
            user-select: none;
            text-decoration: none;
        }
        .sdv-btn:hover {
            filter: brightness(1.06);
        }
        .sdv-btn:active {
            transform: translateY(3px);
            box-shadow: inset 0 2px 0 #95e88c, 0 1px 0 #194714 !important;
        }

        .sdv-btn-gold {
            background: linear-gradient(180deg, #ffd84d 0%, #eba018 55%, #c47a09 100%) !important;
            border: 3px solid #5c3304 !important;
            box-shadow: inset 0 2px 0 #fff1a8, 0 4px 0 #5c3304 !important;
            color: #381a08 !important;
            text-shadow: 0 1px 0 rgba(255, 255, 255, 0.5);
        }
        .sdv-btn-gold:active {
            transform: translateY(3px);
            box-shadow: inset 0 2px 0 #fff1a8, 0 1px 0 #5c3304 !important;
        }

        .sdv-btn-wood {
            background: linear-gradient(180deg, #d48a43 0%, #9e561c 55%, #783e10 100%) !important;
            border: 3px solid #3d1b05 !important;
            box-shadow: inset 0 2px 0 #f2be83, 0 4px 0 #3d1b05 !important;
            color: #fff8e7 !important;
            text-shadow: 1px 1px 0 #3d1b05;
        }
        .sdv-btn-wood:active {
            transform: translateY(3px);
            box-shadow: inset 0 2px 0 #f2be83, 0 1px 0 #3d1b05 !important;
        }

        .sdv-btn-skip {
            min-height: 40px;
            padding: 6px 10px;
            background: linear-gradient(180deg, #e85355 0%, #c92a2c 55%, #9e1b1d 100%) !important;
            border: 2px solid #4a1011 !important;
            box-shadow: inset 0 1px 0 #ff9ea0, 0 3px 0 #4a1011 !important;
            color: #ffffff !important;
            border-radius: 8px !important;
            font-weight: 800 !important;
            cursor: pointer;
            text-shadow: 1px 1px 0 #4a1011;
        }
        .sdv-btn-skip.completed {
            background: linear-gradient(180deg, #5ec454 0%, #2d7a31 100%) !important;
            border-color: #144016 !important;
            box-shadow: inset 0 1px 0 #95e88c, 0 2px 0 #144016 !important;
        }

        /* Quest Lock / Unlock Transitions */
        .quest-locked-blur {
            filter: blur(5px) grayscale(0.45);
            opacity: 0.42;
            pointer-events: none;
            user-select: none;
            max-height: 220px;
            overflow: hidden;
            transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
        }
        .quest-unlocked {
            filter: none !important;
            opacity: 1 !important;
            pointer-events: auto !important;
            user-select: auto !important;
            max-height: 6000px !important;
            overflow: visible !important;
        }

        /* Animations */
        @keyframes sdv-bob {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-5px); }
        }
        .animate-sdv-bob {
            animation: sdv-bob 2.4s ease-in-out infinite;
        }

        @keyframes sdv-pulse-glow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(245, 183, 0, 0.6), 0 4px 0 #5c3304; }
            50% { box-shadow: 0 0 0 8px rgba(245, 183, 0, 0), 0 4px 0 #5c3304; }
        }
        .animate-sdv-glow {
            animation: sdv-pulse-glow 2s infinite;
        }

        @keyframes spin-slow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .animate-spin-slow {
            animation: spin-slow 8s linear infinite;
        }

        @keyframes float-up {
            0% { opacity: 1; transform: translate(-50%, 0) scale(0.95); }
            100% { opacity: 0; transform: translate(-50%, -44px) scale(1.1); }
        }
        .floating-reward {
            position: fixed;
            left: 50%;
            top: 45%;
            z-index: 9999;
            pointer-events: none;
            background-color: #ffd84d !important;
            border: 3px solid #381a08 !important;
            color: #381a08 !important;
            padding: 8px 14px;
            border-radius: 10px;
            box-shadow: 0 6px 16px rgba(0,0,0,0.4);
            animation: float-up 1.25s ease-out forwards;
        }

        /* Inventory Slot */
        .sdv-slot {
            background-color: #e6c687 !important;
            border: 3px solid #6e3711 !important;
            box-shadow: inset 2px 2px 0 #b89153, inset -2px -2px 0 #fae3b4 !important;
            border-radius: 6px !important;
            transition: all 0.15s ease;
            color: #381a08 !important;
            text-decoration: none !important;
        }
        .sdv-slot.active-slot, .sdv-slot:hover {
            border-color: #d9383a !important;
            box-shadow: 0 0 0 2px #f5b700, inset 2px 2px 0 #b89153 !important;
            background-color: #fff1cc !important;
        }

        /* Crop Plot Button */
        .crop-plot {
            min-height: 92px;
            background: repeating-linear-gradient(45deg, #6b3e1b, #6b3e1b 6px, #593112 6px, #593112 12px) !important;
            border: 3px solid #3b1d08 !important;
            border-radius: 10px !important;
            box-shadow: inset 0 3px 6px rgba(0,0,0,0.45), 0 3px 0 #291304 !important;
            cursor: pointer;
            transition: transform 0.15s ease, border-color 0.2s ease;
            color: #ffe9a6 !important;
        }
        .crop-plot:hover {
            border-color: #ffd84d !important;
        }
        .crop-plot.harvested {
            background: linear-gradient(180deg, #4b9e3e 0%, #2d7a31 100%) !important;
            border-color: #ffd84d !important;
            color: #ffffff !important;
        }

        /* Bottom Dock & Music Button Fixed Positioning */
        #t1-bottom-dock {
            position: fixed;
            bottom: 10px;
            left: 50%;
            transform: translate(-50%, 120px);
            width: 94%;
            max-width: 416px;
            z-index: 45;
            opacity: 0;
            pointer-events: none;
            transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.45s ease;
        }
        #t1-bottom-dock.dock-open {
            transform: translate(-50%, 0);
            opacity: 1;
            pointer-events: auto;
        }
        #t1-music-toggle {
            position: fixed;
            bottom: 84px;
            right: 16px;
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background-color: #fce8b8 !important;
            border: 3px solid #4a2108 !important;
            box-shadow: 0 4px 0 #291304, 0 6px 14px rgba(0,0,0,0.4) !important;
            z-index: 45;
            opacity: 0;
            pointer-events: none;
            transition: all 0.35s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }
        #t1-music-toggle.music-open {
            opacity: 1;
            pointer-events: auto;
        }
    </style>
</head>
<body class="antialiased min-h-screen">

<!-- Outer Frame Container -->
<div class="phone-container shadow-2xl relative z-10 pb-28">

    <!-- Audio Element -->
    <audio id="t1-audio" loop preload="auto">
        <source src="<%= event?.background_music || '/music/wedding-song.wav' %>" type="audio/wav">
    </audio>

    <!-- ===================================================================== -->
    <!-- 1. OPENING COVER: PELICAN TOWN FARM MAILBOX & MERMAID'S PENDANT       -->
    <!-- ===================================================================== -->
    <div id="t1-opening-cover" class="fixed inset-0 z-50 flex items-center justify-center px-3 py-4 transition-all duration-700"
         style="background: linear-gradient(180deg, #132542 0%, #2b5885 38%, #549c6a 75%, #2f6132 100%);">

        <!-- Pixel Stars & Clouds Backdrop -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none opacity-80">
            <svg class="w-full h-full" viewBox="0 0 400 700" preserveAspectRatio="xMidYMid slice">
                <rect x="40" y="35" width="4" height="4" fill="#fff9c4"/>
                <rect x="120" y="65" width="3" height="3" fill="#ffe082"/>
                <rect x="280" y="40" width="5" height="5" fill="#fff9c4"/>
                <rect x="340" y="85" width="4" height="4" fill="#fff9c4"/>
                <rect x="75" y="120" width="3" height="3" fill="#ffe082"/>
                <rect x="210" y="25" width="4" height="4" fill="#ffffff"/>
                <g fill="rgba(255,255,255,0.22)">
                    <rect x="20" y="130" width="80" height="18" rx="4"/>
                    <rect x="36" y="118" width="48" height="16" rx="4"/>
                    <rect x="270" y="155" width="90" height="20" rx="4"/>
                    <rect x="288" y="141" width="52" height="18" rx="4"/>
                </g>
                <path d="M0 520 L80 430 L170 490 L260 410 L350 475 L400 440 L400 700 L0 700 Z" fill="#2c5e3b" opacity="0.7"/>
                <path d="M0 560 L110 490 L220 545 L320 480 L400 530 L400 700 L0 700 Z" fill="#1e4629"/>
            </svg>
        </div>

        <div class="relative z-10 w-full max-w-[395px] mx-auto sdv-box p-5 text-center">
            <!-- Top Wooden Signboard -->
            <div class="sdv-wood-banner py-2 px-3 mb-4 inline-flex items-center gap-2">
                <span class="text-sm">🌾</span>
                <span class="font-pixel text-[9px] tracking-wider uppercase">PELICAN TOWN WEDDING QUEST</span>
                <span class="text-sm">🌾</span>
            </div>

            <!-- Mermaid's Pendant Emblem -->
            <div class="sdv-pendant-frame animate-sdv-bob">
                <svg class="w-14 h-14" viewBox="0 0 32 32" shape-rendering="crispEdges">
                    <rect x="11" y="3" width="2" height="2" fill="#f5b700"/>
                    <rect x="19" y="3" width="2" height="2" fill="#f5b700"/>
                    <rect x="10" y="5" width="2" height="3" fill="#d99b26"/>
                    <rect x="20" y="5" width="2" height="3" fill="#d99b26"/>
                    <rect x="12" y="8" width="2" height="2" fill="#f5b700"/>
                    <rect x="18" y="8" width="2" height="2" fill="#f5b700"/>
                    <rect x="14" y="9" width="4" height="2" fill="#ffd84d"/>
                    <rect x="11" y="11" width="10" height="10" fill="#29b6f6"/>
                    <rect x="9" y="13" width="14" height="6" fill="#0288d1"/>
                    <rect x="12" y="12" width="8" height="8" fill="#4fc3f7"/>
                    <rect x="14" y="14" width="4" height="4" fill="#e1f5fe"/>
                    <rect x="13" y="21" width="6" height="3" fill="#0277bd"/>
                    <rect x="14" y="24" width="4" height="2" fill="#01579b"/>
                    <rect x="5" y="9" width="2" height="2" fill="#fff59d"/>
                    <rect x="25" y="11" width="2" height="2" fill="#fff59d"/>
                    <rect x="6" y="22" width="2" height="2" fill="#81d4fa"/>
                    <rect x="24" y="23" width="2" height="2" fill="#81d4fa"/>
                </svg>
                <span class="sdv-badge-gold font-pixel text-[7px]" style="position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%); white-space: nowrap;">
                    MERMAID'S PENDANT
                </span>
            </div>

            <p class="font-pixel text-[8px] uppercase tracking-widest mt-2 mb-1" style="color: #854214;">
                Walimatul 'Ursy &bull; Heart Event Lv. 10
            </p>

            <h1 class="text-2xl sm:text-3xl font-extrabold mb-1 leading-tight" style="color: #381a08;">
                <span data-demo="groom_name"><%= fv(event?.groom_name, 'David') %></span>
                <span class="font-pixel text-lg mx-1" style="color: #d9383a;">&hearts;</span>
                <span data-demo="bride_name"><%= fv(event?.bride_name, 'Sarah') %></span>
            </h1>

            <p class="text-xs font-bold mb-4" style="color: #693818;">
                📅 <%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %>
            </p>

            <!-- Mailbox Recipient Card -->
            <div class="sdv-card-inner p-3.5 mb-4 text-center">
                <p class="font-pixel text-[8px] uppercase mb-1.5" style="color: #854214;">
                    📬 SURAT UNTUK PETUALANG / TAMU:
                </p>
                <p id="t1-recipient-name" class="text-base font-extrabold py-1.5 px-4 rounded-lg inline-block max-w-full truncate"
                   style="background-color: #fce8b8; border: 2px solid #854214; color: #381a08;">
                    Tamu Undangan
                </p>
                <p class="text-[11px] mt-2 leading-snug" style="color: #693818;">
                    Selesaikan <strong>5 Misi Pelican Town</strong> di dalam surat ini untuk membuka seluruh informasi pernikahan!
                </p>
            </div>

            <button id="t1-open-btn" type="button" class="sdv-btn sdv-btn-gold animate-sdv-glow w-full text-xs font-pixel py-3.5">
                <span>▶ MULAI MISI &amp; BUKA UNDANGAN</span>
            </button>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- STICKY TOP STARDEW VALLEY HUD (CLOCK, GOLD & QUEST PROGRESS)          -->
    <!-- ===================================================================== -->
    <header id="sdv-hud" class="sticky top-0 z-40 px-2.5 pt-2 pb-1.5 transition-all duration-500 opacity-0 pointer-events-none">
        <div class="sdv-box px-3 py-2 flex items-center justify-between gap-2">
            <!-- Left: Quest Progress -->
            <div class="flex items-center gap-2 min-w-0 flex-1">
