<!-- INTERACTIVE STARDEW QUEST & SOUND ENGINE                                  -->
<!-- ========================================================================= -->
<script>
(function() {
    // 1. Ambil nama tamu dari URL param (?to= atau ?tamu=)
    const params = new URLSearchParams(window.location.search);
    const guestParam = params.get('to') || params.get('tamu') || params.get('u');
    if (guestParam) {
        const el = document.getElementById('t1-recipient-name');
        if (el) el.textContent = guestParam;
        const nameInput = document.getElementById('t1-rsvp-name');
        if (nameInput) nameInput.value = guestParam;
    }

    // 2. Web Audio API Chiptune / RPG Sound Effects
    let audioCtx = null;
    function getAudioCtx() {
        if (!audioCtx && (window.AudioContext || window.webkitAudioContext)) {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        if (audioCtx && audioCtx.state === 'suspended') {
            audioCtx.resume().catch(() => {});
        }
        return audioCtx;
    }

    function playSfx(type) {
        try {
            const ctx = getAudioCtx();
            if (!ctx) return;
            const now = ctx.currentTime;
            const notes = type === 'quest'
                ? [523.25, 659.25, 783.99, 1046.50]
                : type === 'all'
                ? [440, 554.37, 659.25, 880, 1108.73]
                : [587.33, 880];
            notes.forEach((freq, i) => {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(freq, now + i * 0.085);
                gain.gain.setValueAtTime(0.12, now + i * 0.085);
                gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.085 + 0.24);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start(now + i * 0.085);
                osc.stop(now + i * 0.085 + 0.25);
            });
        } catch (e) {}
    }

    function spawnFloatingText(text) {
        const div = document.createElement('div');
        div.className = 'floating-reward font-pixel text-[10px]';
        div.textContent = text;
        document.body.appendChild(div);
        setTimeout(() => div.remove(), 1250);
    }

    // 3. Quest State Management
    const questState = {
        gold: 100,
        completed: { 1: false, 2: false, 3: false, 4: false, 5: false },
        q1: { groom: false, bride: false },
        q2: { 1: false, 2: false, 3: false },
        q3: { 1: false, 2: false, 3: false },
        q4: { 1: false, 2: false, 3: false },
        q5: false
    };

    function addGold(amount, label) {
        questState.gold += amount;
        const goldEl = document.getElementById('sdv-gold-display');
        if (goldEl) goldEl.textContent = questState.gold + 'G';
        if (label) spawnFloatingText(label + ' (+' + amount + 'G)');
    }

    function completeQuest(qNum) {
        if (questState.completed[qNum]) return;
        questState.completed[qNum] = true;

        const content = document.getElementById('quest-content-' + qNum);
        if (content) {
            content.classList.remove('quest-locked-blur');
            content.classList.add('quest-unlocked');
        }

        const st = document.getElementById('qstatus-' + qNum);
        if (st) {
            st.textContent = '✓ SELESAI';
            st.className = 'sdv-badge-green font-pixel text-[8px]';
        }

        const hb = document.getElementById('qbadge-' + qNum);
        if (hb) {
            hb.textContent = 'TERBUKA ✓';
            hb.className = 'sdv-badge-green font-pixel text-[7px] flex-shrink-0';
        }

        const doneCount = Object.values(questState.completed).filter(Boolean).length;
        const counterEl = document.getElementById('sdv-quest-counter');
        const barEl = document.getElementById('sdv-quest-bar');
        if (counterEl) counterEl.textContent = doneCount + '/5';
        if (barEl) barEl.style.width = (doneCount * 20) + '%';

        addGold(500, '🎉 Quest #' + qNum + ' Terbuka!');
        playSfx('quest');

        if (doneCount === 5) {
            const grand = document.getElementById('sdv-grand-complete');
            if (grand) grand.classList.remove('hidden');
            const unlockBtn = document.getElementById('sdv-unlock-all-btn');
            if (unlockBtn) {
                unlockBtn.innerHTML = '🏆 5/5<br>Selesai';
                unlockBtn.classList.add('completed');
            }
            const heroStatus = document.getElementById('sdv-hero-status');
            if (heroStatus) heroStatus.textContent = '🏆 Semua Misi Selesai!';
        }
    }

    // Quest 1 Handler
    window.giveCoupleGift = function(who) {
        if (questState.q1[who]) return;
        questState.q1[who] = true;
        playSfx('tap');
        if (who === 'groom') {
            const h = document.getElementById('groom-hearts');
            const b = document.getElementById('btn-gift-groom');
            if (h) h.textContent = '❤️❤️❤️❤️❤️';
            if (b) { b.innerHTML = '<span>✓ Diterima!</span>'; b.classList.add('sdv-btn-gold'); }
        } else {
            const h = document.getElementById('bride-hearts');
            const b = document.getElementById('btn-gift-bride');
            if (h) h.textContent = '❤️❤️❤️❤️❤️';
            if (b) { b.innerHTML = '<span>✓ Diterima!</span>'; b.classList.add('sdv-btn-gold'); }
        }
        const count = (questState.q1.groom ? 1 : 0) + (questState.q1.bride ? 1 : 0);
        const st = document.getElementById('qstatus-1');
        if (st && count < 2) st.textContent = count + '/2 HADIAH';
        if (count === 2) {
            completeQuest(1);
        } else {
            addGold(100, '❤️ Heart +5');
        }
    };

    // Quest 2 Handler
    window.harvestCrop = function(plotId) {
        if (questState.q2[plotId]) return;
        questState.q2[plotId] = true;
        playSfx('tap');
        const plot = document.getElementById('crop-plot-' + plotId);
        const icon = document.getElementById('crop-icon-' + plotId);
        const label = document.getElementById('crop-label-' + plotId);
        if (plot) plot.classList.add('harvested');
        if (icon) icon.textContent = '⭐';
        if (label) label.textContent = 'Starfruit!';

        const count = Object.values(questState.q2).filter(Boolean).length;
        const st = document.getElementById('qstatus-2');
        if (st && count < 3) st.textContent = count + '/3 STARFRUIT';
        if (count === 3) {
            completeQuest(2);
        } else {
            addGold(100, '⭐ Starfruit Dipanen');
        }
    };

    // Quest 3 Handler
    window.findScroll = function(bushId) {
        if (questState.q3[bushId]) return;
        questState.q3[bushId] = true;
        playSfx('tap');
        const btn = document.getElementById('scroll-bush-' + bushId);
        const icon = document.getElementById('bush-icon-' + bushId);
        const label = document.getElementById('bush-label-' + bushId);
        if (btn) btn.classList.add('sdv-btn-gold');
        if (icon) icon.textContent = '📜';
        if (label) label.textContent = 'Ditemukan!';

        const count = Object.values(questState.q3).filter(Boolean).length;
        const st = document.getElementById('qstatus-3');
        if (st && count < 3) st.textContent = count + '/3 SCROLL';
        if (count === 3) {
            completeQuest(3);
        } else {
            addGold(100, '📜 Memory Scroll');
        }
    };

    // Quest 4 Handler
    window.slotBundleItem = function(itemId) {
        if (questState.q4[itemId]) return;
        questState.q4[itemId] = true;
        playSfx('tap');
        const slot = document.getElementById('bundle-item-' + itemId);
        const label = document.getElementById('bundle-label-' + itemId);
        if (slot) slot.classList.add('active-slot');
        if (label) label.textContent = '✓ Terpasang';

        const count = Object.values(questState.q4).filter(Boolean).length;
        const st = document.getElementById('qstatus-4');
        if (st && count < 3) st.textContent = count + '/3 ITEM';
        if (count === 3) {
            completeQuest(4);
        } else {
            addGold(100, '💎 Item Bundel');
        }
    };

    // Quest 5 Handler
    window.openTreasureChest = function() {
        if (questState.q5) return;
        questState.q5 = true;
        const icon = document.getElementById('chest-icon');
        const label = document.getElementById('chest-label');
        if (icon) icon.textContent = '🎁';
        if (label) label.textContent = '✓ PETI SHIPPING BIN TERBUKA!';
        completeQuest(5);
    };

    // Unlock All Quests at Once
    window.unlockAllQuests = function() {
        ['groom', 'bride'].forEach(w => { if (!questState.q1[w]) window.giveCoupleGift(w); });
        [1, 2, 3].forEach(i => { if (!questState.q2[i]) window.harvestCrop(i); });
        [1, 2, 3].forEach(i => { if (!questState.q3[i]) window.findScroll(i); });
        [1, 2, 3].forEach(i => { if (!questState.q4[i]) window.slotBundleItem(i); });
        if (!questState.q5) window.openTreasureChest();
        playSfx('all');
        spawnFloatingText('🔓 Semua Informasi Undangan Terbuka!');
    };

    // 4. Audio & Buka Undangan
    const audio = document.getElementById('t1-audio');
    const openBtn = document.getElementById('t1-open-btn');
    const cover = document.getElementById('t1-opening-cover');
    const mainContent = document.getElementById('t1-main-content');
    const hud = document.getElementById('sdv-hud');
    const musicToggle = document.getElementById('t1-music-toggle');
    const bottomDock = document.getElementById('t1-bottom-dock');
    const discIcon = document.getElementById('t1-disc-icon');

    let isPlaying = false;

    function playAudioSafe() {
        if (!audio) return;
        audio.play().then(() => {
            isPlaying = true;
            if (discIcon) discIcon.classList.add('animate-spin-slow');
        }).catch(() => {});
    }

    if (openBtn) {
        openBtn.addEventListener('click', function() {
            playSfx('quest');
            playAudioSafe();
            if (cover) {
                cover.style.transform = 'translateY(-100%)';
                cover.style.opacity = '0';
                setTimeout(() => cover.style.display = 'none', 700);
            }
            if (mainContent) {
                mainContent.classList.remove('opacity-0', 'pointer-events-none');
            }
            if (hud) {
                hud.classList.remove('opacity-0', 'pointer-events-none');
            }
            if (musicToggle) {
                musicToggle.classList.add('music-open');
            }
            if (bottomDock) {
                bottomDock.classList.add('dock-open');
            }
        });
    }

    if (musicToggle) {
        musicToggle.addEventListener('click', function() {
            if (!audio) return;
            if (isPlaying) {
                audio.pause();
                isPlaying = false;
                if (discIcon) discIcon.classList.remove('animate-spin-slow');
            } else {
                audio.play().catch(() => {});
                isPlaying = true;
                if (discIcon) discIcon.classList.add('animate-spin-slow');
            }
        });
    }

    // 5. Countdown Timer
    const cdWrap = document.getElementById('t1-countdown');
    if (cdWrap) {
        const rawDate = cdWrap.dataset.date || '2026-12-31T09:00:00';
        const targetDate = new Date(rawDate).getTime();
        function updateCd() {
            const now = Date.now();
            const diff = Math.max(0, targetDate - now);
            const d = Math.floor(diff / (1000 * 60 * 60 * 24));
            const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const s = Math.floor((diff % (1000 * 60)) / 1000);
            document.getElementById('t1-cd-days').textContent = String(d).padStart(2, '0');
            document.getElementById('t1-cd-hours').textContent = String(h).padStart(2, '0');
            document.getElementById('t1-cd-minutes').textContent = String(m).padStart(2, '0');
            document.getElementById('t1-cd-seconds').textContent = String(s).padStart(2, '0');
        }
        updateCd();
        setInterval(updateCd, 1000);
    }

    // 6. Lightbox
    window.openSdvLightbox = function(url, caption) {
        const modal = document.getElementById('t1-lightbox');
        const img = document.getElementById('t1-lightbox-img');
        const cap = document.getElementById('t1-lightbox-caption');
        if (modal && img) {
            img.src = url;
            if (cap) cap.textContent = caption || 'Momen Bahagia';
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
    };
    window.closeSdvLightbox = function() {
        const modal = document.getElementById('t1-lightbox');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    };

    // 7. Salin Rekening
    window.copyT1 = function(id, btn) {
        const text = document.getElementById(id).textContent.trim();
        playSfx('tap');
        const onCopied = () => {
            const original = btn.innerHTML;
            btn.innerHTML = '<span>✓ Nomor Rekening Tersalin!</span>';
            spawnFloatingText('📋 Tersalin: ' + text);
            setTimeout(() => { btn.innerHTML = original; }, 2000);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(onCopied).catch(onCopied);
        } else {
            onCopied();
        }
    };

    // 8. RSVP AJAX Submit
    const form = document.getElementById('t1-rsvp-form');
    if (form) {
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = document.getElementById('t1-submit-btn');
            const alertEl = document.getElementById('t1-rsvp-alert');
            const name = document.getElementById('t1-rsvp-name').value;
            const attendance = document.getElementById('t1-rsvp-attendance').value;
            const count = parseInt(document.getElementById('t1-rsvp-count').value, 10);
            const message = document.getElementById('t1-rsvp-message').value;

            btn.disabled = true;
            btn.innerHTML = '<span>⏳ Menyimpan ke Bulletin Board...</span>';

            const appendWishCard = () => {
                const empty = document.getElementById('t1-empty-wishes');
                if (empty) empty.remove();
                const list = document.getElementById('t1-wishes-list');
                const card = document.createElement('div');
                card.className = 'sdv-card-inner p-3.5 text-left';
                card.innerHTML = `<div class="flex items-center justify-between mb-1"><strong class="text-xs font-extrabold" style="color: #381a08;">🌾 ${name}</strong><span class="sdv-badge-green font-pixel text-[7px] uppercase">${attendance}</span></div><p class="text-xs leading-relaxed" style="color: #693818;">${message}</p>`;
                if (list) list.prepend(card);
                const countSpan = document.getElementById('t1-wishes-count');
                if (countSpan) countSpan.textContent = String((parseInt(countSpan.textContent || '0', 10) || 0) + 1);
                addGold(1000, '💌 Doa Restu Terkirim!');
                playSfx('quest');
            };

            try {
                const endpoint = '<%= rsvpPath %>';
                if (endpoint && endpoint.startsWith('/')) {
                    const res = await fetch(endpoint, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': '<%= csrfToken %>'
                        },
                        body: JSON.stringify({ name, attendance, number_of_guests: count, message })
                    });
                    if (!res.ok) throw new Error('Network error');
                }
                alertEl.className = 'sdv-badge-green text-xs text-center font-bold p-2.5 rounded-lg block w-full';
                alertEl.textContent = '🎉 Terima kasih! Konfirmasi & doa Anda telah ditempel di Papan Bulletin (+1000G)!';
                appendWishCard();
                form.reset();
            } catch (err) {
                alertEl.className = 'sdv-badge-green text-xs text-center font-bold p-2.5 rounded-lg block w-full';
                alertEl.textContent = '🎉 Terima kasih! Doa Anda telah ditambahkan ke Papan Bulletin (+1000G)!';
                appendWishCard();
                form.reset();
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span>✉️ TEMPEL DOA DI PAPAN BULLETIN</span>';
            }
        });
    }
})();
</script>

</body>
</html>
