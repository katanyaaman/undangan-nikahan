                                        📸 @<%= event.instagram_bride.replace('@', '') %>
                                    </a>
                                </div>
                                <% } %>
                            </div>
                        </div>
                    </section>

                    <!-- PANEL 2: QUEST #2 — PANEN STARFRUIT & RANGKAIAN ACARA -->
                    <section id="acara" class="panel-section space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="font-pixel text-[8px] uppercase" style="color: #7d4014;">QUEST #2 &bull; PANEN KEBUN STARFRUIT</span>
                            <span id="qstatus-2" class="sdv-badge-red font-pixel text-[7px]">0/3 STARFRUIT</span>
                        </div>

                        <div id="quest-gate-2" class="sdv-quest-gate">
