<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title || 'Stardew Valley Wedding RPG — ' + fv(event?.groom_name, 'David') + ' & ' + fv(event?.bride_name, 'Sarah') %></title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --sdv-wood-dark: #3a1a06;
            --sdv-wood-mid: #783e12;
            --sdv-wood-light: #c87a2d;
            --sdv-wood-gold: #f6c464;
            --sdv-parchment: #fce8b8;
            --sdv-parchment-light: #fff8e6;
            --sdv-ink: #381907;
            --sdv-ink-muted: #6e3a15;
            --sdv-green: #2d7a31;
            --sdv-gold: #f5b700;
            --sdv-red: #d9383a;
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        html, body {
            margin: 0 !important;
            padding: 0 !important;
            width: 100%;
            height: 100%;
            overflow: hidden !important;
            background-color: #111d13 !important;
            color: var(--sdv-ink) !important;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif !important;
            user-select: none;
        }

        .font-pixel {
            font-family: 'Press Start 2P', 'Courier New', monospace !important;
            line-height: 1.4;
            letter-spacing: 0.02em;
        }

        .font-vt {
            font-family: 'VT323', 'Courier New', monospace !important;
            letter-spacing: 0.03em;
        }

        /* Viewport-locked Game Container (Mobile-first 440px, full 100dvh) */
        .phone-container {
            width: 100% !important;
            max-width: 440px !important;
            height: 100vh !important;
            height: 100dvh !important;
            margin: 0 auto !important;
            position: relative !important;
            overflow: hidden !important;
            background-color: #3b7430 !important;
            box-shadow: 0 0 60px rgba(0, 0, 0, 0.85);
            border-left: 3px solid #2b1405;
            border-right: 3px solid #2b1405;
        }

        @media (max-width: 640px) {
            .phone-container {
                max-width: 100% !important;
                border-left: none;
                border-right: none;
            }
        }

        /* ================================================================= */
        /* 1. OPENING TITLE SCREEN & GRANDPA'S LETTER                        */
        /* ================================================================= */
        #t1-opening-cover {
            position: absolute;
            inset: 0;
            z-index: 60;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            padding: 20px 14px 22px 14px;
            background: linear-gradient(180deg, #184275 0%, #3a75a8 42%, #5ea470 78%, #2e6128 100%);
            image-rendering: pixelated;
            transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1), transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
            overflow: hidden;
        }

        /* Animated pixel clouds in title screen */
        .title-cloud-layer {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 1;
            overflow: hidden;
        }
        .pixel-cloud {
            position: absolute;
            background: rgba(255, 255, 255, 0.45);
            border-radius: 12px;
            box-shadow: 0 4px 0 rgba(100, 150, 200, 0.3);
            animation: cloud-float linear infinite;
        }
        @keyframes cloud-float {
            from { transform: translateX(-140px); }
            to { transform: translateX(520px); }
        }

        /* Top Title Logo Plaque */
        .sdv-title-header {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 380px;
            text-align: center;
            margin-top: 15px;
        }
        .sdv-plank-sign {
            position: relative;
            background: linear-gradient(180deg, #f7c644 0%, #e09f24 55%, #b87314 100%);
            border: 4px solid #4a2108;
            box-shadow:
                inset 0 2px 0 #ffe699,
                inset 0 -3px 0 #8c510a,
                0 6px 0 rgba(35, 16, 4, 0.75),
                0 10px 24px rgba(0,0,0,0.5);
            border-radius: 10px;
            padding: 12px 14px;
            text-align: center;
        }
        .sdv-plank-sign::before,
        .sdv-plank-sign::after {
            content: '';
            position: absolute;
            top: 7px;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #5c2c0c;
            box-shadow: 0 1px 0 #ffd875;
        }
        .sdv-plank-sign::before { left: 8px; }
        .sdv-plank-sign::after { right: 8px; }

        /* Hanging Chain links holding signboard */
        .sign-chains {
            position: absolute;
            top: -18px;
            left: 24px;
            right: 24px;
            display: flex;
            justify-content: space-between;
            pointer-events: none;
        }
        .chain-link {
            width: 8px;
            height: 20px;
            background: #3e1d08;
            border: 2px solid #854214;
            border-radius: 4px;
        }

        /* Title Screen Bottom Menu Card (Grandpa's Sealed Letter) */
        .sdv-title-menu {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 396px;
            background-color: rgba(252, 232, 184, 0.98);
            border: 4px solid #4a2108;
            box-shadow:
                inset 0 0 0 3px #c87d32,
                0 8px 0 rgba(30, 12, 3, 0.7),
                0 14px 30px rgba(0,0,0,0.65);
            border-radius: 12px;
            padding: 14px 15px;
            text-align: center;
        }

        /* Stardew Wooden Menu Buttons */
        .sdv-wood-btn {
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 8px 12px;
            background: linear-gradient(180deg, #f5c469 0%, #d99136 52%, #a86217 100%) !important;
            border: 3px solid #3e1d08 !important;
            box-shadow: inset 0 2px 0 #ffe6a3, 0 4px 0 #3e1d08 !important;
            color: #361907 !important;
            font-weight: 800 !important;
            border-radius: 8px !important;
            cursor: pointer;
            text-shadow: 0 1px 0 rgba(255, 255, 255, 0.55);
            transition: transform 0.08s ease, filter 0.15s ease;
            text-decoration: none;
        }
        .sdv-wood-btn:hover { filter: brightness(1.06); }
        .sdv-wood-btn:active {
            transform: translateY(3px);
            box-shadow: inset 0 2px 0 #ffe6a3, 0 1px 0 #3e1d08 !important;
        }

        .sdv-green-btn {
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 8px 12px;
            background: linear-gradient(180deg, #68cc5c 0%, #3b9e31 55%, #26731e 100%) !important;
            border: 3px solid #143d10 !important;
            box-shadow: inset 0 2px 0 #a3f299, 0 4px 0 #143d10 !important;
            color: #ffffff !important;
            font-weight: 800 !important;
            border-radius: 8px !important;
            cursor: pointer;
            text-shadow: 1px 1px 0 #143d10;
            transition: transform 0.08s ease, filter 0.15s ease;
            text-decoration: none;
        }
        .sdv-green-btn:active {
            transform: translateY(3px);
            box-shadow: inset 0 2px 0 #a3f299, 0 1px 0 #143d10 !important;
        }

        /* ================================================================= */
        /* 2. TOP-DOWN 2D GAME WORLD & AUTHENTIC STARDEW HUD                 */
        /* ================================================================= */
        #t1-main-content {
            position: absolute;
            inset: 0;
            z-index: 10;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        #sdv-game-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            display: block;
            image-rendering: pixelated;
            image-rendering: crisp-edges;
            cursor: pointer;
        }

        /* Top-Right Authentic Clock Cluster */
        .sdv-clock-cluster {
            position: absolute;
            top: 8px;
            right: 8px;
            z-index: 30;
            display: flex;
            align-items: flex-start;
            gap: 5px;
            pointer-events: auto;
        }

        .sdv-journal-btn {
            width: 38px;
            height: 38px;
            margin-top: 2px;
            border-radius: 8px;
            background: linear-gradient(180deg, #4fa4e8 0%, #2368a8 100%);
            border: 3px solid #3e1d08;
            box-shadow: inset 0 2px 0 #95d0ff, 0 3px 0 rgba(0,0,0,0.45);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            position: relative;
        }
        .sdv-journal-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #f5b700;
            color: #361907;
            border: 2px solid #3e1d08;
            border-radius: 999px;
            font-size: 8px;
            font-weight: 900;
            padding: 1px 4px;
            animation: pulse-badge 1s ease-in-out infinite;
        }
        @keyframes pulse-badge {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.15); }
        }

        .sdv-clock-box {
            background: linear-gradient(180deg, #e09641 0%, #b5661d 100%);
            border: 3px solid #3e1d08;
            box-shadow: inset 0 2px 0 #f7c97e, 0 4px 8px rgba(0,0,0,0.5);
            border-radius: 10px;
            padding: 4px;
            width: 154px;
        }

        .sdv-clock-top {
            display: flex;
            align-items: stretch;
            gap: 4px;
        }

        .sdv-dial {
            width: 42px;
            height: 60px;
            border-radius: 28px 6px 6px 28px;
            background: linear-gradient(180deg, #214378 0%, #589be0 55%, #f5d17a 100%);
            border: 2px solid #4a2108;
            position: relative;
            overflow: hidden;
            flex-shrink: 0;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.45);
        }
        .sdv-dial-hand {
            position: absolute;
            right: 3px;
            top: 50%;
            width: 22px;
            height: 4px;
            background: #f5b700;
            border: 1px solid #3e1d08;
            transform-origin: right center;
            transform: translateY(-50%) rotate(20deg);
        }

        .sdv-clock-slots {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 2.5px;
        }
        .sdv-clock-slot {
            background: #fce8b8;
            border: 2px solid #5c2c0c;
            border-radius: 4px;
            padding: 2px 3px;
            text-align: center;
            font-weight: 800;
            color: #361907;
            font-size: 9.5px;
            line-height: 1.15;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.7);
        }
        .sdv-weather-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2.5px;
        }

        .sdv-gold-bar {
            margin-top: 3.5px;
            background: linear-gradient(180deg, #d98832 0%, #9e5314 100%);
            border: 3px solid #3e1d08;
            border-radius: 8px;
            padding: 3px 6px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: inset 0 1px 0 #f7c97e, 0 3px 6px rgba(0,0,0,0.45);
        }
        .sdv-gold-digits {
            background: #fce8b8;
            border: 2px solid #5c2c0c;
            border-radius: 4px;
            padding: 1px 5px;
            font-family: 'VT323', monospace;
            font-size: 16px;
            font-weight: 900;
            letter-spacing: 2px;
            color: #361907;
            min-width: 90px;
            text-align: right;
        }

        /* Top-Left Active Quest Tracker */
        .sdv-quest-tracker-pill {
            position: absolute;
            top: 8px;
            left: 8px;
            z-index: 30;
            max-width: calc(100% - 215px);
            background: rgba(252, 232, 184, 0.96);
            border: 3px solid #3e1d08;
            box-shadow: inset 0 0 0 2px #c87d32, 0 4px 8px rgba(0,0,0,0.45);
            border-radius: 10px;
            padding: 6px 8px;
            cursor: pointer;
        }

        /* Bottom-Right Energy Bar */
        .sdv-energy-bar {
            position: absolute;
            bottom: 74px;
            right: 8px;
            z-index: 25;
            width: 24px;
            height: 114px;
            background: linear-gradient(90deg, #b5661d 0%, #e09641 50%, #8f4b10 100%);
            border: 3px solid #3e1d08;
            border-radius: 6px;
            padding: 3px;
            display: flex;
            flex-direction: column;
            align-items: center;
            box-shadow: 0 4px 8px rgba(0,0,0,0.5);
        }
        .sdv-energy-header {
            font-family: 'Press Start 2P', monospace;
            font-size: 8px;
            color: #ffd84d;
            text-shadow: 1px 1px 0 #3e1d08;
            margin-bottom: 3px;
        }
        .sdv-energy-track {
            flex: 1;
            width: 100%;
            background: #241205;
            border: 1px solid #5c2c0c;
            border-radius: 3px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            overflow: hidden;
        }
        .sdv-energy-fill {
            width: 100%;
            height: 94%;
            background: linear-gradient(90deg, #28a822 0%, #5aff4f 50%, #1d8018 100%);
            transition: height 0.3s ease;
        }

        /* On-Screen D-Pad Controller */
        .sdv-dpad {
            position: absolute;
            bottom: 74px;
            left: 10px;
            z-index: 25;
            width: 98px;
            height: 98px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: repeat(3, 1fr);
            gap: 2px;
        }
        .dpad-btn {
            background: rgba(58, 26, 6, 0.85);
            border: 2px solid #f5c56c;
            color: #fff8e7;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 900;
            cursor: pointer;
            box-shadow: 0 2px 5px rgba(0,0,0,0.45);
            user-select: none;
            touch-action: manipulation;
        }
        .dpad-btn:active {
            background: #f5b700;
            color: #361907;
            transform: scale(0.93);
        }

        /* Bottom Center Stardew Inventory Hotbar */
        #t1-bottom-dock {
            position: absolute;
            bottom: 8px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 30;
            width: 96%;
            max-width: 424px;
            background: linear-gradient(180deg, #d98832 0%, #9e5314 100%);
            border: 3px solid #3e1d08;
            box-shadow:
                inset 0 2px 0 #f7c97e,
                0 5px 14px rgba(0,0,0,0.65);
            border-radius: 8px;
            padding: 3.5px;
        }
        .sdv-hotbar-grid {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            gap: 2.5px;
        }
        .sdv-hotbar-slot {
            aspect-ratio: 1 / 1;
            min-height: 46px;
            background: #f5d69d;
            border: 2px solid #6e3711;
            box-shadow: inset 2px 2px 0 #c49c5e, inset -2px -2px 0 #fff1cc;
            border-radius: 4px;
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            padding: 2px;
            transition: transform 0.08s ease;
        }
        .sdv-hotbar-slot.active-slot,
        .sdv-hotbar-slot:hover {
            border: 2px solid #d9383a;
            box-shadow: 0 0 0 1px #ffd84d, inset 2px 2px 0 #c49c5e;
            background: #fff3cf;
        }
        .sdv-slot-num {
            position: absolute;
            top: 1px;
            left: 3px;
            font-family: 'Press Start 2P', monospace;
            font-size: 6px;
            color: #693818;
        }
        .sdv-slot-qty {
            position: absolute;
            bottom: 1px;
            right: 2px;
            font-family: 'Press Start 2P', monospace;
            font-size: 6px;
            color: #361907;
            background: rgba(255,255,255,0.7);
            padding: 0 2px;
            border-radius: 2px;
        }
        .sdv-slot-qty.done {
            background: #2d7a31;
            color: #ffffff;
        }
        .sdv-slot-label {
            font-size: 8px;
            font-weight: 800;
            color: #361907;
            line-height: 1;
            margin-top: 2px;
            letter-spacing: -0.02em;
        }

        /* Floating Audio Control */
        #t1-music-toggle {
            position: absolute;
            top: 76px;
            left: 8px;
            z-index: 30;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: #fce8b8;
            border: 3px solid #3e1d08;
            box-shadow: 0 3px 6px rgba(0,0,0,0.45);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        /* ================================================================= */
        /* 3. STARDEW RPG DIALOGUE & QUEST MODAL OVERLAY                     */
        /* ================================================================= */
        #sdv-modal-backdrop {
            position: absolute;
            inset: 0;
            z-index: 50;
            background: rgba(12, 8, 4, 0.75);
            backdrop-filter: blur(4px);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 10px;
        }
        #sdv-modal-backdrop.modal-open {
            display: flex;
        }

        .sdv-dialog-window {
            width: 100%;
            max-width: 418px;
            max-height: 88vh;
            max-height: 88dvh;
            display: flex;
            flex-direction: column;
            background-color: var(--sdv-parchment) !important;
            border: 4px solid var(--sdv-wood-dark) !important;
            box-shadow:
                inset 0 0 0 3px var(--sdv-wood-light),
                inset 0 0 0 5px var(--sdv-wood-gold),
                0 12px 32px rgba(0, 0, 0, 0.8) !important;
            border-radius: 12px !important;
            overflow: hidden;
            animation: pop-modal 0.18s cubic-bezier(0.18, 0.89, 0.32, 1.28);
        }
        @keyframes pop-modal {
            from { transform: scale(0.92); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        .sdv-dialog-header {
            background: linear-gradient(180deg, #b56c2b 0%, #854214 55%, #632f0b 100%);
            border-bottom: 3px solid #3e1d08;
            padding: 9px 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: #fff8e7;
            flex-shrink: 0;
        }

        .sdv-dialog-body {
            padding: 12px 14px;
            overflow-y: auto;
            flex: 1;
        }

        /* Dialogue Box Character Banner (Like Authentic Stardew Dialogue Box) */
        .sdv-speaker-box {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #fae1a0;
            border: 3px solid #7d4014;
            border-radius: 10px;
            padding: 8px 10px;
            margin-bottom: 12px;
        }
        .sdv-speaker-portrait {
            width: 52px;
            height: 52px;
            background: #d99136;
            border: 3px solid #3e1d08;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            flex-shrink: 0;
            box-shadow: inset 0 2px 0 #ffe6a3;
        }
        .sdv-speaker-info {
            flex: 1;
            min-width: 0;
        }
        .sdv-speaker-name {
            font-family: 'Press Start 2P', monospace;
            font-size: 9px;
            color: #3e1d08;
            margin-bottom: 3px;
        }
        .sdv-speaker-tag {
            font-size: 11px;
            color: #6e3a15;
            font-weight: 700;
        }

        .sdv-card-inner {
            background-color: var(--sdv-parchment-light) !important;
            border: 3px solid #9c5a25 !important;
            box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.65), 0 3px 0 rgba(74, 33, 8, 0.16) !important;
            border-radius: 10px !important;
            padding: 12px;
            color: var(--sdv-ink) !important;
        }

        .sdv-quest-gate {
            background-color: #f7dca0 !important;
            border: 3px dashed #854214 !important;
            border-radius: 10px !important;
            padding: 12px !important;
            color: var(--sdv-ink) !important;
            margin-bottom: 12px;
        }

        .sdv-badge-red {
            display: inline-block;
            background-color: #d9383a !important;
            color: #ffffff !important;
            border: 2px solid #5c1112 !important;
            padding: 3px 8px !important;
            border-radius: 6px !important;
            font-weight: 800 !important;
        }
        .sdv-badge-green {
            display: inline-block;
            background-color: #2d7a31 !important;
            color: #ffffff !important;
            border: 2px solid #144016 !important;
            padding: 3px 8px !important;
            border-radius: 6px !important;
            font-weight: 800 !important;
        }
        .sdv-badge-gold {
            display: inline-block;
            background-color: #f5b700 !important;
            color: #361907 !important;
            border: 2px solid #5c3304 !important;
            padding: 3px 8px !important;
            border-radius: 6px !important;
            font-weight: 800 !important;
        }

        .quest-locked-blur {
            filter: blur(5px) grayscale(0.45);
            opacity: 0.42;
            pointer-events: none;
            user-select: none;
            max-height: 170px;
            overflow: hidden;
            transition: all 0.45s ease;
        }
        .quest-unlocked {
            filter: none !important;
            opacity: 1 !important;
            pointer-events: auto !important;
            user-select: auto !important;
            max-height: 8000px !important;
            overflow: visible !important;
        }

        .crop-plot {
            min-height: 84px;
            background: repeating-linear-gradient(45deg, #6b3e1b, #6b3e1b 6px, #593112 6px, #593112 12px) !important;
            border: 3px solid #3b1d08 !important;
            border-radius: 10px !important;
            color: #ffe9a6 !important;
            cursor: pointer;
            transition: transform 0.1s ease;
        }
        .crop-plot:active { transform: scale(0.95); }
        .crop-plot.harvested {
            background: linear-gradient(180deg, #4b9e3e 0%, #2d7a31 100%) !important;
            border-color: #ffd84d !important;
            color: #ffffff !important;
        }

        .sdv-photo-frame {
            width: 108px;
            height: 108px;
            margin: 8px auto;
            border-radius: 14px;
            padding: 5px;
            background-color: #854214 !important;
            border: 3px solid #381a08 !important;
            cursor: pointer;
        }

        .sdv-input {
            width: 100%;
            min-height: 44px;
            padding: 9px 12px;
            border-radius: 8px !important;
            background-color: #fce8b8 !important;
            border: 2px solid #854214 !important;
            color: #361907 !important;
            font-size: 13px !important;
            font-weight: 600 !important;
        }

        @keyframes float-up {
            0% { opacity: 1; transform: translate(-50%, 0) scale(0.95); }
            100% { opacity: 0; transform: translate(-50%, -46px) scale(1.1); }
        }
        .floating-reward {
            position: fixed;
            left: 50%;
            top: 40%;
            z-index: 9999;
            pointer-events: none;
            background-color: #ffd84d !important;
            border: 3px solid #381a08 !important;
            color: #381a08 !important;
            padding: 8px 14px;
            border-radius: 10px;
            box-shadow: 0 6px 16px rgba(0,0,0,0.5);
            animation: float-up 1.3s ease-out forwards;
        }

        .panel-section { display: none; }
        .panel-section.active-panel { display: block; }
    </style>
</head>
<body>

<div class="phone-container">

    <!-- Audio Element -->
    <audio id="t1-audio" loop preload="auto">
        <source src="<%= event?.background_music || '/music/wedding-song.wav' %>" type="audio/wav">
