<style>
    .font-script { font-family: 'Great Vibes', 'Dancing Script', cursive; }
    .font-display { font-family: 'Cinzel', serif; }
</style>

<!-- Audio element -->
<audio id="wedding-audio" loop preload="auto">
    <source src="/music/wedding-song.mp3" type="audio/mpeg">
</audio>

<!-- Opening Cover / Amplop Digital -->
<div id="opening-cover" class="fixed inset-0 z-50 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 flex items-center justify-center transition-all duration-1000 px-4">
    <div class="relative z-10 text-center max-w-lg mx-auto py-12 px-6 rounded-3xl bg-slate-900/80 border border-gold-400/30 shadow-2xl backdrop-blur-xl">
        <!-- Monogram Seal -->
        <div class="w-20 h-20 mx-auto mb-6 rounded-full border-2 border-gold-400/80 flex items-center justify-center bg-gold-400/10 shadow-lg shadow-gold-500/10">
            <span class="font-display text-2xl font-bold text-gold-400 tracking-wider">
                <%= (fv(event?.groom_name, 'D')[0]) %>&<%= (fv(event?.bride_name, 'S')[0]) %>
            </span>
        </div>

        <p class="text-xs uppercase tracking-[0.3em] text-gold-400 mb-2 font-semibold">The Wedding Celebration Of</p>

        <h1 class="font-script text-4xl sm:text-5xl text-white mb-6 leading-tight">
            <span data-demo="groom_name"><%= fv(event?.groom_name, 'David') %></span>
            <span class="text-gold-400 font-serif text-3xl mx-1">&</span>
            <span data-demo="bride_name"><%= fv(event?.bride_name, 'Sarah') %></span>
        </h1>

        <div class="w-12 h-0.5 bg-gradient-to-r from-transparent via-gold-400 to-transparent mx-auto mb-6"></div>

        <p class="text-xs text-slate-400 uppercase tracking-widest mb-1">Kepada Yth. Bapak/Ibu/Saudara/i</p>
        <p id="t1-recipient-name" class="text-lg sm:text-xl font-serif font-semibold text-gold-300 mb-8 px-4 py-2 bg-slate-950/60 rounded-xl border border-slate-800 inline-block">
            Tamu Undangan
        </p>

        <div>
            <button id="open-invitation" class="group inline-flex items-center justify-center px-8 py-3.5 text-sm sm:text-base font-bold text-slate-950 bg-gradient-to-r from-gold-400 via-amber-300 to-gold-400 hover:from-gold-300 hover:to-gold-500 rounded-full shadow-lg shadow-gold-500/20 hover:shadow-gold-500/40 transition-all duration-300 transform hover:scale-105 active:scale-95">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19v-8.93a2 2 0 01.89-1.664l7-4.666a2 2 0 012.22 0l7 4.666A2 2 0 0121 10.07V19M3 19a2 2 0 002 2h14a2 2 0 002-2M3 19l6.75-4.5M21 19l-6.75-4.5M3 10l6.75 4.5M21 10l-6.75 4.5m0 0l-1.14.76a2 2 0 01-2.22 0l-1.14-.76"></path>
                </svg>
                <span>Buka Undangan</span>
            </button>
        </div>
    </div>
</div>

<!-- Main Content Wrapper -->
<div id="main-content" class="opacity-0 pointer-events-none transition-opacity duration-1000 bg-slate-950 text-slate-100">
    <!-- Hero Section -->
    <section id="opening" class="relative min-h-[92vh] flex items-center justify-center text-center px-4 overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950">
        <div class="absolute inset-0 opacity-15 pointer-events-none bg-[radial-gradient(#d4af37_1px,transparent_1px)] [background-size:24px_24px]"></div>

        <div class="relative z-10 max-w-3xl mx-auto py-16">
            <span class="inline-block text-xs uppercase tracking-[0.3em] text-gold-400 font-semibold mb-3">Walimatul 'Ursy</span>
            
            <h1 class="font-script text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-white mb-4 leading-tight">
                <span data-demo="groom_name"><%= fv(event?.groom_name, 'Nama Pria') %></span>
                <span class="block text-2xl sm:text-3xl font-serif text-gold-400 my-2">&</span>
                <span data-demo="bride_name"><%= fv(event?.bride_name, 'Nama Wanita') %></span>
            </h1>

            <p class="text-sm sm:text-base text-slate-300 font-serif tracking-widest mt-4">
                <span data-demo="event_date" data-fmt="long" data-raw="<%= event?.event_date || '' %>"><%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %></span>
            </p>
            <p class="text-xs text-gold-400/90 font-mono tracking-wider mt-1">
                <%= fv(eventTimeStart, 'Pukul 09.00 WIB') %>
            </p>

            <div class="mt-10 animate-bounce">
                <a href="#salam" class="inline-flex items-center text-slate-400 hover:text-gold-400 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Salam & Pasangan Section -->
    <section id="salam" class="py-20 bg-slate-900 text-white relative">
        <div class="container mx-auto px-4 max-w-4xl text-center">
            <div class="mb-12">
                <h2 class="text-2xl sm:text-3xl font-serif text-gold-300 mb-3">
                    Assalamu'alaikum Warahmatullahi Wabarakatuh
                </h2>
                <div class="w-16 h-0.5 bg-gold-400/50 mx-auto mb-6"></div>
                <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-2xl mx-auto">
                    Maha Suci Allah yang telah menciptakan makhluk-Nya berpasang-pasangan. Dengan memohon rahmat dan ridho-Nya, kami bermaksud menyelenggarakan syukuran pernikahan putra-putri kami:
                </p>
            </div>

            <!-- Couple Cards Grid -->
            <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto text-center">
                <!-- Groom Card -->
                <div class="bg-slate-850 rounded-3xl p-7 border border-slate-700/60 shadow-xl hover:border-gold-400/40 transition-all duration-300">
                    <div class="w-32 h-32 mx-auto mb-5 rounded-full p-1 bg-gradient-to-tr from-gold-400 to-amber-200 shadow-md">
                        <div class="w-full h-full rounded-full overflow-hidden bg-slate-800">
                            <img src="<%= groomPhoto || '/images/demo/groom.svg' %>" alt="Mempelai Pria" class="w-full h-full object-cover">
                        </div>
                    </div>
                    <h3 class="font-script text-3xl text-gold-300 mb-1">
                        <span data-demo="groom_name"><%= fv(event?.groom_name, 'Nama Lengkap Pria') %></span>
                    </h3>
                    <p class="text-xs text-slate-400 mb-2">Putra tercinta dari:</p>
                    <p class="text-sm font-medium text-slate-200 leading-snug">
                        <span data-demo="groom_father"><%= fv(event?.groom_father, 'Bapak [Nama]') %></span> & <span data-demo="groom_mother"><%= fv(event?.groom_mother, 'Ibu [Nama]') %></span>
                    </p>
                    <% if (event?.instagram_groom) { %>
                    <a href="https://instagram.com/<%= (event.instagram_groom).replace('@', '') %>" target="_blank" class="inline-flex items-center text-xs font-semibold text-gold-400 hover:text-gold-300 mt-4 px-3 py-1.5 rounded-full bg-slate-800 border border-slate-700 transition-colors">
                        <span>@<%= (event.instagram_groom).replace('@', '') %></span>
                    </a>
                    <% } %>
                </div>

                <!-- Bride Card -->
                <div class="bg-slate-850 rounded-3xl p-7 border border-slate-700/60 shadow-xl hover:border-gold-400/40 transition-all duration-300">
                    <div class="w-32 h-32 mx-auto mb-5 rounded-full p-1 bg-gradient-to-tr from-gold-400 to-amber-200 shadow-md">
                        <div class="w-full h-full rounded-full overflow-hidden bg-slate-800">
                            <img src="<%= bridePhoto || '/images/demo/bride.svg' %>" alt="Mempelai Wanita" class="w-full h-full object-cover">
                        </div>
                    </div>
                    <h3 class="font-script text-3xl text-gold-300 mb-1">
                        <span data-demo="bride_name"><%= fv(event?.bride_name, 'Nama Lengkap Wanita') %></span>
                    </h3>
                    <p class="text-xs text-slate-400 mb-2">Putri tercinta dari:</p>
                    <p class="text-sm font-medium text-slate-200 leading-snug">
                        <span data-demo="bride_father"><%= fv(event?.bride_father, 'Bapak [Nama]') %></span> & <span data-demo="bride_mother"><%= fv(event?.bride_mother, 'Ibu [Nama]') %></span>
                    </p>
                    <% if (event?.instagram_bride) { %>
                    <a href="https://instagram.com/<%= (event.instagram_bride).replace('@', '') %>" target="_blank" class="inline-flex items-center text-xs font-semibold text-gold-400 hover:text-gold-300 mt-4 px-3 py-1.5 rounded-full bg-slate-800 border border-slate-700 transition-colors">
                        <span>@<%= (event.instagram_bride).replace('@', '') %></span>
                    </a>
                    <% } %>
                </div>
            </div>
        </div>
    </section>

    <!-- Event & Countdown Section -->
    <section id="event" class="py-20 bg-slate-950 text-white relative">
        <div class="container mx-auto px-4 max-w-5xl">
            <div class="text-center mb-14">
                <span class="inline-block text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold mb-2">Save The Date</span>
                <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-white mb-4">
                    Waktu & Tempat Acara
                </h2>
                <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-gold-400 to-transparent mx-auto mb-6"></div>
            </div>

            <!-- Countdown Timer Card -->
            <div class="max-w-xl mx-auto mb-14 bg-slate-900/90 rounded-2xl p-6 sm:p-8 border border-gold-400/30 text-center shadow-xl">
                <h3 class="text-sm uppercase tracking-widest text-gold-400 mb-6 font-semibold">Menghitung Hari Bahagia</h3>
                <div id="countdown" class="grid grid-cols-4 gap-3 sm:gap-4">
                    <div class="bg-slate-950 rounded-xl p-3 sm:p-4 border border-slate-800">
                        <div id="days" class="text-2xl sm:text-4xl font-mono font-bold text-white">00</div>
                        <div class="text-[11px] text-slate-400 uppercase tracking-wider mt-1">Hari</div>
                    </div>
                    <div class="bg-slate-950 rounded-xl p-3 sm:p-4 border border-slate-800">
                        <div id="hours" class="text-2xl sm:text-4xl font-mono font-bold text-white">00</div>
                        <div class="text-[11px] text-slate-400 uppercase tracking-wider mt-1">Jam</div>
                    </div>
                    <div class="bg-slate-950 rounded-xl p-3 sm:p-4 border border-slate-800">
                        <div id="minutes" class="text-2xl sm:text-4xl font-mono font-bold text-white">00</div>
                        <div class="text-[11px] text-slate-400 uppercase tracking-wider mt-1">Menit</div>
                    </div>
                    <div class="bg-slate-950 rounded-xl p-3 sm:p-4 border border-slate-800">
                        <div id="seconds" class="text-2xl sm:text-4xl font-mono font-bold text-white">00</div>
                        <div class="text-[11px] text-slate-400 uppercase tracking-wider mt-1">Detik</div>
                    </div>
                </div>
            </div>

            <!-- Event Details Cards -->
            <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
                <!-- Card 1: Akad Nikah -->
                <div class="bg-slate-900 rounded-2xl p-7 border border-slate-800 shadow-xl text-center">
                    <div class="w-12 h-12 rounded-full bg-gold-400/10 text-gold-400 mx-auto mb-4 flex items-center justify-center font-serif text-lg font-bold">
                        I
                    </div>
                    <h3 class="text-xl font-serif font-bold text-white mb-2">Akad Nikah</h3>
                    <div class="space-y-2 text-sm text-slate-300 mb-6">
                        <p class="font-medium text-gold-300">
                            <span data-demo="event_date" data-fmt="long" data-raw="<%= event?.event_date || '' %>"><%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %></span>
                        </p>
                        <p class="font-mono text-xs">Pukul 08.00 - 10.00 WIB</p>
                        <p class="font-semibold text-white mt-3"><span data-demo="venue_name"><%= fv(venueName, 'Masjid Agung & Ballroom') %></span></p>
                        <p class="text-xs text-slate-400 leading-relaxed"><span data-demo="venue_address"><%= fv(venueAddress, 'Jl. Sudirman No. 123, Jakarta') %></span></p>
                    </div>
                    <div class="flex flex-col sm:flex-row items-center justify-center gap-2 pt-2">
                        <a href="https://maps.google.com/?q=<%= encodeURIComponent(venueAddress || venueName || 'Lokasi Acara') %>" target="_blank" class="w-full sm:w-auto inline-flex items-center justify-center px-4 py-2 rounded-xl bg-gold-400 hover:bg-gold-300 text-slate-950 text-xs font-bold transition-all">
                            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            Google Maps
                        </a>
                        <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Akad+Nikah+<%= encodeURIComponent(fv(event?.groom_name, 'David') + '+%26+' + fv(event?.bride_name, 'Sarah')) %>&location=<%= encodeURIComponent(fv(venueName, '') + ', ' + fv(venueAddress, '')) %>" target="_blank" class="w-full sm:w-auto inline-flex items-center justify-center px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium border border-slate-700 transition-all">
                            + Kalender
                        </a>
                    </div>
                </div>

                <!-- Card 2: Resepsi Pernikahan -->
                <div class="bg-slate-900 rounded-2xl p-7 border border-slate-800 shadow-xl text-center">
                    <div class="w-12 h-12 rounded-full bg-gold-400/10 text-gold-400 mx-auto mb-4 flex items-center justify-center font-serif text-lg font-bold">
                        II
                    </div>
                    <h3 class="text-xl font-serif font-bold text-white mb-2">Resepsi Pernikahan</h3>
                    <div class="space-y-2 text-sm text-slate-300 mb-6">
                        <p class="font-medium text-gold-300">
                            <span data-demo="event_date" data-fmt="long" data-raw="<%= event?.event_date || '' %>"><%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %></span>
                        </p>
                        <p class="font-mono text-xs"><%= fv(eventTimeRange, '11.00 WIB - Selesai') %></p>
                        <p class="font-semibold text-white mt-3"><span data-demo="venue_name"><%= fv(venueName, 'Grand Ballroom Hotel') %></span></p>
                        <p class="text-xs text-slate-400 leading-relaxed"><span data-demo="venue_address"><%= fv(venueAddress, 'Jl. Sudirman No. 123, Jakarta') %></span></p>
                    </div>
                    <div class="flex flex-col sm:flex-row items-center justify-center gap-2 pt-2">
                        <a href="https://maps.google.com/?q=<%= encodeURIComponent(venueAddress || venueName || 'Lokasi Acara') %>" target="_blank" class="w-full sm:w-auto inline-flex items-center justify-center px-4 py-2 rounded-xl bg-gold-400 hover:bg-gold-300 text-slate-950 text-xs font-bold transition-all">
                            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            Google Maps
                        </a>
                        <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Resepsi+Pernikahan+<%= encodeURIComponent(fv(event?.groom_name, 'David') + '+%26+' + fv(event?.bride_name, 'Sarah')) %>&location=<%= encodeURIComponent(fv(venueName, '') + ', ' + fv(venueAddress, '')) %>" target="_blank" class="w-full sm:w-auto inline-flex items-center justify-center px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium border border-slate-700 transition-all">
                            + Kalender
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Gallery Section -->
    <%- include('./sections/gallery') %>

    <!-- Gift Section -->
    <%- include('./sections/gift') %>

    <!-- Wishes / Guestbook Section -->
    <%- include('./sections/guestbook') %>

    <!-- RSVP Section -->
    <section id="rsvp" class="py-20 bg-slate-950 text-white relative">
        <div class="container mx-auto px-4 max-w-xl">
            <div class="text-center mb-12">
                <span class="inline-block text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold mb-2">Konfirmasi Kehadiran</span>
                <h2 class="text-3xl sm:text-4xl font-serif text-white mb-3">Reservasi & Ucapan</h2>
                <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-gold-400 to-transparent mx-auto mb-4"></div>
                <p class="text-xs sm:text-sm text-slate-300">
                    Kehadiran Anda merupakan suatu kebahagiaan dan kehormatan bagi kami sekeluarga.
                </p>
            </div>

            <div class="bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-2xl">
                <form id="rsvp-form" class="space-y-4">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div>
                        <label for="name" class="block text-xs uppercase tracking-wider text-slate-300 mb-1.5 font-semibold">Nama Lengkap *</label>
                        <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-gold-400 focus:border-transparent text-sm" placeholder="Nama Anda">
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label for="email" class="block text-xs uppercase tracking-wider text-slate-300 mb-1.5 font-semibold">Email / Kontak</label>
                            <input type="text" id="email" name="email" class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-gold-400 focus:border-transparent text-sm" placeholder="email@contoh.com">
                        </div>
                        <div>
                            <label for="attendance" class="block text-xs uppercase tracking-wider text-slate-300 mb-1.5 font-semibold">Konfirmasi Kehadiran *</label>
                            <select id="attendance" name="attendance" required class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-700 text-white focus:outline-none focus:ring-2 focus:ring-gold-400 focus:border-transparent text-sm">
                                <option value="">Pilih Kehadiran</option>
                                <option value="hadir">Hadir</option>
                                <option value="tidak_hadir">Berhalangan Hadir</option>
                            </select>
                        </div>
                    </div>

                    <div id="guests-field" class="hidden">
                        <label for="number_of_guests" class="block text-xs uppercase tracking-wider text-slate-300 mb-1.5 font-semibold">Jumlah Tamu</label>
                        <input type="number" id="number_of_guests" name="number_of_guests" min="1" max="5" value="1" class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-700 text-white focus:outline-none focus:ring-2 focus:ring-gold-400 focus:border-transparent text-sm">
                    </div>

                    <div>
                        <label for="message" class="block text-xs uppercase tracking-wider text-slate-300 mb-1.5 font-semibold">Ucapan & Doa Restu</label>
                        <textarea id="message" name="message" rows="3" class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-gold-400 focus:border-transparent text-sm" placeholder="Tuliskan doa restu untuk kedua mempelai..."></textarea>
                    </div>

                    <div id="alert-container"></div>

                    <button type="submit" id="submit-btn" class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-gold-400 via-amber-300 to-gold-400 text-slate-950 font-bold text-sm tracking-wide shadow-lg hover:from-gold-300 hover:to-gold-500 transition-all active:scale-95">
                        Kirim Konfirmasi & Doa
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="py-12 bg-slate-950 border-t border-slate-900 text-center text-slate-500 text-xs pb-28">
        <p class="font-script text-2xl text-gold-400 mb-2">Terima Kasih</p>
        <p class="text-slate-400">Merupakan suatu kehormatan dan kebahagiaan atas kehadiran serta doa restu Anda.</p>
        <p class="mt-4 text-slate-600">&copy; <%= new Date().getFullYear() %> Wedding Invitation &bull; Elegant Modern</p>
    </footer>
</div>

<!-- Floating Music Button -->
<button id="music-toggle" aria-label="Toggle Musik" class="fixed bottom-20 right-4 z-40 w-12 h-12 rounded-full bg-slate-900/90 border border-gold-400/50 shadow-xl flex items-center justify-center text-gold-400 transition-all duration-300 opacity-0 pointer-events-none hover:scale-105 active:scale-95">
    <div id="music-disc" class="w-7 h-7 rounded-full border-2 border-gold-400/80 flex items-center justify-center">
        <div class="w-2 h-2 rounded-full bg-gold-400"></div>
    </div>
</button>

<!-- Bottom Navigation Dock -->
<nav id="bottom-nav" class="fixed bottom-3 left-1/2 -translate-x-1/2 z-40 w-[92%] max-w-md rounded-2xl bg-slate-900/90 border border-slate-800/80 backdrop-blur-lg shadow-2xl py-2 px-3 transition-all duration-500 translate-y-24 opacity-0">
    <div class="flex items-center justify-around text-[10px] sm:text-xs font-medium text-slate-400">
        <a href="#opening" class="nav-item flex flex-col items-center py-1 px-2 hover:text-gold-400 transition-colors">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            <span>Home</span>
        </a>
        <a href="#salam" class="nav-item flex flex-col items-center py-1 px-2 hover:text-gold-400 transition-colors">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
            <span>Pasangan</span>
        </a>
        <a href="#event" class="nav-item flex flex-col items-center py-1 px-2 hover:text-gold-400 transition-colors">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <span>Acara</span>
        </a>
        <a href="#gallery" class="nav-item flex flex-col items-center py-1 px-2 hover:text-gold-400 transition-colors">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <span>Galeri</span>
        </a>
        <a href="#gift" class="nav-item flex flex-col items-center py-1 px-2 hover:text-gold-400 transition-colors">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"></path></svg>
            <span>Hadiah</span>
        </a>
        <a href="#rsvp" class="nav-item flex flex-col items-center py-1 px-2 hover:text-gold-400 transition-colors">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            <span>RSVP</span>
        </a>
    </div>
</nav>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 1. Recipient Name from URL ?to=
    const urlParams = new URLSearchParams(window.location.search);
    const toParam = urlParams.get('to');
    if (toParam) {
        const recipEl = document.getElementById('t1-recipient-name');
        if (recipEl) recipEl.textContent = toParam;
    }

    // 2. Audio handling with Web Audio API fallback
    const audioElement = document.getElementById('wedding-audio');
    const musicToggle = document.getElementById('music-toggle');
    const musicDisc = document.getElementById('music-disc');
    let isMusicPlaying = false;
    let synthContext = null;
    let synthInterval = null;

    function playMelodicSynth() {
        try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;
            if (!synthContext) synthContext = new AudioContext();
            if (synthContext.state === 'suspended') synthContext.resume();

            const notes = [261.63, 329.63, 392.00, 523.25, 440.00, 392.00, 349.23, 329.63];
            let noteIdx = 0;
            if (synthInterval) clearInterval(synthInterval);

            synthInterval = setInterval(function() {
                if (!isMusicPlaying || !synthContext) return;
                const osc = synthContext.createOscillator();
                const gain = synthContext.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(notes[noteIdx % notes.length], synthContext.currentTime);
                gain.gain.setValueAtTime(0.04, synthContext.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, synthContext.currentTime + 1.2);
                osc.connect(gain);
                gain.connect(synthContext.destination);
                osc.start();
                osc.stop(synthContext.currentTime + 1.2);
                noteIdx++;
            }, 600);
        } catch(e) {}
    }

    function stopMelodicSynth() {
        if (synthInterval) clearInterval(synthInterval);
        if (synthContext && synthContext.state === 'running') synthContext.suspend();
    }

    function toggleMusic(play) {
        if (play === undefined) play = !isMusicPlaying;
        isMusicPlaying = play;
        if (isMusicPlaying) {
            if (audioElement) {
                audioElement.play().catch(function() {
                    playMelodicSynth();
                });
            } else {
                playMelodicSynth();
            }
            if (musicDisc) musicDisc.classList.add('animate-spin-slow');
        } else {
            if (audioElement) audioElement.pause();
            stopMelodicSynth();
            if (musicDisc) musicDisc.classList.remove('animate-spin-slow');
        }
    }

    if (musicToggle) {
        musicToggle.addEventListener('click', function() {
            toggleMusic();
        });
    }

    // 3. Open Invitation Action
    const openBtn = document.getElementById('open-invitation');
    const openingCover = document.getElementById('opening-cover');
    const mainContent = document.getElementById('main-content');
    const bottomNav = document.getElementById('bottom-nav');

    if (openBtn) {
        openBtn.addEventListener('click', function() {
            toggleMusic(true);
            openingCover.classList.add('opacity-0', '-translate-y-8');
            setTimeout(function() {
                openingCover.style.display = 'none';
                mainContent.classList.remove('opacity-0', 'pointer-events-none');
                mainContent.classList.add('opacity-100');
                if (bottomNav) {
                    bottomNav.classList.remove('translate-y-24', 'opacity-0');
                    bottomNav.classList.add('translate-y-0', 'opacity-100');
                }
                if (musicToggle) {
                    musicToggle.classList.remove('opacity-0', 'pointer-events-none');
                    musicToggle.classList.add('opacity-100');
                }
            }, 800);
        });
    }

    // 4. Countdown Timer
    const eventTimeStr = "<%= event?.event_date || eventDate || '2025-12-31 19:00:00' %>";
    const targetDate = new Date(eventTimeStr).getTime();

    function refreshCountdown() {
        const now = new Date().getTime();
        const diff = targetDate - now;
        const dEl = document.getElementById('days');
        const hEl = document.getElementById('hours');
        const mEl = document.getElementById('minutes');
        const sEl = document.getElementById('seconds');

        if (diff <= 0) {
            if (dEl) dEl.textContent = '00';
            if (hEl) hEl.textContent = '00';
            if (mEl) mEl.textContent = '00';
            if (sEl) sEl.textContent = '00';
            return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        if (dEl) dEl.textContent = String(days).padStart(2, '0');
        if (hEl) hEl.textContent = String(hours).padStart(2, '0');
        if (mEl) mEl.textContent = String(minutes).padStart(2, '0');
        if (sEl) sEl.textContent = String(seconds).padStart(2, '0');
    }
    setInterval(refreshCountdown, 1000);
    refreshCountdown();

    // 5. Attendance Select toggle guests field
    const attSelect = document.getElementById('attendance');
    const gField = document.getElementById('guests-field');
    if (attSelect && gField) {
        attSelect.addEventListener('change', function() {
            if (this.value === 'hadir') {
                gField.classList.remove('hidden');
            } else {
                gField.classList.add('hidden');
            }
        });
    }

    // 6. RSVP AJAX submit & instant guestbook append
    const rsvpForm = document.getElementById('rsvp-form');
    const submitBtn = document.getElementById('submit-btn');
    const alertBox = document.getElementById('alert-container');
    const wishesList = document.getElementById('wishes-list-container');

    if (rsvpForm) {
        rsvpForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = 'Mengirimkan...';
            }

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            try {
                const res = await fetch('<%= rsvpPath %>', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || ''
                    },
                    body: JSON.stringify(data)
                });
                const result = await res.json();

                if (res.ok) {
                    if (alertBox) {
                        alertBox.innerHTML = '<div class="p-3.5 rounded-xl bg-emerald-900/60 border border-emerald-600 text-emerald-200 text-xs font-semibold mb-3">✓ ' + (result.message || 'Konfirmasi kehadiran berhasil terkirim.') + '</div>';
                    }

                    // Dynamically prepend to wishes list if message exists
                    if (data.message && wishesList) {
                        const emptyNotice = document.getElementById('empty-wishes');
                        if (emptyNotice) emptyNotice.remove();

                        const item = document.createElement('div');
                        item.className = 'bg-slate-850/90 rounded-2xl p-5 border border-slate-700/60 shadow-lg animate-fade-in-up';
                        item.innerHTML = `
                            <div class="flex items-start space-x-3.5">
                                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-gold-400 to-gold-600 text-slate-950 font-bold flex items-center justify-center text-sm shadow flex-shrink-0">
                                    ${(data.name || 'G').substring(0, 1).toUpperCase()}
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex flex-wrap items-center justify-between gap-1 mb-1.5">
                                        <h3 class="text-sm sm:text-base font-semibold text-white truncate">${data.name}</h3>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold ${data.attendance === 'hadir' ? 'bg-emerald-900/60 text-emerald-300 border border-emerald-700/50' : 'bg-slate-800 text-slate-400 border border-slate-700'}">
                                            ${data.attendance === 'hadir' ? '✓ Hadir' : 'Berhalangan'}
                                        </span>
                                    </div>
                                    <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mt-1">"${data.message}"</p>
                                    <div class="mt-2 text-[11px] text-slate-500 font-mono">Baru saja</div>
                                </div>
                            </div>
                        `;
                        wishesList.prepend(item);
                    }

                    rsvpForm.reset();
                    if (gField) gField.classList.add('hidden');
                } else {
                    const err = result.errors ? Object.values(result.errors).flat().join('<br>') : (result.message || 'Gagal mengirim.');
                    if (alertBox) {
                        alertBox.innerHTML = '<div class="p-3.5 rounded-xl bg-red-950/80 border border-red-700 text-red-200 text-xs font-semibold mb-3">✕ ' + err + '</div>';
                    }
                }
            } catch(err) {
                if (alertBox) {
                    alertBox.innerHTML = '<div class="p-3.5 rounded-xl bg-red-950/80 border border-red-700 text-red-200 text-xs font-semibold mb-3">✕ Terjadi kesalahan koneksi. Silakan coba lagi.</div>';
                }
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Kirim Konfirmasi & Doa';
                }
            }
        });
    }

    // 7. Active Nav indicator on scroll
    const sections = document.querySelectorAll('section');
    const navLinks = document.querySelectorAll('#bottom-nav a');

    window.addEventListener('scroll', function() {
        let currentId = '';
        sections.forEach(function(sec) {
            const top = sec.offsetTop - 120;
            if (window.pageYOffset >= top) {
                currentId = sec.getAttribute('id');
            }
        });

        navLinks.forEach(function(link) {
            link.classList.remove('text-gold-400');
            link.classList.add('text-slate-400');
            if (link.getAttribute('href') === '#' + currentId) {
                link.classList.add('text-gold-400');
                link.classList.remove('text-slate-400');
            }
        });
    });
});
</script>
