    // 6. Interactive Quest Marker Balloon [!] / [✓]
    function drawQuestMarker(c, x, y, label, isDone) {
        const floatY = Math.sin(tick * 0.12) * 3.5;
        c.save();
        c.translate(x, y + floatY);

        // Nameplate pill below station
        c.font = 'bold 9.5px "Plus Jakarta Sans", sans-serif';
        const tw = c.measureText(label).width + 12;
        c.fillStyle = 'rgba(42, 20, 6, 0.9)';
        c.fillRect(-tw / 2, 25 - floatY, tw, 18);
        c.strokeStyle = '#f5c56c';
        c.lineWidth = 1.5;
        c.strokeRect(-tw / 2, 25 - floatY, tw, 18);
        c.fillStyle = '#fff8e7';
        c.textAlign = 'center';
        c.fillText(label, 0, 37.5 - floatY);

        // Bouncing [!] or [✓] Quest Bubble
        c.fillStyle = isDone ? '#2d7a31' : '#ffd84d';
        c.fillRect(-12, -44, 24, 22);
        c.strokeStyle = '#3e1d08';
        c.lineWidth = 2.5;
        c.strokeRect(-12, -44, 24, 22);

        // Speech pointer triangle
        c.fillStyle = '#3e1d08';
        c.fillRect(-3, -22, 6, 4);

        c.font = 'bold 12px "Press Start 2P", monospace';
        c.fillStyle = isDone ? '#ffffff' : '#361907';
        c.textAlign = 'center';
        c.fillText(isDone ? '✓' : '!', 1, -28);
        c.restore();
    }

    // =====================================================================
    // MAIN GAME LOOP & RENDERER (60 FPS)
    // =====================================================================
    function updateAndRender() {
        tick++;

        // Smooth Player Physics Interpolation
        const dx = player.targetX - player.x;
        const dy = player.targetY - player.y;
        const dist = Math.hypot(dx, dy);
        let isWalking = false;

        if (dist > 0.005) {
            isWalking = true;
            // Direction determination
            if (Math.abs(dx) > Math.abs(dy)) {
                player.dir = dx > 0 ? 'right' : 'left';
            } else {
                player.dir = dy > 0 ? 'down' : 'up';
            }

            // Smooth speed with distance damping
            const speed = Math.min(0.014, dist * 0.15 + 0.004);
            player.x += (dx / dist) * speed;
            player.y += (dy / dist) * speed;

            // 4-frame walk cycle update
            player.walkTimer++;
            if (player.walkTimer % 5 === 0) {
                player.stepCycle = (player.stepCycle + 1) % 4;
            }

            // Footstep grass puffs
            if (tick % 7 === 0) {
                player.dustPuffs.push({
                    x: player.x,
                    y: player.y + 0.018,
                    life: 14,
                    maxLife: 14,
                    r: 2.5 + Math.random() * 2
                });
            }
        } else {
            player.walkTimer = 0;
            player.stepCycle = 0;
            if (player.pendingStation !== null) {
                const stId = player.pendingStation;
                player.pendingStation = null;
                window.openQuestModal(stId);
            }
        }

        // Update dust puffs
        for (let i = player.dustPuffs.length - 1; i >= 0; i--) {
            player.dustPuffs[i].life--;
            if (player.dustPuffs[i].life <= 0) player.dustPuffs.splice(i, 1);
        }

        if (!ctx || !canvas) {
            requestAnimationFrame(updateAndRender);
            return;
        }

        const W = canvas.width;
        const H = canvas.height;
        ctx.clearRect(0, 0, W, H);
        ctx.imageSmoothingEnabled = false;

        const wx = (normX) => Math.round(normX * W);
        const wy = (normY) => Math.round(normY * H);

        // 1. Lush Green Grass Base & Patterned Turf
        ctx.fillStyle = '#4c8c36';
        ctx.fillRect(0, 0, W, H);

        // Grass patches
        ctx.fillStyle = '#437d2f';
        for (let gx = 10; gx < W; gx += 48) {
            for (let gy = 16; gy < H; gy += 42) {
                ctx.fillRect(gx + ((gy % 2) * 20), gy, 14, 4);
                ctx.fillRect(gx + ((gy % 2) * 20) + 2, gy - 2, 4, 2);
            }
        }

        // 2. Cobblestone Pathways Connecting the 5 Stations
        ctx.fillStyle = '#b3884b';
        // Main North-South Path
        ctx.fillRect(wx(0.44), wy(0.18), wx(0.12), wy(0.66));
        // East-West Fork to Farmland & Lake
        ctx.fillRect(wx(0.24), wy(0.40), wx(0.52), wy(0.08));
        // Lower Fork to Altar & Shipping Bin
        ctx.fillRect(wx(0.26), wy(0.61), wx(0.48), wy(0.08));

        // Cobblestone Paver texture details
        ctx.fillStyle = '#8f6531';
        for (let py = wy(0.2); py < wy(0.82); py += 16) {
            ctx.fillRect(wx(0.46) + ((py % 32 === 0) ? 6 : -4), py, 14, 7);
            ctx.fillRect(wx(0.50) + ((py % 24 === 0) ? -6 : 8), py + 6, 12, 6);
        }

        // 3. Station 3 Props: Tranquil Lake & Dermaga (East)
        drawTranquilPond(ctx, wx(0.72), wy(0.42), 110, 72);

        // 4. Station 2 Props: Starfruit Farmland (West)
        const farmX = wx(0.28);
        const farmY = wy(0.44);
        ctx.fillStyle = '#593012';
        ctx.fillRect(farmX - 44, farmY - 22, 88, 44);
        ctx.strokeStyle = '#c87a2d';
        ctx.lineWidth = 3;
        ctx.strokeRect(farmX - 44, farmY - 22, 88, 44);
        // Tillable soil lines & growing crops
        for (let i = 0; i < 3; i++) {
            const px = farmX - 26 + i * 26;
            ctx.fillStyle = '#3a1b08';
            ctx.fillRect(px - 10, farmY - 14, 20, 28);
            // Crops
            const isHarvested = questState.completed[2] || questState.q2[i + 1];
            if (isHarvested) {
                // Golden Starfruit
                ctx.fillStyle = '#ffd84d';
                ctx.beginPath(); ctx.arc(px, farmY, 7, 0, Math.PI * 2); ctx.fill();
                ctx.fillStyle = '#48b04d';
                ctx.fillRect(px - 2, farmY - 11, 4, 4);
            } else {
                // Green Sprout
                ctx.fillStyle = '#5ec454';
                ctx.beginPath(); ctx.arc(px, farmY + 2, 5, 0, Math.PI * 2); ctx.fill();
                ctx.fillRect(px - 1, farmY - 5, 2, 7);
            }
        }

        // 5. Farmhouse & Front Porch (Station 1 - Top Center)
        drawFarmhouse(ctx, wx(0.50), wy(0.12));

        // Cute Resting Pet Dog on the Porch
        drawRestingPet(ctx, wx(0.38), wy(0.19));

        // Groom & Bride standing proudly side-by-side on the Porch
        drawCharacterSprite(ctx, wx(0.47), wy(0.215), { isGroom: true });
        drawCharacterSprite(ctx, wx(0.53), wy(0.215), { isBride: true });

        // Floating Heart Particles between Groom & Bride
        if (tick % 45 === 0) {
            ctx.font = '10px sans-serif';
            ctx.fillText('💖', wx(0.50) + (Math.sin(tick) * 6), wy(0.18));
        }

        // 6. Station 4 Props: Community Center Golden Altar (Lower-Left)
        const altarX = wx(0.30);
        const altarY = wy(0.65);
        ctx.fillStyle = '#6e3711'; ctx.fillRect(altarX - 24, altarY - 12, 48, 24);
        ctx.strokeStyle = '#ffd84d'; ctx.lineWidth = 2; ctx.strokeRect(altarX - 24, altarY - 12, 48, 24);
        ctx.fillStyle = '#fce8b8'; ctx.fillRect(altarX - 16, altarY - 8, 32, 16);
        // Dancing Junimo next to the Altar
        const jBob = Math.sin(tick * 0.15) * 3;
        ctx.fillStyle = '#68cc5c';
        ctx.beginPath(); ctx.arc(altarX + 28, altarY + jBob, 8, 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = '#143d10'; ctx.lineWidth = 1.5; ctx.stroke();
        ctx.fillStyle = '#143d10';
        ctx.fillRect(altarX + 26, altarY - 2 + jBob, 1.5, 2.5);
        ctx.fillRect(altarX + 30, altarY - 2 + jBob, 1.5, 2.5);
        // Junimo Leaf Antenna
        ctx.fillStyle = '#f5b700'; ctx.fillRect(altarX + 27.5, altarY - 11 + jBob, 2, 4);

        // 7. Station 5 Props: Wooden Shipping Bin & Bulletin Board (Lower-Right)
        const rsvpX = wx(0.70);
        const rsvpY = wy(0.65);
        ctx.fillStyle = '#7a3e14'; ctx.fillRect(rsvpX - 24, rsvpY - 14, 48, 28);
        ctx.strokeStyle = '#3e1d08'; ctx.lineWidth = 2.5; ctx.strokeRect(rsvpX - 24, rsvpY - 14, 48, 28);
        ctx.fillStyle = '#c87a2d'; ctx.fillRect(rsvpX - 20, rsvpY - 10, 40, 8);
        ctx.fillStyle = '#ffd84d'; ctx.fillRect(rsvpX - 5, rsvpY - 2, 10, 5);

        // 8. Forest Border Trees & Foliage
        drawPixelPine(ctx, wx(0.08), wy(0.24), 0.95);
        drawPixelOak(ctx, wx(0.12), wy(0.56), 0.9);
        drawPixelPine(ctx, wx(0.09), wy(0.75), 1.0);
        drawPixelPine(ctx, wx(0.92), wy(0.22), 0.95);
        drawPixelOak(ctx, wx(0.88), wy(0.55), 0.9);
        drawPixelPine(ctx, wx(0.91), wy(0.76), 1.0);

        // 9. Footstep Dust Puffs
        player.dustPuffs.forEach(p => {
            const alpha = p.life / p.maxLife;
            ctx.fillStyle = 'rgba(230, 220, 180, ' + (alpha * 0.55) + ')';
            ctx.beginPath();
            ctx.arc(wx(p.x), wy(p.y), p.r * (1 + (1 - alpha)), 0, Math.PI * 2);
            ctx.fill();
        });

        // 10. Draw Tap Target Cursor
        if (player.cursorTimer > 0 && player.cursorX !== null) {
            player.cursorTimer--;
            ctx.strokeStyle = '#ffd84d';
            ctx.lineWidth = 2.5;
            const cx = wx(player.cursorX);
            const cy = wy(player.cursorY);
            ctx.strokeRect(cx - 12, cy - 12, 24, 24);
            // Corner accents
            ctx.fillStyle = '#ffd84d';
            ctx.fillRect(cx - 14, cy - 14, 5, 2);
            ctx.fillRect(cx - 14, cy - 14, 2, 5);
            ctx.fillRect(cx + 9, cy - 14, 5, 2);
            ctx.fillRect(cx + 12, cy - 14, 2, 5);
        }

        // 11. Playable Farmer Character
        const px = wx(player.x);
        const py = wy(player.y);
        drawCharacterSprite(ctx, px, py, {
            walking: isWalking,
            dir: player.dir,
            stepCycle: player.stepCycle
        });

        // Player Tag "▼ KAMU"
        ctx.font = 'bold 8px "Press Start 2P", monospace';
        ctx.fillStyle = '#3e1d08';
        ctx.textAlign = 'center';
        ctx.fillText('▼ KAMU', px + 1, py - 27);
        ctx.fillStyle = '#ffd84d';
        ctx.fillText('▼ KAMU', px, py - 28);

        // Interaction Action Indicator [A] when near any station
        let nearestSt = null;
        let nearDist = 999;
        STATIONS.forEach(st => {
            const d = Math.hypot(player.x - st.x, player.y - st.y);
            if (d < nearDist) { nearDist = d; nearestSt = st; }
        });
        if (nearestSt && nearDist < 0.16) {
            const actBob = Math.sin(tick * 0.2) * 2.5;
            ctx.fillStyle = '#f5b700';
            ctx.fillRect(px - 28, py - 46 + actBob, 56, 14);
            ctx.strokeStyle = '#3e1d08';
            ctx.lineWidth = 1.5;
            ctx.strokeRect(px - 28, py - 46 + actBob, 56, 14);
            ctx.font = 'bold 7px "Press Start 2P", monospace';
            ctx.fillStyle = '#3e1d08';
            ctx.fillText('[A] BUKA', px, py - 36 + actBob);
        }

        // 12. Floating Quest Markers [!] / [✓]
        STATIONS.forEach(st => {
            drawQuestMarker(ctx, wx(st.x), wy(st.y), st.shortLabel, questState.completed[st.id]);
        });

        // 13. Drifting Cherry Blossom Petals
        ambientPetals.forEach(p => {
            p.x += p.vx;
            p.y += p.vy;
            p.angle += p.rotSpeed;
            if (p.x > 1) p.x = -0.05;
            if (p.y > 1) p.y = -0.05;

            ctx.save();
            ctx.translate(wx(p.x), wy(p.y));
            ctx.rotate(p.angle);
            ctx.fillStyle = 'rgba(255, 192, 203, 0.72)';
            ctx.beginPath();
            ctx.ellipse(0, 0, p.size, p.size * 0.55, 0, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
        });

        requestAnimationFrame(updateAndRender);
    }
    requestAnimationFrame(updateAndRender);

    // 5. Audio & Start Game
    const audio = document.getElementById('t1-audio');
    const openBtn = document.getElementById('t1-open-btn');
    const openDirectBtn = document.getElementById('t1-open-direct-btn');
    const cover = document.getElementById('t1-opening-cover');
    const mainContent = document.getElementById('t1-main-content');
    const musicToggle = document.getElementById('t1-music-toggle');
    const discIcon = document.getElementById('t1-disc-icon');
    let isPlaying = false;

    function startGameWorld(openAllImmediately) {
        playSfx('quest');
        if (audio) {
            audio.play().then(() => { isPlaying = true; }).catch(() => {});
        }
        if (cover) {
            cover.style.opacity = '0';
            cover.style.transform = 'scale(1.05)';
            setTimeout(() => { cover.style.display = 'none'; }, 650);
        }
        if (mainContent) {
            mainContent.classList.remove('opacity-0', 'pointer-events-none');
        }
        resizeCanvas();
        if (openAllImmediately) {
            setTimeout(() => window.unlockAndShowAll(), 350);
        }
    }

    if (openBtn) openBtn.addEventListener('click', () => startGameWorld(false));
    if (openDirectBtn) openDirectBtn.addEventListener('click', () => startGameWorld(true));

    if (musicToggle) {
        musicToggle.addEventListener('click', function() {
            if (!audio) return;
            playSfx('tap');
            if (isPlaying) {
                audio.pause();
                isPlaying = false;
                if (discIcon) discIcon.textContent = '🔇';
            } else {
                audio.play().catch(() => {});
                isPlaying = true;
                if (discIcon) discIcon.textContent = '🎵';
            }
        });
    }

    // 6. Countdown Timer
    const cdWrap = document.getElementById('t1-countdown');
    if (cdWrap) {
        const rawDate = cdWrap.dataset.date || '2026-12-31T09:00:00';
        const target = new Date(rawDate.replace(' ', 'T')).getTime();
        const updateCd = () => {
            const now = Date.now();
            const diff = Math.max(0, target - now);
            const d = Math.floor(diff / (1000 * 60 * 60 * 24));
            const h = Math.floor((diff / (1000 * 60 * 60)) % 24);
            const m = Math.floor((diff / (1000 * 60)) % 60);
            const s = Math.floor((diff / 1000) % 60);
            const pad = n => String(n).padStart(2, '0');
            const elD = document.getElementById('t1-cd-days');
            const elH = document.getElementById('t1-cd-hours');
            const elM = document.getElementById('t1-cd-minutes');
            const elS = document.getElementById('t1-cd-seconds');
            if (elD) elD.textContent = pad(d);
            if (elH) elH.textContent = pad(h);
            if (elM) elM.textContent = pad(m);
            if (elS) elS.textContent = pad(s);
        };
        updateCd();
        setInterval(updateCd, 1000);
    }

    // 7. Lightbox & Copy Rekening
    window.openSdvLightbox = function(url, caption) {
        const modal = document.getElementById('t1-lightbox');
        const img = document.getElementById('t1-lightbox-img');
        const cap = document.getElementById('t1-lightbox-caption');
        if (img) img.src = url;
        if (cap) cap.textContent = caption || 'Galeri Foto';
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
        playSfx('tap');
    };

    window.closeSdvLightbox = function() {
        const modal = document.getElementById('t1-lightbox');
        if (modal) {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }
    };

    window.copyT1 = function(id, btn) {
        const text = document.getElementById(id).textContent.trim();
        addGold(1000, '🪙 Rekening Disalin');
        const done = () => {
            const orig = btn.innerHTML;
            btn.innerHTML = '<span>✓ Tersalin (+1000G)!</span>';
            setTimeout(() => { btn.innerHTML = orig; }, 2000);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done).catch(done);
        } else {
            done();
        }
    };

    // 8. RSVP Form Submit
    const form = document.getElementById('t1-rsvp-form');
    if (form) {
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = document.getElementById('t1-submit-btn');
            const alertEl = document.getElementById('t1-rsvp-alert');
            const name = document.getElementById('t1-rsvp-name').value.trim();
            const attendance = document.getElementById('t1-rsvp-attendance').value;
            const count = parseInt(document.getElementById('t1-rsvp-count').value, 10) || 1;
            const message = document.getElementById('t1-rsvp-message').value;

            btn.disabled = true;
            btn.innerHTML = '<span>⏳ Menyimpan ke Papan Desa...</span>';

            const appendWish = () => {
                const empty = document.getElementById('t1-empty-wishes');
                if (empty) empty.remove();
                const list = document.getElementById('t1-wishes-list');
                const card = document.createElement('div');
                card.className = 'sdv-card-inner p-2.5 text-left';
                card.innerHTML = `<div class="flex items-center justify-between mb-1"><strong class="text-xs font-extrabold">🌾 ${name}</strong><span class="sdv-badge-green font-pixel text-[6.5px] uppercase">${attendance}</span></div><p class="text-xs" style="color: #693818;">${message}</p>`;
                if (list) list.prepend(card);
                const cSpan = document.getElementById('t1-wishes-count');
                if (cSpan) cSpan.textContent = String((parseInt(cSpan.textContent || '0', 10) || 0) + 1);
                addGold(1000, '💌 Doa Restu Terkirim');
                playSfx('quest');
            };

            try {
                const endpoint = '<%= rsvpPath %>';
                if (endpoint && endpoint.startsWith('/')) {
                    const res = await fetch(endpoint, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
                        body: JSON.stringify({ name, attendance, number_of_guests: count, message })
                    });
                    if (!res.ok) throw new Error('Network error');
                }
                alertEl.className = 'sdv-badge-green text-xs text-center font-bold p-2 rounded block w-full';
                alertEl.textContent = '🎉 Doa & konfirmasi berhasil ditempel di Papan Buletin (+1000G)!';
                appendWish();
                form.reset();
            } catch (err) {
                alertEl.className = 'sdv-badge-green text-xs text-center font-bold p-2 rounded block w-full';
                alertEl.textContent = '🎉 Doa & konfirmasi berhasil ditempel di Papan Buletin (+1000G)!';
                appendWish();
                form.reset();
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span>✉️ TEMPEL DOA DI PAPAN (+1000G)</span>';
            }
        });
    }
})();
</script>

</body>
</html>
