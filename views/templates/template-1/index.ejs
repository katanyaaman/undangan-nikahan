<!-- 2D TOP-DOWN STARDEW VALLEY RPG ENGINE & QUEST LOGIC                       -->
<!-- ========================================================================= -->
<script>
(function() {
    // 1. Recipient Name from URL
    const params = new URLSearchParams(window.location.search);
    const guestParam = params.get('to') || params.get('tamu') || params.get('u');
    if (guestParam) {
        const el = document.getElementById('t1-recipient-name');
        if (el) el.textContent = guestParam;
        const nameInput = document.getElementById('t1-rsvp-name');
        if (nameInput) nameInput.value = guestParam;
    }

    // 2. High-Fidelity Retro Web Audio API Chiptune Synthesizer
    let audioCtx = null;
    function getAudioCtx() {
        if (!audioCtx && (window.AudioContext || window.webkitAudioContext)) {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        if (audioCtx && audioCtx.state === 'suspended') {
            audioCtx.resume().catch(() => {});
        }
        return audioCtx;
    }

    function playSfx(type) {
        try {
            const ctx = getAudioCtx();
            if (!ctx) return;
            const now = ctx.currentTime;

            if (type === 'step') {
                // Soft leafy grass rustle
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(120 + Math.random() * 40, now);
                osc.frequency.exponentialRampToValueAtTime(60, now + 0.05);
                gain.gain.setValueAtTime(0.04, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start(now);
                osc.stop(now + 0.06);
            } else if (type === 'typewriter') {
                // Melodic text blip like Animal Crossing / Stardew
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'square';
                osc.frequency.setValueAtTime(440 + Math.random() * 60, now);
                gain.gain.setValueAtTime(0.025, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.04);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start(now);
                osc.stop(now + 0.045);
            } else if (type === 'coin') {
                // Dual-tone high crystal chime
                [987.77, 1318.51].forEach((freq, idx) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq, now + idx * 0.06);
                    gain.gain.setValueAtTime(0.09, now + idx * 0.06);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.06 + 0.28);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start(now + idx * 0.06);
                    osc.stop(now + idx * 0.06 + 0.3);
                });
            } else if (type === 'heart') {
                // Romantic chime
                [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, now + idx * 0.05);
                    gain.gain.setValueAtTime(0.08, now + idx * 0.05);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.05 + 0.25);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start(now + idx * 0.05);
                    osc.stop(now + idx * 0.05 + 0.26);
                });
            } else if (type === 'quest') {
                // Stardew Quest Fanfare
                const notes = [392.00, 523.25, 659.25, 783.99, 1046.50];
                notes.forEach((freq, i) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, now + i * 0.07);
                    gain.gain.setValueAtTime(0.12, now + i * 0.07);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.07 + 0.28);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start(now + i * 0.07);
                    osc.stop(now + i * 0.07 + 0.3);
                });
            } else {
                // Default tap
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(587.33, now);
                gain.gain.setValueAtTime(0.08, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start(now);
                osc.stop(now + 0.14);
            }
        } catch (e) {}
    }

    function spawnFloatingText(text) {
        const div = document.createElement('div');
        div.className = 'floating-reward font-pixel text-[9px]';
        div.textContent = text;
        document.body.appendChild(div);
        setTimeout(() => div.remove(), 1300);
    }

    // 3. Game & Quest State
    const questState = {
        gold: 100,
        completed: { 1: false, 2: false, 3: false, 4: false, 5: false },
        q1: { groom: false, bride: false },
        q2: { 1: false, 2: false, 3: false },
        q3: { 1: false, 2: false, 3: false },
        q4: { 1: false, 2: false, 3: false },
        q5: false
    };

    // 5 Interactive Quest Stations on the Map (Normalized coordinates 0..1)
    const STATIONS = [
        { id: 1, key: 'pasangan', x: 0.50, y: 0.21, title: 'Quest #1: Mempelai & 10 Hati', shortLabel: '1. Mempelai', icon: '💐' },
        { id: 2, key: 'acara',    x: 0.28, y: 0.44, title: 'Quest #2: Jadwal & Lokasi Acara', shortLabel: '2. Acara', icon: '⭐' },
        { id: 3, key: 'cerita',   x: 0.72, y: 0.42, title: 'Quest #3: Legenda Mermaid\'s Pendant', shortLabel: '3. Cerita', icon: '📜' },
        { id: 4, key: 'galeri',   x: 0.30, y: 0.65, title: 'Quest #4: Bundel Balai Warga', shortLabel: '4. Galeri', icon: '💎' },
        { id: 5, key: 'hadiah',   x: 0.70, y: 0.65, title: 'Quest #5: Shipping Bin & RSVP', shortLabel: '5. Peti & RSVP', icon: '📦' }
    ];

    // Ultra-Smooth Player Character
    const player = {
        x: 0.50,
        y: 0.50,
        vx: 0,
        vy: 0,
        targetX: 0.50,
        targetY: 0.50,
        dir: 'down', // 'down' | 'up' | 'left' | 'right'
        walkTimer: 0,
        stepCycle: 0,
        pendingStation: null,
        cursorX: null,
        cursorY: null,
        cursorTimer: 0,
        isDragging: false,
        dustPuffs: []
    };

    // Ambient Floating Cherry Blossom Petals
    const ambientPetals = [];
    for (let i = 0; i < 22; i++) {
        ambientPetals.push({
            x: Math.random(),
            y: Math.random(),
            vx: 0.0003 + Math.random() * 0.0006,
            vy: 0.0006 + Math.random() * 0.0008,
            size: 2.5 + Math.random() * 2.5,
            angle: Math.random() * Math.PI * 2,
            rotSpeed: 0.02 + Math.random() * 0.04
        });
    }

    function formatGold7(n) {
        return String(Math.min(9999999, Math.max(0, n))).padStart(7, '0');
    }

    function addGold(amount, label) {
        questState.gold += amount;
        const goldEl = document.getElementById('sdv-gold-display');
        if (goldEl) goldEl.textContent = formatGold7(questState.gold);
        playSfx('coin');
        if (label) spawnFloatingText(label + ' (+' + amount + 'G)');
    }

    function updateHudProgress() {
        const doneCount = Object.values(questState.completed).filter(Boolean).length;
        const counterEl = document.getElementById('sdv-quest-counter');
        if (counterEl) counterEl.textContent = doneCount + '/5';
        const hintEl = document.getElementById('sdv-active-quest-hint');
        const bangEl = document.getElementById('sdv-journal-bang');
        if (doneCount === 5) {
            if (hintEl) hintEl.textContent = '🏆 Semua 5 Misi Selesai! Ketuk untuk baca.';
            if (bangEl) { bangEl.textContent = '✓'; bangEl.style.background = '#48b04d'; bangEl.style.color = '#fff'; }
        } else {
            const nextId = [1,2,3,4,5].find(i => !questState.completed[i]);
            const st = STATIONS.find(s => s.id === nextId);
            if (hintEl && st) hintEl.textContent = 'Misi: Pergi ke ' + st.shortLabel + ' [!]';
        }
    }

    function completeQuest(qNum) {
        if (questState.completed[qNum]) return;
        questState.completed[qNum] = true;

        const content = document.getElementById('quest-content-' + qNum);
        if (content) {
            content.classList.remove('quest-locked-blur');
            content.classList.add('quest-unlocked');
        }
        const st = document.getElementById('qstatus-' + qNum);
        if (st) {
            st.textContent = '✓ SELESAI';
            st.className = 'sdv-badge-green font-pixel text-[7px]';
        }
        const hb = document.getElementById('qbadge-' + qNum);
        if (hb) {
            hb.textContent = 'SELESAI ✓';
            hb.className = 'sdv-badge-green font-pixel text-[7px]';
        }
        const hqty = document.getElementById('hqty-' + qNum);
        if (hqty) {
            hqty.textContent = '✓';
            hqty.classList.add('done');
        }

        addGold(600, '🎉 Quest #' + qNum + ' Terbuka!');
        playSfx('quest');
        updateHudProgress();
    }

    // Mini-game Handlers
    window.giveCoupleGift = function(who) {
        if (questState.q1[who]) return;
        questState.q1[who] = true;
        playSfx('heart');
        if (who === 'groom') {
            document.getElementById('groom-hearts').textContent = '❤️❤️❤️❤️❤️';
            document.getElementById('btn-gift-groom').innerHTML = '<span>✓ Diterima!</span>';
        } else {
            document.getElementById('bride-hearts').textContent = '❤️❤️❤️❤️❤️';
            document.getElementById('btn-gift-bride').innerHTML = '<span>✓ Diterima!</span>';
        }
        const count = (questState.q1.groom ? 1 : 0) + (questState.q1.bride ? 1 : 0);
        if (count === 2) completeQuest(1);
        else addGold(150, '❤️ 10 Hati Terisi');
    };

    window.harvestCrop = function(plotId) {
        if (questState.q2[plotId]) return;
        questState.q2[plotId] = true;
        playSfx('coin');
        const plot = document.getElementById('crop-plot-' + plotId);
        const icon = document.getElementById('crop-icon-' + plotId);
        const label = document.getElementById('crop-label-' + plotId);
        if (plot) plot.classList.add('harvested');
        if (icon) icon.textContent = '⭐';
        if (label) label.textContent = 'Panen!';
        const count = Object.values(questState.q2).filter(Boolean).length;
        if (count === 3) completeQuest(2);
        else addGold(150, '⭐ Starfruit Emas');
    };

    window.findScroll = function(bushId) {
        if (questState.q3[bushId]) return;
        questState.q3[bushId] = true;
        playSfx('heart');
        document.getElementById('bush-icon-' + bushId).textContent = '💎';
        document.getElementById('bush-label-' + bushId).textContent = 'Terbuka!';
        const count = Object.values(questState.q3).filter(Boolean).length;
        if (count === 3) completeQuest(3);
        else addGold(150, '🐚 Kerang Mutiara');
    };

    window.slotBundleItem = function(itemId) {
        if (questState.q4[itemId]) return;
        questState.q4[itemId] = true;
        playSfx('coin');
        document.getElementById('bundle-label-' + itemId).textContent = '✓ Aktif';
        const count = Object.values(questState.q4).filter(Boolean).length;
        if (count === 3) completeQuest(4);
        else addGold(150, '🌈 Bundel Terisi');
    };

    window.openTreasureChest = function() {
        if (questState.q5) return;
        questState.q5 = true;
        document.getElementById('chest-icon').textContent = '🎁';
        document.getElementById('chest-label').textContent = '✓ PETI TERBUKA!';
        completeQuest(5);
    };

    window.unlockAllQuests = function() {
        ['groom', 'bride'].forEach(w => { if (!questState.q1[w]) window.giveCoupleGift(w); });
        [1, 2, 3].forEach(i => { if (!questState.q2[i]) window.harvestCrop(i); });
        [1, 2, 3].forEach(i => { if (!questState.q3[i]) window.findScroll(i); });
        [1, 2, 3].forEach(i => { if (!questState.q4[i]) window.slotBundleItem(i); });
        if (!questState.q5) window.openTreasureChest();
    };

    // Modal & Hotbar Navigation
    function setActiveHotbar(slotId) {
        document.querySelectorAll('.sdv-hotbar-slot').forEach(el => el.classList.remove('active-slot'));
        const target = document.getElementById('hotbar-' + slotId);
        if (target) target.classList.add('active-slot');
    }

    window.openQuestModal = function(target) {
        const backdrop = document.getElementById('sdv-modal-backdrop');
        const titleEl = document.getElementById('sdv-modal-title');
        const iconEl = document.getElementById('sdv-modal-icon');
        const panels = document.querySelectorAll('.panel-section');

        if (target === 'all') {
            window.unlockAllQuests();
            panels.forEach(p => p.classList.add('active-panel'));
            if (titleEl) titleEl.textContent = 'Semua Informasi Undangan';
            if (iconEl) iconEl.textContent = '📖';
            setActiveHotbar('all');
        } else if (target === 'overview') {
            panels.forEach(p => p.classList.remove('active-panel'));
            document.getElementById('hero').classList.add('active-panel');
            if (titleEl) titleEl.textContent = 'Jurnal Misi Pelican Town';
            if (iconEl) iconEl.textContent = '📜';
            setActiveHotbar(0);
        } else {
            const st = STATIONS.find(s => s.id === Number(target));
            if (!st) return;
            panels.forEach(p => p.classList.remove('active-panel'));
            const sec = document.getElementById(st.key);
            if (sec) sec.classList.add('active-panel');
            if (titleEl) titleEl.textContent = st.title;
            if (iconEl) iconEl.textContent = st.icon;
            setActiveHotbar(st.id);
        }

        if (backdrop) backdrop.classList.add('modal-open');
        const scrollBody = document.getElementById('sdv-modal-scroll');
        if (scrollBody) scrollBody.scrollTop = 0;
        playSfx('tap');
    };

    window.closeQuestModal = function() {
        const backdrop = document.getElementById('sdv-modal-backdrop');
        if (backdrop) backdrop.classList.remove('modal-open');
        setActiveHotbar(0);
    };

    window.unlockAndShowAll = function() {
        window.openQuestModal('all');
    };

    window.walkToStation = function(stationId) {
        if (stationId === 'overview') {
            window.openQuestModal('overview');
            return;
        }
        window.closeQuestModal();
        const st = STATIONS.find(s => s.id === Number(stationId));
        if (!st) return;
        setActiveHotbar(st.id);
        player.targetX = st.x;
        player.targetY = Math.min(0.78, st.y + 0.06);
        player.pendingStation = st.id;
        player.cursorX = st.x;
        player.cursorY = st.y;
        player.cursorTimer = 35;
        playSfx('step');
    };

    window.movePlayer = function(dx, dy) {
        window.closeQuestModal();
        const step = 0.08;
        player.targetX = Math.min(0.84, Math.max(0.16, player.x + dx * step));
        player.targetY = Math.min(0.78, Math.max(0.20, player.y + dy * step));
        player.pendingStation = null;
        if (Math.abs(dx) > Math.abs(dy)) player.dir = dx > 0 ? 'right' : 'left';
        else player.dir = dy > 0 ? 'down' : 'up';
        playSfx('step');
    };

    window.interactNearestStation = function() {
        let best = null;
        let bestDist = 999;
        STATIONS.forEach(st => {
            const d = Math.hypot(player.x - st.x, player.y - st.y);
            if (d < bestDist) { bestDist = d; best = st; }
        });
        if (best && bestDist < 0.20) {
            window.openQuestModal(best.id);
        } else if (best) {
            window.walkToStation(best.id);
        }
    };

    // Keyboard navigation
    window.addEventListener('keydown', function(e) {
        const backdrop = document.getElementById('sdv-modal-backdrop');
        if (backdrop && backdrop.classList.contains('modal-open')) {
            if (e.key === 'Escape') window.closeQuestModal();
            return;
        }
        if (e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') { e.preventDefault(); window.movePlayer(0, -1); }
        else if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') { e.preventDefault(); window.movePlayer(0, 1); }
        else if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') { e.preventDefault(); window.movePlayer(-1, 0); }
        else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') { e.preventDefault(); window.movePlayer(1, 0); }
        else if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); window.interactNearestStation(); }
    });

    // =====================================================================
    // 4. HIGH-PERFORMANCE PROCEDURAL CANVAS 2D PIXEL-ART ENGINE
    // =====================================================================
    const canvas = document.getElementById('sdv-game-canvas');
    const ctx = canvas ? canvas.getContext('2d') : null;
    let tick = 0;

    function resizeCanvas() {
        if (!canvas) return;
        const rect = canvas.parentElement.getBoundingClientRect();
        canvas.width = Math.round(rect.width || 440);
        canvas.height = Math.round(rect.height || 820);
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // Touch & Pointer Drag Steering
    if (canvas) {
        function handlePointerMoveTarget(e) {
            const rect = canvas.getBoundingClientRect();
            const sx = (e.clientX - rect.left) * (canvas.width / rect.width);
            const sy = (e.clientY - rect.top) * (canvas.height / rect.height);
            const wx = sx / canvas.width;
            const wy = sy / canvas.height;

            // Check if tapped near any station
            for (const st of STATIONS) {
                if (Math.hypot(wx - st.x, wy - st.y) < 0.08) {
                    window.walkToStation(st.id);
                    return;
                }
            }

            player.targetX = Math.min(0.84, Math.max(0.16, wx));
            player.targetY = Math.min(0.78, Math.max(0.20, wy));
            player.pendingStation = null;
            player.cursorX = player.targetX;
            player.cursorY = player.targetY;
            player.cursorTimer = 28;
            playSfx('step');
        }

        canvas.addEventListener('pointerdown', function(e) {
            player.isDragging = true;
            handlePointerMoveTarget(e);
        });
        window.addEventListener('pointermove', function(e) {
            if (player.isDragging) handlePointerMoveTarget(e);
        });
        window.addEventListener('pointerup', function() {
            player.isDragging = false;
        });
    }

    // --- PROCEDURAL PIXEL-ART ASSETS RENDERERS ---

    // 1. Oak & Pine Trees with layered depth
    function drawPixelPine(c, x, y, scale) {
        c.save();
        c.translate(x, y);
        c.scale(scale, scale);
        // Ground shadow
        c.fillStyle = 'rgba(20, 40, 15, 0.38)';
        c.beginPath(); c.ellipse(0, 24, 20, 7, 0, 0, Math.PI * 2); c.fill();
        // Trunk
        c.fillStyle = '#613916'; c.fillRect(-5, 4, 10, 20);
        c.fillStyle = '#40240d'; c.fillRect(0, 4, 5, 20);
        // Needles layers
        const layers = [
            { y: -6,  w: 42, h: 18, c1: '#235928', c2: '#3b853f' },
            { y: -20, w: 34, h: 18, c1: '#2a6a30', c2: '#489c4a' },
            { y: -34, w: 24, h: 16, c1: '#36803b', c2: '#5cb85c' },
            { y: -46, w: 14, h: 14, c1: '#4a9c4d', c2: '#7de07b' }
        ];
        layers.forEach(l => {
            c.fillStyle = l.c1; c.fillRect(-l.w / 2, l.y, l.w, l.h);
            c.fillStyle = l.c2; c.fillRect(-l.w / 2 + 3, l.y + 2, l.w - 6, l.h - 5);
        });
        c.restore();
    }

    function drawPixelOak(c, x, y, scale) {
        c.save();
        c.translate(x, y);
        c.scale(scale, scale);
        // Ground shadow
        c.fillStyle = 'rgba(20, 40, 15, 0.38)';
        c.beginPath(); c.ellipse(0, 22, 22, 8, 0, 0, Math.PI * 2); c.fill();
        // Trunk
        c.fillStyle = '#6d421d'; c.fillRect(-6, 2, 12, 20);
        c.fillStyle = '#4f2d12'; c.fillRect(0, 2, 6, 20);
        // Rounded lush foliage
        c.fillStyle = '#2d6928';
        c.beginPath(); c.arc(0, -16, 26, 0, Math.PI * 2); c.fill();
        c.fillStyle = '#42943b';
        c.beginPath(); c.arc(-6, -20, 18, 0, Math.PI * 2); c.fill();
        c.fillStyle = '#5fb557';
        c.beginPath(); c.arc(4, -14, 18, 0, Math.PI * 2); c.fill();
        c.fillStyle = '#83d97b';
        c.beginPath(); c.arc(-2, -24, 11, 0, Math.PI * 2); c.fill();
        c.restore();
    }

    // 2. Farmhouse (Rustic Timber Roof, Brick Chimney, Porch, Lantern)
    function drawFarmhouse(c, x, y) {
        c.save();
        c.translate(x, y);

        // Ground shadow
        c.fillStyle = 'rgba(20, 35, 15, 0.45)';
        c.fillRect(-90, 32, 180, 18);

        // Brick Chimney with animated smoke
        c.fillStyle = '#823725'; c.fillRect(45, -58, 16, 32);
        c.fillStyle = '#592215'; c.fillRect(53, -58, 8, 32);
        c.fillStyle = '#3e150d'; c.fillRect(43, -62, 20, 4);
        for (let s = 0; s < 3; s++) {
            const sProg = ((tick * 0.04) + s * 0.33) % 1;
            const sx = 53 + Math.sin(tick * 0.08 + s) * 8 * sProg;
            const sy = -66 - sProg * 26;
            const sR = 3 + sProg * 6;
            c.fillStyle = 'rgba(240, 245, 255, ' + (0.6 * (1 - sProg)) + ')';
            c.beginPath(); c.arc(sx, sy, sR, 0, Math.PI * 2); c.fill();
        }

        // Main Wall (Cedar Timber)
        c.fillStyle = '#8f5223'; c.fillRect(-78, -12, 156, 44);
        c.fillStyle = '#6b3c16';
        for (let p = -78; p < 78; p += 14) {
            c.fillRect(p, -12, 1, 44);
        }

        // Front Porch & Posts
        c.fillStyle = '#522b0e'; c.fillRect(-82, 28, 164, 8);
        c.fillStyle = '#a66835'; c.fillRect(-80, 29, 160, 5);
        c.fillStyle = '#4a250b';
        [-74, -30, 30, 74].forEach(px => c.fillRect(px, 4, 6, 24));

        // Front Door (Warm Timber with Brass knob)
        c.fillStyle = '#3a1a06'; c.fillRect(-15, 2, 30, 28);
        c.fillStyle = '#a65e26'; c.fillRect(-13, 4, 26, 26);
        c.fillStyle = '#ffd84d'; c.fillRect(7, 18, 3, 3);

        // Windows (Glowing Golden interior light)
        [-56, 40].forEach(wx => {
            c.fillStyle = '#2b1405'; c.fillRect(wx - 2, 0, 22, 20);
            c.fillStyle = '#fce277'; c.fillRect(wx, 2, 18, 16);
            c.fillStyle = '#7a3e12';
            c.fillRect(wx + 8, 2, 2, 16);
            c.fillRect(wx, 10, 18, 2);
            // Window flower planter box
            c.fillStyle = '#593315'; c.fillRect(wx - 2, 18, 22, 6);
            c.fillStyle = '#f04868'; c.fillRect(wx + 2, 16, 4, 4);
            c.fillStyle = '#ffd84d'; c.fillRect(wx + 8, 16, 4, 4);
            c.fillStyle = '#5ec454'; c.fillRect(wx + 14, 16, 4, 4);
        });

        // Gable Roof (Stardew terracotta red tiles)
        c.fillStyle = '#a33c2a';
        c.beginPath();
        c.moveTo(-92, -8);
        c.lineTo(0, -62);
        c.lineTo(92, -8);
        c.closePath();
        c.fill();
        c.strokeStyle = '#54190e';
        c.lineWidth = 4;
        c.stroke();

        // Roof overhang trim
        c.fillStyle = '#752516';
        c.fillRect(-94, -8, 188, 5);

        // Hanging porch lantern
        c.fillStyle = '#261205'; c.fillRect(-2, 4, 4, 4);
        c.fillStyle = '#ffd84d'; c.fillRect(-3, 8, 6, 7);

        c.restore();
    }

    // 3. Resting Pet (Farm Dog / Cat with breathing & tail wag)
    function drawRestingPet(c, x, y) {
        c.save();
        c.translate(x, y);
        const breath = Math.sin(tick * 0.1) * 1;
        const tail = Math.sin(tick * 0.25) * 3;

        // Shadow
        c.fillStyle = 'rgba(20, 30, 12, 0.4)';
        c.beginPath(); c.ellipse(0, 4, 12, 5, 0, 0, Math.PI * 2); c.fill();

        // Body
        c.fillStyle = '#d97d29';
        c.beginPath(); c.ellipse(0, 0 + breath, 10, 6, 0, 0, Math.PI * 2); c.fill();

        // Head
        c.fillStyle = '#e8903e';
        c.beginPath(); c.arc(8, -3 + breath, 5.5, 0, Math.PI * 2); c.fill();

        // Sleeping eyes & nose
        c.fillStyle = '#3a1a06';
        c.fillRect(9, -3 + breath, 2, 1);
        c.fillRect(11, -2 + breath, 2, 2);

        // Ears
        c.fillStyle = '#b85e18';
        c.beginPath(); c.arc(6, -7 + breath, 2.5, 0, Math.PI * 2); c.fill();

        // Wagging tail
        c.strokeStyle = '#d97d29';
        c.lineWidth = 2.5;
        c.beginPath();
        c.moveTo(-8, 1);
        c.quadraticCurveTo(-14, -3 + tail, -16, -6 + tail);
        c.stroke();

        // Little Heart/Zzz above head
        if ((tick % 120) < 60) {
            c.font = 'bold 8px "Press Start 2P", monospace';
            c.fillStyle = '#fce8b8';
            c.fillText('z', 14, -8 - ((tick % 60) * 0.15));
        }

        c.restore();
    }

    // 4. Peaceful Pond / Lake with Water Caustics & Water Lilies
    function drawTranquilPond(c, x, y, w, h) {
        c.save();
        c.translate(x, y);

        // Sand shore
        c.fillStyle = '#c79c53';
        c.beginPath(); c.ellipse(0, 0, w / 2 + 5, h / 2 + 5, 0, 0, Math.PI * 2); c.fill();

        // Water basin
        c.fillStyle = '#2b659c';
        c.beginPath(); c.ellipse(0, 0, w / 2, h / 2, 0, 0, Math.PI * 2); c.fill();

        // Shimmering water caustics
        c.fillStyle = '#4fa8de';
        const wave = Math.sin(tick * 0.08) * 3;
        c.beginPath(); c.ellipse(-w * 0.2 + wave, -h * 0.1, w * 0.22, h * 0.2, 0, 0, Math.PI * 2); c.fill();
        c.fillStyle = '#82cbf7';
        c.beginPath(); c.ellipse(w * 0.15 - wave, h * 0.12, w * 0.16, h * 0.15, 0, 0, Math.PI * 2); c.fill();

        // Lily pads
        c.fillStyle = '#3a8731';
        c.beginPath(); c.arc(-w * 0.18, h * 0.15, 6, 0, Math.PI * 1.8); c.fill();
        c.fillStyle = '#f57faa';
        c.beginPath(); c.arc(-w * 0.18, h * 0.15, 2.5, 0, Math.PI * 2); c.fill();

        // Little Wooden Dock / Pier
        c.fillStyle = '#593214'; c.fillRect(w * 0.15, -h * 0.35, 18, 28);
        c.fillStyle = '#854d24'; c.fillRect(w * 0.15 + 1, -h * 0.35 + 1, 16, 26);
        c.restore();
    }

    // 5. Authentic 4-Direction Character Sprite Renderer
    function drawCharacterSprite(c, x, y, opts) {
        c.save();
        c.translate(x, y);

        // Ground Shadow
        c.fillStyle = 'rgba(15, 30, 10, 0.42)';
        c.beginPath(); c.ellipse(0, 14, 11, 5, 0, 0, Math.PI * 2); c.fill();

        const isWalking = opts.walking || false;
        const dir = opts.dir || 'down';
        const cycle = opts.stepCycle || 0; // 0, 1, 2, 3

        // Foot offsets based on walk cycle
        let legL = 0;
        let legR = 0;
        let armL = 0;
        let armR = 0;
        let bob = 0;

        if (isWalking) {
            bob = (cycle === 1 || cycle === 3) ? -1.5 : 0;
            if (cycle === 1) { legL = -3; legR = 3; armL = 3; armR = -3; }
            else if (cycle === 3) { legL = 3; legR = -3; armL = -3; armR = 3; }
        } else {
            // Idle breathing
            bob = Math.sin(tick * 0.08) * 0.8;
        }

        // ============================================
        // NPC Mempelai Pria (Groom)
        // ============================================
        if (opts.isGroom) {
            // Black formal shoes
            c.fillStyle = '#1c1917';
            c.fillRect(-6, 7, 5, 7);
            c.fillRect(1, 7, 5, 7);
            // Navy/Charcoal suit trousers
            c.fillStyle = '#1e293b';
            c.fillRect(-6, 3, 5, 6);
            c.fillRect(1, 3, 5, 6);
            // Black Tuxedo jacket
            c.fillStyle = '#0f172a';
            c.fillRect(-8, -8 + bob, 16, 13);
            // White shirt & Red Rose Boutonniere
            c.fillStyle = '#ffffff';
            c.fillRect(-3, -8 + bob, 6, 8);
            c.fillStyle = '#d9383a';
            c.fillRect(-1, -7 + bob, 2, 7);
            c.fillRect(3, -5 + bob, 3, 3);
            // Hands
            c.fillStyle = '#f5c296';
            c.fillRect(-9, -2 + bob, 2, 4);
            c.fillRect(7, -2 + bob, 2, 4);
            // Face
            c.fillStyle = '#f5c296';
            c.fillRect(-6, -18 + bob, 12, 10);
            // Eyes & Groom smile
            c.fillStyle = '#3a1a06';
