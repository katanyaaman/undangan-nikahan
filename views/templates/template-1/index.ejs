    <!-- ===================================================================== -->
    <!-- 1. OPENING COVER: STARDEW VALLEY TITLE SCREEN & GRANDPA'S LETTER      -->
    <!-- ===================================================================== -->
    <div id="t1-opening-cover">
        <!-- Floating Clouds -->
        <div class="title-cloud-layer">
            <div class="pixel-cloud" style="top: 22px; width: 85px; height: 26px; animation-duration: 22s; animation-delay: 0s;"></div>
            <div class="pixel-cloud" style="top: 55px; width: 110px; height: 32px; animation-duration: 28s; animation-delay: -10s;"></div>
            <div class="pixel-cloud" style="top: 110px; width: 75px; height: 24px; animation-duration: 25s; animation-delay: -5s;"></div>
        </div>

        <!-- Hanging Signboard -->
        <div class="sdv-title-header">
            <div class="sign-chains">
                <div class="chain-link"></div>
                <div class="chain-link"></div>
            </div>
            <div class="sdv-plank-sign">
                <div class="font-pixel text-[8px] uppercase tracking-wider mb-1" style="color: #4a2108;">
                    ★ PELICAN TOWN SPECIAL EVENT ★
                </div>
                <h1 class="text-xl sm:text-2xl font-extrabold leading-tight" style="color: #361907;">
                    <span data-demo="groom_name"><%= fv(event?.groom_name, 'David') %></span>
                    <span style="color: #b81d24;">&hearts;</span>
                    <span data-demo="bride_name"><%= fv(event?.bride_name, 'Sarah') %></span>
                </h1>
                <p class="text-[11px] font-bold mt-1" style="color: #4a2108;">
                    💍 Festival Pernikahan &amp; Ikatan Janji Suci
                </p>
            </div>
        </div>

        <!-- Title Screen Menu Card (Grandpa's Invitation Letter) -->
        <div class="sdv-title-menu">
            <div class="flex items-center justify-between gap-2 pb-2 mb-2" style="border-bottom: 2px solid #c87d32;">
                <span class="font-pixel text-[8px] uppercase" style="color: #7d4014;">💌 UNDANGAN UNTUK:</span>
                <span id="t1-recipient-name" class="font-extrabold text-xs px-2.5 py-1 rounded"
                      style="background: #fff5d9; border: 2px solid #7d4014; color: #361907;">
                    Tamu Undangan
                </span>
            </div>

            <p class="text-[11.5px] font-semibold mb-3 leading-snug" style="color: #4a2108;">
                Walikota Lewis mengundangmu ke Festival Pernikahan di Lembah Pelican! Gerakkan karaktermu dan selesaikan <strong>5 Misi Seru</strong> untuk membuka seluruh isi undangan.
            </p>

            <div class="grid grid-cols-2 gap-2">
                <button id="t1-open-btn" type="button" class="sdv-green-btn font-pixel text-[8.5px] w-full">
                    <span>▶ MASUK GAME</span>
                </button>
                <button id="t1-open-direct-btn" type="button" class="sdv-wood-btn font-pixel text-[8.5px] w-full">
                    <span>📜 BUKA SEMUA</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- 2. PLAYABLE 2D TOP-DOWN STARDEW VALLEY RPG WORLD                      -->
    <!-- ===================================================================== -->
    <div id="t1-main-content" class="opacity-0 pointer-events-none transition-opacity duration-500">

        <!-- 2D Procedural Pixel-Art Map & Character Canvas -->
        <canvas id="sdv-game-canvas" width="440" height="820"></canvas>

        <!-- TOP-LEFT ACTIVE QUEST TRACKER PILL -->
        <div class="sdv-quest-tracker-pill" onclick="openQuestModal('overview')">
            <div class="flex items-center justify-between gap-2 mb-0.5">
                <span class="font-pixel text-[8px] uppercase" style="color: #7d4014;">📜 JURNAL MISI</span>
                <span id="sdv-quest-counter" class="font-pixel text-[8px]" style="color: #2d7a31;">0/5</span>
            </div>
            <div id="sdv-active-quest-hint" class="text-[10px] font-bold leading-tight" style="color: #361907;">
                Ketuk tanda [!] kuning di peta untuk mulai misi!
            </div>
        </div>

        <!-- FLOATING MUSIC TOGGLE -->
        <button id="t1-music-toggle" type="button" aria-label="Toggle Musik" title="Musik Latar">
            <span id="t1-disc-icon" class="text-base">🎵</span>
        </button>

        <!-- TOP-RIGHT AUTHENTIC STARDEW VALLEY CLOCK + DATE + GOLD HUD -->
        <div class="sdv-clock-cluster">
            <!-- Flashing [!] Journal Icon -->
            <button type="button" class="sdv-journal-btn" onclick="openQuestModal('overview')" title="Buka Jurnal Misi & Semua Info">
                <span class="text-base">📜</span>
                <span id="sdv-journal-bang" class="sdv-journal-badge font-pixel">!</span>
            </button>

            <div>
                <div class="sdv-clock-box">
                    <div class="sdv-clock-top">
                        <!-- Half-Circle Day/Night Dial -->
                        <div class="sdv-dial">
                            <div class="sdv-dial-hand"></div>
                        </div>
                        <!-- Right Date / Weather / Time Slots -->
                        <div class="sdv-clock-slots">
                            <div class="sdv-clock-slot font-pixel text-[7.5px]">Festival Day</div>
                            <div class="sdv-weather-row">
                                <div class="sdv-clock-slot text-[10px]" title="Cerah">☀️</div>
                                <div class="sdv-clock-slot text-[10px]" title="Mermaid Wedding">🐚</div>
                            </div>
                            <div id="sdv-clock-time" class="sdv-clock-slot font-pixel text-[7px]">09:00 am</div>
                        </div>
                    </div>
                </div>
                <!-- Segmented Gold Counter -->
                <div class="sdv-gold-bar">
                    <span class="font-pixel text-[9px] font-bold" style="color: #ffd84d; text-shadow: 1px 1px 0 #3e1d08;">G</span>
                    <span id="sdv-gold-display" class="sdv-gold-digits">0000100</span>
                </div>
            </div>
        </div>

        <!-- ON-SCREEN D-PAD CONTROLLER (BOTTOM-LEFT) -->
        <div class="sdv-dpad" aria-label="Kontrol Gerak Karakter">
            <div></div>
            <button type="button" class="dpad-btn" onpointerdown="movePlayer(0, -1)" aria-label="Atas">▲</button>
            <div></div>
            <button type="button" class="dpad-btn" onpointerdown="movePlayer(-1, 0)" aria-label="Kiri">◄</button>
            <button type="button" class="dpad-btn" style="background: #f5b700; color: #361907; border-color: #3e1d08; font-size: 11px;"
                    onclick="interactNearestStation()" title="Interaksi Quest terdekat">A</button>
            <button type="button" class="dpad-btn" onpointerdown="movePlayer(1, 0)" aria-label="Kanan">►</button>
            <div></div>
            <button type="button" class="dpad-btn" onpointerdown="movePlayer(0, 1)" aria-label="Bawah">▼</button>
            <div></div>
        </div>

        <!-- BOTTOM-RIGHT ENERGY BAR ("E") -->
        <div class="sdv-energy-bar" title="Energy Bar">
            <span class="sdv-energy-header">E</span>
            <div class="sdv-energy-track">
                <div id="sdv-energy-fill" class="sdv-energy-fill"></div>
            </div>
        </div>

        <!-- BOTTOM CENTER STARDEW INVENTORY HOTBAR (7 SLOTS) -->
        <nav id="t1-bottom-dock" aria-label="Inventory Hotbar">
            <div class="sdv-hotbar-grid">
                <button type="button" class="sdv-hotbar-slot active-slot" id="hotbar-0" onclick="walkToStation('overview')">
                    <span class="sdv-slot-num">1</span>
                    <span class="text-base leading-none">🗺️</span>
                    <span class="sdv-slot-label">Peta</span>
                </button>
                <button type="button" class="sdv-hotbar-slot" id="hotbar-1" onclick="walkToStation(1)">
                    <span class="sdv-slot-num">2</span>
                    <span class="text-base leading-none">💐</span>
                    <span class="sdv-slot-label">Mempelai</span>
                    <span id="hqty-1" class="sdv-slot-qty">!</span>
                </button>
                <button type="button" class="sdv-hotbar-slot" id="hotbar-2" onclick="walkToStation(2)">
                    <span class="sdv-slot-num">3</span>
                    <span class="text-base leading-none">⭐</span>
                    <span class="sdv-slot-label">Acara</span>
                    <span id="hqty-2" class="sdv-slot-qty">!</span>
                </button>
                <button type="button" class="sdv-hotbar-slot" id="hotbar-3" onclick="walkToStation(3)">
                    <span class="sdv-slot-num">4</span>
                    <span class="text-base leading-none">📜</span>
                    <span class="sdv-slot-label">Cerita</span>
                    <span id="hqty-3" class="sdv-slot-qty">!</span>
                </button>
                <button type="button" class="sdv-hotbar-slot" id="hotbar-4" onclick="walkToStation(4)">
                    <span class="sdv-slot-num">5</span>
                    <span class="text-base leading-none">💎</span>
                    <span class="sdv-slot-label">Galeri</span>
                    <span id="hqty-4" class="sdv-slot-qty">!</span>
                </button>
                <button type="button" class="sdv-hotbar-slot" id="hotbar-5" onclick="walkToStation(5)">
                    <span class="sdv-slot-num">6</span>
                    <span class="text-base leading-none">📦</span>
                    <span class="sdv-slot-label">RSVP</span>
                    <span id="hqty-5" class="sdv-slot-qty">!</span>
                </button>
                <button type="button" class="sdv-hotbar-slot" id="hotbar-all" onclick="unlockAndShowAll()">
                    <span class="sdv-slot-num">7</span>
                    <span class="text-base leading-none">📖</span>
                    <span class="sdv-slot-label">Semua</span>
                </button>
            </div>
        </nav>

        <!-- ================================================================= -->
        <!-- STARDEW RPG DIALOGUE & QUEST MODAL                                -->
        <!-- ================================================================= -->
        <div id="sdv-modal-backdrop" onclick="closeQuestModal()">
            <div class="sdv-dialog-window" onclick="event.stopPropagation()">
                <div class="sdv-dialog-header">
                    <div class="flex items-center gap-2 min-w-0">
                        <span id="sdv-modal-icon" class="text-lg">📜</span>
                        <span id="sdv-modal-title" class="font-pixel text-[8.5px] uppercase truncate">Jurnal Misi Pelican Town</span>
