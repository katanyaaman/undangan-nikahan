                                <span id="qbadge-5" class="sdv-badge-red font-pixel text-[7px]">MISI !</span>
                            </button>

                            <button type="button" onclick="unlockAndShowAll()" class="sdv-wood-btn w-full mt-2 text-xs font-pixel">
                                <span>🔓 BUKA SEMUA INFORMASI SEKALIGUS</span>
                            </button>
                        </div>
                    </section>

                    <!-- PANEL 1: QUEST #1 — AYAT SUCI & PROFIL MEMPELAI -->
