<!DOCTYPE html>
<html lang="id" class="select-none overflow-hidden">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title || 'Misi Truk MBG - Undangan ' + fv(event?.groom_name, 'David') + ' & ' + fv(event?.bride_name, 'Sarah') %></title>
    
    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="/css/app.css">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Three.js (3D WebGL Engine) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        * {
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
        }
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: 'Fredoka', cursive, sans-serif;
            background-color: #a5f3fc;
        }
        
        /* Stylized Game Controls & HUD */
        .toy-btn {
            box-shadow: 0 5px 0 rgba(0,0,0,0.18), 0 8px 16px rgba(0,0,0,0.1);
            transition: all 0.08s ease;
        }
        .toy-btn:active {
            transform: translateY(4px);
            box-shadow: 0 1px 0 rgba(0,0,0,0.18), 0 3px 6px rgba(0,0,0,0.08);
        }

        .hud-glass-toy {
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 3px solid #fde047;
            box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12), inset 0 2px 4px rgba(255, 255, 255, 0.9);
        }

        .modal-pop {
            animation: modalPopAnim 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }
        @keyframes modalPopAnim {
            0% { transform: scale(0.8) translateY(25px); opacity: 0; }
            100% { transform: scale(1) translateY(0); opacity: 1; }
        }

        /* Custom scrollbar */
        .custom-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scroll::-webkit-scrollbar-track {
            background: #fef08a;
            border-radius: 8px;
        }
        .custom-scroll::-webkit-scrollbar-thumb {
            background: #eab308;
            border-radius: 8px;
        }
    </style>
</head>
<body class="relative w-full h-full text-slate-800 select-none overflow-hidden">

    <!-- ========================================================= -->
    <!-- 1. THREE.JS 3D VIEWPORT CANVAS (DIORAMA WORLD) -->
    <!-- ========================================================= -->
    <div id="t6-canvas-container" class="absolute inset-0 z-0 w-full h-full"></div>

    <!-- ========================================================= -->
    <!-- 2. GAME HUD (TOY DIORAMA RPG OVERLAY) -->
    <!-- ========================================================= -->
    <div id="t6-hud" class="absolute inset-0 z-20 pointer-events-none flex flex-col justify-between p-3 sm:p-5 select-none">
        
        <!-- TOP HUD: QUEST PROGRESS & STATUS -->
        <header class="w-full max-w-lg mx-auto pointer-events-auto space-y-2">
            <!-- Header Bar -->
            <div class="flex items-center justify-between hud-glass-toy px-3.5 py-2.5 rounded-3xl">
                <!-- Delivery Mission Badge -->
                <div class="flex items-center space-x-2.5">
                    <div class="w-9 h-9 rounded-2xl bg-gradient-to-tr from-amber-400 to-yellow-400 text-slate-900 font-bold flex items-center justify-center text-xl shadow-md border-2 border-white animate-bounce">
                        🚚
                    </div>
                    <div>
                        <div class="flex items-center space-x-1.5">
                            <span class="text-[11px] font-bold text-amber-600 uppercase tracking-wider">MISI TRUK MBG</span>
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                        </div>
                        <p class="text-xs sm:text-sm font-bold text-slate-800">
                            <%= fv(event?.groom_name, 'David') %> & <%= fv(event?.bride_name, 'Sarah') %>
                        </p>
                    </div>
                </div>

                <!-- Utilities -->
                <div class="flex items-center space-x-1.5">
                    <!-- Auto-Drive Cruise Toggle -->
                    <button type="button" id="btn-autopilot-mini" onclick="toggleAutopilot()" title="Auto Jalan / Manual" 
                            class="toy-btn px-2.5 py-1.5 rounded-2xl bg-gradient-to-r from-teal-400 to-emerald-500 hover:from-teal-500 hover:to-emerald-600 border-2 border-white text-white font-bold text-xs flex items-center space-x-1 shadow">
                        <span id="t6-autopilot-icon">🚀</span>
                        <span id="t6-autopilot-label" class="hidden sm:inline">Auto</span>
                    </button>
                    <!-- Horn Button -->
                    <button type="button" onclick="honkTruckHorn()" title="Klakson Telolet Lucu" 
                            class="toy-btn w-9 h-9 rounded-2xl bg-amber-400 hover:bg-amber-300 border-2 border-white text-slate-900 font-bold flex items-center justify-center text-base shadow">
                        📯
                    </button>
                    <!-- Audio BGM Toggle -->
                    <button type="button" id="t6-audio-toggle" onclick="toggleAudioBGM()" title="Musik Petualangan" 
                            class="toy-btn w-9 h-9 rounded-2xl bg-sky-400 hover:bg-sky-300 border-2 border-white text-white font-bold flex items-center justify-center text-base shadow">
                        <span id="t6-bgm-icon">🎵</span>
                    </button>
                    <!-- Full Invitation Book Menu -->
                    <button type="button" onclick="openBookModal()" title="Buka Buku Undangan Lengkap" 
                            class="toy-btn px-3 py-1.5 rounded-2xl bg-gradient-to-r from-emerald-400 to-teal-500 hover:from-emerald-500 hover:to-teal-600 text-white font-bold text-xs flex items-center space-x-1 shadow border-2 border-white">
                        <span>📖</span>
                        <span class="hidden sm:inline">Buku Tamu</span>
                    </button>
                </div>
            </div>

            <!-- Checkpoint Quest Track -->
            <div class="hud-glass-toy px-3 py-2 rounded-2xl">
                <div class="flex items-center justify-between text-[11px] font-bold text-slate-700 mb-1 px-1">
                    <span id="t6-checkpoint-status">🚩 Menuju Posko 1: Mempelai</span>
                    <span id="t6-speed-hud" class="font-bold text-amber-600 bg-amber-100 px-2.5 py-0.5 rounded-full border border-amber-300">0 KM/H</span>
                </div>
                
                <!-- Progress Line -->
                <div class="relative w-full h-3 bg-amber-100 rounded-full overflow-hidden p-0.5 border border-amber-300">
                    <div id="t6-progress-bar" class="h-full bg-gradient-to-r from-amber-400 via-orange-400 to-emerald-400 rounded-full transition-all duration-300" style="width: 5%;"></div>
                </div>

                <!-- Checkpoint Quick Jump Buttons -->
                <div class="flex items-center justify-between pt-1.5 px-0.5 text-[10px] font-bold text-slate-500">
                    <button onclick="teleportToCheckpoint(0)" class="hover:text-amber-600 transition-colors">🚩 Start</button>
                    <button onclick="teleportToCheckpoint(1)" class="hover:text-amber-600 transition-colors">💑 Mempelai</button>
                    <button onclick="teleportToCheckpoint(2)" class="hover:text-amber-600 transition-colors">⏰ Acara</button>
                    <button onclick="teleportToCheckpoint(3)" class="hover:text-amber-600 transition-colors">📸 Galeri</button>
                    <button onclick="teleportToCheckpoint(4)" class="hover:text-amber-600 transition-colors">🎁 Kado</button>
                    <button onclick="teleportToCheckpoint(5)" class="hover:text-emerald-600 transition-colors text-emerald-600">🏁 RSVP</button>
                </div>
            </div>
        </header>

        <!-- CENTER HUD: COMPACT TOAST NOTIFICATION -->
        <div id="t6-toast" class="self-center pointer-events-auto opacity-0 translate-y-4 transition-all duration-300 max-w-max mx-auto bg-amber-400 text-slate-900 font-bold text-xs sm:text-sm px-4 py-2 rounded-full shadow-xl border-2 border-white flex items-center space-x-2">
            <span>📢</span>
            <span id="t6-toast-text">Ayo gas truk menuju pesta pernikahan!</span>
        </div>

        <!-- BOTTOM HUD: SLEEK MINIMAL DIRECT INTERACTION HINT -->
        <div id="t6-interaction-hint" class="self-center pointer-events-none transition-all duration-700 bg-white/90 backdrop-blur-md px-4 py-2 rounded-full shadow-lg border-2 border-amber-300 text-[11px] sm:text-xs font-bold text-slate-800 flex items-center space-x-2 animate-bounce mb-2">
            <span class="text-sm">👆</span>
            <span>Scroll / Geser Layar untuk Melaju & Belok • Ketuk Truk / Gerbang untuk Interaksi</span>
        </div>

    </div>

    <!-- ========================================================= -->
    <!-- 3. WELCOME / START MISSION OVERLAY (CUTE TOY MODAL) -->
    <!-- ========================================================= -->
    <div id="t6-start-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm select-none">
        <div class="modal-pop w-full max-w-sm sm:max-w-md bg-white border-4 border-amber-400 rounded-3xl p-5 sm:p-6 shadow-2xl text-center space-y-4">
            
            <div class="space-y-1">
                <span class="inline-block px-3 py-1 bg-amber-100 border border-amber-300 rounded-full text-amber-700 font-bold text-xs">
                    🎮 3D Diorama Adventure Invitation
                </span>
                <h1 class="font-black text-2xl sm:text-3xl text-amber-500 drop-shadow-xs">
                    MISI TRUK PENGANTAR MBG
                </h1>
                <p class="text-xs text-slate-500 font-medium">
                    (Paket Spesial Kebahagiaan & Berkah Pernikahan)
                </p>
            </div>

            <!-- Toy Truck Graphic -->
            <div class="relative py-1">
                <div class="w-24 h-24 mx-auto rounded-3xl bg-gradient-to-tr from-amber-300 via-yellow-300 to-blue-400 p-2 shadow-lg shadow-amber-500/20 flex items-center justify-center animate-bounce border-3 border-white">
                    <span class="text-5xl">🚚</span>
                </div>
                <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 px-3 py-0.5 bg-emerald-500 text-white rounded-full text-[10px] font-bold shadow border border-white">
                    SIAP JALAN! ✨
                </div>
            </div>

            <!-- Guest Card -->
            <div class="bg-amber-50 border-2 border-amber-200 rounded-2xl p-3.5 text-left space-y-1">
                <span class="text-[10px] uppercase font-bold text-amber-700">Kepada Tamu Istimewa:</span>
                <p class="font-bold text-base text-slate-800">
                    <%= (typeof to !== 'undefined' && to) ? to : (locals.to || 'Tamu Undangan Terhormat') %>
                </p>
                <p class="text-xs text-slate-600 leading-relaxed">
                    Kendarai truk pengantar MBG menyusuri dunia miniatur yang indah menuju resepsi pernikahan <strong><%= fv(event?.groom_name, 'David') %></strong> & <strong><%= fv(event?.bride_name, 'Sarah') %></strong>!
                </p>
            </div>

            <!-- Action Button -->
            <button type="button" onclick="startDeliveryMission()" 
                    class="toy-btn w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-500 hover:from-amber-500 hover:to-yellow-500 text-slate-950 font-black text-base shadow-lg flex items-center justify-center space-x-2 border-2 border-white">
                <span>🚀</span>
                <span>MULAI PETUALANGAN TRUK!</span>
            </button>

            <!-- Mode Baca Direct -->
            <button type="button" onclick="openBookModalDirect()" class="text-xs text-slate-500 hover:text-amber-600 underline font-semibold">
                Atau langsung buka buku undangan lengkap (Mode Baca)
            </button>
        </div>
    </div>

    <!-- ========================================================= -->
    <!-- 4. CHECKPOINT POP-UP MODAL (POSKO MISI PERNIKAHAN) -->
    <!-- ========================================================= -->
    <div id="t6-checkpoint-modal" class="fixed inset-0 z-40 hidden items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs select-none">
        <div class="modal-pop w-full max-w-sm sm:max-w-md bg-white border-4 border-amber-400 rounded-3xl p-5 shadow-2xl space-y-4 max-h-[85vh] overflow-y-auto custom-scroll">
            
            <!-- Modal Header -->
            <div class="flex items-center justify-between border-b-2 border-amber-100 pb-2.5">
                <div class="flex items-center space-x-2.5">
                    <span id="t6-modal-icon" class="text-3xl">💑</span>
                    <div>
                        <span id="t6-modal-badge" class="text-[10px] font-bold text-amber-600 uppercase">POSKO 1 DARI 5</span>
                        <h3 id="t6-modal-title" class="font-bold text-base text-slate-800">Profil Pengantin</h3>
                    </div>
                </div>
                <button type="button" onclick="closeCheckpointModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold flex items-center justify-center text-xs">
                    ✕
                </button>
            </div>

            <!-- Dynamic Modal Content Body -->
            <div id="t6-modal-body" class="space-y-3 text-xs sm:text-sm text-slate-700">
                <!-- Injected via JavaScript -->
            </div>

            <!-- Modal Footer Action -->
            <div class="pt-2 border-t-2 border-amber-100 flex items-center space-x-2">
                <button type="button" onclick="resumeDeliveryDrive()" 
                        class="toy-btn flex-1 py-3 px-4 rounded-2xl bg-gradient-to-r from-amber-400 to-yellow-400 text-slate-950 font-black text-xs sm:text-sm flex items-center justify-center space-x-1.5 shadow border-2 border-white">
                    <span>Lanjut Kemudikan Truk 🚚</span>
                    <span>▶</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ========================================================= -->
    <!-- 5. FULL READABLE INVITATION MODAL (BUKU TAMU LENGKAP) -->
    <!-- ========================================================= -->
    <div id="t6-book-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-5 bg-slate-900/50 backdrop-blur-md">
        <div class="modal-pop w-full max-w-md bg-white border-4 border-amber-400 rounded-3xl p-5 shadow-2xl flex flex-col max-h-[90vh]">
            
            <!-- Header -->
            <div class="flex items-center justify-between border-b-2 border-amber-100 pb-3 flex-shrink-0">
                <div class="flex items-center space-x-2.5">
                    <span class="text-2xl">📖</span>
                    <div>
                        <h3 class="font-black text-base text-amber-600">Buku Undangan Lengkap</h3>
                        <p class="text-[11px] text-slate-500"><%= fv(event?.groom_name, 'David') %> & <%= fv(event?.bride_name, 'Sarah') %></p>
                    </div>
                </div>
                <button type="button" onclick="closeBookModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold flex items-center justify-center text-xs">
                    ✕
                </button>
            </div>

            <!-- Scrollable Content -->
            <div class="flex-1 overflow-y-auto custom-scroll py-4 space-y-5 text-xs sm:text-sm text-slate-700 pr-1">
                
                <!-- Salam & Ayat Suci -->
                <div class="text-center space-y-1.5 bg-amber-50 p-4 rounded-2xl border border-amber-200">
                    <span class="text-amber-700 font-bold text-[10px] tracking-wider uppercase">Bismillahirrahmannirrahim</span>
                    <p class="italic text-slate-600 text-xs leading-relaxed">
                        "Dan di antara tanda-tanda (kebesaran)-Nya ialah Dia menciptakan pasangan-pasangan untukmu dari jenismu sendiri, agar kamu cenderung dan merasa tenteram kepadanya, dan Dia menjadikan di antaramu rasa kasih dan sayang."
                    </p>
                    <span class="text-[11px] font-bold text-amber-600">(QS. Ar-Rum: 21)</span>
                </div>

                <!-- Mempelai Card -->
                <div class="space-y-2.5">
                    <h4 class="font-bold text-amber-600 text-sm flex items-center space-x-1.5">
                        <span>💑</span>
                        <span>Mempelai yang Berbahagia</span>
                    </h4>
                    
                    <div class="grid grid-cols-2 gap-2.5 text-center">
                        <!-- Groom -->
                        <div class="bg-amber-50/70 p-3 rounded-2xl border border-amber-200 space-y-1">
                            <div class="w-14 h-14 mx-auto rounded-full bg-amber-200 border-2 border-white flex items-center justify-center text-2xl shadow-xs">
                                🤵
                            </div>
                            <h5 class="font-bold text-slate-800 text-xs"><%= fv(event?.groom_name, 'David Anderson') %></h5>
                            <p class="text-[10px] text-slate-500">Putra <%= fv(event?.groom_father, 'Bpk. Robert') %> & <%= fv(event?.groom_mother, 'Ibu Jennifer') %></p>
                            <% if (event?.instagram_groom) { %>
                                <span class="inline-block text-[10px] text-amber-600 font-semibold"><%= event.instagram_groom %></span>
                            <% } %>
                        </div>
                        <!-- Bride -->
                        <div class="bg-pink-50/70 p-3 rounded-2xl border border-pink-200 space-y-1">
                            <div class="w-14 h-14 mx-auto rounded-full bg-pink-200 border-2 border-white flex items-center justify-center text-2xl shadow-xs">
                                👰
                            </div>
                            <h5 class="font-bold text-slate-800 text-xs"><%= fv(event?.bride_name, 'Sarah Johnson') %></h5>
                            <p class="text-[10px] text-slate-500">Putri <%= fv(event?.bride_father, 'Bpk. Michael') %> & <%= fv(event?.bride_mother, 'Ibu Emily') %></p>
                            <% if (event?.instagram_bride) { %>
                                <span class="inline-block text-[10px] text-pink-600 font-semibold"><%= event.instagram_bride %></span>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Jadwal Acara & Lokasi -->
                <div class="space-y-2.5 bg-amber-50/80 p-4 rounded-2xl border border-amber-200">
                    <h4 class="font-bold text-amber-600 text-sm flex items-center space-x-1.5">
                        <span>⏰</span>
                        <span>Jadwal & Lokasi Acara</span>
                    </h4>
                    
                    <div class="space-y-2">
                        <div class="flex items-start space-x-2">
                            <span class="text-base">📅</span>
                            <div>
                                <p class="font-bold text-slate-800"><%= eventDateLong || 'Sabtu, 31 Desember 2025' %></p>
                                <p class="text-[11px] text-slate-500">Pukul 09.00 - Selesai WIB</p>
                            </div>
                        </div>

                        <div class="flex items-start space-x-2">
                            <span class="text-base">📍</span>
                            <div>
                                <p class="font-bold text-slate-800"><%= venueName || 'Grand Ballroom Hotel' %></p>
                                <p class="text-[11px] text-slate-500 leading-snug"><%= venueAddress || 'Jl. Sudirman No. 123, Jakarta' %></p>
                            </div>
                        </div>
                    </div>

                    <a href="https://maps.google.com/?q=<%= encodeURIComponent((venueName || '') + ' ' + (venueAddress || '')) %>" target="_blank" rel="noopener noreferrer"
                       class="w-full py-2.5 bg-amber-400 hover:bg-amber-500 text-slate-900 font-bold text-xs rounded-xl flex items-center justify-center space-x-1.5 transition-colors border border-amber-500 shadow-xs">
                        <span>🗺️ Buka Rute Google Maps</span>
                    </a>
                </div>

                <!-- Titipan Kado & Amplop Digital -->
                <div class="space-y-2.5 bg-amber-50/80 p-4 rounded-2xl border border-amber-200">
                    <h4 class="font-bold text-amber-600 text-sm flex items-center space-x-1.5">
                        <span>🎁</span>
                        <span>Titipan Kasih & Amplop Digital</span>
                    </h4>
                    <p class="text-[11px] text-slate-600">Doa restu Anda adalah karunia terindah bagi kami. Namun jika ingin memberikan tanda kasih:</p>
                    
                    <div class="space-y-2 text-xs">
                        <div class="bg-white p-2.5 rounded-xl border border-amber-200 flex items-center justify-between shadow-xs">
                            <div>
                                <span class="font-bold text-slate-800">BCA: 1234567890</span>
                                <p class="text-[10px] text-slate-500">a.n <%= fv(event?.groom_name, 'David Anderson') %></p>
                            </div>
                            <button type="button" onclick="copyText('1234567890', this)" class="px-2.5 py-1 bg-amber-400 text-slate-900 font-bold text-[10px] rounded-lg">Salin</button>
                        </div>

                        <div class="bg-white p-2.5 rounded-xl border border-amber-200 flex items-center justify-between shadow-xs">
                            <div>
                                <span class="font-bold text-slate-800">MANDIRI: 0987654321</span>
                                <p class="text-[10px] text-slate-500">a.n <%= fv(event?.bride_name, 'Sarah Johnson') %></p>
                            </div>
                            <button type="button" onclick="copyText('0987654321', this)" class="px-2.5 py-1 bg-amber-400 text-slate-900 font-bold text-[10px] rounded-lg">Salin</button>
                        </div>
                    </div>
                </div>

                <!-- Form RSVP Langsung -->
                <div class="space-y-2.5 bg-emerald-50 p-4 rounded-2xl border border-emerald-200">
                    <h4 class="font-bold text-emerald-700 text-sm flex items-center space-x-1.5">
                        <span>✍️</span>
                        <span>Konfirmasi Kehadiran (RSVP)</span>
                    </h4>

                    <form id="t6-book-rsvp-form" class="space-y-2.5">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div>
                            <label class="block text-[10px] font-bold text-slate-600 uppercase mb-1">Nama Lengkap</label>
                            <input type="text" name="name" required value="<%= (typeof to !== 'undefined' && to) ? to : (locals.to || '') %>" placeholder="Masukkan nama Anda..." class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs text-slate-800 focus:outline-none focus:border-amber-500">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-slate-600 uppercase mb-1">Status Kehadiran</label>
                            <select name="attendance" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs text-slate-800 focus:outline-none focus:border-amber-500">
                                <option value="hadir">🟢 Hadir</option>
                                <option value="tidak_hadir">🔴 Berhalangan Hadir</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-slate-600 uppercase mb-1">Jumlah Tamu</label>
                            <input type="number" name="number_of_guests" min="1" max="5" value="1" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs text-slate-800 focus:outline-none focus:border-amber-500">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-slate-600 uppercase mb-1">Ucapan & Doa Restu</label>
                            <textarea name="message" rows="2" placeholder="Tuliskan ucapan selamat..." class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs text-slate-800 focus:outline-none focus:border-amber-500"></textarea>
                        </div>
                        <button type="submit" id="t6-book-rsvp-btn" class="w-full py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-xs rounded-xl shadow border border-emerald-600">
                            Kirim Konfirmasi Balasan
                        </button>
                    </form>
                </div>

