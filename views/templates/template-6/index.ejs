                    <div class="text-center bg-emerald-100 border border-emerald-300 p-3 rounded-2xl">
                        <h4 class="font-black text-emerald-800 text-sm">🎉 MISI SELESAI DENGAN SUKSES!</h4>
                        <p class="text-[11px] text-slate-700">Truk MBG berhasil tiba di gedung resepsi! Silakan isi konfirmasi kehadiran Anda di bawah ini:</p>
                    </div>

                    <form id="t6-modal-rsvp-form" class="space-y-2">
                        <input type="hidden" name="_csrf" value="${WEDDING_DATA.csrfToken}">
                        <div>
                            <input type="text" name="name" required value="<%= (typeof to !== 'undefined' && to) ? to : (locals.to || '') %>" placeholder="Nama Anda..." class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs text-slate-800 focus:outline-none focus:border-amber-500">
                        </div>
                        <div>
                            <select name="attendance" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs text-slate-800 focus:outline-none focus:border-amber-500">
                                <option value="hadir">🟢 Ya, Insya Allah Hadir</option>
                                <option value="tidak_hadir">🔴 Maaf, Berhalangan Hadir</option>
                            </select>
                        </div>
                        <div>
                            <textarea name="message" rows="2" placeholder="Tuliskan ucapan & doa restu..." class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs text-slate-800 focus:outline-none focus:border-amber-500"></textarea>
                        </div>
                        <button type="submit" id="t6-modal-rsvp-btn" class="w-full py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-xs rounded-xl shadow border border-emerald-600">
                            Kirim Balasan RSVP
                        </button>
                    </form>
                </div>
            `;
            setTimeout(() => setupModalRsvpForm(), 50);
        }

        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeCheckpointModal() {
        const modal = document.getElementById('t6-checkpoint-modal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    }

    function resumeDeliveryDrive() {
        closeCheckpointModal();
        truckSpeed = 25;
        showToast("🚚 Melanjutkan misi pengantaran!");
    }

    function teleportToCheckpoint(index) {
        if (!isMissionStarted) startDeliveryMission();
        const cp = CHECKPOINTS[index];
        if (!cp) return;

        totalDistance = cp.distance;
        truckGroup.position.z = -cp.distance;
        truckGroup.position.x = 0;
        truckSpeed = 0;

        CHECKPOINTS.forEach((c, i) => {
            c.passed = (i <= index);
        });

        onReachCheckpoint(cp, index);
    }

    function startDeliveryMission() {
        isMissionStarted = true;
        isAutopilot = true;
        initAudio();

        const startModal = document.getElementById('t6-start-modal');
        if (startModal) {
            startModal.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => startModal.style.display = 'none', 300);
        }

        truckSpeed = 26;
        honkTruckHorn();
        showToast("🚚 Geser / Scroll layar untuk kendalikan truk!");
    }

    function openBookModalDirect() {
        startDeliveryMission();
        openBookModal();
    }

    function openBookModal() {
        const m = document.getElementById('t6-book-modal');
        if (m) {
            m.classList.remove('hidden');
            m.classList.add('flex');
        }
    }

    function closeBookModal() {
        const m = document.getElementById('t6-book-modal');
        if (m) {
            m.classList.add('hidden');
            m.classList.remove('flex');
        }
    }

    function showToast(text) {
        const toast = document.getElementById('t6-toast');
        const txt = document.getElementById('t6-toast-text');
        if (toast && txt) {
            txt.textContent = text;
            toast.classList.remove('opacity-0', 'translate-y-4');
            toast.classList.add('opacity-100', 'translate-y-0');
            setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', 'translate-y-4');
            }, 2500);
        }
    }

    function copyText(txt, btn) {
        navigator.clipboard.writeText(txt).then(() => {
            showToast('Tersalin ke clipboard: ' + txt);
            if (btn) {
                const org = btn.textContent;
                btn.textContent = '✓';
                setTimeout(() => btn.textContent = org, 1500);
            }
        });
    }

    // RSVP Handlers
    function handleRsvpSubmit(form, btn) {
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            if (btn) {
                btn.disabled = true;
                btn.textContent = 'Mengirimkan RSVP...';
            }

            const fd = new FormData(this);
            const data = Object.fromEntries(fd.entries());

            const safeName = (data.name || 'tamu').toLowerCase().replace(/[^a-z0-9]/g, '') || 'tamu';
            data.email = `${safeName}_${Date.now()}@undangan.local`;

            try {
                const res = await fetch(WEDDING_DATA.rsvpPath, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': WEDDING_DATA.csrfToken
                    },
                    body: JSON.stringify(data)
                });
                const result = await res.json();

                if (res.ok) {
                    playCheckpointChime();
                    if (typeof confetti === 'function') confetti({ particleCount: 100, spread: 80 });
                    showToast('🎉 Konfirmasi RSVP berhasil tersimpan!');

                    const wList = document.getElementById('t6-wishes-list');
                    if (wList && data.message) {
                        const item = document.createElement('div');
                        item.className = 'bg-amber-50/70 p-2.5 rounded-xl border border-amber-200 text-xs';
                        item.innerHTML = `
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-bold text-slate-800">${data.name}</span>
                                <span class="text-[9px] px-1.5 py-0.5 rounded font-bold ${data.attendance === 'hadir' ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-200 text-slate-600'}">
                                    ${data.attendance === 'hadir' ? 'Hadir' : 'Berhalangan'}
                                </span>
                            </div>
                            <p class="text-slate-600 text-[11px]">${data.message}</p>
                        `;
                        wList.prepend(item);
                    }

                    form.reset();
                    if (btn) btn.textContent = '✓ Terkirim!';
                    setTimeout(() => {
                        closeCheckpointModal();
                    }, 1200);
                } else {
                    alert('Gagal mengirim RSVP: ' + (result.message || 'Terjadi kendala'));
                }
            } catch(e) {
                alert('Gagal mengirim RSVP. Periksa koneksi internet.');
            } finally {
                if (btn) btn.disabled = false;
            }
        });
    }

    function setupModalRsvpForm() {
        const form = document.getElementById('t6-modal-rsvp-form');
        const btn = document.getElementById('t6-modal-rsvp-btn');
        if (form) handleRsvpSubmit(form, btn);
    }

    const bookForm = document.getElementById('t6-book-rsvp-form');
    const bookBtn = document.getElementById('t6-book-rsvp-btn');
    if (bookForm) handleRsvpSubmit(bookForm, bookBtn);

    document.addEventListener('DOMContentLoaded', () => {
        initThreeJS();
    });
    </script>
</body>
</html>
