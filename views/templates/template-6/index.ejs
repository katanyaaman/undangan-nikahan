        });

        // Front Grille & Lower Bumper
        const bumper = new THREE.Mesh(new THREE.BoxGeometry(2.24, 0.55, 0.3), matYellowCab);
        bumper.position.set(0, -0.7, 1.05);
        cabGroup.add(bumper);

        // Front Headlights
        [-0.8, 0.8].forEach(hx => {
            const hl = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.22, 0.08), matLight);
            hl.position.set(hx, -0.65, 1.22);
            cabGroup.add(hl);
        });

        // Curved Front Wheel Arches (Yellow Fender Over Front Wheels)
        [-1.16, 1.16].forEach(fx => {
            const fender = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.65, 1.4), matYellowCab);
            fender.position.set(fx, -0.65, 0.1);
            cabGroup.add(fender);
        });

        truckGroup.add(cabGroup);

        // 3. BLUE CARGO CONTAINER BOX (IMAGE 2 MATCH)
        const boxGroup = new THREE.Group();
        boxGroup.position.set(0, 2.05, -1.05);

        // Blue Container Body
        const blueBox = new THREE.Mesh(new THREE.BoxGeometry(2.28, 2.1, 3.2), matBlueBox);
        blueBox.castShadow = true;
        boxGroup.add(blueBox);

        // Vertical Center Dividing Seam on side panels
        [-1.15, 1.15].forEach(sx => {
            const seam = new THREE.Mesh(new THREE.BoxGeometry(0.05, 2.05, 0.08), matWhiteTrim);
            seam.position.set(sx, 0, 0);
            boxGroup.add(seam);
        });

        // White Top Roof with Longitudinal Ridges (Image 2)
        const whiteRoof = new THREE.Mesh(new THREE.BoxGeometry(2.34, 0.25, 3.26), matWhiteTrim);
        whiteRoof.position.y = 1.12;
        boxGroup.add(whiteRoof);

        // White Bottom Frame Trim
        const whiteBottom = new THREE.Mesh(new THREE.BoxGeometry(2.32, 0.12, 3.24), matWhiteTrim);
        whiteBottom.position.y = -1.02;
