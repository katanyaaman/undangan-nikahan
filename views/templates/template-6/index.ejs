        const wheelPositions = [
            [-1.15, 0.48, 1.45],  // Front Left
            [1.15, 0.48, 1.45],   // Front Right
            [-1.15, 0.48, -1.25], // Rear Left
            [1.15, 0.48, -1.25],  // Rear Right
