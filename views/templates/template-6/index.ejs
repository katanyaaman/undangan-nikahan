    // =========================================================
    // CHOO-CHOO WORLD DIORAMA (IMAGE 1 MATCH)
    // Mint grass, pillowy hills, waterfalls, hot air balloon!
    // =========================================================
    function buildDioramaWorld() {
        const SEGMENT_LENGTH = 32;
        const SEGMENT_COUNT = 14;

        // Pastel Diorama Materials (Image 1 Color Palette)
        const matMintGrass = new THREE.MeshStandardMaterial({ color: 0x86EFAC, roughness: 0.9 }); // Bright Mint Green Grass
        const matHillGreen = new THREE.MeshStandardMaterial({ color: 0x4ADE80, roughness: 0.8 }); // Pillowy Hill Green
        const matHillCap = new THREE.MeshStandardMaterial({ color: 0xA7F3D0, roughness: 0.7 });   // Light Mint Hill Cap (Image 1)
        const matRoadTrack = new THREE.MeshStandardMaterial({ color: 0xFBBF24, roughness: 0.5 }); // Colorful Toy Track (Image 1 Rainbow Rails)
        const matTrackBlue = new THREE.MeshStandardMaterial({ color: 0x38BDF8, roughness: 0.5 });
        const matWater = new THREE.MeshStandardMaterial({ color: 0x60A5FA, roughness: 0.2, metalness: 0.3 }); // Crystal Blue Waterfall & Pond
        const matWhitePuff = new THREE.MeshStandardMaterial({ color: 0xFFFFFF, roughness: 0.4 });

        // Build Continuous Diorama Terrain Segments
        for (let i = 0; i < SEGMENT_COUNT; i++) {
            const segGroup = new THREE.Group();
            segGroup.position.z = -i * SEGMENT_LENGTH;

            // 1. Vast Minty Green Ground Plane (Image 1)
            const ground = new THREE.Mesh(new THREE.PlaneGeometry(140, SEGMENT_LENGTH), matMintGrass);
            ground.rotation.x = -Math.PI / 2;
            ground.position.y = -0.02;
            segGroup.add(ground);

            // 2. Toy Track Rails (Colorful Curved Track like Image 1)
            const trackGeo = new THREE.PlaneGeometry(7.0, SEGMENT_LENGTH);
            const trackMesh = new THREE.Mesh(trackGeo, (i % 2 === 0 ? matRoadTrack : matTrackBlue));
            trackMesh.rotation.x = -Math.PI / 2;
            trackMesh.position.y = 0.02;
            trackMesh.receiveShadow = true;
            segGroup.add(trackMesh);

            // Track Border Rails (Toy Train/Road Rails)
            [-3.6, 3.6].forEach(rx => {
                const rail = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.22, SEGMENT_LENGTH), new THREE.MeshStandardMaterial({ color: 0xF43F5E }));
                rail.position.set(rx, 0.11, 0);
                segGroup.add(rail);
            });

            // Center Dashes
            for (let s = -SEGMENT_LENGTH / 2 + 2; s < SEGMENT_LENGTH / 2; s += 5.5) {
                const tie = new THREE.Mesh(new THREE.PlaneGeometry(0.4, 2.5), matWhitePuff);
                tie.rotation.x = -Math.PI / 2;
                tie.position.set(0, 0.03, s);
                segGroup.add(tie);
            }

            // 3. PILLOWY ROUNDED HILLS WITH WATERFALLS (EXACT IMAGE 1 MATCH!)
            [-22, 22].forEach(hx => {
                const hillGroup = new THREE.Group();
                hillGroup.position.set(hx + (Math.random() * 4 - 2), 0, (Math.random() - 0.5) * SEGMENT_LENGTH * 0.7);

                // Big Smooth Pillowy Hill Dome
                const hill = new THREE.Mesh(new THREE.SphereGeometry(6.5, 20, 16, 0, Math.PI * 2, 0, Math.PI / 2), matHillGreen);
                hill.scale.set(1.4, 0.9, 1.4);
                hill.castShadow = true;
                hillGroup.add(hill);

                // Light Mint "Icing" Cap on top of Hill (Image 1)
                const cap = new THREE.Mesh(new THREE.SphereGeometry(4.2, 16, 12, 0, Math.PI * 2, 0, Math.PI / 2), matHillCap);
                cap.position.y = 2.8;
                cap.scale.set(1.45, 0.7, 1.45);
                hillGroup.add(cap);

                // Waterfall Spilling down the hill (Image 1)
                if (Math.random() > 0.4) {
                    const waterfall = new THREE.Mesh(new THREE.CylinderGeometry(0.7, 1.1, 4.2, 12), matWater);
                    waterfall.position.set(0, 2.3, 3.8);
                    waterfall.rotation.x = 0.35;
                    hillGroup.add(waterfall);

                    // Cute Little Crystal Blue Pond at the bottom of Waterfall (Image 1)
                    const pond = new THREE.Mesh(new THREE.CylinderGeometry(2.4, 2.4, 0.1, 16), matWater);
                    pond.position.set(0, 0.04, 6.2);
                    hillGroup.add(pond);
                }

                segGroup.add(hillGroup);
            });

            // 4. ROUNDED CONE TREES & FLOWERS (IMAGE 1 MATCH)
            spawnChooChooFlora(segGroup, SEGMENT_LENGTH);

            scene.add(segGroup);
            roadSegments.push(segGroup);
        }

        // 5. CUTE HOT AIR BALLOON (EXACT IMAGE 1 MATCH!)
        buildHotAirBalloon();

        // 6. CUTE LITTLE BIPLANES & MARSHMALLOW CLOUDS (IMAGE 1 MATCH)
        buildCloudsAndPlanes();
    }

    // ROUND CONE TREES & CUTE FLOWER PATCHES (IMAGE 1)
    function spawnChooChooFlora(parentGroup, length) {
        const matTree = new THREE.MeshStandardMaterial({ color: 0x10B981, roughness: 0.6 });
        const matLightTree = new THREE.MeshStandardMaterial({ color: 0x34D399, roughness: 0.6 });
        const matTrunk = new THREE.MeshStandardMaterial({ color: 0x78350F, roughness: 0.9 });
        const matFlower = new THREE.MeshBasicMaterial({ color: 0xFDE047 });

        [-8.5, 8.5, -14, 14].forEach(sideX => {
            const flora = new THREE.Group();
            flora.position.set(sideX + (Math.random() * 3 - 1.5), 0, (Math.random() - 0.5) * length * 0.85);

            if (Math.random() > 0.3) {
                // Smooth rounded cone tree from Image 1
                const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.25, 0.3, 1.4, 12), matTrunk);
                trunk.position.y = 0.7;
                trunk.castShadow = true;
                flora.add(trunk);

                // Smooth round cone with rounded tip
                const foliage = new THREE.Mesh(new THREE.ConeGeometry(1.2, 3.2, 16), (Math.random() > 0.5 ? matTree : matLightTree));
                foliage.position.y = 2.4;
                foliage.castShadow = true;
                flora.add(foliage);
            } else {
                // Little Flower Sprig patch (Image 1)
                for (let f = 0; f < 3; f++) {
                    const fl = new THREE.Mesh(new THREE.SphereGeometry(0.22, 8, 8), matFlower);
                    fl.position.set((f - 1) * 0.4, 0.22, (Math.random() - 0.5) * 0.4);
                    flora.add(fl);
                }
            }

            parentGroup.add(flora);
        });
    }

    // HOT AIR BALLOON (IMAGE 1 MATCH: STRIPED BALLOON IN SKY)
    function buildHotAirBalloon() {
        hotAirBalloon = new THREE.Group();
        hotAirBalloon.position.set(-18, 22, -35);

        // Striped Balloon Envelope (Rainbow layers)
        const stripeColors = [0xF43F5E, 0xFBBF24, 0x38BDF8, 0x818CF8];
        stripeColors.forEach((col, idx) => {
            const slice = new THREE.Mesh(
                new THREE.SphereGeometry(3.2, 20, 8, 0, Math.PI * 2, (idx * Math.PI) / 6, Math.PI / 6),
                new THREE.MeshStandardMaterial({ color: col, roughness: 0.3 })
            );
            slice.scale.set(1.0, 1.25, 1.0);
            hotAirBalloon.add(slice);
        });

        // Little Woven Basket below
        const basket = new THREE.Mesh(new THREE.BoxGeometry(1.0, 0.8, 1.0), new THREE.MeshStandardMaterial({ color: 0x92400E, roughness: 0.8 }));
        basket.position.y = -3.8;
        hotAirBalloon.add(basket);

        // Suspension Ropes
        [-0.4, 0.4].forEach(bx => {
            const rope = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 1.8), new THREE.MeshBasicMaterial({ color: 0x78350F }));
            rope.position.set(bx, -2.8, 0);
            hotAirBalloon.add(rope);
        });

        scene.add(hotAirBalloon);
    }

    // CLOUDS & TOY AIRPLANE (IMAGE 1 MATCH)
    function buildCloudsAndPlanes() {
        // Fluffy Marshmallow Clouds
        const cloudMat = new THREE.MeshStandardMaterial({ color: 0xFFFFFF, roughness: 0.3, transparent: true, opacity: 0.95 });
        for (let c = 0; c < 10; c++) {
            const cGroup = new THREE.Group();
            cGroup.position.set((Math.random() - 0.5) * 80, 18 + Math.random() * 8, -c * 40);

            [[0,0,0], [1.4, -0.2, 0], [-1.4, -0.2, 0], [0.6, 0.4, 0.4], [-0.5, 0.3, -0.3]].forEach(cp => {
                const puff = new THREE.Mesh(new THREE.SphereGeometry(1.5, 16, 16), cloudMat);
                puff.position.set(...cp);
                cGroup.add(puff);
            });
            scene.add(cGroup);
        }

        // Cute Little Orange Biplane (Image 1 top right)
        planeMesh = new THREE.Group();
        planeMesh.position.set(15, 24, -45);
        const planeBody = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.4, 2.4, 12), new THREE.MeshStandardMaterial({ color: 0xFB923C }));
        planeBody.rotation.x = Math.PI / 2;
        planeMesh.add(planeBody);

        const wings = new THREE.Mesh(new THREE.BoxGeometry(3.6, 0.08, 0.7), new THREE.MeshStandardMaterial({ color: 0xFDE047 }));
        wings.position.set(0, 0.2, 0.2);
        planeMesh.add(wings);

        scene.add(planeMesh);
    }

    // CHECKPOINT FESTIVAL GATES (FESTIVE STATIONS ALONG TRACK)
    function buildCheckpointArches() {
        CHECKPOINTS.forEach((cp, idx) => {
            const archGroup = new THREE.Group();
            archGroup.position.set(0, 0, -cp.distance);

            // Cute Candy-Stripe Pillars
            const pillarMat = new THREE.MeshStandardMaterial({ color: idx === 5 ? 0x10B981 : 0xF59E0B, roughness: 0.3 });
            [-4.2, 4.2].forEach(px => {
                const pillar = new THREE.Mesh(new THREE.CylinderGeometry(0.35, 0.4, 5.4, 16), pillarMat);
                pillar.position.set(px, 2.7, 0);
                pillar.castShadow = true;
                archGroup.add(pillar);

                const topBall = new THREE.Mesh(new THREE.SphereGeometry(0.55, 16, 16), new THREE.MeshStandardMaterial({ color: 0xFDE047 }));
                topBall.position.set(px, 5.4, 0);
                archGroup.add(topBall);
            });

            // Overhead Rounded Arch Beam
            const beam = new THREE.Mesh(new THREE.CylinderGeometry(0.4, 0.4, 9.2, 16), new THREE.MeshStandardMaterial({ color: idx === 5 ? 0x059669 : 0xD97706 }));
            beam.rotation.z = Math.PI / 2;
            beam.position.set(0, 5.1, 0);
            archGroup.add(beam);

            // Cute Station Signboard
            const bCanvas = document.createElement('canvas');
            bCanvas.width = 512; bCanvas.height = 128;
            const bCtx = bCanvas.getContext('2d');
            bCtx.fillStyle = '#FFFFFF';
            bCtx.roundRect ? bCtx.roundRect(0, 0, 512, 128, 30) : bCtx.fillRect(0, 0, 512, 128);
            bCtx.fill();
            bCtx.lineWidth = 8;
            bCtx.strokeStyle = idx === 5 ? '#10B981' : '#F59E0B';
            bCtx.stroke();

            bCtx.fillStyle = idx === 5 ? '#047857' : '#B45309';
            bCtx.font = 'bold 36px Fredoka, sans-serif';
            bCtx.textAlign = 'center';
            bCtx.fillText(cp.badge + ': ' + cp.title.toUpperCase(), 256, 75);

            const bTex = new THREE.CanvasTexture(bCanvas);
            const bFace = new THREE.Mesh(new THREE.PlaneGeometry(8.2, 1.8), new THREE.MeshBasicMaterial({ map: bTex, transparent: true }));
            bFace.position.set(0, 5.1, 0.45);
            archGroup.add(bFace);

            // Floating 3D Balloons on both sides
            const balloonColors = [0xF43F5E, 0x38BDF8, 0xFBBF24];
            [-4.8, 4.8].forEach((bx, bIdx) => {
                const balloon = new THREE.Mesh(new THREE.SphereGeometry(0.65, 16, 16), new THREE.MeshStandardMaterial({ color: balloonColors[bIdx % 3] }));
                balloon.position.set(bx, 6.4, 0);
                balloon.scale.set(1.0, 1.25, 1.0);
                archGroup.add(balloon);
            });

            scene.add(archGroup);
            checkpointArches.push({ cp, group: archGroup });
        });
    }

    function onWindowResize() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    }

    function setupControlListeners() {
        // Keyboard support
        window.addEventListener('keydown', (e) => {
            if (e.code === 'KeyW' || e.code === 'ArrowUp') { keys.gas = true; isAutopilot = false; }
            if (e.code === 'KeyS' || e.code === 'ArrowDown') { keys.brake = true; isAutopilot = false; }
            if (e.code === 'KeyA' || e.code === 'ArrowLeft') { keys.left = true; isAutopilot = false; }
            if (e.code === 'KeyD' || e.code === 'ArrowRight') { keys.right = true; isAutopilot = false; }
            if (e.code === 'Space') {
                e.preventDefault();
                honkTruckHorn();
            }
        });

        window.addEventListener('keyup', (e) => {
            if (e.code === 'KeyW' || e.code === 'ArrowUp') keys.gas = false;
            if (e.code === 'KeyS' || e.code === 'ArrowDown') keys.brake = false;
            if (e.code === 'KeyA' || e.code === 'ArrowLeft') keys.left = false;
            if (e.code === 'KeyD' || e.code === 'ArrowRight') keys.right = false;
        });

        // 1. Direct Wheel / Scroll Interaction (Scrollytelling feel)
        window.addEventListener('wheel', (e) => {
            if (!isMissionStarted) return;
            initAudio();
            hideInteractionHint();
            // Scroll down: drive forward! Scroll up: brake/reverse
            if (e.deltaY > 0) {
                truckSpeed = Math.min(MAX_SPEED, Math.max(truckSpeed, 18) + Math.min(Math.abs(e.deltaY) * 0.16, 12));
            } else {
                truckSpeed = Math.max(-5, truckSpeed - Math.min(Math.abs(e.deltaY) * 0.16, 12));
            }
        }, { passive: true });

        // 2. Direct Touch / Pointer Drag & Swipe on 3D Viewport
        const container = document.getElementById('t6-canvas-container');
        if (!container) return;

        container.addEventListener('pointerdown', (e) => {
            if (e.target.closest('#t6-start-modal, #t6-checkpoint-modal, #t6-book-modal')) return;
            isPointerDown = true;
            pointerStartX = e.clientX;
            pointerStartY = e.clientY;
            pointerLastX = e.clientX;
            pointerLastY = e.clientY;
            hasDragged = false;
            initAudio();
        });

        window.addEventListener('pointermove', (e) => {
            if (!isPointerDown) return;
            const dx = e.clientX - pointerLastX;
            const dy = e.clientY - pointerLastY;
            const totalDist = Math.hypot(e.clientX - pointerStartX, e.clientY - pointerStartY);

            if (totalDist > 8) {
                hasDragged = true;
                hideInteractionHint();
            }

            // Steer truck horizontally across road lane
            truckX = Math.max(-2.6, Math.min(2.6, truckX + dx * 0.016));
            truckGroup.rotation.y = THREE.MathUtils.clamp(-dx * 0.03, -0.25, 0.25);
            truckGroup.rotation.z = THREE.MathUtils.clamp(-dx * 0.012, -0.09, 0.09);

            // Drag up: accelerate / gas! Drag down: brake!
            if (dy < -2) {
                truckSpeed = Math.min(MAX_SPEED, truckSpeed + Math.abs(dy) * 0.35);
            } else if (dy > 2) {
                truckSpeed = Math.max(-8, truckSpeed - dy * 0.45);
            }

            pointerLastX = e.clientX;
            pointerLastY = e.clientY;
        });

        window.addEventListener('pointerup', (e) => {
            if (!isPointerDown) return;
            isPointerDown = false;

            // Direct Click / Tap Raycaster on 3D elements!
            if (!hasDragged && isMissionStarted) {
                handleCanvasTap(e.clientX, e.clientY);
            }
        });
    }

    function handleCanvasTap(clientX, clientY) {
        mouseCoords.x = (clientX / window.innerWidth) * 2 - 1;
        mouseCoords.y = -(clientY / window.innerHeight) * 2 + 1;
        raycaster.setFromCamera(mouseCoords, camera);

        // A. Tap directly on 3D Truck: Horn + Hop Bounce!
        const truckHits = raycaster.intersectObjects(truckGroup.children, true);
        if (truckHits.length > 0) {
            honkTruckHorn();
            return;
        }

        // B. Tap on Hot Air Balloon
        if (hotAirBalloon) {
            const balloonHits = raycaster.intersectObjects(hotAirBalloon.children, true);
            if (balloonHits.length > 0) {
                hotAirBalloon.position.y += 2.5;
                if (typeof confetti === 'function') {
                    confetti({ particleCount: 50, spread: 70, origin: { x: 0.3, y: 0.3 } });
                }
                showToast("🎈 Balon udara menyambut gembira!");
                return;
            }
        }

        // C. Tap on Checkpoint Arches
        for (let i = 0; i < checkpointArches.length; i++) {
            const arch = checkpointArches[i];
            const hits = raycaster.intersectObjects(arch.group.children, true);
            if (hits.length > 0) {
                teleportToCheckpoint(i);
                return;
            }
        }

        // D. Tap on road ahead -> Speed boost rush!
        truckSpeed = Math.min(MAX_SPEED, Math.max(truckSpeed, 20) + 12);
        truckJumpVy = 2.0;
        showToast("💨 Truk melaju makin kencang!");
    }

    function hideInteractionHint() {
        const hint = document.getElementById('t6-interaction-hint');
        if (hint && !hint.classList.contains('opacity-0')) {
            hint.classList.add('opacity-0', 'pointer-events-none');
        }
    }

    function toggleAutopilot() {
        isAutopilot = !isAutopilot;
        const icon = document.getElementById('t6-autopilot-icon');
        const label = document.getElementById('t6-autopilot-label');
        const btn = document.getElementById('btn-autopilot-mini');

        if (isAutopilot) {
            if (icon) icon.textContent = '⏸️';
            if (label) label.textContent = 'Auto';
            if (btn) btn.classList.add('ring-2', 'ring-white', 'scale-105');
            showToast("🚀 Auto Cruise Aktif! Truk meluncur santai...");
        } else {
            if (icon) icon.textContent = '🚀';
            if (label) label.textContent = 'Manual';
            if (btn) btn.classList.remove('ring-2', 'ring-white', 'scale-105');
            showToast("🎮 Kendali Penuh: Geser/Scroll layar");
        }
    }

    // =========================================================
    // GAME LOOP: PHYSICS & 3/4 ISOMETRIC TOP-DOWN CAMERA
    // =========================================================
    function animate() {
        requestAnimationFrame(animate);

        const delta = Math.min(clock.getDelta(), 0.1);

        if (isMissionStarted) {
            updateVehiclePhysics(delta);
            updateRoadScenery();
            checkCheckpointCollisions();
            updateHUD();
        }

        // Subtle animation for hot air balloon & airplane
        if (hotAirBalloon) {
            hotAirBalloon.position.y = 22 + Math.sin(clock.getElapsedTime() * 1.5) * 1.2;
            hotAirBalloon.rotation.y = clock.getElapsedTime() * 0.1;
        }
        if (planeMesh) {
            planeMesh.position.x = 15 + Math.cos(clock.getElapsedTime() * 0.8) * 4;
            planeMesh.position.y = 24 + Math.sin(clock.getElapsedTime() * 1.2) * 1.5;
        }

        renderer.render(scene, camera);
    }

    function updateVehiclePhysics(delta) {
        // Truck Jump / Suspension bounce
        if (truckJumpY > 0 || truckJumpVy > 0) {
            truckJumpY += truckJumpVy * delta;
            truckJumpVy -= 22 * delta;
            if (truckJumpY <= 0) {
                truckJumpY = 0;
                truckJumpVy = 0;
            }
        }
        truckGroup.position.y = truckJumpY;

        if (isAutopilot) {
            truckSpeed = THREE.MathUtils.lerp(truckSpeed, 32, delta * 3);
            if (!isPointerDown) {
                truckX = THREE.MathUtils.lerp(truckX, 0, delta * 2);
                truckGroup.rotation.y = THREE.MathUtils.lerp(truckGroup.rotation.y, 0, delta * 6);
                truckGroup.rotation.z = THREE.MathUtils.lerp(truckGroup.rotation.z, 0, delta * 6);
            }
        } else {
            if (keys.gas) {
                truckSpeed = Math.min(truckSpeed + ACCEL * delta, MAX_SPEED);
            } else if (keys.brake) {
                truckSpeed = Math.max(truckSpeed - BRAKE_DECEL * delta, -10);
            } else if (!isPointerDown) {
                // Natural coasting
                if (truckSpeed > 18) truckSpeed = Math.max(18, truckSpeed - DRAG * delta);
                else if (truckSpeed < 0) truckSpeed = Math.min(0, truckSpeed + DRAG * delta);
            }

            if (keys.left) {
                truckX = Math.max(-2.5, truckX - STEER_SPEED * delta);
                truckGroup.rotation.y = THREE.MathUtils.lerp(truckGroup.rotation.y, 0.16, delta * 8);
                truckGroup.rotation.z = THREE.MathUtils.lerp(truckGroup.rotation.z, 0.06, delta * 8);
            } else if (keys.right) {
                truckX = Math.min(2.5, truckX + STEER_SPEED * delta);
                truckGroup.rotation.y = THREE.MathUtils.lerp(truckGroup.rotation.y, -0.16, delta * 8);
                truckGroup.rotation.z = THREE.MathUtils.lerp(truckGroup.rotation.z, -0.06, delta * 8);
            } else if (!isPointerDown) {
                truckGroup.rotation.y = THREE.MathUtils.lerp(truckGroup.rotation.y, 0, delta * 6);
                truckGroup.rotation.z = THREE.MathUtils.lerp(truckGroup.rotation.z, 0, delta * 6);
            }
        }

        const moveDist = (truckSpeed / 3.6) * delta;
        totalDistance += moveDist;

        truckGroup.position.x = truckX;
        truckGroup.position.z -= moveDist;

        // Subtle toy suspension rocking
        if (cabinMesh && Math.abs(truckSpeed) > 1) {
            const bounce = Math.sin(clock.getElapsedTime() * 15) * 0.03;
            cabinMesh.position.y = bounce;
        }

        // Spin Wheels
        const wheelRot = (truckSpeed / 3.6) * 3.5 * delta;
        wheels.forEach(w => {
            w.children.forEach(c => {
                c.rotation.y += wheelRot;
            });
        });

        // =====================================================
        // TAMPILAN DARI ATAS AGAK MIRING (TRUE 3/4 ISOMETRIC VIEW)
        // Offset (X: 8.5, Y: 11.5, Z: 12.0) looking down diagonally at truck!
        // =====================================================
        const targetCamX = truckGroup.position.x * 0.4 + 8.5;
        const targetCamY = 11.5;
        const targetCamZ = truckGroup.position.z + 12.0;
        camera.position.x = THREE.MathUtils.lerp(camera.position.x, targetCamX, delta * 4);
        camera.position.y = THREE.MathUtils.lerp(camera.position.y, targetCamY, delta * 4);
        camera.position.z = THREE.MathUtils.lerp(camera.position.z, targetCamZ, delta * 6);
        camera.lookAt(truckGroup.position.x * 0.4, 1.2 + truckJumpY * 0.5, truckGroup.position.z - 1.5);
    }

    function updateRoadScenery() {
        const SEGMENT_LENGTH = 32;
        const totalSpan = roadSegments.length * SEGMENT_LENGTH;

        roadSegments.forEach(seg => {
            if (seg.position.z > camera.position.z + 25) {
                seg.position.z -= totalSpan;
            }
        });
    }

    function checkCheckpointCollisions() {
        const truckZ = Math.abs(truckGroup.position.z);

        CHECKPOINTS.forEach((cp, idx) => {
            if (!cp.passed && truckZ >= cp.distance) {
                cp.passed = true;
                currentCheckpointIndex = idx;
                onReachCheckpoint(cp, idx);
            }
        });
    }

    function onReachCheckpoint(cp, idx) {
        playCheckpointChime();

        if (typeof confetti === 'function') {
            confetti({
                particleCount: idx === 5 ? 120 : 60,
                spread: 70,
                origin: { y: 0.55 }
            });
        }

        truckSpeed = 0;
        keys.gas = false;

        openCheckpointModal(cp, idx);
    }

    function updateHUD() {
        const speedHud = document.getElementById('t6-speed-hud');
        if (speedHud) {
            speedHud.textContent = Math.round(Math.abs(truckSpeed)) + ' KM/H';
        }

        const prog = Math.min(100, Math.max(5, (totalDistance / TOTAL_MISSION_LENGTH) * 100));
        const progBar = document.getElementById('t6-progress-bar');
        if (progBar) {
            progBar.style.width = prog + '%';
        }

        const cpStatus = document.getElementById('t6-checkpoint-status');
        if (cpStatus) {
            const nextCp = CHECKPOINTS.find(c => !c.passed) || CHECKPOINTS[CHECKPOINTS.length - 1];
            cpStatus.textContent = `${nextCp.badge}: ${nextCp.title}`;
        }
    }

