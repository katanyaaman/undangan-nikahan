        const matBlueBox = new THREE.MeshStandardMaterial({ color: 0x4F6EF7, roughness: 0.35 });   // Soft Toy Blue Box
        const matWhiteTrim = new THREE.MeshStandardMaterial({ color: 0xFAFAFA, roughness: 0.25 }); // White Roof & Frame
        const matDarkGrey = new THREE.MeshStandardMaterial({ color: 0x374151, roughness: 0.8 });   // Dark Grey Chassis & Fenders
        const matChrome = new THREE.MeshStandardMaterial({ color: 0xD1D5DB, metalness: 0.8, roughness: 0.2 }); // Silver Fuel Tanks & Rims
        const matGlass = new THREE.MeshStandardMaterial({ color: 0xC4B5A5, roughness: 0.2, metalness: 0.1 }); // Warm Tinted Glass (Image 2)
        const matTire = new THREE.MeshStandardMaterial({ color: 0x1F2937, roughness: 0.9 });      // Thick Black Rubber
