        const cabGroup = new THREE.Group();
        cabGroup.position.set(0, 1.7, 1.35);

        // Main Yellow Cab Body (Rounded box)
        cabinMesh = new THREE.Mesh(new THREE.BoxGeometry(2.2, 1.9, 2.0), matYellowCab);
        cabinMesh.castShadow = true;
        cabGroup.add(cabinMesh);

        // Curved Cab Roof Overhang (Image 2)
        const cabRoof = new THREE.Mesh(new THREE.BoxGeometry(2.24, 0.2, 1.9), matYellowCab);
        cabRoof.position.y = 1.0;
        cabGroup.add(cabRoof);

        // Front Curved Windshield (Warm Tint Glass matching Image 2)
        const windshield = new THREE.Mesh(new THREE.BoxGeometry(2.0, 0.95, 0.15), matGlass);
        windshield.position.set(0, 0.32, 1.02);
        windshield.rotation.x = -0.15;
        cabGroup.add(windshield);

        // Side Door Windows (Tinted glass with corner cut)
        [-1.11, 1.11].forEach(sideX => {
            const sideWin = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.75, 1.05), matGlass);
            sideWin.position.set(sideX, 0.35, 0.3);
