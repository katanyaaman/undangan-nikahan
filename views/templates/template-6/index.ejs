    <!-- ========================================================= -->
    <!-- 6. THREE.JS ENGINE: TOY TRUCK & MINIATURE DIORAMA WORLD -->
    <!-- ========================================================= -->
    <script>
    const WEDDING_DATA = {
        groom: "<%= fv(event?.groom_name, 'David Anderson') %>",
        bride: "<%= fv(event?.bride_name, 'Sarah Johnson') %>",
        dateLong: "<%= eventDateLong || 'Sabtu, 31 Desember 2025' %>",
        venue: "<%= venueName || 'Grand Ballroom Hotel' %>",
        address: "<%= venueAddress || 'Jl. Sudirman No. 123, Jakarta' %>",
        rsvpPath: "<%= rsvpPath %>",
        csrfToken: "<%= csrfToken %>"
    };

    let isMissionStarted = false;
    let isAutopilot = true; // Auto-cruise gently by default for smooth living diorama
    let truckSpeed = 0;
    const MAX_SPEED = 48;
    const ACCEL = 28;
    const BRAKE_DECEL = 38;
    const DRAG = 8;

    let truckX = 0;
    const STEER_SPEED = 7.0;

    let totalDistance = 0;
    const TOTAL_MISSION_LENGTH = 1100;

    // Interactive Gesture & Physics variables
    let truckJumpY = 0;
    let truckJumpVy = 0;
    let isPointerDown = false;
    let pointerStartX = 0;
    let pointerStartY = 0;
    let pointerLastX = 0;
    let pointerLastY = 0;
    let hasDragged = false;
    const raycaster = new THREE.Raycaster();
    const mouseCoords = new THREE.Vector2();

    const CHECKPOINTS = [
        { id: 0, distance: 25, title: "Briefing Misi", badge: "START", passed: false },
        { id: 1, distance: 200, title: "Mempelai Pengantin", badge: "POSKO 1", passed: false },
        { id: 2, distance: 420, title: "Jadwal & Lokasi Acara", badge: "POSKO 2", passed: false },
        { id: 3, distance: 650, title: "Galeri Foto Bahagia", badge: "POSKO 3", passed: false },
        { id: 4, distance: 880, title: "Titipan Kado Digital", badge: "POSKO 4", passed: false },
        { id: 5, distance: 1050, title: "Finish Line & RSVP", badge: "FINISH", passed: false }
    ];

    const keys = { gas: false, brake: false, left: false, right: false };

    let scene, camera, renderer;
    let truckGroup, cabinMesh, wheels = [];
    let hotAirBalloon, planeMesh;
    let roadSegments = [];
    let checkpointArches = [];
    let clock;

    // Web Audio Synthesizer
    let audioCtx = null;
    let bgmInterval = null;
    let isBgmPlaying = false;

    function initAudio() {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
    }

    function honkTruckHorn() {
        initAudio();
        truckJumpVy = 4.8; // Playful suspension leap
        try {
            const now = audioCtx.currentTime;
            [523.25, 659.25, 783.99].forEach((freq, idx) => {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(freq, now + idx * 0.06);
                gain.gain.setValueAtTime(0.14, now + idx * 0.06);
                gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.06 + 0.28);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start(now + idx * 0.06);
                osc.stop(now + idx * 0.06 + 0.28);
            });
            showToast("📯 Telolet! Truk MBG siap beraksi!");
        } catch(e) {}
    }

    function playCheckpointChime() {
        initAudio();
        try {
            const notes = [523.25, 659.25, 783.99, 1046.50];
            notes.forEach((freq, i) => {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime + i * 0.09);
                gain.gain.setValueAtTime(0.15, audioCtx.currentTime + i * 0.09);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + i * 0.09 + 0.35);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start(audioCtx.currentTime + i * 0.09);
                osc.stop(audioCtx.currentTime + i * 0.09 + 0.35);
            });
        } catch(e) {}
    }

    function toggleAudioBGM() {
        initAudio();
        isBgmPlaying = !isBgmPlaying;
        const icon = document.getElementById('t6-bgm-icon');
        const btn = document.getElementById('t6-audio-toggle');

        if (isBgmPlaying) {
            if (icon) icon.textContent = '🔊';
            if (btn) btn.classList.add('bg-amber-400');
            startBgmLoop();
            showToast("🎵 Musik Petualangan Dimulai!");
        } else {
            if (icon) icon.textContent = '🔇';
            if (btn) btn.classList.remove('bg-amber-400');
            stopBgmLoop();
            showToast("🔇 Musik BGM Dimatikan");
        }
    }

    function startBgmLoop() {
        stopBgmLoop();
        const notes = [
            523.25, 659.25, 783.99, 659.25, 523.25, 659.25,
            392.00, 493.88, 587.33, 493.88, 392.00, 493.88,
            440.00, 523.25, 659.25, 523.25, 440.00, 523.25,
            349.23, 440.00, 523.25, 440.00, 392.00, 523.25
        ];
        let step = 0;
        bgmInterval = setInterval(() => {
            if (!isBgmPlaying || !audioCtx) return;
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(notes[step % notes.length], audioCtx.currentTime);
                gain.gain.setValueAtTime(0.04, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.22);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.22);
                step++;
            } catch(e) {}
        }, 220);
    }

    function stopBgmLoop() {
        if (bgmInterval) {
            clearInterval(bgmInterval);
            bgmInterval = null;
        }
    }

    // =========================================================
    // 3D SCENE & TOY DIORAMA WORLD (IMAGE 1 & IMAGE 2 MATCH)
    // =========================================================
    function initThreeJS() {
        const container = document.getElementById('t6-canvas-container');
        clock = new THREE.Clock();

        // 1. Scene: Bright Pastel Sky & Diorama Fog
        scene = new THREE.Scene();
        scene.background = new THREE.Color(0xa7f3d0); // Warm mint pastel horizon
        scene.fog = new THREE.FogExp2(0xa7f3d0, 0.008);

        // 2. Camera: 3/4 ISOMETRIC TOP-DOWN DIORAMA PERSPECTIVE!
        // Looking down at a cute ~40-deg isometric angle like Image 1
        const aspect = window.innerWidth / window.innerHeight;
        camera = new THREE.PerspectiveCamera(38, aspect, 0.1, 1000);
        camera.position.set(9.0, 11.5, 12.0);
        camera.lookAt(0, 1.2, -1.5);

        // 3. Renderer
        renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        container.appendChild(renderer.domElement);

        // 4. Soft Sunny Toy Lighting
        const hemiLight = new THREE.HemisphereLight(0xffffff, 0x86efac, 0.95);
        scene.add(hemiLight);

        const dirLight = new THREE.DirectionalLight(0xfffbeb, 1.3);
        dirLight.position.set(20, 35, 18);
        dirLight.castShadow = true;
        dirLight.shadow.mapSize.width = 1024;
        dirLight.shadow.mapSize.height = 1024;
        scene.add(dirLight);

        // 5. Build Toy Box Truck (Image 2 Match: Yellow Cab + Blue Box)
        buildToyBoxTruck();

        // 6. Build Choo-Choo World Diorama (Image 1 Match: Mint grass, pillowy hills, waterfalls, balloon)
        buildDioramaWorld();

        // 7. Build Checkpoint Gates
        buildCheckpointArches();

        window.addEventListener('resize', onWindowResize, false);
        setupControlListeners();

        animate();
    }

    // =========================================================
    // EXACT MATCH TRUCK (IMAGE 2: YELLOW CAB + BLUE BOX TRUCK)
    // =========================================================
    function buildToyBoxTruck() {
        truckGroup = new THREE.Group();
        truckGroup.position.set(0, 0, 0);

