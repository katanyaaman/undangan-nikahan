<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title || 'WA Group Undangan - ' + fv(event?.groom_name, 'David') + ' & ' + fv(event?.bride_name, 'Sarah') %></title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400&family=Amiri:wght@400;700&display=swap" rel="stylesheet">

    <style>
        /* ========================================================= */
        /* STANDAR WHATSAPP GROUP RESMI: TYPOGRAPHY, WARNA & WALLPAPER */
        /* ========================================================= */
        html, body, #t7-chat-wrapper, .font-sans, p, span, div, h1, h2, h3, h4, h5, h6, strong, a, label, input, textarea, button, select {
            font-family: 'Roboto', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
        }

        body {
            background-color: #0c1317 !important;
            color: #111b21 !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow-x: hidden !important;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        @media (max-width: 640px) {
            body {
                background-color: #efeae2 !important;
            }
            .phone-container {
                max-width: 100% !important;
                border-left-width: 0 !important;
                border-right-width: 0 !important;
                box-shadow: none !important;
            }
        }

        .wa-arabic, .wa-arabic * {
            font-family: 'Amiri', 'Traditional Arabic', serif !important;
            font-size: 18px !important;
            line-height: 1.8 !important;
            letter-spacing: 0 !important;
            color: #111b21 !important;
        }

        /* Ukuran Smartphone Standar Indonesia (360px - 412px) */
        .phone-container {
            width: 100% !important;
            max-width: 412px !important;
            margin-left: auto !important;
            margin-right: auto !important;
        }

        /* Wallpaper Resmi WhatsApp (Doodle Asli Ringan WebP) - Tiled Alami Proporsional */
        .wa-bg-authentic {
            background-color: #efeae2 !important;
            background-image: url('/images/wa-background.webp') !important;
            background-repeat: repeat !important;
            background-size: 380px auto !important;
            background-position: top center !important;
            background-blend-mode: multiply !important;
            background-attachment: scroll !important;
        }

        /* Container Obrolan: Kunci 100vh penuh agar kolom ketikan selalu full di paling bawah */
        #t7-chat-wrapper {
            height: 100vh !important;
            height: 100dvh !important;
            min-height: 100vh !important;
            min-height: 100dvh !important;
            max-height: 100vh !important;
            max-height: 100dvh !important;
            display: flex !important;
            flex-direction: column !important;
            justify-content: space-between !important;
            overflow: hidden !important;
            position: relative !important;
        }

        /* Area stream pesan mengisi seluruh sisa ruang tengah */
        #t7-chat-main {
            flex: 1 1 0% !important;
            min-height: 0 !important;
            height: auto !important;
            overflow-y: auto !important;
            overscroll-behavior: contain !important;
            scroll-behavior: smooth !important;
        }
        #t7-chat-main > * {
            scroll-margin-top: 16px;
            scroll-margin-bottom: 16px;
        }

        /* Bagian ketikan selalu full di bagian paling bawah */
        #t7-bottom-bar {
            flex-shrink: 0 !important;
            margin-top: auto !important;
            width: 100% !important;
            position: relative !important;
            z-index: 40 !important;
        }

        #t7-sticker-drawer {
            flex-shrink: 0 !important;
            width: 100% !important;
        }

        /* Bubble Masuk WhatsApp Group (Putih Bersih - iOS Standar 16px Radius) */
        .wa-bubble-group {
            background-color: #ffffff !important;
            color: #111b21 !important;
            box-shadow: 0 1px 1px rgba(11, 20, 26, 0.08) !important;
            border-radius: 16px !important;
            border-top-left-radius: 4px !important;
            position: relative !important;
            font-size: 15px !important;
            line-height: 1.38 !important;
            letter-spacing: -0.01em !important;
            display: flow-root !important;
            max-width: 85% !important;
        }
        .wa-bubble-group.has-tail::before {
            content: "";
            position: absolute;
            top: 0;
            left: -6px;
            width: 8px;
            height: 12px;
            background-color: #ffffff;
            clip-path: polygon(100% 0, 0 0, 100% 100%);
        }

        /* Bubble Keluar Tamu Undangan (Hijau Muda Khas WA - iOS Standar 16px Radius) */
        .wa-bubble-out {
            background-color: #DCF8C6 !important;
            color: #111b21 !important;
            box-shadow: 0 1px 1px rgba(11, 20, 26, 0.08) !important;
            border-radius: 16px !important;
            border-top-right-radius: 4px !important;
            position: relative !important;
            font-size: 15px !important;
            line-height: 1.38 !important;
            letter-spacing: -0.01em !important;
            display: flow-root !important;
            max-width: 85% !important;
        }
        .wa-bubble-out.has-tail::before {
            content: "";
            position: absolute;
            top: 0;
            right: -6px;
            width: 8px;
            height: 12px;
            background-color: #DCF8C6;
            clip-path: polygon(0 0, 100% 0, 0 100%);
        }

        /* System Info Pill (Chip Abu-abu di Tengah) */
        .wa-system-chip {
            background-color: rgba(255, 255, 255, 0.88) !important;
            color: #54656f !important;
            box-shadow: 0 1px 1px rgba(11, 20, 26, 0.08) !important;
            border-radius: 8px !important;
            font-size: 11.5px !important;
            line-height: 1.35 !important;
            font-weight: 400 !important;
            text-align: center !important;
        }

        .wa-security-chip {
            background-color: #ffeecd !important;
            color: #54656f !important;
            box-shadow: 0 1px 1px rgba(11, 20, 26, 0.08) !important;
            border-radius: 8px !important;
            font-size: 11px !important;
            line-height: 1.35 !important;
            text-align: center !important;
        }

        /* Sender Name Color Tags in WA Group */
        .wa-sender-groom {
            color: #008069 !important; /* Hijau WhatsApp untuk Pria */
            font-weight: 700 !important;
            font-size: 12.5px !important;
        }
        .wa-sender-bride {
            color: #a855f7 !important; /* Ungu/Magenta untuk Wanita */
            font-weight: 700 !important;
            font-size: 12.5px !important;
        }
        .wa-sender-badge {
            font-size: 9.5px !important;
            font-weight: 600 !important;
            background-color: #e2e8f0;
            color: #475569;
            padding: 1px 5px;
            border-radius: 4px;
            margin-left: 4px;
            white-space: nowrap !important;
            flex-shrink: 0 !important;
        }

        /* Timestamp Metadata */
        .wa-msg-meta {
            float: right;
            margin-left: 8px;
            margin-top: 4px;
            margin-bottom: -2px;
            display: inline-flex;
            align-items: center;
            gap: 2.5px;
            user-select: none;
            white-space: nowrap;
        }
        .wa-time {
            font-size: 11px !important;
            color: #8696a0 !important;
            font-feature-settings: "tnum";
            font-variant-numeric: tabular-nums;
        }

        /* Inner Cards */
        .wa-inner-card {
            background-color: #f8f9fa !important;
            border: 1px solid rgba(0, 0, 0, 0.06) !important;
            border-radius: 12px !important;
        }

        /* WhatsApp Native Quoted Reply Box */
        .wa-reply-quote {
            background-color: rgba(0, 0, 0, 0.04) !important;
            border-left: 3.5px solid #a855f7 !important;
            border-radius: 6px !important;
            border-top-left-radius: 2px !important;
            border-bottom-left-radius: 2px !important;
            padding: 4px 8px !important;
            margin-bottom: 6px !important;
            margin-top: 3px !important;
            user-select: none;
            cursor: pointer;
            transition: background-color 0.15s ease;
        }
        .wa-reply-quote:hover {
            background-color: rgba(0, 0, 0, 0.06) !important;
        }
        .wa-reply-quote:active {
            background-color: rgba(0, 0, 0, 0.09) !important;
        }
        .wa-reply-quote-sender {
            font-size: 11.5px !important;
            font-weight: 700 !important;
            color: #a855f7 !important;
            line-height: 1.2 !important;
            margin-bottom: 2px !important;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .wa-reply-quote-text {
            font-size: 12px !important;
            color: #54656f !important;
            line-height: 1.3 !important;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Typing Dots Animation */
        .wa-typing-bubble {
            background-color: #ffffff !important;
            box-shadow: 0 1px 1px rgba(11, 20, 26, 0.08) !important;
            border-radius: 16px !important;
            border-top-left-radius: 4px !important;
            padding: 8px 14px !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 4px !important;
            position: relative !important;
        }
        .wa-typing-bubble.has-tail::before {
            content: "";
            position: absolute;
            top: 0;
            left: -6px;
            width: 8px;
            height: 12px;
            background-color: #ffffff;
            clip-path: polygon(100% 0, 0 0, 100% 100%);
        }
        .wa-typing-dot {
            width: 6px;
            height: 6px;
            background-color: #8696a0;
            border-radius: 50%;
            animation: waTypingBounce 1.3s infinite ease-in-out;
        }
        .wa-typing-dot:nth-child(2) { animation-delay: 0.18s; }
        .wa-typing-dot:nth-child(3) { animation-delay: 0.36s; }
        @keyframes waTypingBounce {
            0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
            30% { transform: translateY(-4px); opacity: 1; }
        }

        .chat-pop {
            animation: chatPop 0.28s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
        }
        @keyframes chatPop {
            0% { opacity: 0; transform: translateY(8px) scale(0.97); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* Tombol Pilihan Menu / Quick Reply Chips (Native WA Interactive Style) */
        .wa-action-btn {
            background-color: #ffffff !important;
            color: #111b21 !important;
            border: 1px solid rgba(0, 0, 0, 0.08) !important;
            border-radius: 18px !important;
            min-height: 44px !important;
            padding: 8px 14px !important;
            font-size: 13.5px !important;
            font-weight: 500 !important;
            line-height: 1.3 !important;
            text-align: center !important;
            overflow-wrap: anywhere !important;
            box-shadow: 0 1px 2px rgba(0,0,0,0.06) !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 6px !important;
            transition: all 0.15s ease !important;
            cursor: pointer !important;
        }
        .wa-action-btn > span {
            min-width: 0 !important;
            text-align: center !important;
            line-height: 1.3 !important;
        }
        .wa-action-btn:hover {
            background-color: #f7f7f8 !important;
            border-color: rgba(0, 0, 0, 0.12) !important;
        }
        .wa-action-btn:active, .wa-action-btn.active {
            background-color: #e7fce3 !important;
            border-color: #25d366 !important;
            color: #0b704c !important;
            font-weight: 600 !important;
        }

        /* Status Story Ring */
        .status-ring-pulse {
            animation: ringPulse 2.4s infinite ease-in-out;
        }
        @keyframes ringPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        /* Waveform Animation */
        @keyframes waveAnim {
            0%, 100% { height: 6px; }
            50% { height: 22px; }
        }
        .waveform-bar.playing {
            animation: waveAnim 0.9s ease-in-out infinite;
        }

        /* Hilangkan seluruh scrollbar bawaan browser agar seperti tampilan native smartphone */
        html, body, #t7-chat-main, #t7-chat-wrapper, * {
            -ms-overflow-style: none !important;
            scrollbar-width: none !important;
        }
        ::-webkit-scrollbar {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
        }
    </style>
</head>
<body id="t7-body" class="bg-[#0c1317] text-[#111b21] font-sans antialiased overflow-x-hidden select-none min-h-screen">

<!-- Audio Element Pernikahan -->
<audio id="t7-audio" loop preload="auto">
    <source src="/music/wedding-song.mp3" type="audio/mpeg">
    <source src="/music/wedding-song.wav" type="audio/wav">
</audio>

<!-- =================================================================== -->
<!-- 1. LOCKSCREEN NOTIFIKASI WA GROUP SMARTPHONE -->
<!-- =================================================================== -->
<div id="t7-lockscreen" class="fixed inset-0 z-50 flex items-center justify-center bg-[#0c1317] transition-all duration-700">
    <div class="phone-container h-full min-h-[100dvh] max-h-[100dvh] flex flex-col justify-between p-4 sm:p-6 bg-cover bg-center bg-gradient-to-b from-slate-950 via-slate-900 to-black text-white shadow-2xl relative border-x border-white/10 overflow-y-auto">
    
    <!-- iPhone Dynamic Island & Status Bar -->
    <div class="w-full flex items-center justify-between text-xs font-semibold px-2 text-slate-300">
        <span id="t7-clock-mini" class="font-mono">09:41</span>
        
        <!-- Dynamic Island -->
        <div class="h-7 w-28 bg-black/90 rounded-full border border-white/15 shadow-2xl flex items-center justify-between px-2.5 mx-auto">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <div class="flex space-x-0.5 items-center">
                <span class="w-1 h-2 bg-emerald-400 rounded-full animate-bounce"></span>
                <span class="w-1 h-3.5 bg-emerald-300 rounded-full animate-bounce" style="animation-delay: 150ms"></span>
                <span class="w-1 h-2 bg-emerald-400 rounded-full animate-bounce" style="animation-delay: 300ms"></span>
            </div>
            <span class="w-2.5 h-2.5 rounded-full bg-blue-500/80"></span>
        </div>

        <div class="flex items-center space-x-2">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zm6-4a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zm6-3a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"></path></svg>
            <div class="w-5 h-2.5 border border-slate-300 rounded-sm p-0.5 flex items-center">
                <div class="w-full h-full bg-emerald-400 rounded-2xs"></div>
            </div>
        </div>
    </div>

    <!-- Jam Besar Lockscreen -->
    <div class="text-center my-auto py-2">
        <h1 id="t7-lockscreen-time" class="text-6xl sm:text-7xl md:text-8xl font-extralight tracking-tight text-white/95">09:41</h1>
        <p id="t7-lockscreen-date" class="text-sm font-medium text-slate-300 mt-1">Minggu, 31 Desember</p>
    </div>

    <!-- KARTU NOTIFIKASI WA GROUP -->
    <div class="max-w-md w-full mx-auto space-y-4 shrink-0">
        <div id="t7-notif-card" onclick="openWAChatWithProcess(this)" class="cursor-pointer bg-white text-slate-900 rounded-2xl p-4 shadow-2xl border border-white/60 transform hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 shrink-0">
            <!-- Header Notifikasi -->
            <div class="flex items-center justify-between text-[11px] text-slate-500 mb-2 font-semibold">
                <div class="flex items-center space-x-1.5">
                    <div class="w-4 h-4 rounded-full bg-[#25D366] flex items-center justify-center text-white shadow-sm shrink-0">
                        <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z"/></svg>
                    </div>
                    <span class="tracking-wider uppercase font-bold text-emerald-800">WHATSAPP GROUP</span>
                </div>
                <span>Baru saja</span>
            </div>

            <!-- Isi Chat Masuk Alami Grup -->
            <div class="flex items-start space-x-3">
                <div class="relative w-12 h-12 rounded-full p-0.5 bg-gradient-to-tr from-emerald-400 via-teal-300 to-green-300 status-ring-pulse shrink-0 shadow aspect-square">
                    <img src="<%= bridePhoto || groomPhoto || '/images/demo/g-couple.svg' %>" alt="Grup" class="w-full h-full rounded-full object-cover aspect-square">
                    <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 bg-emerald-500 rounded-full border-2 border-white flex items-center justify-center text-[7px] text-white">👥</span>
                </div>
                <div class="flex-1 min-w-0">
                    <h2 class="text-sm font-bold text-slate-900 truncate">
                        💍 Road to Halal: <%= fv(event?.groom_name, 'David') %> & <%= fv(event?.bride_name, 'Sarah') %>
                    </h2>
                    <p class="text-xs text-slate-700 line-clamp-2 mt-0.5 font-medium leading-relaxed">
                        <strong class="text-emerald-700"><%= fv(event?.groom_name, 'David') %></strong> menambahkan Anda ke grup. "Izin invite bestie kita nih..."
                    </p>
                </div>
            </div>

            <!-- Tombol Buka Obrolan -->
            <div class="mt-3 pt-2.5 border-t border-slate-200 flex items-center justify-between text-xs text-emerald-700 font-bold">
                <span id="t7-notif-action-text" class="flex items-center space-x-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                    <span>Ketuk untuk Masuk ke Grup</span>
                </span>
                <span id="t7-notif-arrow" class="text-emerald-600 transition-transform">➔</span>
            </div>
        </div>

        <div class="text-center text-xs text-slate-400 flex items-center justify-center space-x-1.5 py-1">
            <svg class="w-4 h-4 animate-bounce text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>
            <span>Ketuk notifikasi untuk bergabung</span>
        </div>
    </div>
    </div>
</div>

<!-- =================================================================== -->
<!-- 2. WHATSAPP FULLSCREEN STATUS / STORY -->
<!-- =================================================================== -->
<div id="t7-story-modal" class="fixed inset-0 z-50 bg-[#0c1317] hidden items-center justify-center select-none">
    <div class="phone-container h-full min-h-[100dvh] max-h-[100dvh] flex flex-col justify-between text-white bg-black relative shadow-2xl border-x border-white/10 overflow-hidden">
    <div class="p-3 pt-4 flex space-x-1.5 z-20">
        <div class="flex-1 h-1 bg-white/30 rounded-full overflow-hidden"><div id="sb-0" class="h-full bg-white w-0 transition-all duration-100 ease-linear"></div></div>
        <div class="flex-1 h-1 bg-white/30 rounded-full overflow-hidden"><div id="sb-1" class="h-full bg-white w-0 transition-all duration-100 ease-linear"></div></div>
        <div class="flex-1 h-1 bg-white/30 rounded-full overflow-hidden"><div id="sb-2" class="h-full bg-white w-0 transition-all duration-100 ease-linear"></div></div>
    </div>

    <!-- Header Story WA -->
    <div class="flex items-center justify-between px-4 py-2 z-20">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-emerald-400 shadow shrink-0 aspect-square">
                <img src="<%= bridePhoto || groomPhoto || '/images/demo/g-couple.svg' %>" alt="Status" class="w-full h-full object-cover aspect-square">
            </div>
            <div>
                <h3 class="text-sm font-bold text-white"><%= fv(event?.groom_name, 'David') %> & <%= fv(event?.bride_name, 'Sarah') %></h3>
                <p id="t7-story-time" class="text-[11px] text-white/70">Hari ini, 09.30</p>
            </div>
        </div>
        <div class="flex items-center space-x-2">
            <span class="text-[10px] text-white/70 bg-white/10 px-2.5 py-0.5 rounded-full">Tahan untuk Jeda</span>
            <button onclick="closeWAStory()" aria-label="Tutup Story" class="w-9 h-9 rounded-full bg-black/50 flex items-center justify-center text-white hover:bg-black/80">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
    </div>

    <!-- Konten Foto & Sentuh Navigasi -->
    <div id="t7-story-viewport" class="relative flex-1 flex items-center justify-center overflow-hidden">
        <img id="t7-story-image" src="/images/demo/g-couple.svg" alt="Story" class="max-h-[75vh] w-auto max-w-full object-contain">
        <div class="absolute inset-y-0 left-0 w-1/3 z-10 cursor-pointer" onclick="prevWAStory()"></div>
        <div class="absolute inset-y-0 right-0 w-2/3 z-10 cursor-pointer" onclick="nextWAStory()"></div>
    </div>

    <!-- Caption & Quick Reply Emojis -->
    <div class="p-4 z-20 bg-gradient-to-t from-black/95 via-black/60 to-transparent space-y-3">
        <p id="t7-story-caption" class="text-sm font-medium text-white drop-shadow text-center">Our Journey Together 💕</p>
        
        <div class="flex items-center justify-center space-x-4 py-1">
            <button onclick="sendStoryReaction('❤️', event)" class="text-2xl transform active:scale-125 hover:scale-110 transition-transform">❤️</button>
