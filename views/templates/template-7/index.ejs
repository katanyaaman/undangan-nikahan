<!-- JAVASCRIPT LOGIC INTERAKTIF -->
<!-- =================================================================== -->
<script>
// Data Foto Story WhatsApp
const storyList = [
    { src: '/images/demo/g-couple.svg', caption: 'The Happy Couple 💕', time: 'Hari ini, 09.15' },
    { src: '/images/demo/g-rings.svg', caption: 'Counting Days to Forever 💍', time: 'Hari ini, 09.25' },
    { src: '/images/demo/g-mosque.svg', caption: 'Bismillah Menuju Hari Bahagia ✨', time: 'Hari ini, 09.30' }
];

let currentStoryIndex = 0;
let storyTimer = null;
let isStoryPaused = false;
let isAudioPlaying = false;
let synthAudioCtx = null;
let synthIntervalId = null;

// Sound effects generator
function playTone(freq, type = 'sine', duration = 0.15, vol = 0.05) {
    try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        const ctx = new AudioContext();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.setValueAtTime(vol, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + duration);
    } catch(e) {}
}

function playIncomingSound() {
    playTone(587.33, 'sine', 0.08, 0.06);
    setTimeout(() => playTone(880.00, 'sine', 0.18, 0.08), 80);
}

function playOutgoingSound() {
    playTone(783.99, 'sine', 0.06, 0.05);
    setTimeout(() => playTone(1046.50, 'sine', 0.12, 0.06), 60);
}

// Background melody synth fallback
function startFallbackSynthMusic() {
    if (synthIntervalId) return;
    try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        synthAudioCtx = new AudioContext();
        const notes = [440.00, 466.16, 440.00, 392.00, 369.99, 311.13, 369.99, 293.66];
        let noteIdx = 0;
        synthIntervalId = setInterval(() => {
            if (!isAudioPlaying || !synthAudioCtx) return;
            const osc = synthAudioCtx.createOscillator();
            const gain = synthAudioCtx.createGain();
            osc.type = 'triangle';
            osc.frequency.value = notes[noteIdx % notes.length];
            gain.gain.setValueAtTime(0.02, synthAudioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.0001, synthAudioCtx.currentTime + 0.9);
            osc.connect(gain);
            gain.connect(synthAudioCtx.destination);
            osc.start();
            osc.stop(synthAudioCtx.currentTime + 0.9);
            noteIdx++;
        }, 600);
    } catch(e) {}
}

function stopFallbackSynthMusic() {
    if (synthIntervalId) {
        clearInterval(synthIntervalId);
        synthIntervalId = null;
    }
}

// Toggle Audio Background Musik (Default: Muted)
function toggleAudio(forcePlay = null) {
    const audio = document.getElementById('t7-audio');
    const onIcon = document.getElementById('t7-music-on-icon');
    const offIcon = document.getElementById('t7-music-off-icon');

    const shouldPlay = (forcePlay !== null) ? forcePlay : !isAudioPlaying;

    if (shouldPlay) {
        if (audio) {
            audio.play().then(() => {
                isAudioPlaying = true;
                stopFallbackSynthMusic();
                if (onIcon) onIcon.classList.remove('hidden');
                if (offIcon) offIcon.classList.add('hidden');
            }).catch(() => {
                isAudioPlaying = true;
                startFallbackSynthMusic();
                if (onIcon) onIcon.classList.remove('hidden');
                if (offIcon) offIcon.classList.add('hidden');
            });
        }
    } else {
        if (audio) audio.pause();
        isAudioPlaying = false;
        stopFallbackSynthMusic();
        if (onIcon) onIcon.classList.add('hidden');
        if (offIcon) offIcon.classList.remove('hidden');
    }
}

// Buka obrolan dari notifikasi
function openWAChatWithProcess(cardEl) {
    const actionText = document.getElementById('t7-notif-action-text');
    const arrow = document.getElementById('t7-notif-arrow');
    
    if (actionText) actionText.innerHTML = '<span class="inline-block w-2.5 h-2.5 border-2 border-emerald-600 border-t-transparent rounded-full animate-spin"></span> <span>Bergabung ke grup...</span>';
    if (arrow) arrow.classList.add('translate-x-2');
    playIncomingSound();

    setTimeout(() => {
        const lock = document.getElementById('t7-lockscreen');
        const chat = document.getElementById('t7-chat-wrapper');

        if (lock) {
            lock.classList.add('-translate-y-full', 'opacity-0');
            setTimeout(() => {
                lock.style.display = 'none';
                if (chat) chat.classList.remove('hidden');
                const chatMain = document.getElementById('t7-chat-main');
                if (chatMain) chatMain.scrollTop = 0;
                window.scrollTo({ top: 0, behavior: 'instant' });
                startStaggeredGroupChat();
            }, 600);
        }
    }, 450);
}

function backToLockscreen() {
    const lock = document.getElementById('t7-lockscreen');
    const chat = document.getElementById('t7-chat-wrapper');
    if (lock && chat) {
        chat.classList.add('hidden');
        lock.style.display = 'flex';
        setTimeout(() => {
            lock.classList.remove('-translate-y-full', 'opacity-0');
        }, 20);
    }
}

// Menampilkan indikator mengetik sesuai pengirim
function showTypingFor(senderName, avatarSrc, targetAfterEl) {
    const typingBubble = document.getElementById('t7-typing-bubble');
    const hStatus = document.getElementById('t7-header-status');
    const typingAvatar = document.getElementById('t7-typing-avatar');

    if (hStatus) hStatus.textContent = `${senderName} sedang mengetik...`;
    if (typingAvatar && avatarSrc) typingAvatar.src = avatarSrc;

    if (typingBubble && targetAfterEl && targetAfterEl.parentNode) {
        targetAfterEl.after(typingBubble);
        typingBubble.classList.remove('hidden');
        const chatMain = document.getElementById('t7-chat-main');
        if (chatMain) {
            chatMain.scrollTo({ top: chatMain.scrollHeight, behavior: 'smooth' });
        }
    }
}

function hideTyping() {
    const typingBubble = document.getElementById('t7-typing-bubble');
    const hStatus = document.getElementById('t7-header-status');
    if (typingBubble) typingBubble.classList.add('hidden');
    if (hStatus) hStatus.textContent = "<%= fv(event?.groom_name, 'David') %>, <%= fv(event?.bride_name, 'Sarah') %>, Anda";
}

// Alur Obrolan Grup Bertahap Natural
function startStaggeredGroupChat() {
    const chatMain = document.getElementById('t7-chat-main');
    if (chatMain) chatMain.scrollTop = 0;

    const bridePhoto = "<%= bridePhoto || '/images/demo/bride.svg' %>";
    const groomPhoto = "<%= groomPhoto || '/images/demo/groom.svg' %>";

    const sysMsg1 = document.getElementById('t7-sys-msg-1');
    const step1 = document.getElementById('chat-step-1'); // Sarah
    const step2 = document.getElementById('chat-step-2'); // David
    const stepInvite = document.getElementById('chat-step-invite'); // Sys invite
    const step3 = document.getElementById('chat-step-3'); // Sarah salam
    const step4 = document.getElementById('chat-step-4'); // David sambut
    const stepVN = document.getElementById('chat-step-vn'); // VN
    const actionsHub = document.getElementById('chat-actions-hub');

    // 1. Sarah mengetik pesan pertama
    showTypingFor("<%= fv(event?.bride_name, 'Sarah') %>", bridePhoto, sysMsg1);

    setTimeout(() => {
        playIncomingSound();
        hideTyping();
        if (step1) step1.classList.remove('hidden');
        if (chatMain) chatMain.scrollTop = 0;

        // 2. David membalas pesan Sarah
        setTimeout(() => {
            showTypingFor("<%= fv(event?.groom_name, 'David') %>", groomPhoto, step1);

            setTimeout(() => {
                playIncomingSound();
                hideTyping();
                if (step2) step2.classList.remove('hidden');

                // 3. System message David menambahkan Tamu
                setTimeout(() => {
                    playIncomingSound();
                    if (stepInvite) stepInvite.classList.remove('hidden');

                    // 4. Sarah menyapa Tamu Undangan
                    setTimeout(() => {
                        showTypingFor("<%= fv(event?.bride_name, 'Sarah') %>", bridePhoto, stepInvite);

                        setTimeout(() => {
                            playIncomingSound();
                            hideTyping();
                            if (step3) step3.classList.remove('hidden');

                            // 5. David menyambut Tamu
                            setTimeout(() => {
                                showTypingFor("<%= fv(event?.groom_name, 'David') %>", groomPhoto, step3);

                                setTimeout(() => {
                                    playIncomingSound();
                                    hideTyping();
                                    if (step4) step4.classList.remove('hidden');

                                    // 6. Voice note & Menu Pilihan
                                    setTimeout(() => {
                                        playIncomingSound();
                                        if (stepVN) stepVN.classList.remove('hidden');
                                        if (actionsHub) actionsHub.classList.remove('hidden');
                                        if (chatMain) chatMain.scrollTo({ top: chatMain.scrollHeight, behavior: 'smooth' });
                                    }, 1500);

                                }, 2200);
                            }, 1200);

                        }, 2400);
                    }, 1000);

                }, 1000);

            }, 2000);
        }, 1200);

    }, 1800);
}

// Buka rincian satu persatu secara smooth
function revealSectionSmooth(sectionId, btnEl, labelText) {
    const targetEl = document.getElementById(sectionId);
    if (!targetEl) return;

    if (btnEl) {
        btnEl.classList.add('active');
        btnEl.innerHTML = '<span class="inline-block w-2.5 h-2.5 border-2 border-emerald-600 border-t-transparent rounded-full animate-spin"></span> <span>Memuat...</span>';
    }

    const typingBubble = document.getElementById('t7-typing-bubble');
    const chatMain = document.getElementById('t7-chat-main');
    if (typingBubble && chatMain) {
        chatMain.appendChild(typingBubble);
        typingBubble.classList.remove('hidden');
        chatMain.scrollTo({ top: chatMain.scrollHeight, behavior: 'smooth' });
    }

    setTimeout(() => {
        playIncomingSound();
        if (typingBubble && typingBubble.parentNode) {
            typingBubble.before(targetEl);
            typingBubble.classList.add('hidden');
        }
        targetEl.classList.remove('hidden');
        if (btnEl) btnEl.innerHTML = `<span>✓ ${labelText}</span>`;

        const outBox = document.getElementById('t7-outgoing-bubbles');
        if (chatMain && outBox) {
            chatMain.appendChild(outBox);
        }

        setTimeout(() => {
            if (chatMain) chatMain.scrollTo({ top: chatMain.scrollHeight, behavior: 'smooth' });
        }, 60);
    }, 700);
}

// Buka semua bagian langsung secara smooth
function revealAllSectionsSmooth(btnEl) {
    if (btnEl) {
        btnEl.innerHTML = '<span class="inline-block w-2.5 h-2.5 border-2 border-emerald-600 border-t-transparent rounded-full animate-spin"></span> <span>Memuat seluruh rincian...</span>';
    }

    const typingBubble = document.getElementById('t7-typing-bubble');
    const chatMain = document.getElementById('t7-chat-main');
    if (typingBubble && chatMain) {
        chatMain.appendChild(typingBubble);
        typingBubble.classList.remove('hidden');
        chatMain.scrollTo({ top: chatMain.scrollHeight, behavior: 'smooth' });
    }

    const ids = ['t7-couple-bubble', 't7-event-bubble', 't7-gallery-bubble', 't7-gift-bubble', 't7-rsvp-bubble', 't7-wishes-section'];

    setTimeout(() => {
        ids.forEach(id => {
            const el = document.getElementById(id);
            if (el && typingBubble && typingBubble.parentNode) {
                typingBubble.before(el);
                el.classList.remove('hidden');
            }
        });

        if (typingBubble) typingBubble.classList.add('hidden');
        if (btnEl) btnEl.innerHTML = '<span>✓ Seluruh Rincian Terbuka</span>';
        playIncomingSound();

        const outBox = document.getElementById('t7-outgoing-bubbles');
        if (chatMain && outBox) {
            chatMain.appendChild(outBox);
        }

        setTimeout(() => {
            const firstRevealed = document.getElementById('t7-couple-bubble') || document.getElementById('t7-event-bubble');
            if (firstRevealed && chatMain) {
                const targetTop = Math.max(0, firstRevealed.offsetTop - 70);
                chatMain.scrollTo({ top: targetTop, behavior: 'smooth' });
            }
        }, 80);
    }, 700);
}

// Kirim Pesan Cepat / Balasan Bestie di Grup
function sendQuickWish() {
    const input = document.getElementById('t7-quick-input');
    if (!input || !input.value.trim()) return;
    const text = input.value.trim();
    input.value = '';

    appendGuestOutgoingBubble(text);
}

function sendWASticker(stickerText) {
    toggleStickerDrawer(false);
    appendGuestOutgoingBubble(stickerText);
}

function appendGuestOutgoingBubble(text) {
    playOutgoingSound();
    const outBox = document.getElementById('t7-outgoing-bubbles');
    const chatMain = document.getElementById('t7-chat-main');
    if (!outBox) return;

    const guestName = document.querySelector('.t7-guest-name')?.textContent || 'Tamu Undangan';
    const nowTime = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }).replace(':', '.');

    const bubbleEl = document.createElement('div');
    bubbleEl.className = 'flex justify-end max-w-[88%] sm:max-w-[78%] ml-auto chat-pop';
    bubbleEl.innerHTML = `
        <div class="wa-bubble-out has-tail px-3.5 py-2 text-xs rounded-xl shadow-xs">
            <p class="leading-relaxed text-[#111b21]">${text}</p>
            <div class="wa-msg-meta">
                <span class="wa-time">${nowTime}</span>
                <span class="text-blue-500 font-bold text-[10px]">✓✓</span>
            </div>
        </div>
    `;

    outBox.appendChild(bubbleEl);
    if (chatMain) {
        setTimeout(() => {
            chatMain.scrollTo({ top: chatMain.scrollHeight, behavior: 'smooth' });
        }, 50);
    }

    // Balasan Otomatis Natural dari Pengantin di Grup
    setTimeout(() => {
        const bridePhoto = "<%= bridePhoto || '/images/demo/bride.svg' %>";
        showTypingFor("<%= fv(event?.bride_name, 'Sarah') %>", bridePhoto, bubbleEl);

        setTimeout(() => {
            playIncomingSound();
            hideTyping();

            const replyBubble = document.createElement('div');
            replyBubble.className = 'flex items-start space-x-2 max-w-[88%] sm:max-w-[78%] chat-pop mt-2';
            replyBubble.innerHTML = `
                <img src="${bridePhoto}" alt="Sarah" class="w-7 h-7 rounded-full object-cover shrink-0 mt-1 aspect-square bg-slate-200">
                <div class="wa-bubble-group has-tail px-3 py-2 text-xs rounded-xl shadow-xs">
                    <div class="flex items-center space-x-1 mb-0.5">
                        <span class="wa-sender-bride"><%= fv(event?.bride_name, 'Sarah') %> 💕</span>
                        <span class="wa-sender-badge">Admin</span>
                    </div>
                    <p class="leading-relaxed text-[#111b21]">Makasih banyak yaa bestie ucapan & doanyaa! Sampai jumpa di hari bahagia kita nanti yaa 🥰🎉</p>
                    <div class="wa-msg-meta"><span class="wa-time">${nowTime}</span></div>
                </div>
            `;
            outBox.appendChild(replyBubble);
            if (chatMain) chatMain.scrollTo({ top: chatMain.scrollHeight, behavior: 'smooth' });
        }, 1800);
    }, 1200);
}

function toggleStickerDrawer(force) {
    const drawer = document.getElementById('t7-sticker-drawer');
    if (!drawer) return;
    if (typeof force === 'boolean') {
        if (force) drawer.classList.remove('hidden');
        else drawer.classList.add('hidden');
    } else {
        drawer.classList.toggle('hidden');
    }
}

// Modal Info Grup
function openGroupInfo() {
    const m = document.getElementById('t7-group-info-modal');
    if (m) m.classList.remove('hidden'), m.classList.add('flex');
}
function closeGroupInfo() {
    const m = document.getElementById('t7-group-info-modal');
    if (m) m.classList.add('hidden'), m.classList.remove('flex');
}

// Modal QRIS
function openQRISModal() {
    const m = document.getElementById('t7-qris-modal');
    if (m) m.classList.remove('hidden'), m.classList.add('flex');
}
function closeQRISModal() {
    const m = document.getElementById('t7-qris-modal');
    if (m) m.classList.add('hidden'), m.classList.remove('flex');
}

// Modal RSVP
function openRSVPDialog(attStatus) {
    const attField = document.getElementById('t7-form-att');
    if (attField) attField.value = attStatus;
    const m = document.getElementById('t7-rsvp-modal');
    if (m) m.classList.remove('hidden'), m.classList.add('flex');
}
function closeRSVPDialog() {
    const m = document.getElementById('t7-rsvp-modal');
    if (m) m.classList.add('hidden'), m.classList.remove('flex');
}

// Copy to clipboard
function copyT7(elementId, btn) {
    const textEl = document.getElementById(elementId);
    if (!textEl) return;
    navigator.clipboard.writeText(textEl.textContent.trim()).then(() => {
        showT7Toast('Tersalin ke clipboard!');
        if (btn) {
            const org = btn.textContent;
            btn.textContent = '✓ Disalin';
            setTimeout(() => btn.textContent = org, 1500);
        }
    });
}

function showT7Toast(msg) {
    const toast = document.getElementById('t7-toast');
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.remove('opacity-0', '-translate-y-4');
    toast.classList.add('opacity-100', 'translate-y-0');
    setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', '-translate-y-4');
    }, 2500);
}

// Status / Story Modal
function openWAStory(index = 0) {
    const m = document.getElementById('t7-story-modal');
    if (!m) return;
    m.classList.remove('hidden');
    m.classList.add('flex');
    currentStoryIndex = index;
    showStorySlide(currentStoryIndex);
}

function closeWAStory() {
    const m = document.getElementById('t7-story-modal');
    if (m) {
        m.classList.add('hidden');
        m.classList.remove('flex');
    }
    if (storyTimer) clearInterval(storyTimer);
}

function showStorySlide(index) {
    if (storyTimer) clearInterval(storyTimer);
    const item = storyList[index % storyList.length];
    const imgEl = document.getElementById('t7-story-image');
    const capEl = document.getElementById('t7-story-caption');
    const timeEl = document.getElementById('t7-story-time');

    if (imgEl) imgEl.src = item.src;
    if (capEl) capEl.textContent = item.caption;
    if (timeEl) timeEl.textContent = item.time;

    [0, 1, 2].forEach(i => {
        const bar = document.getElementById(`sb-${i}`);
        if (!bar) return;
        if (i < index) bar.style.width = '100%';
        else if (i === index) bar.style.width = '0%';
        else bar.style.width = '0%';
    });

    let progress = 0;
    const currentBar = document.getElementById(`sb-${index}`);
    storyTimer = setInterval(() => {
        if (isStoryPaused) return;
        progress += 2;
        if (currentBar) currentBar.style.width = `${progress}%`;
        if (progress >= 100) {
            clearInterval(storyTimer);
            if (index + 1 < storyList.length) {
                showStorySlide(index + 1);
            } else {
                closeWAStory();
            }
        }
    }, 100);
}

function prevWAStory() {
    if (currentStoryIndex > 0) {
        currentStoryIndex--;
        showStorySlide(currentStoryIndex);
    }
}

function nextWAStory() {
    if (currentStoryIndex + 1 < storyList.length) {
        currentStoryIndex++;
        showStorySlide(currentStoryIndex);
    } else {
        closeWAStory();
    }
}

function sendStoryReaction(emoji) {
    showT7Toast(`Reaksi ${emoji} terkirim ke pengantin!`);
    playOutgoingSound();
}

function sendStoryReply() {
    const inp = document.getElementById('t7-story-reply-input');
    if (!inp || !inp.value.trim()) return;
    const txt = inp.value.trim();
    inp.value = '';
    closeWAStory();
    appendGuestOutgoingBubble(txt);
}

// Voice Note: ucapan pengantin bersuara Indonesia
let vnAudioTimer = null;
let vnPlaying = false;
let vnElapsedSec = 0;
function fmtVNTime(sec) {
    const m = String(Math.floor(sec / 60)).padStart(2, '0');
    const s = String(Math.floor(sec % 60)).padStart(2, '0');
    return `${m}:${s}`;
}
function setVNPlayingUI(playing) {
    const playIcon = document.getElementById('t7-vn-play-icon');
    const pauseIcon = document.getElementById('t7-vn-pause-icon');
    const bars = document.querySelectorAll('#chat-step-vn .waveform-bar');
    if (playIcon) playIcon.classList.toggle('hidden', playing);
    if (pauseIcon) pauseIcon.classList.toggle('hidden', !playing);
    bars.forEach((b, i) => {
        b.classList.toggle('playing', playing);
        b.style.animationDelay = playing ? `${(i % 5) * 0.12}s` : '';
    });
}
function pickIDVoice() {
    try {
        const vs = window.speechSynthesis.getVoices() || [];
        return vs.find((v) => /^id([-_]|$)/i.test(v.lang || '')) || null;
    } catch (e) { return null; }
}
function vnGreetingText() {
    const gEl = document.querySelector('.t7-guest-name');
    const guest = ((gEl ? gEl.textContent : '') || 'Tamu Undangan').trim().replace(/["<>]/g, '') || 'Tamu Undangan';
    const bride = "<%= fv(event?.bride_name, 'Sarah') %>".replace(/["<>]/g, '');
    const groom = "<%= fv(event?.groom_name, 'David') %>".replace(/["<>]/g, '');
    return `Halo ${guest}! Aku ${bride}, dan aku ${groom}. Makasih banyak sudah gabung ke grup rahasia kita. Kita punya kabar bahagia banget: kita, mau nikah! Simak sampai habis ya, cek tanggal dan lokasinya, terus konfirmasi kehadiran kamu. Sampai ketemu di hari bahagia!`;
}
function startVNTick() {
    const timeEl = document.getElementById('t7-vn-time');
    if (vnAudioTimer) clearInterval(vnAudioTimer);
    vnAudioTimer = setInterval(() => {
        vnElapsedSec += 0.5;
        if (timeEl) timeEl.textContent = fmtVNTime(vnElapsedSec);
    }, 500);
}
function stopVNTick() {
    if (vnAudioTimer) clearInterval(vnAudioTimer);
    vnAudioTimer = null;
}
function stopVNSpeech() {
    try { window.speechSynthesis.cancel(); } catch (e) {}
}
function toggleVNAudio() {
    if (!('speechSynthesis' in window)) {
        if (!vnPlaying) {
            vnPlaying = true;
            vnElapsedSec = 0;
            setVNPlayingUI(true);
            toggleAudio(true);
            startVNTick();
        } else {
            vnPlaying = false;
            setVNPlayingUI(false);
            toggleAudio(false);
            stopVNTick();
        }
        return;
    }
    try { window.speechSynthesis.getVoices(); } catch (e) {}
    if (!vnPlaying) {
        if (typeof isAudioPlaying !== 'undefined' && isAudioPlaying) toggleAudio(false);
        stopVNSpeech();
        const u = new SpeechSynthesisUtterance(vnGreetingText());
        u.lang = 'id-ID';
        u.rate = 0.98;
        u.pitch = 1;
        const voice = pickIDVoice();
        if (voice) u.voice = voice;
        vnPlaying = true;
        vnElapsedSec = 0;
        setVNPlayingUI(true);
        const timeEl = document.getElementById('t7-vn-time');
        if (timeEl) timeEl.textContent = '00:00';
        startVNTick();
        u.onend = () => { vnPlaying = false; setVNPlayingUI(false); stopVNTick(); };
        u.onerror = () => { vnPlaying = false; setVNPlayingUI(false); stopVNTick(); };
        window.speechSynthesis.speak(u);
    } else {
        stopVNSpeech();
        vnPlaying = false;
        setVNPlayingUI(false);
        stopVNTick();
    }
}

// Countdown Timer Acara
function initCountdown() {
    const targetDateStr = "<%= event?.event_date || '2025-12-31 19:00:00' %>";
    const target = new Date(targetDateStr.replace(/-/g, '/')).getTime();

    function update() {
        const now = Date.now();
        const diff = target - now;

        const dEl = document.getElementById('t7-d');
        const hEl = document.getElementById('t7-h');
        const mEl = document.getElementById('t7-m');
        const sEl = document.getElementById('t7-s');

        if (diff <= 0) {
            if (dEl) dEl.textContent = '00';
            if (hEl) hEl.textContent = '00';
            if (mEl) mEl.textContent = '00';
            if (sEl) sEl.textContent = '00';
            return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        if (dEl) dEl.textContent = String(days).padStart(2, '0');
        if (hEl) hEl.textContent = String(hours).padStart(2, '0');
        if (mEl) mEl.textContent = String(minutes).padStart(2, '0');
        if (sEl) sEl.textContent = String(seconds).padStart(2, '0');
    }

    update();
    setInterval(update, 1000);
}

// Handle Form RSVP Submit
document.addEventListener('DOMContentLoaded', () => {
    initCountdown();

    const rsvpForm = document.getElementById('t7-rsvp-form');
    if (rsvpForm) {
        rsvpForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = document.getElementById('t7-form-btn');
            if (btn) {
                btn.disabled = true;
                btn.textContent = 'Mengirimkan konfirmasi...';
            }

            const fd = new FormData(this);
            const data = Object.fromEntries(fd.entries());

            try {
                const res = await fetch('<%= rsvpPath %>', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': data._csrf
                    },
                    body: JSON.stringify(data)
                });
                const result = await res.json();

                if (res.ok) {
                    playIncomingSound();
                    closeRSVPDialog();
                    showT7Toast('🎉 Konfirmasi RSVP berhasil tersimpan!');

                    // Update counter di polling
                    const attStat = document.getElementById('t7-attending-stat');
                    if (attStat && data.attendance === 'hadir') {
                        const current = parseInt(attStat.textContent) || 0;
                        attStat.textContent = `${current + 1} Tamu`;
                    }

                    // Tampilkan balasan langsung di obrolan grup
                    const wishText = data.message ? `"${data.message}" (${data.attendance === 'hadir' ? 'Insya Allah Hadir' : 'Berhalangan Hadir'})` : `Saya konfirmasi: ${data.attendance === 'hadir' ? 'Insya Allah Hadir' : 'Berhalangan Hadir'}`;
                    appendGuestOutgoingBubble(wishText);
                } else {
                    alert('Gagal mengirim RSVP: ' + (result.message || 'Terjadi kendala'));
                }
            } catch(err) {
                alert('Gagal mengirim RSVP. Pastikan koneksi internet stabil.');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.textContent = 'Kirim Konfirmasi Balasan';
                }
            }
        });
    }

    // Input Enter handler
    const quickInput = document.getElementById('t7-quick-input');
    if (quickInput) {
        quickInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                sendQuickWish();
            }
        });
    }
});
</script>
</body>
