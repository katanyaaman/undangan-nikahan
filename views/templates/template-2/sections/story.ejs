<!-- Love Story Timeline Section - Classic Romantic -->
<section id="story" class="relative py-20 bg-gradient-to-b from-white via-rose-50/50 to-white overflow-hidden">
    <div class="relative z-10 container mx-auto px-4 max-w-4xl">
        <div class="text-center mb-16">
            <span class="inline-block text-xs uppercase tracking-[0.25em] text-rose-600 font-semibold mb-2">Our Journey</span>
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-slate-800 mb-4">
                Kisah Cinta Kami
            </h2>
            <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-rose-400 to-transparent mx-auto mb-4"></div>
            <p class="text-slate-600 max-w-xl mx-auto text-sm sm:text-base leading-relaxed">
                Setiap detik perjalanan yang mempertemukan dan menyatukan dua hati dalam satu ikatan janji suci.
            </p>
        </div>

        <!-- Vertical Timeline Ribbon -->
        <div class="relative max-w-2xl mx-auto pl-6 sm:pl-0">
            <!-- Timeline Center Line -->
            <div class="absolute left-6 sm:left-1/2 top-4 bottom-4 -translate-x-1/2 w-0.5 bg-rose-200"></div>

            <div class="space-y-10">
                <!-- Milestone 1 -->
                <div class="relative sm:flex sm:items-center">
                    <div class="sm:w-1/2 sm:pr-8 sm:text-right pl-6 sm:pl-0">
                        <div class="bg-white rounded-2xl p-6 shadow-md border border-rose-100 hover:shadow-lg transition-all">
                            <span class="inline-block text-xs font-mono font-bold text-rose-600 uppercase tracking-wider mb-1">Awal Pertemuan</span>
                            <h3 class="text-lg font-serif font-bold text-slate-850 mb-2">Pertama Kali Bersua</h3>
                            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                                Sebuah pertemuan sederhana yang ditakdirkan Tuhan, mengawali perbincangan hangat dan kecocokan hati yang mendalam.
                            </p>
                        </div>
                    </div>
                    <!-- Center Node -->
                    <div class="absolute left-6 sm:left-1/2 top-6 sm:top-1/2 -translate-x-1/2 -translate-y-1/2 w-5 h-5 rounded-full bg-rose-500 border-4 border-white shadow-md"></div>
                    <div class="hidden sm:block sm:w-1/2 sm:pl-8"></div>
                </div>

                <!-- Milestone 2 -->
                <div class="relative sm:flex sm:items-center">
                    <div class="hidden sm:block sm:w-1/2 sm:pr-8"></div>
                    <!-- Center Node -->
                    <div class="absolute left-6 sm:left-1/2 top-6 sm:top-1/2 -translate-x-1/2 -translate-y-1/2 w-5 h-5 rounded-full bg-pink-500 border-4 border-white shadow-md"></div>
                    <div class="sm:w-1/2 sm:pl-8 pl-6 sm:pl-0">
                        <div class="bg-white rounded-2xl p-6 shadow-md border border-rose-100 hover:shadow-lg transition-all">
                            <span class="inline-block text-xs font-mono font-bold text-pink-600 uppercase tracking-wider mb-1">Komitmen Hati</span>
                            <h3 class="text-lg font-serif font-bold text-slate-850 mb-2">Menjalin Hubungan Serius</h3>
                            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                                Melewati berbagai suka dan duka bersama, belajar saling memahami, mendukung impian satu sama lain, dan bertumbuh bersama.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Milestone 3 -->
                <div class="relative sm:flex sm:items-center">
                    <div class="sm:w-1/2 sm:pr-8 sm:text-right pl-6 sm:pl-0">
                        <div class="bg-white rounded-2xl p-6 shadow-md border border-rose-100 hover:shadow-lg transition-all">
                            <span class="inline-block text-xs font-mono font-bold text-rose-700 uppercase tracking-wider mb-1">Pertunangan</span>
                            <h3 class="text-lg font-serif font-bold text-slate-850 mb-2">Restu Kedua Keluarga</h3>
                            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                                Dengan restu dan doa tulus orang tua, kami melangkah menuju jenjang yang lebih suci untuk menyempurnakan ibadah pernikahan.
                            </p>
                        </div>
                    </div>
                    <!-- Center Node -->
                    <div class="absolute left-6 sm:left-1/2 top-6 sm:top-1/2 -translate-x-1/2 -translate-y-1/2 w-5 h-5 rounded-full bg-rose-600 border-4 border-white shadow-md"></div>
                    <div class="hidden sm:block sm:w-1/2 sm:pl-8"></div>
                </div>
            </div>
        </div>
    </div>
</section>
