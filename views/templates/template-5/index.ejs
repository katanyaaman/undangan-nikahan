<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title || 'WhatsApp Undangan - ' + fv(event?.groom_name, 'David') + ' & ' + fv(event?.bride_name, 'Sarah') %></title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400&family=Amiri:wght@400;700&display=swap" rel="stylesheet">

    <style>
        /* ========================================================= */
        /* STANDAR WHATSAPP RESMI: TYPOGRAPHY ROBOTO, WARNA & WALLPAPER */
        /* ========================================================= */
        html, body, #t5-chat-wrapper, .font-sans, p, span, div, h1, h2, h3, h4, h5, h6, strong, a, label, input, textarea, button, select {
            font-family: 'Roboto', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
        }

        body {
            background-color: #efeae2 !important;
            color: #111b21 !important;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .wa-arabic, .wa-arabic * {
            font-family: 'Amiri', 'Traditional Arabic', serif !important;
            font-size: 18px !important;
            line-height: 1.8 !important;
            letter-spacing: 0 !important;
            color: #111b21 !important;
        }

        /* Wallpaper Resmi WhatsApp (Doodle Asli Ringan WebP) - Full Terus Tanpa Terpotong */
        .wa-bg-authentic {
            background-color: #efeae2 !important;
            background-image: url('/images/wa-background.webp') !important;
            background-repeat: no-repeat !important;
            background-size: 100% 100% !important;
            background-position: center center !important;
            background-blend-mode: multiply !important;
        }

        /* Gelembung Pesan Masuk Resmi WhatsApp (Putih Bersih & Lengkungan Khas WA) */
        .wa-bubble-in {
            background-color: #ffffff !important;
            color: #111b21 !important;
            box-shadow: 0 1px 0.5px rgba(11, 20, 26, 0.13) !important;
            border-radius: 8px !important;
            border-top-left-radius: 2px !important;
            position: relative !important;
            font-size: 14.5px !important;
            line-height: 1.38 !important;
            letter-spacing: -0.01em !important;
            display: flow-root !important;
        }
        .wa-bubble-in.has-tail::before {
            content: "";
            position: absolute;
            top: 0;
            left: -6px;
            width: 8px;
            height: 12px;
            background-color: #ffffff;
            clip-path: polygon(100% 0, 0 0, 100% 100%);
        }
        .wa-bubble-in > p,
        .wa-bubble-in > span,
        .wa-bubble-in .wa-bubble-text,
        .wa-bubble-in h2,
        .wa-bubble-in h3,
        .wa-bubble-in h4,
        .wa-bubble-in h5 {
            color: #111b21;
        }
        .wa-bubble-in strong {
            color: #111b21 !important;
            font-weight: 500 !important;
        }

        /* Countdown Timer & Tombol Berwarna Gelap: Wajib Teks Putih Terang & Kontras Tinggi */
        .wa-countdown-box,
        .wa-countdown-box span,
        .wa-countdown-box div,
        .wa-countdown-box p {
            color: #ffffff !important;
        }
        .wa-countdown-box .wa-countdown-title {
            color: #a7f3d0 !important;
        }
        .wa-countdown-box .wa-countdown-label {
            color: #d1fae5 !important;
        }
        .wa-btn-maps,
        .wa-btn-maps span,
        .wa-btn-maps svg {
            color: #ffffff !important;
            stroke: #ffffff !important;
        }

        /* Gelembung Pesan Keluar Resmi WhatsApp (Hijau Lembut Khas WA) */
        .wa-bubble-out {
            background-color: #DCF8C6 !important;
            color: #111b21 !important;
            box-shadow: 0 1px 0.5px rgba(11, 20, 26, 0.13) !important;
            border-radius: 8px !important;
            border-top-right-radius: 2px !important;
            position: relative !important;
            font-size: 14.5px !important;
            line-height: 1.38 !important;
            letter-spacing: -0.01em !important;
            display: flow-root !important;
        }
        .wa-bubble-out.has-tail::after {
            content: "";
            position: absolute;
            top: 0;
            right: -6px;
            width: 8px;
            height: 12px;
            background-color: #DCF8C6;
            clip-path: polygon(0 0, 100% 0, 0 100%);
        }
        .wa-bubble-out p,
        .wa-bubble-out span {
            color: #111b21 !important;
        }
        .wa-bubble-out strong {
            color: #111b21 !important;
            font-weight: 500 !important;
        }

        /* Format Posisi Teks & Jam Resmi WhatsApp (Inline Float Right di Akhir Kalimat) */
        .wa-bubble-text {
            display: inline;
            font-size: 14.5px;
            line-height: 1.38;
            color: #111b21;
            word-break: break-word;
            margin: 0;
        }
        .wa-msg-meta {
            float: right;
            margin-left: 7px;
            margin-top: 4px;
            margin-bottom: -2px;
            font-size: 11px;
            line-height: 15px;
            color: #667781;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 2px;
            user-select: none;
        }
        .wa-time {
            font-size: 11px !important;
            font-weight: 400 !important;
            color: #667781 !important;
            letter-spacing: 0.02em !important;
            font-variant-numeric: tabular-nums;
            line-height: 15px;
        }

        /* Kartu Di Dalam Pesan (Detail Acara, Rekening, Profil) */
        .wa-inner-card {
            background-color: #f8f9fa !important;
            border: 1px solid rgba(0, 0, 0, 0.06) !important;
            color: #000000 !important;
            border-radius: 12px !important;
        }
        .wa-inner-card p,
        .wa-inner-card span,
        .wa-inner-card strong,
        .wa-inner-card h4,
        .wa-inner-card h5 {
            color: #000000 !important;
        }

        /* Chip Tanggal di Atas Obrolan */
        .wa-date-chip {
            background-color: rgba(255, 255, 255, 0.82) !important;
            backdrop-filter: blur(10px) !important;
            color: #667781 !important;
            box-shadow: 0 1px 1.5px rgba(0, 0, 0, 0.06) !important;
            border-radius: 8px !important;
            font-size: 11px !important;
            font-weight: 500 !important;
            padding: 3px 12px !important;
        }

        /* Tombol Pilihan Menu Interaktif */
        .wa-action-btn {
            background-color: #ffffff !important;
            color: #000000 !important;
            border: 1px solid rgba(0, 0, 0, 0.08) !important;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04) !important;
            border-radius: 20px !important;
            font-size: 13px !important;
            font-weight: 600 !important;
            transition: all 0.2s ease !important;
        }
            font-size: 13px !important;
            font-weight: 600 !important;
            transition: all 0.2s ease !important;
        }
        .wa-action-btn:hover {
            background-color: #f2f2f7 !important;
        }
        .wa-action-btn.active {
            background-color: #e7fce3 !important;
            border-color: #25d366 !important;
            color: #0b704c !important;
        }

        /* Floating Emoji Reaction Bar (Seperti Popup WhatsApp iOS) */
        .wa-reaction-bar {
            background: rgba(255, 255, 255, 0.96) !important;
            backdrop-filter: blur(16px) !important;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15), 0 0 1px rgba(0, 0, 0, 0.2) !important;
            border-radius: 9999px !important;
            padding: 4px 10px !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 6px !important;
            z-index: 30 !important;
        }
        .wa-reaction-btn {
            font-size: 20px !important;
            line-height: 1 !important;
            transition: transform 0.15s ease !important;
            cursor: pointer !important;
        }
        .wa-reaction-btn:hover, .wa-reaction-btn:active {
            transform: scale(1.3) !important;
        }
        .wa-reaction-badge {
            background: #ffffff !important;
            border: 1px solid #e5e5ea !important;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08) !important;
            border-radius: 9999px !important;
            padding: 1px 6px !important;
            font-size: 11px !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 2px !important;
            position: absolute !important;
            bottom: -8px !important;
            right: 12px !important;
            z-index: 10 !important;
        }

        /* Gelembung Animasi Mengetik Resmi WhatsApp (Pill Bulat & 3 Titik Berkedip) */
        .wa-typing-bubble {
            background-color: #ffffff !important;
            border-radius: 18px !important;
            border-top-left-radius: 4px !important;
            box-shadow: 0 1px 0.5px rgba(11, 20, 26, 0.13) !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 10px 14px !important;
            gap: 5px !important;
            position: relative !important;
        }
        .wa-typing-bubble.has-tail::before {
            content: "";
            position: absolute;
            top: 0;
            left: -6px;
            width: 8px;
            height: 12px;
            background-color: #ffffff;
            clip-path: polygon(100% 0, 0 0, 100% 100%);
        }
        .wa-typing-dot {
            display: inline-block !important;
            width: 7px !important;
            height: 7px !important;
            background-color: #8696a0 !important;
            border-radius: 50% !important;
            animation: waDotBounce 1.4s infinite ease-in-out both !important;
        }
        .wa-typing-dot:nth-child(1) {
            animation-delay: 0s !important;
        }
        .wa-typing-dot:nth-child(2) {
            animation-delay: 0.2s !important;
        }
        .wa-typing-dot:nth-child(3) {
            animation-delay: 0.4s !important;
        }
        @keyframes waDotBounce {
            0%, 60%, 100% {
                transform: translateY(0);
                opacity: 0.35;
            }
            30% {
                transform: translateY(-5px);
                opacity: 1;
            }
        }

        /* Pulse green status ring */
        @keyframes ringPulse {
            0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.75); }
            70% { box-shadow: 0 0 0 8px rgba(37, 211, 102, 0); }
            100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
        }
        .status-ring-pulse {
            animation: ringPulse 2.2s infinite;
        }

        /* Waveform Animation */
        @keyframes waveAnim {
            0%, 100% { height: 6px; }
            50% { height: 22px; }
        }
        .waveform-bar.playing {
            animation: waveAnim 0.9s ease-in-out infinite;
        }

        /* Smooth Staggered Chat Arrival */
        @keyframes chatPopIn {
            0% { opacity: 0; transform: translateY(12px) scale(0.98); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }
        .chat-pop {
            animation: chatPopIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Floating reaction heart/emoji */
        @keyframes floatUp {
            0% { transform: translateY(0) scale(0.7); opacity: 1; }
            100% { transform: translateY(-380px) scale(1.5); opacity: 0; }
        }
        .floating-emoji {
            position: absolute;
            animation: floatUp 2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
            pointer-events: none;
            z-index: 70;
        }

        /* Ukuran Smartphone Standar Indonesia (360px - 412px) */
        .phone-container {
            width: 100% !important;
            max-width: 412px !important;
            margin-left: auto !important;
            margin-right: auto !important;
        }

        #t5-chat-main {
            scroll-behavior: smooth;
        }
        #t5-chat-main > * {
            scroll-margin-top: 16px;
            scroll-margin-bottom: 16px;
        }

        /* Hilangkan seluruh scrollbar bawaan browser agar seperti tampilan native smartphone */
        html, body, #t5-chat-main, #t5-chat-wrapper, * {
            -ms-overflow-style: none !important;
            scrollbar-width: none !important;
        }
        ::-webkit-scrollbar {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
        }
    </style>
</head>
<body id="t5-body" class="bg-[#0c1317] text-[#111b21] font-sans antialiased overflow-x-hidden select-none min-h-screen">

<!-- Audio Element Pernikahan -->
<audio id="t5-audio" loop preload="auto">
    <source src="/music/wedding-song.mp3" type="audio/mpeg">
</audio>

<!-- =================================================================== -->
<!-- 1. LOCKSCREEN NOTIFIKASI SMARTPHONE (PROSES SMOOTH & ALAMI) -->
<!-- =================================================================== -->
<div id="t5-lockscreen" class="fixed inset-0 z-50 flex items-center justify-center bg-[#0c1317] transition-all duration-700">
    <div class="phone-container h-full flex flex-col justify-between p-6 bg-cover bg-center bg-gradient-to-b from-slate-950 via-slate-900 to-black text-white shadow-2xl relative border-x border-white/10 overflow-hidden">
    
    <!-- iPhone Dynamic Island & Status Bar -->
    <div class="w-full flex items-center justify-between text-xs font-semibold px-2 text-slate-300">
        <span id="t5-clock-mini" class="font-mono">09:41</span>
        
        <!-- Dynamic Island -->
        <div class="h-7 w-28 bg-black/90 rounded-full border border-white/15 shadow-2xl flex items-center justify-between px-2.5 mx-auto">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <div class="flex space-x-0.5 items-center">
                <span class="w-1 h-2 bg-emerald-400 rounded-full animate-bounce"></span>
                <span class="w-1 h-3.5 bg-emerald-300 rounded-full animate-bounce" style="animation-delay: 150ms"></span>
                <span class="w-1 h-2 bg-emerald-400 rounded-full animate-bounce" style="animation-delay: 300ms"></span>
            </div>
            <span class="w-2.5 h-2.5 rounded-full bg-blue-500/80"></span>
        </div>

        <div class="flex items-center space-x-2">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zm6-4a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zm6-3a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"></path></svg>
            <div class="w-5 h-2.5 border border-slate-300 rounded-sm p-0.5 flex items-center">
                <div class="w-full h-full bg-emerald-400 rounded-2xs"></div>
            </div>
        </div>
    </div>

    <!-- Jam Besar Lockscreen -->
    <div class="text-center my-auto">
        <h1 id="t5-lockscreen-time" class="text-7xl sm:text-8xl font-extralight tracking-tight text-white/95">09:41</h1>
        <p id="t5-lockscreen-date" class="text-sm font-medium text-slate-300 mt-1">Minggu, 31 Desember</p>
    </div>

    <!-- KARTU NOTIFIKASI WA ALAMI -->
    <div class="max-w-md w-full mx-auto space-y-4">
        <div id="t5-notif-card" onclick="openWAChatWithProcess(this)" class="cursor-pointer bg-white text-slate-900 rounded-2xl p-4 shadow-2xl border border-white/60 transform hover:scale-[1.02] active:scale-[0.98] transition-all duration-300">
            <!-- Header Notifikasi -->
            <div class="flex items-center justify-between text-[11px] text-slate-500 mb-2 font-semibold">
                <div class="flex items-center space-x-1.5">
                    <div class="w-4 h-4 rounded-full bg-[#25D366] flex items-center justify-center text-white shadow-sm">
                        <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z"/></svg>
                    </div>
                    <span class="tracking-wider uppercase font-bold text-emerald-800">WHATSAPP</span>
                </div>
                <span>Baru saja</span>
            </div>

            <!-- Isi Chat Masuk Alami -->
            <div class="flex items-start space-x-3">
                <div class="w-11 h-11 rounded-full p-0.5 bg-gradient-to-tr from-emerald-400 via-teal-300 to-green-300 status-ring-pulse flex-shrink-0 shadow">
                    <img src="<%= bridePhoto || groomPhoto || '/images/demo/g-couple.svg' %>" alt="Mempelai" class="w-full h-full rounded-full object-cover">
                </div>
                <div class="flex-1 min-w-0">
                    <h2 class="text-sm font-bold text-slate-900 truncate">
                        <%= fv(event?.groom_name, 'David') %> & <%= fv(event?.bride_name, 'Sarah') %> 💕
                    </h2>
                    <p class="text-xs text-slate-700 line-clamp-2 mt-0.5 font-medium leading-relaxed">
                        Hai <strong id="t5-notif-guest" class="text-slate-900 font-bold">Tamu Undangan</strong>, ada kabar bahagia dari kami berdua! Buka obrolan yaa 😊
                    </p>
                </div>
            </div>

            <!-- Tombol Buka Obrolan -->
            <div class="mt-3 pt-2.5 border-t border-slate-200 flex items-center justify-between text-xs text-emerald-700 font-bold">
                <span id="t5-notif-action-text" class="flex items-center space-x-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                    <span>Ketuk untuk Buka Pesan</span>
                </span>
                <span id="t5-notif-arrow" class="text-emerald-600 transition-transform">➔</span>
            </div>
        </div>

        <div class="text-center text-xs text-slate-400 flex items-center justify-center space-x-1.5 py-1">
            <svg class="w-4 h-4 animate-bounce text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>
            <span>Ketuk notifikasi untuk masuk</span>
        </div>
    </div>
    </div>
</div>

<!-- =================================================================== -->
<!-- 2. WHATSAPP FULLSCREEN STATUS / STORY -->
<!-- =================================================================== -->
<div id="t5-story-modal" class="fixed inset-0 z-50 bg-[#0c1317] hidden items-center justify-center select-none">
    <div class="phone-container h-full flex flex-col justify-between text-white bg-black relative shadow-2xl border-x border-white/10 overflow-hidden">
    <div class="p-3 pt-4 flex space-x-1.5 z-20">
        <div class="flex-1 h-1 bg-white/30 rounded-full overflow-hidden"><div id="sb-0" class="h-full bg-white w-0 transition-all duration-100 ease-linear"></div></div>
        <div class="flex-1 h-1 bg-white/30 rounded-full overflow-hidden"><div id="sb-1" class="h-full bg-white w-0 transition-all duration-100 ease-linear"></div></div>
        <div class="flex-1 h-1 bg-white/30 rounded-full overflow-hidden"><div id="sb-2" class="h-full bg-white w-0 transition-all duration-100 ease-linear"></div></div>
    </div>

    <!-- Header Story WA -->
    <div class="flex items-center justify-between px-4 py-2 z-20">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-emerald-400 shadow">
                <img src="<%= bridePhoto || groomPhoto || '/images/demo/g-couple.svg' %>" alt="Status" class="w-full h-full object-cover">
            </div>
            <div>
                <h3 class="text-sm font-bold text-white"><%= fv(event?.groom_name, 'David') %> & <%= fv(event?.bride_name, 'Sarah') %></h3>
                <p id="t5-story-time" class="text-[11px] text-white/70">Hari ini, 09.30</p>
            </div>
        </div>
        <div class="flex items-center space-x-2">
            <span class="text-[10px] text-white/70 bg-white/10 px-2.5 py-0.5 rounded-full">Tahan untuk Jeda</span>
            <button onclick="closeWAStory()" aria-label="Tutup Story" class="w-9 h-9 rounded-full bg-black/50 flex items-center justify-center text-white hover:bg-black/80">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
    </div>

    <!-- Konten Foto & Sentuh Navigasi -->
    <div id="t5-story-viewport" class="relative flex-1 flex items-center justify-center overflow-hidden">
        <img id="t5-story-image" src="/images/demo/g-couple.svg" alt="Story" class="max-h-[75vh] w-auto max-w-full object-contain">
        <div class="absolute inset-y-0 left-0 w-1/3 z-10 cursor-pointer" onclick="prevWAStory()"></div>
        <div class="absolute inset-y-0 right-0 w-2/3 z-10 cursor-pointer" onclick="nextWAStory()"></div>
    </div>

    <!-- Caption & Quick Reply Emojis -->
    <div class="p-4 z-20 bg-gradient-to-t from-black/95 via-black/60 to-transparent space-y-3">
        <p id="t5-story-caption" class="text-sm font-medium text-white drop-shadow text-center">Our Journey Together 💕</p>
        
        <div class="flex items-center justify-center space-x-4 py-1">
            <button onclick="sendStoryReaction('❤️', event)" class="text-2xl transform active:scale-125 hover:scale-110 transition-transform">❤️</button>
            <button onclick="sendStoryReaction('😍', event)" class="text-2xl transform active:scale-125 hover:scale-110 transition-transform">😍</button>
            <button onclick="sendStoryReaction('👏', event)" class="text-2xl transform active:scale-125 hover:scale-110 transition-transform">👏</button>
            <button onclick="sendStoryReaction('🎉', event)" class="text-2xl transform active:scale-125 hover:scale-110 transition-transform">🎉</button>
            <button onclick="sendStoryReaction('🤲', event)" class="text-2xl transform active:scale-125 hover:scale-110 transition-transform">🤲</button>
        </div>

        <div class="flex items-center space-x-2">
            <input type="text" id="t5-story-reply-input" placeholder="Balas cerita pengantin..." 
                   class="flex-1 bg-white/20 border border-white/30 rounded-full px-4 py-2 text-xs text-white placeholder-white/60 focus:outline-none focus:ring-1 focus:ring-emerald-400">
            <button onclick="sendStoryReply()" class="w-9 h-9 rounded-full bg-[#25D366] text-white flex items-center justify-center shadow hover:bg-emerald-600">
                <svg class="w-4 h-4 ml-0.5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
            </button>
        </div>
    </div>
    </div>
</div>

<!-- =================================================================== -->
<!-- 3. SIMULASI PANGGILAN SUARA & VIDEO WHATSAPP -->
<!-- =================================================================== -->
<div id="t5-call-modal" class="fixed inset-0 z-50 bg-[#0c1317] text-white hidden items-center justify-center select-none">
    <div class="phone-container h-full flex flex-col items-center justify-between p-6 bg-gradient-to-b from-[#075E54] via-[#054c44] to-[#0b141a] text-white shadow-2xl relative border-x border-white/10 overflow-hidden">
    <div class="text-center pt-8">
        <span id="t5-call-badge" class="inline-block px-3 py-1 rounded-full bg-white/10 text-xs font-semibold text-emerald-400 mb-3 border border-white/10">
            Panggilan WhatsApp Masuk
        </span>
        <h2 class="text-2xl font-bold mb-1"><%= fv(event?.groom_name, 'David') %> & <%= fv(event?.bride_name, 'Sarah') %></h2>
        <p id="t5-call-status" class="text-sm text-slate-300 font-mono">Berdering...</p>
    </div>

    <div class="relative my-auto">
        <div id="t5-call-avatar-ring" class="w-36 h-36 rounded-full overflow-hidden p-1.5 border-4 border-emerald-400 status-ring-pulse shadow-2xl">
            <img src="<%= bridePhoto || groomPhoto || '/images/demo/g-couple.svg' %>" alt="Mempelai" class="w-full h-full rounded-full object-cover">
        </div>
    </div>

    <div class="w-full max-w-xs text-center space-y-6 pb-6">
        <p id="t5-call-msg" class="text-xs text-slate-300 italic px-4">
            "Halo! Senang sekali Anda menerima panggilan kami. Mohon doa restu dan kehadirannya yaa! 💕"
        </p>

        <div id="t5-call-actions-incoming" class="flex items-center justify-around">
            <button onclick="endWACall()" class="flex flex-col items-center space-y-1">
                <div class="w-14 h-14 rounded-full bg-rose-600 text-white flex items-center justify-center shadow-lg hover:bg-rose-700 active:scale-95 transition-all">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.707 2.293a1 1 0 00-1.414 1.414l14 14a1 1 0 001.414-1.414l-1.473-1.473A10.014 10.014 0 0019.542 10C18.268 5.943 14.478 3 10 3a9.958 9.958 0 00-4.512 1.074l-1.78-1.781zm4.261 4.26l1.514 1.515a2.003 2.003 0 012.45 2.45l1.514 1.514a4 4 0 00-5.478-5.478z" clip-rule="evenodd"></path><path d="M12.454 16.697L9.75 13.992a4 4 0 01-3.742-3.741L2.335 6.578A9.98 9.98 0 00.458 10c1.274 4.057 5.064 7 9.542 7 .847 0 1.669-.105 2.454-.303z"></path></svg>
                </div>
                <span class="text-[11px] text-slate-400">Tolak</span>
            </button>

            <button onclick="acceptWACall()" class="flex flex-col items-center space-y-1">
                <div class="w-14 h-14 rounded-full bg-emerald-500 text-white flex items-center justify-center shadow-lg hover:bg-emerald-600 active:scale-95 transition-all animate-bounce">
                    <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path></svg>
                </div>
                <span class="text-[11px] text-emerald-400 font-bold">Terima</span>
            </button>
        </div>

        <div id="t5-call-actions-connected" class="hidden flex items-center justify-around">
            <button onclick="toggleAudio()" class="w-12 h-12 rounded-full bg-white/10 text-white flex items-center justify-center hover:bg-white/20">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M9.383 3.076A1 1 0 0110 4v12a1 1 0 01-1.707.707L4.586 13H2a1 1 0 01-1-1V8a1 1 0 011-1h2.586l3.707-3.707a1 1 0 011.09-.217zM14.657 2.929a1 1 0 011.414 0A9.972 9.972 0 0119 10a9.972 9.972 0 01-2.929 7.071 1 1 0 01-1.414-1.414A7.971 7.971 0 0017 10c0-2.21-.894-4.208-2.343-5.657a1 1 0 010-1.414zm-2.829 2.828a1 1 0 011.415 0A5.983 5.983 0 0115 10a5.984 5.984 0 01-1.757 4.243 1 1 0 01-1.415-1.415A3.984 3.984 0 0013 10a3.983 3.983 0 00-1.172-2.828 1 1 0 010-1.415z" clip-rule="evenodd"></path></svg>
            </button>
            <button onclick="endWACall()" class="w-14 h-14 rounded-full bg-rose-600 text-white flex items-center justify-center shadow-lg hover:bg-rose-700 active:scale-95 transition-all">
                <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.707 2.293a1 1 0 00-1.414 1.414l14 14a1 1 0 001.414-1.414l-1.473-1.473A10.014 10.014 0 0019.542 10C18.268 5.943 14.478 3 10 3a9.958 9.958 0 00-4.512 1.074l-1.78-1.781zm4.261 4.26l1.514 1.515a2.003 2.003 0 012.45 2.45l1.514 1.514a4 4 0 00-5.478-5.478z" clip-rule="evenodd"></path><path d="M12.454 16.697L9.75 13.992a4 4 0 01-3.742-3.741L2.335 6.578A9.98 9.98 0 00.458 10c1.274 4.057 5.064 7 9.542 7 .847 0 1.669-.105 2.454-.303z"></path></svg>
            </button>
            <button onclick="openWAStory(0); endWACall();" class="w-12 h-12 rounded-full bg-white/10 text-white flex items-center justify-center hover:bg-white/20">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            </button>
        </div>
    </div>
    </div>
</div>

<!-- =================================================================== -->
<!-- 4. RUANG OBROLAN WHATSAPP UTAMA (WARNA FONT STANDAR WA RESMI) -->
<!-- =================================================================== -->
<div id="t5-chat-wrapper" class="hidden h-screen max-h-screen flex flex-col phone-container shadow-2xl relative wa-bg-authentic border-x border-black/10 overflow-hidden">
    
    <!-- HEADER WHATSAPP RESMI (iOS STYLE) -->
    <header class="flex-shrink-0 z-40 bg-[#F6F6F6]/95 backdrop-blur-md text-[#000000] px-3 py-2 flex items-center justify-between border-b border-black/10 shadow-xs">
        <div class="flex items-center space-x-2.5 min-w-0">
            <!-- Back Arrow with unread count < 4 -->
            <button onclick="backToLockscreen()" aria-label="Kembali ke Notifikasi" class="flex items-center text-[#007AFF] hover:opacity-80 py-1 transition-opacity">
                <svg class="w-6 h-6 -mr-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
                <span class="text-[17px] font-normal leading-none">4</span>
            </button>

            <!-- AVATAR MEMPELAI DENGAN STATUS ONLINE -->
            <div onclick="openWAStory(0)" title="Ketuk untuk melihat Cerita Mempelai" class="relative cursor-pointer flex-shrink-0 group">
                <div class="w-9 h-9 rounded-full p-0.5 bg-gradient-to-tr from-emerald-400 to-teal-400 ring-1.5 ring-emerald-500 status-ring-pulse">
                    <img src="<%= bridePhoto || groomPhoto || '/images/demo/g-couple.svg' %>" alt="Mempelai" class="w-full h-full rounded-full object-cover">
                </div>
                <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-500 rounded-full border-2 border-white"></span>
            </div>

            <!-- Nama & Status Kontak (iOS Typography) -->
            <div class="min-w-0 flex-1 cursor-pointer" onclick="openWAStory(0)">
                <h2 class="text-[15px] sm:text-[16px] font-semibold truncate text-[#000000] leading-snug">
                    <%= fv(event?.groom_name, 'David') %> & <%= fv(event?.bride_name, 'Sarah') %>
                </h2>
                <p id="t5-header-status" class="text-[11px] text-[#8E8E93] truncate font-sans leading-none mt-0.5">
                    online
                </p>
            </div>
        </div>

        <!-- Tombol Aksi Header (iOS Blue Outline Icons) -->
        <div class="flex items-center space-x-3 text-[#007AFF]">
            <button onclick="startWACall('video')" title="Video Call" class="hover:opacity-75 p-1 transition-opacity">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9A2.25 2.25 0 004.5 18.75z"/>
                </svg>
            </button>
            <button onclick="startWACall('voice')" title="Panggilan Suara" class="hover:opacity-75 p-1 transition-opacity">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
                </svg>
            </button>
        </div>
    </header>

    <!-- STREAM CHAT BUBBLES RESMI (iOS WHATSAPP TYPOGRAPHY & SPACING) -->
    <main id="t5-chat-main" class="flex-1 bg-transparent p-3 sm:p-4 space-y-2.5 pb-4 overflow-y-auto overscroll-contain">
        <!-- Date Badge Pin -->
        <div id="t5-date-pin" class="text-center my-1">
            <span class="inline-block wa-date-chip px-3 py-1 shadow-sm">
                Hari ini &bull; <%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %>
            </span>
        </div>

        <!-- TYPING INDICATOR BUBBLE (Ditempatkan dinamis DI BAWAH chat) -->
        <div id="t5-typing-bubble" class="hidden flex items-start chat-pop">
            <div class="wa-typing-bubble has-tail">
                <span class="wa-typing-dot"></span>
                <span class="wa-typing-dot"></span>
                <span class="wa-typing-dot"></span>
            </div>
        </div>

        <!-- BUBBLE 1: SALAM PERSONAL & PEMBUKA -->
        <div id="chat-step-1" onclick="toggleBubbleReaction('chat-step-1-bubble', event)" class="hidden flex items-start max-w-[90%] sm:max-w-[78%] chat-pop cursor-pointer group">
            <div id="chat-step-1-bubble" class="wa-bubble-in has-tail px-3.5 py-2.5 shadow-xs w-fit transition-transform active:scale-[0.99]">
                <p class="wa-arabic text-center py-0.5 text-base sm:text-lg mb-1 border-b border-black/[0.04]">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
                <p class="text-[14.5px] font-medium leading-snug text-[#111b21] mb-1">
                    Assalamu’alaikum Warahmatullahi Wabarakatuh
                </p>
                <p class="wa-bubble-text">
                    Halo <strong id="t5-chat-guest" class="text-[#111b21] font-medium">Tamu Undangan</strong>, gimana kabarnya? Semoga selalu diberikan kesehatan & kebahagiaan sekeluarga yaa... 🙏<span style="display:inline-block;width:38px;height:0;"></span><span class="wa-msg-meta"><span class="wa-time">09.41</span></span>
                </p>
            </div>
        </div>

        <!-- BUBBLE 2: KABAR BAHAGIA PERNIKAHAN -->
        <div id="chat-step-2" onclick="toggleBubbleReaction('chat-step-2-bubble', event)" class="hidden flex items-start max-w-[92%] sm:max-w-[80%] chat-pop cursor-pointer group">
            <div id="chat-step-2-bubble" class="wa-bubble-in has-tail px-3.5 py-2.5 shadow-xs w-fit transition-transform active:scale-[0.99]">
                <p class="text-[14.5px] leading-relaxed text-[#111b21] mb-2">
                    Alhamdulillah, dengan penuh rasa syukur, kami ingin berbagi kabar bahagia. Insya Allah kami akan melangsungkan pernikahan pada:
                </p>
                <div class="wa-inner-card px-3 py-2 space-y-1 mb-2 rounded-xl">
                    <p class="font-medium text-[14px] text-[#111b21]">🗓️ <%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %></p>
                    <p class="text-[13px] text-[#54656f]">📍 <%= fv(venueName, 'Grand Ballroom Hotel') %></p>
                </div>
                <p class="wa-bubble-text">
                    Kehadiran serta doa restu Anda merupakan kehormatan dan kebahagiaan terbesar bagi kami sekeluarga. 💕<span style="display:inline-block;width:38px;height:0;"></span><span class="wa-msg-meta"><span class="wa-time">09.41</span></span>
                </p>
            </div>
        </div>

        <!-- BUBBLE 3: VOICE NOTE PESAN SINGKAT MEMPELAI -->
        <div id="chat-step-3" class="hidden flex items-start max-w-[90%] sm:max-w-[78%] chat-pop">
            <div class="wa-bubble-in has-tail px-3 py-2.5 shadow-xs w-fit">

                <div class="flex items-center space-x-2.5">
                    <!-- Tombol Play VN -->
                    <button id="t5-vn-btn" onclick="toggleVNAudio()" aria-label="Putar Musik" class="w-10 h-10 rounded-full bg-[#25D366] text-white flex items-center justify-center flex-shrink-0 shadow-xs hover:bg-emerald-600 transition-colors">
                        <svg id="t5-vn-play-icon" class="w-4.5 h-4.5 ml-0.5" fill="currentColor" viewBox="0 0 20 20"><path d="M6.3 2.841A1.5 1.5 0 004 4.11v11.78a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"></path></svg>
                        <svg id="t5-vn-pause-icon" class="w-4.5 h-4.5 hidden" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
                    </button>

                    <!-- Waveform Bars & Meta Info -->
                    <div class="flex-1 min-w-[170px] sm:min-w-[210px]">
                        <div class="flex items-center space-x-1 h-5">
                            <span class="waveform-bar w-1 bg-emerald-500 rounded-full h-2"></span>
                            <span class="waveform-bar w-1 bg-emerald-500 rounded-full h-4"></span>
                            <span class="waveform-bar w-1 bg-emerald-500 rounded-full h-5"></span>
                            <span class="waveform-bar w-1 bg-emerald-500 rounded-full h-3"></span>
                            <span class="waveform-bar w-1 bg-emerald-500 rounded-full h-5"></span>
                            <span class="waveform-bar w-1 bg-emerald-500 rounded-full h-4"></span>
                            <span class="waveform-bar w-1 bg-emerald-500 rounded-full h-2"></span>
                            <span class="waveform-bar w-1 bg-emerald-500 rounded-full h-5"></span>
                            <span class="waveform-bar w-1 bg-emerald-500 rounded-full h-3"></span>
                            <span class="waveform-bar w-1 bg-emerald-500 rounded-full h-4"></span>
                            <span class="waveform-bar w-1 bg-emerald-500 rounded-full h-2"></span>
                        </div>
                        <div class="flex items-center justify-between text-[11px] text-[#8696a0] mt-1 font-sans">
                            <span id="t5-vn-time">00:00</span>
                            <span class="wa-msg-meta !mt-0 !mb-0 !bottom-0">
                                <span class="wa-time">09.42</span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- QUICK ACTION CHOICES: BACA DETAIL ATAU BUKA SEMUA SECARA SMOOTH (STANDAR WA PILLS) -->
        <div id="chat-actions-hub" class="hidden py-1 space-y-2 chat-pop">
            <p class="text-[11px] text-center text-[#54656f] font-medium">
                Pilih informasi yang ingin kamu lihat:
            </p>
            <div class="grid grid-cols-2 gap-2 max-w-md mx-auto">
                <button id="btn-choice-event" onclick="revealSectionSmooth('t5-event-bubble', this, '💍 Waktu & Lokasi')" class="wa-action-btn p-2.5 active:scale-95">
                    <span>💍 Waktu & Lokasi</span>
                </button>
                <button id="btn-choice-gallery" onclick="revealSectionSmooth('t5-gallery-bubble', this, '📷 Album Foto')" class="wa-action-btn p-2.5 active:scale-95">
                    <span>📷 Album Foto</span>
                </button>
                <button id="btn-choice-rsvp" onclick="revealSectionSmooth('t5-rsvp-bubble', this, '💌 RSVP Kehadiran')" class="wa-action-btn p-2.5 active:scale-95">
                    <span>💌 RSVP Kehadiran</span>
                </button>
                <button id="btn-choice-gift" onclick="revealSectionSmooth('t5-gift-bubble', this, '🎁 Amplop Digital')" class="wa-action-btn p-2.5 active:scale-95">
                    <span>🎁 Amplop Digital</span>
                </button>
            </div>
            <div class="text-center pt-1">
                <button id="btn-choice-all" onclick="revealAllSectionsSmooth(this)" class="wa-action-btn px-4 py-1.5 active:scale-95">
                    ⚡ Tampilkan Semua Rincian Acara Lengkap
                </button>
            </div>
        </div>

        <!-- BUBBLE 4: KARTU KONTAK MEMPELAI (VCARD) -->
        <div id="t5-couple-bubble" class="hidden flex items-start max-w-[92%] sm:max-w-[82%] chat-pop">
            <div class="wa-bubble-in has-tail p-3.5 shadow-xs space-y-3 w-fit">
                <div class="text-xs font-bold text-[#54656f] uppercase tracking-wider flex items-center justify-between border-b border-black/[0.06] pb-2">
                    <span>👤 Profil Mempelai</span>
                    <span class="font-bold text-[#111b21]">David & Sarah</span>
                </div>

                <div class="space-y-2.5">
                    <!-- Mempelai Pria -->
                    <div class="wa-inner-card flex items-center space-x-3 p-2.5 rounded-xl">
                        <div class="w-12 h-12 rounded-full overflow-hidden bg-slate-200 flex-shrink-0">
                            <img src="<%= groomPhoto || '/images/demo/groom.svg' %>" alt="Pria" class="w-full h-full object-cover">
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="text-sm font-bold text-[#111b21] truncate"><%= fv(event?.groom_name, 'David Anderson') %></h4>
                            <p class="text-[11px] text-[#54656f]">Putra: <%= fv(event?.groom_father, 'Bpk. Robert') %> & <%= fv(event?.groom_mother, 'Ibu Jennifer') %></p>
                            <% if (event?.instagram_groom) { %>
                            <a href="https://instagram.com/<%= (event.instagram_groom).replace('@', '') %>" target="_blank" class="text-[11px] text-[#008069] font-semibold hover:underline">
                                Instagram: @<%= (event.instagram_groom).replace('@', '') %>
                            </a>
                            <% } %>
                        </div>
                    </div>

                    <!-- Mempelai Wanita -->
                    <div class="wa-inner-card flex items-center space-x-3 p-2.5 rounded-xl">
                        <div class="w-12 h-12 rounded-full overflow-hidden bg-slate-200 flex-shrink-0">
                            <img src="<%= bridePhoto || '/images/demo/bride.svg' %>" alt="Wanita" class="w-full h-full object-cover">
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="text-sm font-bold text-[#111b21] truncate"><%= fv(event?.bride_name, 'Sarah Johnson') %></h4>
                            <p class="text-[11px] text-[#54656f]">Putri: <%= fv(event?.bride_father, 'Bpk. Michael') %> & <%= fv(event?.bride_mother, 'Ibu Emily') %></p>
                            <% if (event?.instagram_bride) { %>
                            <a href="https://instagram.com/<%= (event.instagram_bride).replace('@', '') %>" target="_blank" class="text-[11px] text-[#008069] font-semibold hover:underline">
                                Instagram: @<%= (event.instagram_bride).replace('@', '') %>
                            </a>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end pt-1">
                    <span class="wa-msg-meta !mt-0 !mb-0 !bottom-0"><span class="wa-time">09.42</span></span>
                </div>
            </div>
        </div>

        <!-- BUBBLE 5: DETAIL WAKTU, TEMPAT & HITUNG MUNDUR -->
        <div id="t5-event-bubble" class="hidden flex items-start max-w-[92%] sm:max-w-[82%] chat-pop">
            <div class="wa-bubble-in has-tail p-3.5 shadow-xs space-y-3 w-fit">
                <div class="flex items-center space-x-2 text-xs font-bold text-[#111b21] border-b border-black/[0.06] pb-2">
                    <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <span>Rangkaian Acara Pernikahan</span>
                </div>

                <div class="space-y-2 text-xs sm:text-sm">
                    <div class="wa-inner-card p-2.5 rounded-xl">
                        <h5 class="font-bold text-[#111b21] text-xs mb-1">💍 AKAD NIKAH</h5>
                        <p class="font-bold text-[#111b21]"><%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %></p>
                        <p class="text-[11px] text-[#54656f] font-mono">Pukul 08.00 - 10.00 WIB</p>
                    </div>

                    <div class="wa-inner-card p-2.5 rounded-xl">
                        <h5 class="font-bold text-[#111b21] text-xs mb-1">🎉 RESEPSI PERNIKAHAN</h5>
                        <p class="font-bold text-[#111b21]"><%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %></p>
                        <p class="text-[11px] text-[#54656f] font-mono"><%= fv(eventTimeRange, '11.00 WIB - Selesai') %></p>
                    </div>

                    <div class="pt-1">
                        <p class="font-bold text-[#111b21]">📍 <%= fv(venueName, 'Grand Ballroom Hotel') %></p>
                        <p class="text-xs text-[#54656f]"><%= fv(venueAddress, 'Jl. Sudirman No. 123, Jakarta') %></p>
                    </div>
                </div>

                <!-- Countdown Timer -->
                <div class="wa-countdown-box p-3 bg-gradient-to-r from-[#075E54] to-[#128C7E] text-white rounded-xl text-center shadow-xs">
                    <span class="wa-countdown-title text-[10.5px] uppercase tracking-widest text-emerald-200 font-bold block mb-1.5">Hitung Mundur Acara</span>
                    <div id="t5-countdown" class="grid grid-cols-4 gap-1 font-mono text-xs font-bold text-white">
                        <div><span id="t5-d" class="text-base sm:text-lg font-bold text-white block">00</span><span class="wa-countdown-label block text-[9.5px] text-emerald-100 font-sans">Hari</span></div>
                        <div><span id="t5-h" class="text-base sm:text-lg font-bold text-white block">00</span><span class="wa-countdown-label block text-emerald-100 text-[9.5px] font-sans">Jam</span></div>
                        <div><span id="t5-m" class="text-base sm:text-lg font-bold text-white block">00</span><span class="wa-countdown-label block text-emerald-100 text-[9.5px] font-sans">Mnt</span></div>
                        <div><span id="t5-s" class="text-base sm:text-lg font-bold text-white block">00</span><span class="wa-countdown-label block text-emerald-100 text-[9.5px] font-sans">Dtk</span></div>
                    </div>
                </div>

                <!-- Tombol Navigasi Peta -->
                <div class="grid grid-cols-2 gap-2 pt-1">
                    <a href="https://maps.google.com/?q=<%= encodeURIComponent(venueAddress || venueName || 'Lokasi Acara') %>" target="_blank"
                       class="wa-btn-maps text-center py-2.5 px-3 bg-[#075E54] text-white rounded-xl text-xs font-bold hover:bg-emerald-700 transition-colors flex items-center justify-center space-x-1.5 shadow-xs">
                        <svg class="w-3.5 h-3.5 text-white stroke-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
                        <span class="text-white font-bold">Petunjuk Maps</span>
                    </a>
                    <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Pernikahan+<%= encodeURIComponent(fv(event?.groom_name, 'David') + '+%26+' + fv(event?.bride_name, 'Sarah')) %>&location=<%= encodeURIComponent(fv(venueName, '') + ', ' + fv(venueAddress, '')) %>" target="_blank"
                       class="text-center py-2.5 px-3 bg-white text-[#111b21] border border-slate-300 rounded-xl text-xs font-semibold hover:bg-slate-50 transition-colors flex items-center justify-center space-x-1 shadow-xs">
                        <span class="text-[#111b21] font-semibold">+ Simpan Kalender</span>
                    </a>
                </div>

                <div class="flex justify-end pt-1">
                    <span class="wa-msg-meta !mt-0 !mb-0 !bottom-0"><span class="wa-time">09.43</span></span>
                </div>
            </div>
        </div>

        <!-- BUBBLE 6: ALBUM MEDIA FOTO BERDUA -->
        <div id="t5-gallery-bubble" class="hidden flex items-start max-w-[92%] sm:max-w-[82%] chat-pop">
            <div class="wa-bubble-in has-tail p-3 shadow-xs space-y-2 w-fit">
                <div class="text-xs font-bold text-[#54656f] mb-1 flex items-center justify-between">
                    <span>📷 Album Foto Mempelai</span>
                    <span class="text-[#008069] text-[11px] font-semibold cursor-pointer" onclick="openWAStory(0)">Lihat di Story ➔</span>
                </div>

                <% const _t5Demo = ['/images/demo/g-couple.svg', '/images/demo/g-rings.svg', '/images/demo/g-mosque.svg', '/images/demo/g-lantern.svg']; %>
                <% const _t5Photos = (galleryPhotos && galleryPhotos.length) ? galleryPhotos : _t5Demo; %>

                <div class="grid grid-cols-2 gap-2 rounded-xl overflow-hidden cursor-pointer" onclick="openWAStory(0)">
                    <% _t5Photos.slice(0, 4).forEach(function(img, i) { %>
                    <div class="relative aspect-square bg-slate-100 overflow-hidden group rounded-lg">
                        <img src="<%= img %>" alt="Galeri <%= i + 1 %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                        <% if (i === 3 && _t5Photos.length > 4) { %>
                        <div class="absolute inset-0 bg-black/60 flex items-center justify-center text-white font-bold text-base">
                            +<%= _t5Photos.length - 4 %> Foto
                        </div>
                        <% } %>
                    </div>
                    <% }); %>
                </div>

                <div class="flex items-center justify-between pt-1 text-[11px] text-[#54656f]">
                    <span>Ketuk foto untuk putar Status Cerita</span>
                    <span class="wa-msg-meta !mt-0 !mb-0 !bottom-0"><span class="wa-time">09.43</span></span>
                </div>
            </div>
        </div>

        <!-- BUBBLE 7: AMPLOP DIGITAL (TRANSFER BANK & QRIS) -->
        <div id="t5-gift-bubble" class="hidden flex items-start max-w-[92%] sm:max-w-[82%] chat-pop">
            <div class="wa-bubble-in has-tail p-3.5 shadow-xs space-y-3 w-fit">
                <div class="flex items-center justify-between text-xs font-bold text-[#54656f] border-b border-black/[0.06] pb-2">
                    <span>🎁 Amplop Digital (Cashless Gift)</span>
                    <span class="text-[#008069] font-mono text-[11px]">Terverifikasi</span>
                </div>

                <p class="text-xs text-[#111b21] leading-relaxed">
                    Bagi rekan/keluarga yang berkenan mengirimkan tanda kasih secara cashless:
                </p>

                <!-- Rekening BCA -->
                <div class="wa-inner-card p-2.5 rounded-xl">
                    <div class="flex items-center justify-between mb-1.5">
                        <span class="text-xs font-bold text-blue-800">BANK BCA</span>
                        <span class="text-[11px] text-[#54656f]">a.n <%= fv(event?.groom_name, 'David Anderson') %></span>
                    </div>
                    <div class="flex items-center justify-between bg-white px-3 py-1.5 rounded-lg border border-slate-200">
                        <span id="t5-bca-num" class="font-mono text-sm font-bold text-[#111b21]">1234567890</span>
                        <button onclick="copyT5('t5-bca-num', this)" class="px-2.5 py-1 bg-emerald-600 text-white text-[11px] font-bold rounded-lg hover:bg-emerald-700 transition-colors">
                            Salin
                        </button>
                    </div>
                </div>

                <!-- Rekening Mandiri -->
                <div class="wa-inner-card p-2.5 rounded-xl">
                    <div class="flex items-center justify-between mb-1.5">
                        <span class="text-xs font-bold text-amber-800">BANK MANDIRI</span>
                        <span class="text-[11px] text-[#54656f]">a.n <%= fv(event?.bride_name, 'Sarah Johnson') %></span>
                    </div>
                    <div class="flex items-center justify-between bg-white px-3 py-1.5 rounded-lg border border-slate-200">
                        <span id="t5-mandiri-num" class="font-mono text-sm font-bold text-[#111b21]">0987654321</span>
                        <button onclick="copyT5('t5-mandiri-num', this)" class="px-2.5 py-1 bg-emerald-600 text-white text-[11px] font-bold rounded-lg hover:bg-emerald-700 transition-colors">
                            Salin
                        </button>
                    </div>
                </div>

                <!-- Tombol Buka Pop-Up QRIS -->
                <button onclick="openQRISModal()" class="w-full py-2 px-3 bg-emerald-50 hover:bg-emerald-100 text-[#075E54] font-bold text-xs rounded-xl border border-emerald-300 flex items-center justify-center space-x-1.5 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path></svg>
                    <span>Tampilkan Scan QRIS Amplop Digital</span>
                </button>

                <div class="flex justify-end pt-1">
                    <span class="wa-msg-meta !mt-0 !mb-0 !bottom-0"><span class="wa-time">09.44</span></span>
                </div>
            </div>
        </div>

        <!-- BUBBLE 8: POLLING WHATSAPP (KONFIRMASI RSVP) -->
        <div id="t5-rsvp-bubble" class="hidden flex items-start max-w-[92%] sm:max-w-[82%] chat-pop">
            <div class="wa-bubble-in has-tail p-3.5 shadow-xs space-y-3 w-fit">
                <div class="flex items-center space-x-1.5 text-xs font-bold text-[#111b21] border-b border-black/[0.06] pb-2">
                    <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zm6-4a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zm6-3a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"></path></svg>
                    <span>Polling Kehadiran (RSVP)</span>
                </div>
                <p class="text-xs sm:text-sm font-bold text-[#111b21]">
                    Apakah kamu bisa hadir di hari bahagia kami?
                </p>

                <!-- Tombol Respon Cepat -->
                <div class="space-y-2 pt-1">
                    <div onclick="openRSVPDialog('hadir')" class="cursor-pointer p-3 rounded-xl border-2 border-emerald-500/50 hover:border-emerald-600 bg-emerald-50/70 transition-all space-y-1.5">
                        <div class="flex items-center justify-between text-xs font-bold text-[#111b21]">
                            <span>🟢 Ya, Insya Allah Hadir</span>
                            <span id="t5-attending-stat" class="font-mono text-[#0b704c] font-bold"><%= attendingCount ?? 0 %> Tamu</span>
                        </div>
                        <div class="w-full h-1.5 bg-slate-200 rounded-full overflow-hidden">
                            <div class="h-full bg-emerald-500 rounded-full" style="width: 80%;"></div>
                        </div>
                    </div>

                    <div onclick="openRSVPDialog('tidak_hadir')" class="cursor-pointer p-3 rounded-xl border border-slate-300 hover:border-slate-400 bg-slate-50 transition-all space-y-1.5">
                        <div class="flex items-center justify-between text-xs font-semibold text-[#111b21]">
                            <span>⚪ Maaf, Belum Bisa Hadir</span>
                            <span id="t5-notattending-stat" class="font-mono text-[#54656f]"><%= notAttendingCount ?? 0 %> Tamu</span>
                        </div>
                        <div class="w-full h-1.5 bg-slate-200 rounded-full overflow-hidden">
                            <div class="h-full bg-slate-400 rounded-full" style="width: 20%;"></div>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end pt-1">
                    <span class="wa-msg-meta !mt-0 !mb-0 !bottom-0"><span class="wa-time">09.44</span></span>
                </div>
            </div>
        </div>

        <!-- BUBBLE 9: DINDING DOA BERSAMA / UCAPAN TAMU -->
        <div id="t5-wishes-section" class="hidden pt-4 chat-pop">
            <div class="text-center my-3">
                <span class="inline-block wa-date-chip px-3 py-1 shadow-sm font-bold">
                    💬 Pesan & Doa Tamu Lainnya
                </span>
            </div>

            <div id="t5-wishes-stream" class="space-y-2.5">
                <% if ((wishes ?? []).length) { %>
                    <% (wishes ?? []).forEach(function(wish) { %>
                    <div class="flex items-start max-w-[88%]">
                        <div class="wa-bubble-in p-3 shadow-sm text-xs w-full">
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-bold text-[#111b21]"><%= wish.name %></span>
                                <span class="text-[10px] px-1.5 py-0.2 rounded font-semibold <%= wish.attendance === 'hadir' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-700' %>">
                                    <%= wish.attendance === 'hadir' ? 'Hadir' : 'Berhalangan' %>
                                </span>
                            </div>
                            <% if (wish.message) { %>
                            <p class="leading-relaxed text-[#111b21]"><%= wish.message %></p>
                            <% } %>
                            <div class="wa-time text-right font-mono mt-1 text-[11px] text-[#8696a0]"><%= timeAgo(wish.created_at) %></div>
                        </div>
                    </div>
                    <% }); %>
                <% } else { %>
                    <div id="t5-empty-wishes" class="text-center py-6 text-xs text-[#54656f] bg-white rounded-xl border border-slate-200">
                        Belum ada doa tertulis. Jadilah yang pertama mengirimkan ucapan di bawah!
                    </div>
                <% } %>
            </div>
        </div>

        <!-- OUTGOING CHAT BUBBLES CONTAINER (BALASAN TAMU SETELAH RSVP / STIKER / REAKSI DI PALING BAWAH) -->
        <div id="t5-outgoing-bubbles" class="space-y-3 pt-1">
            <!-- Dynamic outgoing messages will be placed here at the absolute bottom -->
        </div>
    </main>

    <!-- STICKER PACK DRAWER -->
    <div id="t5-sticker-drawer" class="hidden flex-shrink-0 bg-[#f0f2f5] p-3 border-t border-slate-200 grid grid-cols-3 gap-2.5 z-40">
        <button onclick="sendWASticker('💍 Happy Wedding! Semoga Sakinah Mawaddah Warahmah 💕')" class="bg-white p-2.5 rounded-xl shadow-xs border border-slate-200 hover:border-emerald-500 text-center text-xs active:scale-95 transition-all">
            <span class="text-2xl block mb-1">💍</span>
            <span class="font-bold text-[10px] text-[#111b21]">Happy Wedding</span>
        </button>
        <button onclick="sendWASticker('🕊️ Barakallahu Lakuma Wa Baraka \'Alaika!')" class="bg-white p-2.5 rounded-xl shadow-xs border border-slate-200 hover:border-emerald-500 text-center text-xs active:scale-95 transition-all">
            <span class="text-2xl block mb-1">🕊️</span>
            <span class="font-bold text-[10px] text-[#111b21]">Barakallah</span>
        </button>
        <button onclick="sendWASticker('🥳 Kondangan Time! Selamat Berbahagia! 🎉')" class="bg-white p-2.5 rounded-xl shadow-xs border border-slate-200 hover:border-emerald-500 text-center text-xs active:scale-95 transition-all">
            <span class="text-2xl block mb-1">🥳</span>
            <span class="font-bold text-[10px] text-[#111b21]">Kondangan!</span>
        </button>
        <button onclick="sendWASticker('💖 Langgeng Selamanya ya Kalian Berdua! ✨')" class="bg-white p-2.5 rounded-xl shadow-xs border border-slate-200 hover:border-emerald-500 text-center text-xs active:scale-95 transition-all">
            <span class="text-2xl block mb-1">💖</span>
            <span class="font-bold text-[10px] text-[#111b21]">Langgeng Ya!</span>
        </button>
        <button onclick="sendWASticker('🤲 Bismillah, Lancar dan Sukses Sampai Hari H 🙏')" class="bg-white p-2.5 rounded-xl shadow-xs border border-slate-200 hover:border-emerald-500 text-center text-xs active:scale-95 transition-all">
            <span class="text-2xl block mb-1">🤲</span>
            <span class="font-bold text-[10px] text-[#111b21]">Doa Terbaik</span>
        </button>
        <button onclick="sendWASticker('🥂 Cheers to Love and Forever! 🎊')" class="bg-white p-2.5 rounded-xl shadow-xs border border-slate-200 hover:border-emerald-500 text-center text-xs active:scale-95 transition-all">
            <span class="text-2xl block mb-1">🥂</span>
            <span class="font-bold text-[10px] text-[#111b21]">Cheers!</span>
        </button>
    </div>

    <!-- 5. BOTTOM BAR CHAT INPUT (iOS WHATSAPP STYLE - FLEX-SHRINK-0) -->
    <footer id="t5-bottom-bar" class="flex-shrink-0 w-full bg-[#F6F6F6]/95 backdrop-blur-md p-2 px-3 flex items-center space-x-2 z-40 border-t border-black/10 shadow-xs">
        <!-- Plus Button (+) iOS Blue -->
        <button type="button" onclick="toggleStickerDrawer()" aria-label="Buka Lampiran" class="text-[#007AFF] hover:opacity-80 p-1 flex-shrink-0">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path></svg>
        </button>

        <!-- Input Field (Pill Rounded Asli WA iOS) -->
        <div class="flex-1 flex items-center bg-white rounded-full px-3.5 py-1.5 border border-gray-300/80 shadow-xs">
            <input type="text" id="t5-quick-input" placeholder="Ketik pesan ucapan..." 
                   class="flex-1 bg-transparent text-[#000000] text-[15px] border-0 focus:outline-none placeholder-gray-400">
            <!-- Sticker Icon Inside Input -->
            <button type="button" onclick="toggleStickerDrawer()" class="text-[#007AFF] hover:opacity-80 pl-1.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 01-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm6 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75z"></path></svg>
            </button>
        </div>

        <!-- Camera Button -->
        <button type="button" onclick="openWAStory(0)" title="Kamera Story" class="text-[#007AFF] hover:opacity-80 p-1 flex-shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z"></path></svg>
        </button>

        <!-- Send Button -->
        <button type="button" id="t5-send-btn" onclick="sendQuickWish()" aria-label="Kirim Pesan" class="w-8 h-8 rounded-full bg-[#007AFF] text-white flex items-center justify-center flex-shrink-0 shadow hover:bg-blue-600 active:scale-95 transition-all">
            <svg class="w-4 h-4 ml-0.5 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
            </svg>
        </button>
    </footer>
</div>

