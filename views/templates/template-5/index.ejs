<!-- 7. MODAL FORM RSVP POPUP -->
<!-- =================================================================== -->
<div id="t5-rsvp-modal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white text-[#111b21] rounded-3xl p-6 max-w-sm w-full shadow-2xl">
        <div class="flex items-center justify-between mb-3 border-b pb-2">
            <h3 class="font-bold text-sm text-[#111b21]">Konfirmasi RSVP WhatsApp</h3>
            <button onclick="closeRSVPDialog()" class="text-slate-400 hover:text-slate-700">✕</button>
        </div>

        <form id="t5-rsvp-form" class="space-y-3">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" id="t5-form-att" name="attendance" value="hadir">

            <div>
                <label class="block text-[11px] font-bold text-[#54656f] uppercase mb-1">Nama Anda *</label>
                <input type="text" id="t5-form-name" name="name" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 text-[#111b21] rounded-xl text-xs focus:ring-1 focus:ring-emerald-500">
            </div>

            <div>
                <label class="block text-[11px] font-bold text-[#54656f] uppercase mb-1">No. WhatsApp / Email</label>
                <input type="text" id="t5-form-email" name="email" placeholder="08xxxxxxxxxx atau email" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 text-[#111b21] rounded-xl text-xs focus:ring-1 focus:ring-emerald-500">
            </div>

            <div id="t5-form-guest-wrap">
                <label class="block text-[11px] font-bold text-[#54656f] uppercase mb-1">Jumlah Tamu</label>
                <input type="number" id="t5-form-num" name="number_of_guests" min="1" max="5" value="1" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 text-[#111b21] rounded-xl text-xs focus:ring-1 focus:ring-emerald-500">
            </div>

            <div>
                <label class="block text-[11px] font-bold text-[#54656f] uppercase mb-1">Ucapan & Doa Restu</label>
                <textarea id="t5-form-msg" name="message" rows="3" placeholder="Tuliskan ucapan doa restu..." class="w-full px-3 py-2 bg-slate-50 border border-slate-200 text-[#111b21] rounded-xl text-xs focus:ring-1 focus:ring-emerald-500"></textarea>
            </div>

            <button type="submit" id="t5-form-btn" class="w-full py-2.5 bg-[#25D366] text-white font-bold text-xs rounded-xl hover:bg-emerald-600 transition-colors shadow">
                Kirim Konfirmasi Balasan
            </button>
        </form>
    </div>
</div>

<!-- TOAST ALERT -->
<div id="t5-toast" class="fixed top-6 left-1/2 -translate-x-1/2 z-50 px-5 py-2.5 rounded-full bg-[#075E54] text-white font-bold text-xs shadow-2xl transition-all duration-300 opacity-0 pointer-events-none -translate-y-4">
    Tersalin ke clipboard!
</div>

<!-- =================================================================== -->
<!-- JAVASCRIPT LOGIC INTERAKTIF -->
<!-- =================================================================== -->
<script>
// Data Foto Story WhatsApp: HANYA FOTO BERDUA & PERJALANAN
const storyList = [
    { src: '/images/demo/g-couple.svg', caption: 'The Happy Couple 💕', time: 'Hari ini, 09.15' },
    { src: '/images/demo/g-rings.svg', caption: 'Counting Days to Forever 💍', time: 'Hari ini, 09.25' },
    { src: '/images/demo/g-mosque.svg', caption: 'Bismillah Menuju Hari Bahagia ✨', time: 'Hari ini, 09.30' }
];

let currentStoryIndex = 0;
let storyTimer = null;
let isStoryPaused = false;
let isAudioPlaying = false;
let currentSpeed = 1;
let synthAudioCtx = null;
let synthIntervalId = null;
let callDurationTimer = null;
let callSeconds = 0;

// Web Audio synthesizer for UI sound effects
function playTone(freq, type = 'sine', duration = 0.15, vol = 0.05) {
    try {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return;
        if (!synthAudioCtx) synthAudioCtx = new AC();
        if (synthAudioCtx.state === 'suspended') synthAudioCtx.resume();
        const osc = synthAudioCtx.createOscillator();
        const g = synthAudioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, synthAudioCtx.currentTime);
        g.gain.setValueAtTime(vol, synthAudioCtx.currentTime);
        g.gain.exponentialRampToValueAtTime(0.0001, synthAudioCtx.currentTime + duration);
        osc.connect(g);
        g.connect(synthAudioCtx.destination);
        osc.start();
        osc.stop(synthAudioCtx.currentTime + duration);
    } catch(e) {}
}

function playSentSound() {
    playTone(587.33, 'triangle', 0.1, 0.04);
}

function playIncomingSound() {
    playTone(880, 'sine', 0.12, 0.05);
    setTimeout(() => playTone(1174.66, 'sine', 0.15, 0.05), 90);
}

// Background melody synth fallback
function playMelodySynth() {
    try {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return;
        if (!synthAudioCtx) synthAudioCtx = new AC();
        if (synthAudioCtx.state === 'suspended') synthAudioCtx.resume();
        const notes = [329.63, 392.00, 440.00, 523.25, 440.00, 392.00, 349.23, 329.63];
        let n = 0;
        if (synthIntervalId) clearInterval(synthIntervalId);
        synthIntervalId = setInterval(() => {
            if (!isAudioPlaying || !synthAudioCtx) return;
            const osc = synthAudioCtx.createOscillator();
            const g = synthAudioCtx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(notes[n % notes.length], synthAudioCtx.currentTime);
            g.gain.setValueAtTime(0.04, synthAudioCtx.currentTime);
            g.gain.exponentialRampToValueAtTime(0.0001, synthAudioCtx.currentTime + 1.2);
            osc.connect(g);
            g.connect(synthAudioCtx.destination);
            osc.start();
            osc.stop(synthAudioCtx.currentTime + 1.2);
            n++;
        }, 600);
    } catch(e) {}
}

function stopMelodySynth() {
    if (synthIntervalId) clearInterval(synthIntervalId);
    if (synthAudioCtx && synthAudioCtx.state === 'running') synthAudioCtx.suspend();
}

function toggleAudio(play) {
    const audio = document.getElementById('t5-audio');
    const playIcon = document.getElementById('t5-vn-play-icon');
    const pauseIcon = document.getElementById('t5-vn-pause-icon');
    const waveBars = document.querySelectorAll('.waveform-bar');

    if (play === undefined) play = !isAudioPlaying;
    isAudioPlaying = play;

    if (isAudioPlaying) {
        if (audio) {
            audio.playbackRate = currentSpeed;
            audio.play().catch(() => playMelodySynth());
        } else {
            playMelodySynth();
        }
        if (playIcon) playIcon.classList.add('hidden');
        if (pauseIcon) pauseIcon.classList.remove('hidden');
        waveBars.forEach(b => b.classList.add('playing'));
    } else {
        if (audio) audio.pause();
        stopMelodySynth();
        if (playIcon) playIcon.classList.remove('hidden');
        if (pauseIcon) pauseIcon.classList.add('hidden');
        waveBars.forEach(b => b.classList.remove('playing'));
    }
}

function toggleVNAudio() {
    toggleAudio();
}

// Speed multiplier (1x -> 1.5x -> 2x)
function cycleAudioSpeed() {
    const btn = document.getElementById('t5-speed-btn');
    const audio = document.getElementById('t5-audio');
    if (currentSpeed === 1) currentSpeed = 1.5;
    else if (currentSpeed === 1.5) currentSpeed = 2;
    else currentSpeed = 1;

    if (btn) btn.textContent = currentSpeed + 'x';
    if (audio) audio.playbackRate = currentSpeed;
}

// BUKA CHAT DENGAN PROSES SMOOTH & ALIRAN ALAMI
function openWAChatWithProcess(cardEl) {
    const actionText = document.getElementById('t5-notif-action-text');
    const arrow = document.getElementById('t5-notif-arrow');
    
    if (actionText) actionText.innerHTML = '<span class="inline-block w-2.5 h-2.5 border-2 border-emerald-600 border-t-transparent rounded-full animate-spin"></span> <span>Membuka obrolan...</span>';
    if (arrow) arrow.classList.add('translate-x-2');
    playIncomingSound();

    setTimeout(() => {
        const lock = document.getElementById('t5-lockscreen');
        const chat = document.getElementById('t5-chat-wrapper');

        if (lock) {
            lock.classList.add('-translate-y-full', 'opacity-0');
            setTimeout(() => {
                lock.style.display = 'none';
                if (chat) chat.classList.remove('hidden');
                const chatMain = document.getElementById('t5-chat-main');
                if (chatMain) chatMain.scrollTop = 0;
                window.scrollTo({ top: 0, behavior: 'instant' });
                startStaggeredChatStream();
            }, 600);
        }
    }, 450);
}

function positionTypingBelow(el) {
    const typingBubble = document.getElementById('t5-typing-bubble');
    if (!typingBubble) return;
    if (el && el.parentNode) {
        el.after(typingBubble);
    }
    typingBubble.classList.remove('hidden');

    const chatMain = document.getElementById('t5-chat-main');
    if (chatMain) {
        const bottomOffset = typingBubble.offsetTop + typingBubble.offsetHeight;
        if (bottomOffset > chatMain.scrollTop + chatMain.clientHeight) {
            chatMain.scrollTo({ top: bottomOffset - chatMain.clientHeight + 16, behavior: 'smooth' });
        }
    }
}

// Posisikan indikator mengetik selalu di PALING BAWAH seluruh bubble yang terlihat + auto scroll ke bawah
function positionTypingAtBottom() {
    const typingBubble = document.getElementById('t5-typing-bubble');
    const chatMain = document.getElementById('t5-chat-main');
    if (!typingBubble || !chatMain) return;

    const outBox = document.getElementById('t5-outgoing-bubbles');
    if (outBox && outBox.parentNode === chatMain) {
        outBox.before(typingBubble);
    } else {
        const children = Array.from(chatMain.children);
        let lastVisibleChild = null;

        for (const child of children) {
            if (child === typingBubble || child === outBox) continue;
            if (!child.classList.contains('hidden') && child.style.display !== 'none') {
                lastVisibleChild = child;
            }
        }

        if (lastVisibleChild) {
            lastVisibleChild.after(typingBubble);
        } else {
            chatMain.appendChild(typingBubble);
        }
    }

    typingBubble.classList.remove('hidden');

    // Auto scroll ke paling bawah menuju indikator mengetik di container chatMain
    setTimeout(() => {
        chatMain.scrollTo({ top: chatMain.scrollHeight, behavior: 'smooth' });
    }, 40);
}

function startStaggeredChatStream() {
    const chatMain = document.getElementById('t5-chat-main');
    if (chatMain) chatMain.scrollTop = 0;

    const hStatus = document.getElementById('t5-header-status');
    const typingBubble = document.getElementById('t5-typing-bubble');
    const datePin = document.getElementById('t5-date-pin');
    const step1 = document.getElementById('chat-step-1');
    const step2 = document.getElementById('chat-step-2');
    const step3 = document.getElementById('chat-step-3');
    const actionsHub = document.getElementById('chat-actions-hub');

    // 1. Sedang mengetik pesan pertama (Salam Pembuka)
    if (hStatus) hStatus.textContent = 'sedang mengetik...';
    positionTypingBelow(datePin);

    // Pesan 1 Muncul setelah delay mengetik alami
    setTimeout(() => {
        playIncomingSound();
        if (typingBubble) typingBubble.classList.add('hidden');
        if (hStatus) hStatus.textContent = 'online';
        if (step1) step1.classList.remove('hidden');
        if (chatMain) chatMain.scrollTop = 0;

        // Jeda membaca pesan 1 (~1.2 detik), lalu mulai mengetik pesan 2
        setTimeout(() => {
            if (hStatus) hStatus.textContent = 'sedang mengetik...';
            positionTypingBelow(step1);

            // Pesan 2 Muncul setelah mengetik kabar bahagia (~2.4 detik)
            setTimeout(() => {
                playIncomingSound();
                if (typingBubble) typingBubble.classList.add('hidden');
                if (hStatus) hStatus.textContent = 'online';
                if (step2) step2.classList.remove('hidden');

                // Jeda membaca pesan 2 (~1.2 detik), lalu status berganti merekam audio VN
                setTimeout(() => {
                    if (hStatus) hStatus.textContent = 'merekam audio...';
                    positionTypingBelow(step2);

                    // Pesan 3 (Voice Note & Menu Navigasi) Muncul (~2.0 detik)
                    setTimeout(() => {
                        playIncomingSound();
                        if (step3) step3.classList.remove('hidden');
                        if (actionsHub) actionsHub.classList.remove('hidden');
                        if (typingBubble) typingBubble.classList.add('hidden');
                        if (hStatus) hStatus.textContent = 'online';
                        toggleAudio(true);

                        // Pastikan posisi obrolan tetap di bagian atas (tanggal & salam pembuka tidak terpotong)
                        if (chatMain) {
                            chatMain.scrollTop = 0;
                        }
                    }, 2000);
                }, 1200);
            }, 2400);
        }, 1200);
    }, 1800);
}

// Buka rincian satu persatu secara smooth (loading dan bubble baru selalu DI PALING BAWAH chat)
function revealSectionSmooth(sectionId, btnEl, labelText) {
    const targetEl = document.getElementById(sectionId);
    if (!targetEl) return;

    if (btnEl) {
        btnEl.classList.add('active');
        btnEl.innerHTML = '<span class="inline-block w-2.5 h-2.5 border-2 border-emerald-600 border-t-transparent rounded-full animate-spin"></span> <span>Memuat...</span>';
    }

    const hStatus = document.getElementById('t5-header-status');
    const typingBubble = document.getElementById('t5-typing-bubble');
    if (hStatus) hStatus.textContent = 'sedang mengetik...';

    // Posisikan indikator mengetik selalu di PALING BAWAH seluruh bubble yang terlihat + auto scroll
    positionTypingAtBottom();

    setTimeout(() => {
        playIncomingSound();

        // Pindahkan targetEl tepat sebelum typingBubble
        if (typingBubble && typingBubble.parentNode) {
            typingBubble.before(targetEl);
        }

        targetEl.classList.remove('hidden');
        if (hStatus) hStatus.textContent = 'online';
        if (typingBubble) typingBubble.classList.add('hidden');
        if (btnEl) btnEl.innerHTML = `<span>✓ ${labelText}</span>`;

        // Pastikan outBox (reaksi / balasan) SELALU TETAP DI PALING BAWAH
        const chatMain = document.getElementById('t5-chat-main');
        const outBox = document.getElementById('t5-outgoing-bubbles');
        if (chatMain && outBox) {
            chatMain.appendChild(outBox);
        }

        // Auto scroll ke bawah menuju bubble rincian yang baru saja muncul di container chatMain
        setTimeout(() => {
            if (chatMain) {
                chatMain.scrollTo({ top: chatMain.scrollHeight, behavior: 'smooth' });
            }
        }, 60);
    }, 700);
}

// Buka semua bagian langsung secara smooth (loading dan semua rincian DI PALING BAWAH chat)
function revealAllSectionsSmooth(btnEl) {
    if (btnEl) {
        btnEl.innerHTML = '<span class="inline-block w-2.5 h-2.5 border-2 border-emerald-600 border-t-transparent rounded-full animate-spin"></span> <span>Memuat seluruh rincian...</span>';
    }

    const hStatus = document.getElementById('t5-header-status');
    const typingBubble = document.getElementById('t5-typing-bubble');
    if (hStatus) hStatus.textContent = 'sedang mengetik...';

    // Posisikan indikator mengetik di PALING BAWAH chat dan auto scroll
    positionTypingAtBottom();

    const ids = ['chat-step-1', 'chat-step-2', 'chat-step-3', 'chat-actions-hub', 't5-couple-bubble', 't5-event-bubble', 't5-gallery-bubble', 't5-gift-bubble', 't5-rsvp-bubble', 't5-wishes-section'];
    
    setTimeout(() => {
        ids.forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                if (typingBubble && typingBubble.parentNode) {
                    typingBubble.before(el);
                }
                el.classList.remove('hidden');
            }
        });
        if (typingBubble) typingBubble.classList.add('hidden');
        if (hStatus) hStatus.textContent = 'online';
        if (btnEl) btnEl.innerHTML = '<span>✓ Seluruh Rincian Terbuka</span>';
        playIncomingSound();
        toggleAudio(true);

        // Pastikan outBox (reaksi / balasan) SELALU TETAP DI PALING BAWAH setelah seluruh rincian dibuka
        const chatMain = document.getElementById('t5-chat-main');
        const outBox = document.getElementById('t5-outgoing-bubbles');
        if (chatMain && outBox) {
            chatMain.appendChild(outBox);
        }

        setTimeout(() => {
            const firstRevealed = document.getElementById('t5-couple-bubble') || document.getElementById('t5-event-bubble');
            if (firstRevealed) {
                firstRevealed.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }, 80);
    }, 700);
}

// Emoji Reaction Popup (Sesuai Screenshot WhatsApp iOS)
function toggleBubbleReaction(bubbleId, event) {
    if (event) event.stopPropagation();
    const existing = document.getElementById('wa-active-reaction-bar');
    if (existing) {
        existing.remove();
        if (existing.dataset.targetId === bubbleId) return;
    }

    const bubble = document.getElementById(bubbleId);
    if (!bubble) return;

    const bar = document.createElement('div');
    bar.id = 'wa-active-reaction-bar';
    bar.dataset.targetId = bubbleId;
    bar.className = 'wa-reaction-bar chat-pop absolute -top-10 left-3 shadow-xl';
    bar.innerHTML = `
        <button type="button" onclick="reactToBubble('${bubbleId}', '👍', event)" class="wa-reaction-btn">👍</button>
        <button type="button" onclick="reactToBubble('${bubbleId}', '❤️', event)" class="wa-reaction-btn">❤️</button>
        <button type="button" onclick="reactToBubble('${bubbleId}', '😂', event)" class="wa-reaction-btn">😂</button>
        <button type="button" onclick="reactToBubble('${bubbleId}', '😮', event)" class="wa-reaction-btn">😮</button>
        <button type="button" onclick="reactToBubble('${bubbleId}', '😢', event)" class="wa-reaction-btn">😢</button>
        <button type="button" onclick="reactToBubble('${bubbleId}', '🙏', event)" class="wa-reaction-btn">🙏</button>
        <button type="button" onclick="reactToBubble('${bubbleId}', '✨', event)" class="wa-reaction-btn text-base font-bold text-gray-500">+</button>
    `;
    bubble.style.position = 'relative';
    bubble.appendChild(bar);
}

function reactToBubble(bubbleId, emoji, event) {
    if (event) event.stopPropagation();
    const bar = document.getElementById('wa-active-reaction-bar');
    if (bar) bar.remove();

    const bubble = document.getElementById(bubbleId);
    if (!bubble) return;

    let badge = bubble.querySelector('.wa-reaction-badge');
    if (!badge) {
        badge = document.createElement('span');
        badge.className = 'wa-reaction-badge';
        bubble.appendChild(badge);
    }
    badge.innerHTML = `${emoji} <span class="font-bold text-[10px] text-gray-700">1</span>`;

    // Floating reaction animation
    const span = document.createElement('span');
    span.className = 'floating-emoji text-3xl';
    span.textContent = emoji;
    span.style.left = (event ? event.clientX - 15 : window.innerWidth / 2) + 'px';
    span.style.top = (event ? event.clientY - 20 : window.innerHeight / 2) + 'px';
    document.body.appendChild(span);
    setTimeout(() => span.remove(), 2100);

    playSentSound();
    appendOutgoingBubble(`Bereaksi ${emoji} pada pesan`);
}

document.addEventListener('click', function(e) {
    const bar = document.getElementById('wa-active-reaction-bar');
    if (bar && !bar.contains(e.target)) {
        bar.remove();
    }
});

function resetToBeginning() {
    if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
    }
    window.scrollTo(0, 0);

    const lock = document.getElementById('t5-lockscreen');
    const chat = document.getElementById('t5-chat-wrapper');
    const actionText = document.getElementById('t5-notif-action-text');
    const arrow = document.getElementById('t5-notif-arrow');
    const audio = document.getElementById('t5-audio');

    // 1. Tampilkan kembali lockscreen di posisi teratas
    if (lock) {
        lock.style.display = 'flex';
        lock.classList.remove('-translate-y-full', 'opacity-0');
    }

    // 2. Sembunyikan chat wrapper
    if (chat) {
        chat.classList.add('hidden');
    }

    // 3. Reset teks notifikasi
    if (actionText) {
        actionText.innerHTML = '<span>Ketuk untuk Buka Undangan</span>';
    }
    if (arrow) {
        arrow.classList.remove('translate-x-2');
    }

    // 4. Sembunyikan semua bubble chat agar aliran pesan mengulang dari awal
    const chatIds = [
        'chat-step-1', 'chat-step-2', 'chat-step-3', 'chat-actions-hub',
        't5-couple-bubble', 't5-event-bubble', 't5-gallery-bubble',
        't5-gift-bubble', 't5-rsvp-bubble', 't5-wishes-section'
    ];
    chatIds.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.add('hidden');
    });

    const typingBubble = document.getElementById('t5-typing-bubble');
    if (typingBubble) typingBubble.classList.add('hidden');

    const hStatus = document.getElementById('t5-header-status');
    if (hStatus) hStatus.textContent = 'online';

    // Kembalikan typing bubble ke bawah pin tanggal
    const datePin = document.getElementById('t5-date-pin');
    if (datePin && typingBubble) {
        datePin.after(typingBubble);
    }

    // 5. Matikan musik / VN
    if (audio) {
        audio.pause();
        audio.currentTime = 0;
        isAudioPlaying = false;
    }
    stopMelodySynth();
    const playIcon = document.getElementById('t5-vn-play-icon');
    const pauseIcon = document.getElementById('t5-vn-pause-icon');
    if (playIcon) playIcon.classList.remove('hidden');
    if (pauseIcon) pauseIcon.classList.add('hidden');
    const waveBars = document.querySelectorAll('.waveform-bar');
    waveBars.forEach(b => b.classList.remove('playing'));
}

// Reset otomatis setiap kali halaman dibuka atau kembali dari navigasi browser
resetToBeginning();
window.addEventListener('pageshow', function() {
    resetToBeginning();
});

function backToLockscreen() {
    resetToBeginning();
}

// WhatsApp Story Functions
function openWAStory(index) {
    currentStoryIndex = index || 0;
    const modal = document.getElementById('t5-story-modal');
    if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        showStorySlide(currentStoryIndex);
    }
}

function closeWAStory() {
    const modal = document.getElementById('t5-story-modal');
    if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        if (storyTimer) clearTimeout(storyTimer);
    }
    const chatMain = document.getElementById('t5-chat-main');
    if (chatMain) {
        setTimeout(() => {
            chatMain.scrollTo({ top: chatMain.scrollHeight, behavior: 'smooth' });
        }, 100);
    }
}

function showStorySlide(idx) {
    if (idx < 0) idx = 0;
    if (idx >= storyList.length) {
        closeWAStory();
        return;
    }
    currentStoryIndex = idx;
    const item = storyList[currentStoryIndex];
    const img = document.getElementById('t5-story-image');
    const cap = document.getElementById('t5-story-caption');
    const time = document.getElementById('t5-story-time');

    if (img) img.src = item.src;
    if (cap) cap.textContent = item.caption;
    if (time) time.textContent = item.time;

    for (let i = 0; i < 3; i++) {
        const bar = document.getElementById('sb-' + i);
        if (bar) {
            bar.style.transition = 'none';
            if (i < currentStoryIndex) bar.style.width = '100%';
            else bar.style.width = '0%';
        }
    }

    const curBar = document.getElementById('sb-' + currentStoryIndex);
    if (curBar) {
        setTimeout(() => {
            curBar.style.transition = 'width 4s linear';
            curBar.style.width = '100%';
        }, 50);
    }

    if (storyTimer) clearTimeout(storyTimer);
    storyTimer = setTimeout(() => {
        if (!isStoryPaused) nextWAStory();
    }, 4100);
}

function nextWAStory() {
    showStorySlide(currentStoryIndex + 1);
}

function prevWAStory() {
    showStorySlide(currentStoryIndex - 1);
}

// Story Hold-to-Pause
const storyViewport = document.getElementById('t5-story-viewport');
if (storyViewport) {
    const pauseStory = () => { isStoryPaused = true; };
    const resumeStory = () => { isStoryPaused = false; };
    storyViewport.addEventListener('mousedown', pauseStory);
    storyViewport.addEventListener('mouseup', resumeStory);
    storyViewport.addEventListener('touchstart', pauseStory);
    storyViewport.addEventListener('touchend', resumeStory);
}

// Story Quick Reaction & Reply
function sendStoryReaction(emoji, ev) {
    const span = document.createElement('span');
    span.className = 'floating-emoji text-4xl';
    span.textContent = emoji;
    span.style.left = (ev ? ev.clientX - 15 : window.innerWidth / 2) + 'px';
    span.style.top = (ev ? ev.clientY - 20 : window.innerHeight / 2) + 'px';
    document.body.appendChild(span);
    setTimeout(() => span.remove(), 2100);

    playSentSound();
    showToast('Bereaksi ' + emoji + ' pada status mempelai');
    appendOutgoingBubble(`Bereaksi ${emoji} pada status`);
}

function sendStoryReply() {
    const input = document.getElementById('t5-story-reply-input');
    if (!input || !input.value.trim()) return;
    const txt = input.value.trim();
    appendOutgoingBubble(txt);
    input.value = '';
    closeWAStory();
    showToast('Balasan terkirim ke obrolan!');
}

// WhatsApp Simulated Calling
function startWACall(type) {
    const modal = document.getElementById('t5-call-modal');
    const status = document.getElementById('t5-call-status');
    const badge = document.getElementById('t5-call-badge');
    const incomingActions = document.getElementById('t5-call-actions-incoming');
    const connectedActions = document.getElementById('t5-call-actions-connected');

    if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        if (incomingActions) incomingActions.classList.remove('hidden');
        if (connectedActions) connectedActions.classList.add('hidden');
        if (status) status.textContent = 'Berdering...';
        if (badge) badge.textContent = type === 'video' ? 'Panggilan Video Masuk' : 'Panggilan Suara Masuk';
        playTone(440, 'triangle', 0.5, 0.08);
    }
}

function acceptWACall() {
    const status = document.getElementById('t5-call-status');
    const incomingActions = document.getElementById('t5-call-actions-incoming');
    const connectedActions = document.getElementById('t5-call-actions-connected');

    if (incomingActions) incomingActions.classList.add('hidden');
    if (connectedActions) connectedActions.classList.remove('hidden');

    callSeconds = 0;
    if (callDurationTimer) clearInterval(callDurationTimer);
    callDurationTimer = setInterval(() => {
        callSeconds++;
        const m = String(Math.floor(callSeconds / 60)).padStart(2, '0');
        const s = String(callSeconds % 60).padStart(2, '0');
        if (status) status.textContent = `${m}:${s}`;
    }, 1000);

    toggleAudio(true);
}

function endWACall() {
    const modal = document.getElementById('t5-call-modal');
    if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }
    if (callDurationTimer) clearInterval(callDurationTimer);
}

// RSVP Dialog
function openRSVPDialog(att) {
    const modal = document.getElementById('t5-rsvp-modal');
    const attInput = document.getElementById('t5-form-att');
    const guestWrap = document.getElementById('t5-form-guest-wrap');

    if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }
    if (attInput) attInput.value = att;
    if (guestWrap) {
        if (att === 'hadir') guestWrap.classList.remove('hidden');
        else guestWrap.classList.add('hidden');
    }
}

function closeRSVPDialog() {
    const modal = document.getElementById('t5-rsvp-modal');
    if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }
}

// QRIS Modal
function openQRISModal() {
    const m = document.getElementById('t5-qris-modal');
    if (m) {
        m.classList.remove('hidden');
        m.classList.add('flex');
    }
}

function closeQRISModal() {
    const m = document.getElementById('t5-qris-modal');
    if (m) {
        m.classList.add('hidden');
        m.classList.remove('flex');
    }
}

// Sticker Drawer
function toggleStickerDrawer() {
    const drawer = document.getElementById('t5-sticker-drawer');
    if (drawer) drawer.classList.toggle('hidden');
}

function sendWASticker(text) {
    appendOutgoingBubble(text, true);
    toggleStickerDrawer();
    playSentSound();
}

// Salin Text Toast
function copyT5(id, btn) {
    const el = document.getElementById(id);
    if (!el) return;
    const txt = el.textContent.trim();
    navigator.clipboard.writeText(txt).then(() => {
        showToast('Berhasil disalin: ' + txt);
        if (btn) {
            const org = btn.textContent;
            btn.textContent = '✓';
            setTimeout(() => btn.textContent = org, 1500);
        }
    });
}

function showToast(msg) {
    const toast = document.getElementById('t5-toast');
    if (toast) {
        toast.textContent = msg;
        toast.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');
        setTimeout(() => {
            toast.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4');
            toast.classList.remove('opacity-100', 'translate-y-0');
        }, 2500);
    }
}

// Outgoing Chat Bubbles Builder (Selalu lanjut di PALING BAWAH seluruh chat)
function appendOutgoingBubble(msg, isSticker = false) {
    const chatMain = document.getElementById('t5-chat-main');
    if (!chatMain) return;

    let outBox = document.getElementById('t5-outgoing-bubbles');
    if (!outBox) {
        outBox = document.createElement('div');
        outBox.id = 't5-outgoing-bubbles';
        outBox.className = 'space-y-3 pt-1';
    }
    // Pastikan kontainer outBox selalu berada di PALING BAWAH seluruh elemen chat
    chatMain.appendChild(outBox);

    const outBubble = document.createElement('div');
    outBubble.className = 'flex justify-end max-w-[88%] sm:max-w-[78%] ml-auto chat-pop';
    
    const now = new Date();
    const timeStr = String(now.getHours()).padStart(2, '0') + '.' + String(now.getMinutes()).padStart(2, '0');

    if (isSticker) {
        outBubble.innerHTML = `
            <div class="bg-white p-3 rounded-2xl shadow-xs text-center space-y-1 border border-black/5">
                <p class="text-base font-bold text-[#111b21]">${msg}</p>
                <div class="flex items-center justify-end space-x-1 text-[11px] text-[#8696a0] pt-0.5">
                    <span>${timeStr}</span>
                    <span class="text-[#53bdeb] font-medium tracking-tighter">✓✓</span>
                </div>
            </div>
        `;
    } else {
        outBubble.innerHTML = `
            <div class="wa-bubble-out has-tail px-3.5 py-2 shadow-xs text-[14.5px] w-fit">
                <p class="wa-bubble-text">${msg}<span style="display:inline-block;width:48px;height:0;"></span><span class="wa-msg-meta !text-[#667781]"><span class="wa-time">${timeStr}</span><span class="text-[#53bdeb] text-[12px] font-medium tracking-tighter">✓✓</span></span></p>
            </div>
        `;
    }

    outBox.appendChild(outBubble);
    chatMain.scrollTo({ top: chatMain.scrollHeight, behavior: 'smooth' });

    // Loading balasan otomatis DI BAWAH bubble yang baru saja dikirim
    const hStatus = document.getElementById('t5-header-status');
    if (hStatus) hStatus.textContent = 'sedang mengetik...';
    positionTypingBelow(outBubble);
    chatMain.scrollTo({ top: chatMain.scrollHeight, behavior: 'smooth' });

    setTimeout(() => {
        const replyBubble = document.createElement('div');
        replyBubble.className = 'flex items-start max-w-[88%] sm:max-w-[78%] chat-pop mt-2';
        replyBubble.innerHTML = `
            <div class="wa-bubble-in has-tail px-3.5 py-2 shadow-xs text-[14.5px] w-fit">
                <p class="wa-bubble-text">Terima kasih banyak atas ucapan & doa restunya! Sangat berarti bagi kami berdua 🙏💕<span style="display:inline-block;width:38px;height:0;"></span><span class="wa-msg-meta"><span class="wa-time">${timeStr}</span></span></p>
            </div>
        `;
        outBox.appendChild(replyBubble);
        const typingBubble = document.getElementById('t5-typing-bubble');
        if (typingBubble) typingBubble.classList.add('hidden');
        if (hStatus) hStatus.textContent = 'online';
        playIncomingSound();
        chatMain.scrollTo({ top: chatMain.scrollHeight, behavior: 'smooth' });
    }, 1800);
}

// Inisialisasi DOM
document.addEventListener('DOMContentLoaded', function() {
    // 1. Recipient Query Param ?to=
    const params = new URLSearchParams(window.location.search);
    const to = params.get('to');
    if (to) {
        const nGuest = document.getElementById('t5-notif-guest');
        const cGuest = document.getElementById('t5-chat-guest');
        const fName = document.getElementById('t5-form-name');
        if (nGuest) nGuest.textContent = to;
        if (cGuest) cGuest.textContent = to;
        if (fName) fName.value = to;
    }

    // 2. Jam Mini Lockscreen
    function updateClock() {
        const now = new Date();
        const hrs = String(now.getHours()).padStart(2, '0');
        const mns = String(now.getMinutes()).padStart(2, '0');
        const mini = document.getElementById('t5-clock-mini');
        const big = document.getElementById('t5-lockscreen-time');
        if (mini) mini.textContent = `${hrs}:${mns}`;
        if (big) big.textContent = `${hrs}:${mns}`;
    }
    updateClock();
    setInterval(updateClock, 30000);

    // 3. Countdown Acara
    const target = new Date("<%= event?.event_date || eventDate || '2025-12-31 19:00:00' %>").getTime();
    function refreshCountdown() {
        const diff = target - new Date().getTime();
        if (diff <= 0) return;
        const d = Math.floor(diff / (1000 * 60 * 60 * 24));
        const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const s = Math.floor((diff % (1000 * 60)) / 1000);
        const dEl = document.getElementById('t5-d');
        const hEl = document.getElementById('t5-h');
        const mEl = document.getElementById('t5-m');
        const sEl = document.getElementById('t5-s');
        if (dEl) dEl.textContent = String(d).padStart(2, '0');
        if (hEl) hEl.textContent = String(h).padStart(2, '0');
        if (mEl) mEl.textContent = String(m).padStart(2, '0');
        if (sEl) sEl.textContent = String(s).padStart(2, '0');
    }
    refreshCountdown();
    setInterval(refreshCountdown, 1000);

    // 4. RSVP Submit Handler
    const rForm = document.getElementById('t5-rsvp-form');
    const rBtn = document.getElementById('t5-form-btn');
    const outBox = document.getElementById('t5-outgoing-bubbles');
    const wStream = document.getElementById('t5-wishes-stream');
    const wSection = document.getElementById('t5-wishes-section');

    if (rForm) {
        rForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            if (rBtn) {
                rBtn.disabled = true;
                rBtn.innerHTML = '<span class="inline-block w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin"></span> <span>Mengirimkan Konfirmasi...</span>';
            }

            const fd = new FormData(this);
            const data = Object.fromEntries(fd.entries());

            // Normalisasi email & phone agar selalu lolos validasi server
            if (!data.email || !data.email.includes('@')) {
                const phoneInput = data.email || '';
                const safeName = (data.name || 'tamu').toLowerCase().replace(/[^a-z0-9]/g, '') || 'tamu';
                data.email = `${safeName}_${Date.now()}@undangan.local`;
                if (phoneInput) data.phone = phoneInput;
            }

            try {
                const res = await fetch('<%= rsvpPath %>', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || ''
                    },
                    body: JSON.stringify(data)
                });
                const result = await res.json();

                if (res.ok) {
                    closeRSVPDialog();
                    playSentSound();

                    // Bubble Chat Keluar (Hijau dengan Double Checkmarks)
                    const chatMain = document.getElementById('t5-chat-main');
                    if (outBox && chatMain) {
                        chatMain.appendChild(outBox);
                        const outBubble = document.createElement('div');
                        outBubble.className = 'flex justify-end max-w-[90%] sm:max-w-[80%] ml-auto chat-pop';
                        outBubble.innerHTML = `
                            <div class="wa-bubble-out p-3 shadow-sm text-xs space-y-1">
                                <p class="font-bold text-[#111b21]">${data.attendance === 'hadir' ? '✅ Saya Konfirmasi Hadir' : '❌ Saya Berhalangan Hadir'}</p>
                                ${data.message ? `<p class="leading-relaxed font-medium text-[#111b21]">"${data.message}"</p>` : ''}
                                <div class="flex items-center justify-end space-x-1 text-[10px] text-slate-600 font-mono pt-0.5">
                                    <span>Baru saja</span>
                                    <span class="text-blue-500 font-bold">✓✓</span>
                                </div>
                            </div>
                        `;
                        outBox.appendChild(outBubble);
                        chatMain.scrollTo({ top: chatMain.scrollHeight, behavior: 'smooth' });

                        // Balasan otomatis dari Mempelai setelah 1.2 detik
                        setTimeout(() => {
                            playIncomingSound();
                            const replyBubble = document.createElement('div');
                            replyBubble.className = 'flex items-start max-w-[90%] sm:max-w-[80%] chat-pop';
                            replyBubble.innerHTML = `
                                <div class="wa-bubble-in p-3.5 shadow-sm text-xs space-y-1">
                                    <p class="font-bold text-[#111b21]"><%= fv(event?.groom_name, 'David') %> & <%= fv(event?.bride_name, 'Sarah') %></p>
                                    <p class="leading-relaxed text-[#111b21]">
                                        Alhamdulillah, terima kasih banyak <strong>${data.name}</strong> atas konfirmasi dan doanya! Semoga Allah membalas dengan kebaikan berlipat. Sampai jumpa di hari bahagia kami 🙏🥰
                                    </p>
                                    <div class="wa-time text-right font-mono">Baru saja</div>
                                </div>
                            `;
                            outBox.appendChild(replyBubble);
                            chatMain.scrollTo({ top: chatMain.scrollHeight, behavior: 'smooth' });
                        }, 1200);
                    }

                    if (wSection) wSection.classList.remove('hidden');

                    if (data.message && wStream) {
                        const emptyEl = document.getElementById('t5-empty-wishes');
                        if (emptyEl) emptyEl.remove();

                        const streamItem = document.createElement('div');
                        streamItem.className = 'flex items-start max-w-[88%] chat-pop';
                        streamItem.innerHTML = `
                            <div class="wa-bubble-in p-3 shadow-sm text-xs w-full">
                                <div class="flex items-center justify-between mb-1">
                                    <span class="font-bold text-[#111b21]">${data.name}</span>
                                    <span class="text-[10px] px-1.5 py-0.2 rounded font-semibold ${data.attendance === 'hadir' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-700'}">
                                        ${data.attendance === 'hadir' ? 'Hadir' : 'Berhalangan'}
                                    </span>
                                </div>
                                <p class="leading-relaxed text-[#111b21]">${data.message}</p>
                                <div class="wa-time text-right font-mono mt-1">Baru saja</div>
                            </div>
                        `;
                        wStream.prepend(streamItem);
                    }

                    rForm.reset();
                } else {
                    alert('Gagal mengirim RSVP: ' + (result.message || 'Terjadi kesalahan'));
                }
            } catch(e) {
                alert('Gagal mengirim RSVP.');
            } finally {
                if (rBtn) {
                    rBtn.disabled = false;
                    rBtn.textContent = 'Kirim Konfirmasi Balasan';
                }
            }
        });
    }

    // Dukungan tekan Enter untuk kirim pesan cepat
    const quickInp = document.getElementById('t5-quick-input');
    if (quickInp) {
        quickInp.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                sendQuickWish();
            }
        });
    }
});

// Quick Wish Send dari Bottom Bar (Langsung kirim pesan ke obrolan di paling bawah)
function sendQuickWish() {
    const input = document.getElementById('t5-quick-input');
    if (!input || !input.value.trim()) return;
    const msg = input.value.trim();
    input.value = '';
    playSentSound();
    appendOutgoingBubble(msg);

    // Sinkronisasi ucapan ke backend RSVP di background
    const guestName = document.getElementById('t5-chat-guest')?.textContent || 'Tamu Undangan';
    const safeName = guestName.toLowerCase().replace(/[^a-z0-9]/g, '') || 'tamu';
    fetch('<%= rsvpPath %>', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || ''
        },
        body: JSON.stringify({
            name: guestName,
            email: `${safeName}_${Date.now()}@undangan.local`,
            attendance: 'hadir',
            number_of_guests: 1,
            message: msg
        })
    }).catch(() => {});
}
</script>
</body>
</html>
