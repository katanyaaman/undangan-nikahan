<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title || 'Telegram Group Undangan - ' + fv(event?.groom_name, 'David') + ' & ' + fv(event?.bride_name, 'Sarah') %></title>
    <link rel="stylesheet" href="/css/app.css">

    <style>
        /* Telegram iOS: system font, warna dan wallpaper khas */
        html, body, #t8-chat-wrapper, .font-sans, p, span, div, h1, h2, h3, h4, h5, h6, strong, a, label, input, textarea, button, select {
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
        }

        body {
            background-color: #0f141b !important;
            color: #000000 !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow-x: hidden !important;
            -webkit-font-smoothing: antialiased;
        }

        /* iPhone 17 Pro Max: 440pt, Dynamic Island */
        .phone-container {
            width: 100% !important;
            max-width: 440px !important;
            margin-left: auto !important;
            margin-right: auto !important;
        }

        @media (max-width: 640px) {
            body {
                background-color: #dfe5ec !important;
            }
            .phone-container {
                max-width: 100% !important;
                border-left-width: 0 !important;
                border-right-width: 0 !important;
                box-shadow: none !important;
            }
        }

        /* Wallpaper Telegram terang: gambar webp proporsional (gak gepeng) */
        .tg-bg-authentic {
            background-color: #7d9675 !important;
            background-image: url('/images/telegram-bg.webp') !important;
            background-size: cover !important;
            background-position: center top !important;
            background-repeat: no-repeat !important;
        }

        /* Bubble masuk Telegram (putih, radius resmi 15px, ukuran font proporsional) */
        .tg-bubble-in {
            background-color: #ffffff !important;
            color: #000000 !important;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08) !important;
            border-radius: 15px !important;
            border-top-left-radius: 5px !important;
            position: relative !important;
            font-size: 14px !important;
            line-height: 1.4 !important;
            letter-spacing: -0.01em !important;
            display: flow-root !important;
            max-width: 82% !important;
            min-width: 0 !important;
            overflow-wrap: break-word !important;
            word-break: break-word !important;
        }
        .tg-bubble-in.tg-wide { max-width: 100% !important; }
        .tg-bubble-in.has-tail::before {
            content: "";
            position: absolute;
            top: 0;
            left: -6px;
            width: 9px;
            height: 13px;
            background-color: #ffffff;
            clip-path: polygon(100% 0, 0 0, 100% 100%);
        }

        /* Bubble keluar Telegram (hijau muda khas) */
        .tg-bubble-out {
            background-color: #dff3c6 !important;
            color: #000000 !important;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08) !important;
            border-radius: 15px !important;
            border-top-right-radius: 5px !important;
            position: relative !important;
            font-size: 14px !important;
            line-height: 1.4 !important;
            letter-spacing: -0.01em !important;
            display: flow-root !important;
            max-width: 82% !important;
            min-width: 0 !important;
            overflow-wrap: break-word !important;
            word-break: break-word !important;
        }
        .tg-bubble-in.tg-wide { max-width: 100% !important; }
        .tg-bubble-out.has-tail::before {
            content: "";
            position: absolute;
            top: 0;
            right: -6px;
            width: 9px;
            height: 13px;
            background-color: #dff3c6;
            clip-path: polygon(0 0, 100% 0, 0 100%);
        }

        /* Nama pengirim khas grup Telegram */
        .tg-sender-bride { color: #d95990 !important; font-weight: 600 !important; font-size: 15px !important; }
        .tg-sender-groom { color: #3fa2f7 !important; font-weight: 600 !important; font-size: 15px !important; }

        /* Timestamp Telegram */
        .tg-msg-meta {
            float: right;
            margin-left: 8px;
            margin-top: 6px;
            margin-bottom: -3px;
            display: inline-flex;
            align-items: center;
            gap: 3px;
            white-space: nowrap;
            user-select: none;
        }
        .tg-time { font-size: 12px !important; color: #8e8e93 !important; font-variant-numeric: tabular-nums; }
        .tg-checks { color: #4ab3f1 !important; font-size: 12px !important; line-height: 1 !important; }

        /* Pesan service Telegram (tengah, gelap transparan) */
        .tg-service {
            background-color: rgba(25, 35, 48, 0.62) !important;
            color: #ffffff !important;
            border-radius: 13px !important;
            font-size: 13px !important;
            line-height: 1.35 !important;
            text-align: center !important;
            max-width: 100% !important;
            white-space: normal !important;
            overflow-wrap: break-word !important;
        }
        .tg-service * { color: #ffffff !important; }

        /* Fallback warna teks notifikasi + tombol VN (tidak tergantung build Tailwind) */
        .t8-nt-app { color: #8e8e93 !important; }
        .t8-nt-title { color: #000000 !important; }
        .t8-nt-body { color: rgba(0, 0, 0, 0.8) !important; }
        #t8-vn-btn {
            background: rgba(42, 171, 238, 0.55) !important;
            backdrop-filter: blur(12px) saturate(160%) !important;
            -webkit-backdrop-filter: blur(12px) saturate(160%) !important;
            border: 1px solid rgba(255, 255, 255, 0.55) !important;
            box-shadow: 0 2px 10px rgba(42, 171, 238, 0.35), inset 0 1px 1px rgba(255, 255, 255, 0.4) !important;
            color: #ffffff !important;
        }
        #t8-vn-btn.vn-live { animation: t8vnPulse 1.6s ease-out infinite !important; }
        @keyframes t8vnPulse {
            0% { box-shadow: 0 0 0 0 rgba(42, 171, 238, 0.45), inset 0 1px 1px rgba(255, 255, 255, 0.4); }
            70% { box-shadow: 0 0 0 10px rgba(42, 171, 238, 0), inset 0 1px 1px rgba(255, 255, 255, 0.4); }
            100% { box-shadow: 0 0 0 0 rgba(42, 171, 238, 0), inset 0 1px 1px rgba(255, 255, 255, 0.4); }
        }
        #t8-speed-btn {
            background: rgba(42, 171, 238, 0.16) !important;
            backdrop-filter: blur(8px) saturate(150%) !important;
            -webkit-backdrop-filter: blur(8px) saturate(150%) !important;
            border: 1px solid rgba(42, 171, 238, 0.5) !important;
            color: #007aff !important;
        }

        /* Kartu dalam pesan */
        .tg-inner-card {
            background-color: #f4f6f9 !important;
            border-radius: 12px !important;
        }

        /* Inline keyboard ala bot Telegram: tombol penuh selebar pesan */
        .tg-inline-btn {
            background-color: rgba(255, 255, 255, 0.92) !important;
            color: #007aff !important;
            border-radius: 10px !important;
            min-height: 44px !important;
            padding: 10px 14px !important;
            font-size: 15px !important;
            font-weight: 500 !important;
            line-height: 1.3 !important;
            text-align: center !important;
            overflow-wrap: anywhere !important;
            box-shadow: 0 1px 1px rgba(0, 0, 0, 0.1) !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 6px !important;
            width: 100% !important;
            cursor: pointer !important;
            transition: background-color 0.15s ease !important;
        }
        .tg-inline-btn:active { background-color: rgba(0, 122, 255, 0.12) !important; }

        /* Polling ala Telegram: radio + persen + garis animasi + footer */
        .tg-poll-bar { transition: width 0.6s cubic-bezier(0.2, 0.9, 0.3, 1) !important; }
        .tg-poll-pct { transition: opacity 0.34s ease !important; }
        .tg-radio {
            width: 20px !important;
            height: 20px !important;
            border-radius: 50% !important;
            border: 2px solid #8e8e93 !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            flex-shrink: 0 !important;
            transition: all 0.15s ease !important;
        }
        .tg-radio.chosen {
            border-color: #2aabee !important;
            background-color: #2aabee !important;
            color: #ffffff !important;
        }

        /* Waveform voice message */
        @keyframes tgWaveAnim {
            0%, 100% { height: 6px; }
            50% { height: 22px; }
        }
        .tg-wave.playing { animation: tgWaveAnim 0.9s ease-in-out infinite; }

        /* Animasi kemunculan pesan */
        .chat-pop { animation: tgPop 0.25s ease-out forwards; }
        @keyframes tgPop {
            0% { opacity: 0; transform: translateY(6px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        /* Container obrolan penuh */
        #t8-chat-wrapper {
            height: 100vh !important;
            height: 100dvh !important;
            min-height: 100vh !important;
            min-height: 100dvh !important;
            max-height: 100vh !important;
            max-height: 100dvh !important;
            display: flex !important;
            flex-direction: column !important;
            overflow: hidden !important;
            position: relative !important;
        }
        #t8-chat-main {
            flex: 1 1 0% !important;
            min-height: 0 !important;
            overflow-y: auto !important;
            overscroll-behavior: contain !important;
            scroll-behavior: smooth !important;
        }
        #t8-bottom-bar { flex-shrink: 0 !important; width: 100% !important; position: relative !important; z-index: 40 !important; }

        html, body, #t8-chat-main, #t8-chat-wrapper, * {
            -ms-overflow-style: none !important;
            scrollbar-width: none !important;
        }
        ::-webkit-scrollbar { display: none !important; width: 0 !important; height: 0 !important; }

        /* === LIGHT THEME ala Telegram (mode terang resmi) === */
        #t8-chat-wrapper {
            background-color: #7d9675 !important;
            background-image: url('/images/telegram-bg.webp') !important;
            background-size: cover !important;
            background-position: center top !important;
            background-repeat: no-repeat !important;
        }
        .tg-bg-authentic {
            background-color: transparent !important;
            background-image: url('/images/telegram-bg.webp') !important;
            background-size: cover !important;
            background-position: center top !important;
            background-repeat: no-repeat !important;
        }
        .tg-service {
            background-color: rgba(94, 167, 93, 0.92) !important;
            color: #ffffff !important;
            max-width: 100% !important;
            white-space: normal !important;
            overflow-wrap: break-word !important;
        }
        .tg-service * { color: #ffffff !important; }

        /* Badge admin grup */
        .tg-admin {
            font-size: 11px !important;
            font-weight: 600 !important;
            color: #0b8457 !important;
            background: rgba(11, 133, 87, 0.12) !important;
            padding: 2px 6px !important;
            border-radius: 6px !important;
            margin-left: 6px !important;
            white-space: nowrap !important;
        }

        /* Kutipan balasan di dalam bubble */
        .tg-quote {
            border-left: 3px solid #3fa2f7 !important;
            background: rgba(0, 0, 0, 0.045) !important;
            border-radius: 8px !important;
            padding: 6px 8px !important;
            margin-bottom: 6px !important;
        }
        .tg-quote-text {
            font-size: 14px !important;
            color: #55575c !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
        }

        /* Bilangan views khas grup */
        .tg-views { color: #8e8e93 !important; font-size: 12px !important; white-space: nowrap !important; }

        /* Header nav iOS terang */
        .t8-navheader {
            display: flex !important;
            align-items: center !important;
            gap: 4px !important;
            background: rgba(255, 255, 255, 0.82) !important;
            backdrop-filter: blur(20px) saturate(150%) !important;
            -webkit-backdrop-filter: blur(20px) saturate(150%) !important;
            border-bottom: 1px solid rgba(0, 0, 0, 0.08) !important;
            box-shadow: 0 1px 5px -1px rgba(0, 0, 0, 0.12) !important;
            padding: 6px 8px !important;
            position: relative !important;
            z-index: 30 !important;
        }
        .t8-back { color: #007aff !important; font-size: 16px !important; padding: 8px 6px !important; min-width: 44px !important; min-height: 44px !important; }
        .t8-navtitle { color: #000000 !important; font-size: 16px !important; font-weight: 600 !important; }
        .t8-navstatus { color: #8e8e93 !important; font-size: 13px !important; }

        /* Bar voice chat terang */
        .tg-voicebar {
            background-color: rgba(227, 242, 253, 0.96) !important;
            border-radius: 14px !important;
            padding: 8px 10px !important;
            display: flex !important;
            align-items: center !important;
            gap: 8px !important;
            box-shadow: 0 1px 1px rgba(0, 0, 0, 0.1) !important;
        }
        .tg-joinbtn {
            background-color: #2aabee !important;
            color: #ffffff !important;
            font-weight: 700 !important;
            font-size: 14px !important;
            border-radius: 9999px !important;
            padding: 8px 18px !important;
            min-height: 44px !important;
        }
        .tg-miniava {
            width: 26px !important;
            height: 26px !important;
            border-radius: 50% !important;
            object-fit: cover !important;
            border: 2px solid rgba(255, 255, 255, 1) !important;
            margin-left: -8px !important;
        }
        .tg-miniava:first-child { margin-left: 0 !important; }

        /* Bar pinned message terang */
        .t8-pinned {
            display: flex !important;
            align-items: center !important;
            gap: 8px !important;
            background: rgba(255, 255, 255, 0.9) !important;
            backdrop-filter: blur(20px) saturate(150%) !important;
            -webkit-backdrop-filter: blur(20px) saturate(150%) !important;
            border-bottom: 1px solid rgba(0, 0, 0, 0.08) !important;
            padding: 6px 10px !important;
            position: relative !important;
            z-index: 30 !important;
        }
        .t8-pinned.hidden { display: none !important; }

        /* Tombol lompat ke bawah */
        .t8-fab {
            position: absolute !important;
            right: 12px !important;
            bottom: 92px !important;
            width: 44px !important;
            height: 44px !important;
            border-radius: 50% !important;
            background: rgba(255, 255, 255, 0.96) !important;
            color: #333333 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25) !important;
            z-index: 35 !important;
        }
        .t8-fab.hidden { display: none !important; }

        /* Input bar terang */
        .t8-inputbar {
            background: rgba(255, 255, 255, 0.92) !important;
            backdrop-filter: blur(20px) saturate(150%) !important;
            -webkit-backdrop-filter: blur(20px) saturate(150%) !important;
            border-top: 1px solid rgba(0, 0, 0, 0.08) !important;
        }
        .t8-field {
            background-color: #e9ebee !important;
            border-radius: 9999px !important;
            padding: 8px 14px !important;
            color: #000000 !important;
        }
        .t8-field::placeholder { color: #8e8e93; }
        .t8-homebar { background: rgba(255, 255, 255, 0.92) !important; display: flex !important; justify-content: center !important; padding: 6px 0 !important; }
        .t8-homebar-pill { width: 128px !important; height: 4px !important; border-radius: 9999px !important; background: rgba(0, 0, 0, 0.35) !important; }
    </style>
</head>
<body id="t8-body" class="bg-[#0f141b] text-black font-sans antialiased overflow-x-hidden select-none min-h-screen">

<!-- Audio Element Pernikahan -->
<audio id="t8-audio" loop preload="auto">
    <source src="/music/wedding-song.mp3" type="audio/mpeg">
    <source src="/music/wedding-song.wav" type="audio/wav">
</audio>

<!-- =================================================================== -->
<!-- 1. NOTIFIKASI TELEGRAM DI LOCKSCREEN -->
<!-- =================================================================== -->
<div id="t8-lockscreen" class="fixed inset-0 z-50 flex items-center justify-center bg-[#0f141b] transition-all duration-700">
    <div class="phone-container h-full min-h-[100dvh] max-h-[100dvh] flex flex-col justify-between p-4 sm:p-6 bg-gradient-to-b from-slate-950 via-slate-900 to-black text-white shadow-2xl relative border-x border-white/10 overflow-y-auto">

        <div class="w-full flex items-center justify-between text-xs font-semibold px-2 text-slate-300">
            <span id="t8-clock-mini" class="font-mono">09:41</span>
            <div class="h-7 w-28 bg-black/90 rounded-full border border-white/15 shadow-2xl mx-auto"></div>
            <div class="flex items-center space-x-2">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zm6-4a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zm6-3a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"></path></svg>
                <div class="w-5 h-2.5 border border-slate-300 rounded-sm p-0.5 flex items-center">
                    <div class="w-full h-full bg-emerald-400 rounded-[2px]"></div>
                </div>
            </div>
        </div>

        <div class="flex-1 flex flex-col items-center justify-center space-y-6">
            <div class="text-center">
                <p id="t8-clock-big" class="text-7xl font-extralight tracking-tight">09:41</p>
                <p class="text-sm text-slate-300 mt-1">Rabu, 31 Desember</p>
            </div>

            <!-- Single Authentic Notification Card (Tanpa Dobel) -->
            <div id="t8-notif-card" onclick="openTGChat()" class="w-full max-w-sm bg-white/95 backdrop-blur-xl rounded-2xl p-3.5 flex items-start space-x-3 cursor-pointer active:scale-95 transition-transform shadow-2xl text-left">
                <div class="w-10 h-10 rounded-full bg-gradient-to-b from-[#5ca3ec] to-[#2a7fd5] flex items-center justify-center shrink-0 shadow-sm">
                    <svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M21.9 4.6L2.7 12.1c-.7.3-.7 1.2.1 1.4l4.8 1.5 1.8 5.6c.2.7 1.1.9 1.6.3l2.6-2.6 5 3.7c.6.4 1.4.1 1.6-.6l3.1-15.3c.2-.9-.6-1.7-1.4-1.5zM8.4 13.5l9.5-6.7c.2-.1.4.1.2.3l-7.8 7.1-.3 3-1.6-3.7z"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between mb-0.5">
                        <p class="t8-nt-app text-[11px] font-semibold tracking-wide">TELEGRAM</p>
                        <p class="text-[11px] text-slate-400 font-medium">now</p>
                    </div>
                    <p class="t8-nt-title text-[14px] font-semibold text-black truncate mb-0.5">Road to Halal 💍 (5)</p>
                    <p id="t8-notif-action-text" class="t8-nt-body text-[13px] text-slate-700 truncate leading-snug">
                        Sarah: Halo <strong class="t8-guest-name font-semibold"><%= (typeof to !== 'undefined' && to) ? to : (locals.to || 'Tamu Undangan') %></strong>! Ada kabar bahagia buat kamu... 🙈✨
                    </p>
                </div>
            </div>
            
            <p class="text-xs text-slate-400 font-medium">Ketuk notifikasi untuk membuka undangan</p>
        </div>

        <div class="w-32 h-1 bg-white/80 rounded-full mx-auto"></div>
    </div>
</div>

<!-- =================================================================== -->
<!-- 2. LAYAR OBROLAN GRUP TELEGRAM -->
<!-- =================================================================== -->
<div id="t8-chat-wrapper" class="hidden phone-container bg-[#0f141b] shadow-2xl border-x border-white/10">

    <!-- Header grup Telegram: ‹ Chats | judul tengah | avatar -->
    <div class="t8-navheader">
        <button onclick="backToNotif()" aria-label="Kembali" class="t8-back shrink-0">‹ Chats</button>
        <div class="flex-1 min-w-0 text-center leading-tight cursor-pointer" onclick="scrollTGTop()">
            <p class="t8-navtitle truncate">Road to Halal 💍</p>
            <p id="t8-header-status" class="t8-navstatus truncate">5 members, 2 online</p>
        </div>
        <div class="w-9 h-9 rounded-full bg-gradient-to-b from-[#e46aa0] to-[#b04a7e] flex items-center justify-center text-white text-sm font-semibold shrink-0">RH</div>
    </div>

    <!-- Bar pinned message -->
    <div id="t8-pinnedbar" class="t8-pinned hidden">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-b from-[#e46aa0] to-[#b04a7e] flex items-center justify-center text-white shrink-0">💍</div>
        <div class="flex-1 min-w-0 leading-tight cursor-pointer" onclick="goPinned()">
            <p class="text-[14px] font-semibold truncate" style="color:#007aff">Pinned Message</p>
            <p class="text-[13px] truncate" style="color:#55575c">Road to Halal 💍 • <%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %></p>
        </div>
        <button onclick="unpinBar(event)" aria-label="Lepas pin" class="shrink-0" style="min-width:44px;min-height:44px;color:#8e8e93">
            <svg class="w-5 h-5 mx-auto" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 4h6l1 7 3 3v2H5v-2l3-3 1-7zM12 16v5"></path></svg>
        </button>
    </div>

    <!-- Aliran pesan -->
    <div id="t8-chat-main" class="tg-bg-authentic flex-1 px-2.5 py-3 space-y-2 overflow-y-auto">

        <div id="t8-date-pin" class="hidden text-center chat-pop">
            <span class="inline-block tg-service px-3 py-1">December 31</span>
        </div>

        <!-- 1. System: David created group -->
        <div id="chat-step-created" class="hidden text-center chat-pop">
            <span class="inline-block tg-service px-3 py-1"><%= fv(event?.groom_name, 'David') %> created the group "Road to Halal 💍"</span>
        </div>

        <!-- 2. Bubble Sarah: ngingetin David buat add bestie -->
        <div id="chat-step-1" class="hidden flex items-end space-x-1.5 max-w-[92%] chat-pop">
            <img src="<%= bridePhoto || '/images/demo/bride.svg' %>" alt="Sarah" class="w-8 h-8 rounded-full object-cover shrink-0 aspect-square bg-slate-200">
            <div class="tg-bubble-in has-tail min-w-0 px-3 py-2 shadow-xs">
                <p class="tg-sender-bride mb-0.5"><%= fv(event?.bride_name, 'Sarah') %><span class="tg-admin">admin</span></p>
                <p class="text-[14px] leading-relaxed text-black">
                    Yang, jangan lupa invite bestie kita si <strong class="t8-guest-name font-semibold"><%= (typeof to !== 'undefined' && to) ? to : (locals.to || 'Tamu Undangan') %></strong> ke grup ya! Dia wajib banget tau kabar bahagia kita duluan 🙈✨
