            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2"></path></svg>
        </button>
        <button type="button" id="t8-send-btn" onclick="sendQuickWish()" aria-label="Kirim" class="w-9 h-9 text-[#007aff] hidden items-center justify-center shrink-0 min-w-[44px] min-h-[44px]">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm4.3 7.3l-7 7a1 1 0 01-1.4-1.4l7-7a1 1 0 011.4 1.4z" opacity="0"/><path d="M3.4 20.4l17.5-8.4c.8-.4.8-1.6 0-2L3.4 1.6c-.7-.3-1.5.2-1.5 1l2.1 7.1c.1.4.5.7.9.7H11c.6 0 1 .4 1 1s-.4 1-1 1H4.9c-.4 0-.8.3-.9.7L1.9 19.4c0 .8.8 1.3 1.5 1z"/></svg>
        </button>
        <button type="button" id="t8-mic-btn" onclick="toggleVNAudio()" aria-label="Voice message" class="w-9 h-9 text-[#007aff] flex items-center justify-center shrink-0 min-w-[44px] min-h-[44px]">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15a3 3 0 003-3V6a3 3 0 10-6 0v6a3 3 0 003 3zm7-3a7 7 0 01-14 0H3a10 10 0 008 9.9V22h2v-1.1A10 10 0 0021 12h-2z"></path></svg>
        </button>
    </div>
    <div class="t8-homebar"><div class="t8-homebar-pill"></div></div>
</div>

<div id="t8-toast" class="hidden fixed bottom-24 left-1/2 -translate-x-1/2 z-[60] bg-black/80 text-white text-[13px] px-4 py-2 rounded-full whitespace-nowrap"></div>

<script>
// Status bar clock
function tickClock() {
    try {
        const d = new Date();
        const s = String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
        const a = document.getElementById('t8-clock-mini');
        const b = document.getElementById('t8-clock-big');
        if (a) a.textContent = s;
        if (b) b.textContent = s;
    } catch (e) {}
}
setInterval(tickClock, 1000);
tickClock();

// Bunyi pesan ala Telegram (WebAudio, best-effort)
let t8AC = null;
function t8blip(freq, dur, vol, delay) {
    try {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return;
        if (!t8AC) t8AC = new AC();
        if (t8AC.state === 'suspended') t8AC.resume();
        const t = t8AC.currentTime + (delay || 0);
        const o = t8AC.createOscillator();
        const g = t8AC.createGain();
        o.type = 'sine';
        o.frequency.setValueAtTime(freq, t);
        g.gain.setValueAtTime(vol || 0.04, t);
        g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
        o.connect(g);
        o.connect(t8AC.destination);
        o.start(t);
        o.stop(t + dur + 0.02);
    } catch (e) {}
}
function t8sndSend() { t8blip(880, 0.08, 0.05, 0); }
function t8sndIncoming() { t8blip(660, 0.07, 0.03, 0); t8blip(990, 0.09, 0.03, 0.07); }

function showT8Toast(msg) {
    const t = document.getElementById('t8-toast');
    if (!t) return;
    t.textContent = msg;
    t.classList.remove('hidden');
    clearTimeout(t._h);
    t._h = setTimeout(() => t.classList.add('hidden'), 2200);
}

function scrollTGChatTo(el) {
    const main = document.getElementById('t8-chat-main');
    if (!main) return;
    setTimeout(() => {
        if (el && el.scrollIntoView) el.scrollIntoView({ behavior: 'smooth', block: 'end' });
        else main.scrollTo({ top: main.scrollHeight, behavior: 'smooth' });
    }, 60);
}
function scrollTGTop() {
    const main = document.getElementById('t8-chat-main');
    if (main) main.scrollTo({ top: 0, behavior: 'smooth' });
}
function backToNotif() {
    const lock = document.getElementById('t8-lockscreen');
    const chat = document.getElementById('t8-chat-wrapper');
    if (lock && chat) {
        chat.classList.add('hidden');
        lock.style.display = 'flex';
        requestAnimationFrame(() => lock.classList.remove('opacity-0'));
    }
}
function goPinned() {
    revealSection('t8-event-bubble', null);
}
function unpinBar(e) {
    if (e) e.stopPropagation();
    const bar = document.getElementById('t8-pinnedbar');
    if (bar) bar.classList.add('hidden');
}
function fabGoBottom() {
    const main = document.getElementById('t8-chat-main');
    if (main) main.scrollTo({ top: main.scrollHeight, behavior: 'smooth' });
}
function setHeaderStatus(text, typing) {
    const h = document.getElementById('t8-header-status');
    if (!h) return;
    h.textContent = text;
    h.style.color = typing ? '#0a84ff' : '';
}

// Buka obrolan dari notifikasi
function openTGChat() {
    try {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!t8AC && AC) t8AC = new AC();
        if (t8AC && t8AC.state === 'suspended') t8AC.resume();
        const bgAudio = document.getElementById('t8-audio');
        if (bgAudio) { bgAudio.play().catch(() => {}); }
    } catch (e) {}
    const lock = document.getElementById('t8-lockscreen');
    const chat = document.getElementById('t8-chat-wrapper');
    if (!lock || !chat) return;
    lock.classList.add('opacity-0');
    setTimeout(() => {
        lock.style.display = 'none';
        chat.classList.remove('hidden');
        const main = document.getElementById('t8-chat-main');
        if (main) main.scrollTop = 0;
        startStaggeredChat();
    }, 450);
}

function showTyping(name, ms) {
    return new Promise((resolve) => {
        const row = document.getElementById('t8-typing-row');
        setHeaderStatus(name + ' is typing...', true);
        if (row) {
            row.classList.remove('hidden');
            row.classList.add('flex');
            scrollTGChatTo(row);
        }
        setTimeout(() => {
            if (row) {
                row.classList.add('hidden');
                row.classList.remove('flex');
            }
            setHeaderStatus('5 members, 2 online', false);
            resolve();
        }, ms);
    });
}

function showStep(id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.remove('hidden');
    t8sndIncoming();
    scrollTGChatTo(el);
}

// Urutan chat logis dan alami
async function startStaggeredChat() {
    if (window._t8Started) return;
    window._t8Started = true;
    const wait = (ms) => new Promise((r) => setTimeout(r, ms));

    showStep('t8-date-pin');
    const pinned = document.getElementById('t8-pinnedbar');
    if (pinned) pinned.classList.remove('hidden');
    await wait(400);

    // 1. David buat grup
    showStep('chat-step-created');
    await wait(600);

    // 2. Sarah minta David buat invite si tamu
    await showTyping('Sarah', 900);
    showStep('chat-step-1');
    await wait(700);

    // 3. David setuju mau invite
    await showTyping('David', 800);
    showStep('chat-step-2');
    await wait(600);

    // 4. David baru add tamu (Urutan logis!)
    showStep('chat-step-added');
    await wait(700);

    // 5. Sarah menyapa tamu
    await showTyping('Sarah', 1000);
    showStep('chat-step-3');
    await wait(700);

    // 6. David memberi penjelasan
    await showTyping('David', 900);
    showStep('chat-step-4');
    await wait(800);

    // 7. Voice note & pilihan menu
    showStep('chat-step-vn');
    await wait(800);
    showStep('chat-actions-hub');
}

// Bubble keluar tamu
function nowTGTime() {
    const d = new Date();
    return String(d.getHours()).padStart(2, '0') + '.' + String(d.getMinutes()).padStart(2, '0');
}
function appendGuestOutgoing(text) {
    const box = document.getElementById('t8-outgoing-bubbles');
    if (!box) return;
    const safe = String(text).replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const div = document.createElement('div');
    div.className = 'flex justify-end chat-pop';
    div.innerHTML = '<div class="tg-bubble-out has-tail px-3 py-2 shadow-xs"><p class="text-[14px] leading-relaxed text-black">' + safe +
        '<span class="tg-msg-meta"><span class="tg-time">' + nowTGTime() + '</span><span class="tg-checks">✓✓</span></span></p></div>';
    box.appendChild(div);
}

// Inline keyboard: tampilkan detail + kirim pilihan sebagai bubble keluar
const t8Shown = {};
function revealSection(id, btn) {
    if (btn && btn.disabled) return;
    if (t8Shown[id]) {
        const el = document.getElementById(id);
        if (el) scrollTGChatTo(el);
        return;
    }
    t8Shown[id] = true;
    if (btn) {
        btn.disabled = true;
        btn.style.opacity = '0.55';
        appendGuestOutgoing(btn.textContent.trim());
    }
    setTimeout(() => showStep(id), 450);
}
function revealAllSections(btn) {
    if (btn) {
        btn.disabled = true;
        btn.style.opacity = '0.55';
        appendGuestOutgoing('Tampilkan semua rincian 🙏');
    }
    ['t8-event-bubble', 't8-gallery-bubble', 't8-poll-bubble', 't8-gift-bubble'].forEach((id, i) => {
        if (!t8Shown[id]) {
            t8Shown[id] = true;
            setTimeout(() => showStep(id), 450 + i * 550);
        }
    });
}

// Voice Note bersuara Indonesia
let vnAudioTimer = null;
let vnPlaying = false;
let vnElapsedSec = 0;
let vnRate = 1;
function fmtVNTime(sec) {
    const m = String(Math.floor(sec / 60)).padStart(2, '0');
    const s = String(Math.floor(sec % 60)).padStart(2, '0');
    return m + ':' + s;
}
function setVNPlayingUI(playing) {
    const playIcon = document.getElementById('t8-vn-play-icon');
    const pauseIcon = document.getElementById('t8-vn-pause-icon');
    const vnBtn = document.getElementById('t8-vn-btn');
    const bars = document.querySelectorAll('#chat-step-vn .tg-wave');
    if (playIcon) playIcon.classList.toggle('hidden', playing);
    if (pauseIcon) pauseIcon.classList.toggle('hidden', !playing);
    if (vnBtn) vnBtn.classList.toggle('vn-live', playing);
    bars.forEach((b, i) => {
        b.classList.toggle('playing', playing);
        b.style.animationDelay = playing ? ((i % 5) * 0.12) + 's' : '';
        b.style.backgroundColor = playing ? '#2aabee' : '';
    });
}
function pickIDVoice() {
    try {
        const vs = window.speechSynthesis.getVoices() || [];
        return vs.find((v) => /^id([-_]|$)/i.test(v.lang || '')) || null;
    } catch (e) { return null; }
}
function vnGreetingText() {
    const gEl = document.querySelector('.t8-guest-name');
    const guest = ((gEl ? gEl.textContent : '') || 'Tamu Undangan').trim().replace(/["<>]/g, '') || 'Tamu Undangan';
    const bride = "<%= fv(event?.bride_name, 'Sarah') %>".replace(/["<>]/g, '');
    const groom = "<%= fv(event?.groom_name, 'David') %>".replace(/["<>]/g, '');
    return 'Halo ' + guest + '! Aku ' + bride + ', dan aku ' + groom + '. Makasih banyak sudah gabung ke grup Telegram rahasia kita. Kita punya kabar bahagia banget: kita, mau nikah! Simak sampai habis ya, cek tanggal dan lokasinya, terus isi polling kehadiran kamu. Sampai ketemu di hari bahagia!';
}
function startVNTick() {
    const timeEl = document.getElementById('t8-vn-time');
    if (vnAudioTimer) clearInterval(vnAudioTimer);
    vnAudioTimer = setInterval(() => {
        vnElapsedSec += 0.5;
        if (timeEl) timeEl.textContent = fmtVNTime(vnElapsedSec);
    }, 500);
}
function stopVNTick() {
    if (vnAudioTimer) clearInterval(vnAudioTimer);
    vnAudioTimer = null;
}
function toggleVNAudio() {
    const dot = document.getElementById('t8-vn-dot');
    if (dot) dot.style.display = 'none';
    if (!('speechSynthesis' in window)) {
        const audio = document.getElementById('t8-audio');
        if (!vnPlaying) {
            vnPlaying = true;
            setVNPlayingUI(true);
            if (audio) audio.play().catch(() => {});
            startVNTick();
        } else {
            vnPlaying = false;
            setVNPlayingUI(false);
            if (audio) audio.pause();
            stopVNTick();
        }
        return;
    }
    try { window.speechSynthesis.getVoices(); } catch (e) {}
    if (!vnPlaying) {
        try { window.speechSynthesis.cancel(); } catch (e) {}
        const audio = document.getElementById('t8-audio');
        if (audio) audio.pause();
        const u = new SpeechSynthesisUtterance(vnGreetingText());
        u.lang = 'id-ID';
        u.rate = vnRate;
        u.pitch = 1;
        const voice = pickIDVoice();
        if (voice) u.voice = voice;
        vnPlaying = true;
        vnElapsedSec = 0;
        setVNPlayingUI(true);
        const timeEl = document.getElementById('t8-vn-time');
        if (timeEl) timeEl.textContent = '00:00';
        startVNTick();
        u.onend = () => { vnPlaying = false; setVNPlayingUI(false); stopVNTick(); };
        u.onerror = () => { vnPlaying = false; setVNPlayingUI(false); stopVNTick(); };
        window.speechSynthesis.speak(u);
    } else {
        try { window.speechSynthesis.cancel(); } catch (e) {}
        vnPlaying = false;
        setVNPlayingUI(false);
        stopVNTick();
    }
}
function cycleVNSpeed() {
    vnRate = vnRate === 1 ? 1.5 : (vnRate === 1.5 ? 2 : 1);
    const b = document.getElementById('t8-speed-btn');
    if (b) b.textContent = String(vnRate).replace('.5', ',5') + 'x';
    showT8Toast('Kecepatan VN ' + String(vnRate).replace('.5', ',5') + 'x');
}

// Polling RSVP (anatomi asli: radio + persen + garis + avatar voter)
let pollVoted = false;
let pollResultsShown = false;
function setPollResultsVisible(visible) {
    pollResultsShown = visible;
    ['hadir', 'tidak'].forEach((k) => {
        const pct = document.getElementById('t8-pct-' + k);
        const line = document.getElementById('t8-line-' + k);
        if (pct) pct.classList.toggle('opacity-0', !visible);
        if (line) line.classList.toggle('opacity-0', !visible);
    });
    const f = document.getElementById('t8-poll-footer');
    if (f) f.textContent = visible ? 'Hide Results' : 'View Results';
}
function togglePollResults() {
    setPollResultsVisible(!pollResultsShown);
}
function votePoll(val) {
    const hadir = val === 'hadir';
    const radioH = document.getElementById('t8-radio-hadir');
    const radioT = document.getElementById('t8-radio-tidak');
    if (radioH) {
        radioH.classList.toggle('chosen', hadir);
        radioH.textContent = hadir ? '✓' : '';
    }
    if (radioT) {
        radioT.classList.toggle('chosen', !hadir);
        radioT.textContent = hadir ? '' : '✓';
    }
    const barH = document.getElementById('t8-bar-hadir');
    const barT = document.getElementById('t8-bar-tidak');
    const pctH = document.getElementById('t8-pct-hadir');
    const pctT = document.getElementById('t8-pct-tidak');
    const votes = document.getElementById('t8-votes');
    const att = document.getElementById('t8-form-att');
    if (att) att.value = val;
    const base = parseInt((votes ? votes.textContent : '0'), 10) || 0;
    const hPct = hadir ? 85 : 15;
    if (barH) barH.style.width = hPct + '%';
    if (barT) barT.style.width = (100 - hPct) + '%';
    if (pctH) pctH.textContent = hPct + '%';
    if (pctT) pctT.textContent = (100 - hPct) + '%';
    if (!pollVoted) {
        pollVoted = true;
        if (votes) votes.textContent = String(base + 1);
        const box = document.getElementById('t8-voters');
        if (box) {
            const me = document.createElement('span');
            me.className = 'w-[18px] h-[18px] rounded-full border border-white bg-[#2aabee] text-white text-[10px] font-bold flex items-center justify-center';
            me.textContent = '✓';
            me.title = 'Kamu';
            box.appendChild(me);
        }
    }
    setPollResultsVisible(true);
    showT8Toast(hadir ? 'Mantap, ditunggu kehadirannya!' : 'Gapapa, kirim doa ya!');
    const form = document.getElementById('t8-rsvp-form');
    if (form) scrollTGChatTo(form);
}

// Salin nomor rekening
function copyT8(elementId, btn) {
    const el = document.getElementById(elementId);
    const txt = el ? el.textContent.trim() : '';
    const done = () => {
        showT8Toast('Nomor tersalin!');
        if (btn) {
            const old = btn.textContent;
            btn.textContent = 'OK!';
            setTimeout(() => { btn.textContent = old; }, 1500);
        }
    };
    if (navigator.clipboard && txt) navigator.clipboard.writeText(txt).then(done).catch(done);
    else done();
}

// Countdown
function initCountdown() {
    const target = new Date(("<%= event?.event_date || '2025-12-31 19:00:00' %>").replace(/-/g, '/')).getTime();
    function update() {
        const diff = target - Date.now();
        const set = (id, v) => { const e = document.getElementById(id); if (e) e.textContent = v; };
        if (diff <= 0) {
            set('t8-d', '00'); set('t8-h', '00'); set('t8-m', '00'); set('t8-s', '00');
            return;
        }
        set('t8-d', String(Math.floor(diff / 86400000)).padStart(2, '0'));
        set('t8-h', String(Math.floor(diff / 3600000) % 24).padStart(2, '0'));
        set('t8-m', String(Math.floor(diff / 60000) % 60).padStart(2, '0'));
        set('t8-s', String(Math.floor(diff / 1000) % 60).padStart(2, '0'));
    }
    update();
    setInterval(update, 1000);
}
initCountdown();

// Input bar: mic <-> send + kirim bubble
const quickInput = document.getElementById('t8-quick-input');
const sendBtn = document.getElementById('t8-send-btn');
const micBtn = document.getElementById('t8-mic-btn');
function syncInputBar() {
    const has = !!(quickInput && quickInput.value.trim());
    if (sendBtn) {
        sendBtn.classList.toggle('hidden', !has);
        sendBtn.classList.toggle('flex', has);
    }
    if (micBtn) {
        micBtn.classList.toggle('hidden', has);
        micBtn.classList.toggle('flex', !has);
    }
}
if (quickInput) {
    quickInput.addEventListener('input', syncInputBar);
    quickInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            e.preventDefault();
            sendQuickWish();
        }
    });
}
const t8mainEl = document.getElementById('t8-chat-main');
if (t8mainEl) {
    t8mainEl.addEventListener('scroll', () => {
        const fab = document.getElementById('t8-fab');
        if (!fab) return;
        const nearBottom = t8mainEl.scrollHeight - t8mainEl.scrollTop - t8mainEl.clientHeight < 200;
        fab.classList.toggle('hidden', nearBottom);
    });
}
function sendQuickWish() {
    if (!quickInput || !quickInput.value.trim()) return;
    t8sndSend();
    appendGuestOutgoing(quickInput.value.trim());
    quickInput.value = '';
    syncInputBar();
}

// Submit RSVP
document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('t8-rsvp-form');
    if (!form) return;
    form.addEventListener('submit', async function (e) {
        e.preventDefault();
        const btn = document.getElementById('t8-form-btn');
        if (btn) {
            btn.disabled = true;
            btn.textContent = 'Mengirim...';
        }
        const fd = new FormData(this);
        const data = Object.fromEntries(fd.entries());
        try {
            const res = await fetch('<%= rsvpPath %>', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': data._csrf },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (res.ok) {
                t8sndSend();
                showT8Toast('Konfirmasi tersimpan, makasih!');
                const msg = data.message ? ('"' + data.message + '"') : 'Saya konfirmasi: ' + (data.attendance === 'hadir' ? 'Insya Allah Hadir' : 'Berhalangan');
                appendGuestOutgoing(msg);
            } else {
                showT8Toast('Gagal: ' + (result.message || 'coba lagi'));
            }
        } catch (err) {
            showT8Toast('Koneksi bermasalah, coba lagi');
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.textContent = 'Kirim Konfirmasi';
            }
        }
    });
});
</script>
</body>
</html>
