<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title || 'The Wedding of ' + fv(event?.groom_name, 'David') + ' & ' + fv(event?.bride_name, 'Sarah') %></title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Italianno&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .font-script { font-family: 'Italianno', cursive; }
        .font-serif-earth { font-family: 'Lora', Georgia, serif; }
        
        .phone-container {
            width: 100% !important;
            max-width: 440px !important;
            margin-left: auto !important;
            margin-right: auto !important;
        }

        .terracotta-gradient-text {
            background: linear-gradient(135deg, #ba5338 0%, #db7152 50%, #873622 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .rustic-grain {
            background-image: radial-gradient(rgba(186, 83, 56, 0.08) 1px, transparent 0);
            background-size: 24px 24px;
        }

        .arch-frame {
            border-top-left-radius: 9999px;
            border-top-right-radius: 9999px;
        }

        @keyframes spin-slow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .animate-spin-slow {
            animation: spin-slow 10s linear infinite;
        }
    </style>
</head>
<body class="bg-[#241712] text-[#33221b] font-sans antialiased overflow-x-hidden selection:bg-[#ba5338] selection:text-white min-h-screen">

<!-- Ambient Desktop Background -->
<div class="fixed inset-0 pointer-events-none opacity-40 z-0 rustic-grain"></div>

<!-- Outer Frame Container -->
<div class="phone-container min-h-screen bg-[#F7F2EC] shadow-2xl relative border-x border-[#dfd1c3] z-10">

    <!-- Audio Element -->
    <audio id="t3-audio" loop preload="auto">
        <source src="<%= event?.background_music || '/music/wedding-song.mp3' %>" type="audio/mpeg">
    </audio>

    <!-- 1. OPENING COVER / AMPLOP TUSCAN TERRACOTTA -->
    <div id="t3-opening-cover" class="fixed inset-0 z-50 flex items-center justify-center bg-gradient-to-b from-[#f3e7dc] via-[#F7F2EC] to-[#ece0d3] px-4 transition-all duration-1000">
        <!-- Floating Warm Sunbeam -->
        <div class="absolute w-72 h-72 rounded-full bg-[#ba5338]/15 blur-3xl pointer-events-none"></div>

        <div class="relative z-10 text-center max-w-[380px] w-full mx-auto py-12 px-6 rounded-3xl bg-white/95 border border-[#dfd1c3] shadow-2xl backdrop-blur-xl">
            <!-- Terracotta Clay Seal -->
            <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-[#f1ded6] border-2 border-[#ba5338] flex items-center justify-center shadow-md relative">
                <span class="font-script text-4xl font-bold text-[#ba5338]">
                    <%= (fv(event?.groom_name, 'D')[0]) %>&<%= (fv(event?.bride_name, 'S')[0]) %>
                </span>
                <div class="absolute -inset-1 rounded-full border border-[#ba5338]/30 animate-pulse"></div>
            </div>

            <p class="text-[11px] uppercase tracking-[0.35em] text-[#ba5338] font-semibold mb-2">
                The Wedding Celebration Of
            </p>

            <h1 class="font-script text-6xl text-[#78301f] mb-1 leading-none">
                <span data-demo="groom_name"><%= fv(event?.groom_name, 'David') %></span>
                <span class="text-[#ba5338] font-serif-earth text-3xl mx-1">&</span>
                <span data-demo="bride_name"><%= fv(event?.bride_name, 'Sarah') %></span>
            </h1>

            <p class="text-xs text-[#7e6255] font-serif-earth tracking-widest my-5">
                <%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %>
            </p>

            <div class="w-16 h-px bg-gradient-to-r from-transparent via-[#ba5338] to-transparent mx-auto mb-6"></div>

            <p class="text-[11px] text-[#7e6255] uppercase tracking-widest mb-1.5">Kepada Yth. Bapak/Ibu/Saudara/i</p>
            <p id="t3-recipient-name" class="text-base font-serif-earth font-bold text-[#78301f] mb-8 px-5 py-2.5 bg-[#fcf8f4] rounded-xl border border-[#dfd1c3] inline-block shadow-sm max-w-full truncate">
                Tamu Undangan
            </p>

            <div>
                <button id="t3-open-btn" class="w-full inline-flex items-center justify-center gap-2.5 px-8 py-3.5 text-sm font-bold text-white bg-gradient-to-r from-[#ba5338] via-[#cb6247] to-[#993b23] hover:brightness-105 rounded-full shadow-lg shadow-[#ba5338]/25 transition-all duration-300 transform hover:scale-[1.02] active:scale-95">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19v-8.93a2 2 0 01.89-1.664l7-4.666a2 2 0 012.22 0l7 4.666A2 2 0 0121 10.07V19M3 19a2 2 0 002 2h14a2 2 0 002-2M3 19l6.75-4.5M21 19l-6.75-4.5M3 10l6.75 4.5M21 10l-6.75 4.5m0 0l-1.14.76a2 2 0 01-2.22 0l-1.14-.76"></path>
                    </svg>
                    <span>Buka Undangan</span>
                </button>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT WRAPPER -->
    <div id="t3-main-content" class="opacity-0 pointer-events-none transition-opacity duration-1000">

        <!-- 2. HERO / SAVE THE DATE MEDITERRANEAN ARCH -->
        <section id="hero" class="relative min-h-[92vh] flex items-center justify-center text-center px-4 py-20 overflow-hidden bg-gradient-to-b from-[#f5eae0] via-[#F7F2EC] to-[#f4ebe1]">
            <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-80 h-80 bg-[#ba5338]/15 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10 max-w-sm mx-auto">
                <span class="inline-block text-[10px] uppercase tracking-[0.35em] text-[#ba5338] font-semibold mb-4 px-3.5 py-1 rounded-full border border-[#e5d4c5] bg-white/80 shadow-xs">
                    Save The Date
                </span>

                <h2 class="font-script text-6xl sm:text-7xl text-[#78301f] mb-3 leading-none drop-shadow-xs">
                    <span data-demo="groom_name"><%= fv(event?.groom_name, 'David') %></span>
                    <span class="block text-2xl font-serif-earth text-[#ba5338] my-1">&</span>
                    <span data-demo="bride_name"><%= fv(event?.bride_name, 'Sarah') %></span>
                </h2>

                <p class="text-xs text-[#6e5347] font-serif-earth tracking-widest mt-4">
                    <span data-demo="event_date"><%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %></span>
                </p>
                <p class="text-xs text-[#ba5338] font-mono tracking-wider mt-1">
                    <%= fv(eventTimeStart, 'Pukul 09.00 WIB') %>
                </p>

                <!-- Countdown Timer 4 Warm Clay Capsules -->
                <div id="t3-countdown" class="grid grid-cols-4 gap-2.5 mt-10" data-date="<%= eventDate || '2026-12-31T09:00:00' %>">
                    <div class="bg-white/90 border border-[#dfd1c3] rounded-2xl p-2.5 shadow-sm">
                        <span id="t3-cd-days" class="block font-serif-earth font-bold text-lg text-[#ba5338]">00</span>
                        <span class="text-[9px] uppercase tracking-wider text-[#7e6255]">Hari</span>
                    </div>
                    <div class="bg-white/90 border border-[#dfd1c3] rounded-2xl p-2.5 shadow-sm">
                        <span id="t3-cd-hours" class="block font-serif-earth font-bold text-lg text-[#ba5338]">00</span>
                        <span class="text-[9px] uppercase tracking-wider text-[#7e6255]">Jam</span>
                    </div>
                    <div class="bg-white/90 border border-[#dfd1c3] rounded-2xl p-2.5 shadow-sm">
                        <span id="t3-cd-minutes" class="block font-serif-earth font-bold text-lg text-[#ba5338]">00</span>
                        <span class="text-[9px] uppercase tracking-wider text-[#7e6255]">Menit</span>
                    </div>
                    <div class="bg-white/90 border border-[#dfd1c3] rounded-2xl p-2.5 shadow-sm">
                        <span id="t3-cd-seconds" class="block font-serif-earth font-bold text-lg text-[#ba5338]">00</span>
                        <span class="text-[9px] uppercase tracking-wider text-[#7e6255]">Detik</span>
                    </div>
                </div>

                <div class="mt-10 animate-bounce">
                    <a href="#pasangan" class="inline-flex items-center text-[#ba5338] hover:text-[#78301f] transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </section>

        <!-- 3. PETIKAN KATA & PASANGAN (THE COUPLE IN ARCHES) -->
        <section id="pasangan" class="py-16 px-4 bg-[#F7F2EC] border-t border-[#dfd1c3]">
            <div class="max-w-sm mx-auto text-center">
                <!-- Quote Tuscan -->
                <div class="mb-12 p-6 rounded-3xl bg-white border border-[#dfd1c3] shadow-sm">
                    <p class="font-serif-earth italic text-base text-[#78301f] mb-3 leading-relaxed">
                        "Bersamamu, perjalanan ini terasa seperti kepulangan. Dua jiwa yang melangkah seirama di bawah naungan kasih dan restu Sang Pencipta."
                    </p>
                    <span class="text-[10px] uppercase tracking-widest text-[#7e6255] font-semibold">
                        — Untaian Bahagia Dua Insan
                    </span>
                </div>

                <span class="text-[10px] uppercase tracking-[0.35em] text-[#ba5338] block mb-1">Mempelai Terkasih</span>
                <h3 class="font-script text-5xl text-[#78301f] mb-2">Dua Mempelai</h3>
                <div class="w-12 h-0.5 bg-[#ba5338] mx-auto mb-8"></div>

                <!-- Groom Arch Frame -->
                <div class="mb-10 p-6 rounded-3xl bg-white border border-[#dfd1c3] shadow-md relative overflow-hidden group">
                    <div class="w-32 h-40 mx-auto mb-4 arch-frame overflow-hidden p-1 bg-gradient-to-t from-[#ba5338] via-[#e5d4c5] to-[#f5eae0] shadow-md">
                        <div class="w-full h-full arch-frame overflow-hidden bg-stone-100">
                            <img src="<%= groomPhoto || '/images/demo/groom.svg' %>" alt="Mempelai Pria" class="w-full h-full object-cover">
                        </div>
                    </div>
                    <h4 class="font-script text-5xl text-[#78301f] mb-1 leading-none">
                        <span data-demo="groom_name"><%= fv(event?.groom_name, 'David Anderson') %></span>
                    </h4>
                    <p class="text-xs text-[#ba5338] font-serif-earth uppercase tracking-wider mb-3">Mempelai Pria</p>
                    <p class="text-xs text-[#6e5347] leading-relaxed">
                        Putra tercinta dari<br>
                        <span class="font-semibold text-[#33221b]"><%= fv(event?.groom_father, 'Bpk. Michael Anderson') %></span> &<br>
                        <span class="font-semibold text-[#33221b]"><%= fv(event?.groom_mother, 'Ibu Emily Anderson') %></span>
                    </p>
                    <% if (event?.instagram_groom) { %>
                    <div class="mt-4">
                        <a href="https://instagram.com/<%= event.instagram_groom.replace('@', '') %>" target="_blank" class="inline-flex items-center gap-1.5 text-xs text-[#ba5338] hover:underline">
                            <span>@<%= event.instagram_groom.replace('@', '') %></span>
                        </a>
                    </div>
                    <% } %>
                </div>

                <!-- Terracotta Ampersand -->
                <div class="my-6">
                    <span class="font-script text-5xl text-[#ba5338]">&</span>
                </div>

                <!-- Bride Arch Frame -->
                <div class="p-6 rounded-3xl bg-white border border-[#dfd1c3] shadow-md relative overflow-hidden group">
                    <div class="w-32 h-40 mx-auto mb-4 arch-frame overflow-hidden p-1 bg-gradient-to-t from-[#ba5338] via-[#e5d4c5] to-[#f5eae0] shadow-md">
                        <div class="w-full h-full arch-frame overflow-hidden bg-stone-100">
                            <img src="<%= bridePhoto || '/images/demo/bride.svg' %>" alt="Mempelai Wanita" class="w-full h-full object-cover">
                        </div>
                    </div>
                    <h4 class="font-script text-5xl text-[#78301f] mb-1 leading-none">
                        <span data-demo="bride_name"><%= fv(event?.bride_name, 'Sarah Johnson') %></span>
                    </h4>
                    <p class="text-xs text-[#ba5338] font-serif-earth uppercase tracking-wider mb-3">Mempelai Wanita</p>
                    <p class="text-xs text-[#6e5347] leading-relaxed">
                        Putri tercinta dari<br>
                        <span class="font-semibold text-[#33221b]"><%= fv(event?.bride_father, 'Bpk. Robert Johnson') %></span> &<br>
                        <span class="font-semibold text-[#33221b]"><%= fv(event?.bride_mother, 'Ibu Linda Johnson') %></span>
                    </p>
                    <% if (event?.instagram_bride) { %>
                    <div class="mt-4">
                        <a href="https://instagram.com/<%= event.instagram_bride.replace('@', '') %>" target="_blank" class="inline-flex items-center gap-1.5 text-xs text-[#ba5338] hover:underline">
                            <span>@<%= event.instagram_bride.replace('@', '') %></span>
                        </a>
                    </div>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- 4. RANGKAIAN ACARA (EVENT AGENDA) -->
        <section id="acara" class="py-16 px-4 bg-[#f1e6da] border-t border-[#dfd1c3]">
            <div class="max-w-sm mx-auto text-center">
                <span class="text-[10px] uppercase tracking-[0.35em] text-[#ba5338] block mb-1">Waktu & Tempat</span>
                <h3 class="font-script text-5xl text-[#78301f] mb-2">Rangkaian Acara</h3>
                <div class="w-12 h-0.5 bg-[#ba5338] mx-auto mb-8"></div>

                <!-- Akad Nikah Card -->
                <div class="p-6 rounded-3xl bg-white border border-[#dfd1c3] shadow-sm mb-6 text-left">
                    <div class="flex items-center justify-between mb-4 border-b border-[#f1ded6] pb-3">
                        <h4 class="font-serif-earth font-bold text-lg text-[#78301f]">Akad Nikah</h4>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-[#f1ded6] text-[#ba5338] border border-[#e5d4c5]">Khidmat</span>
                    </div>
                    <div class="space-y-2.5 text-xs text-[#6e5347]">
                        <div class="flex items-center gap-2.5">
                            <svg class="w-4 h-4 text-[#ba5338]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            <span data-demo="event_date"><%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %></span>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <svg class="w-4 h-4 text-[#ba5338]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span><%= fv(eventTimeStart, '08.00 - 10.00 WIB') %></span>
                        </div>
                        <div class="flex items-start gap-2.5">
                            <svg class="w-4 h-4 text-[#ba5338] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            <div>
                                <strong class="text-[#33221b] block" data-demo="venue_name"><%= fv(event?.venue_name, 'Tuscan Estate & Vineyard') %></strong>
                                <span class="text-[#7e6255]" data-demo="venue_address"><%= fv(event?.venue_address, 'Jl. Lembah Pinus No. 8, Yogyakarta') %></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Resepsi Card -->
                <div class="p-6 rounded-3xl bg-white border border-[#dfd1c3] shadow-sm mb-6 text-left">
                    <div class="flex items-center justify-between mb-4 border-b border-[#f1ded6] pb-3">
                        <h4 class="font-serif-earth font-bold text-lg text-[#78301f]">Resepsi Pernikahan</h4>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-[#f1ded6] text-[#ba5338] border border-[#e5d4c5]">Perayaan</span>
                    </div>
                    <div class="space-y-2.5 text-xs text-[#6e5347]">
                        <div class="flex items-center gap-2.5">
                            <svg class="w-4 h-4 text-[#ba5338]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            <span data-demo="event_date"><%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %></span>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <svg class="w-4 h-4 text-[#ba5338]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span><%= fv(eventTimeRange, '11.00 WIB - Selesai') %></span>
                        </div>
                        <div class="flex items-start gap-2.5">
                            <svg class="w-4 h-4 text-[#ba5338] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            <div>
                                <strong class="text-[#33221b] block" data-demo="venue_name"><%= fv(event?.venue_name, 'Tuscan Estate & Vineyard') %></strong>
                                <span class="text-[#7e6255]" data-demo="venue_address"><%= fv(event?.venue_address, 'Jl. Lembah Pinus No. 8, Yogyakarta') %></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Google Maps Link Button -->
                <a href="<%= event?.venue_maps_url || 'https://maps.google.com' %>" target="_blank" class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-gradient-to-r from-[#ba5338] to-[#993b23] text-white font-bold text-xs uppercase tracking-wider rounded-xl shadow-md hover:brightness-105 active:scale-95 transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    <span>Buka Petunjuk Lokasi Google Maps</span>
                </a>
            </div>
        </section>

        <!-- 5. KISAH CINTA (OUR STORY ROADMAP) -->
        <section id="cerita" class="py-16 px-4 bg-[#F7F2EC] border-t border-[#dfd1c3]">
            <div class="max-w-sm mx-auto">
                <div class="text-center mb-10">
                    <span class="text-[10px] uppercase tracking-[0.35em] text-[#ba5338] block mb-1">Jejak Waktu</span>
                    <h3 class="font-script text-5xl text-[#78301f] mb-2">Kisah Perjalanan</h3>
                    <div class="w-12 h-0.5 bg-[#ba5338] mx-auto"></div>
                </div>

                <div class="relative border-l-2 border-[#ba5338]/50 ml-4 space-y-8 pl-6">
                    <!-- Chapter 1 -->
                    <div class="relative">
                        <div class="absolute -left-[31px] top-1 w-4 h-4 rounded-full bg-white border-2 border-[#ba5338]"></div>
                        <span class="text-[10px] font-mono text-[#ba5338] uppercase tracking-wider">Awal Cerita &bull; 2021</span>
                        <h4 class="font-serif-earth text-base font-bold text-[#78301f] mt-0.5">Pertemuan Hangat</h4>
                        <p class="text-xs text-[#6e5347] mt-1 leading-relaxed">
                            Di bawah semilir angin sore, percakapan sederhana itu menumbuhkan ketertarikan yang begitu alami dan tulus.
                        </p>
                    </div>

                    <!-- Chapter 2 -->
                    <div class="relative">
                        <div class="absolute -left-[31px] top-1 w-4 h-4 rounded-full bg-white border-2 border-[#ba5338]"></div>
                        <span class="text-[10px] font-mono text-[#ba5338] uppercase tracking-wider">Langkah Searah &bull; 2023</span>
                        <h4 class="font-serif-earth text-base font-bold text-[#78301f] mt-0.5">Satu Tujuan</h4>
                        <p class="text-xs text-[#6e5347] mt-1 leading-relaxed">
                            Belajar saling mengerti, tumbuh dalam kesabaran, dan memantapkan keyakinan untuk membangun masa depan bersama.
                        </p>
                    </div>

                    <!-- Chapter 3 -->
                    <div class="relative">
                        <div class="absolute -left-[31px] top-1 w-4 h-4 rounded-full bg-[#ba5338] shadow-[0_0_8px_#ba5338]"></div>
                        <span class="text-[10px] font-mono text-[#ba5338] uppercase tracking-wider">Janji Suci &bull; 2025</span>
                        <h4 class="font-serif-earth text-base font-bold text-[#78301f] mt-0.5">Menuju Hari Bahagia</h4>
                        <p class="text-xs text-[#6e5347] mt-1 leading-relaxed">
                            Keluarga besar telah merestui, dan kini kami bersiap mengucap ikrar sehidup semati dalam ikatan pernikahan yang suci.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 6. GALERI FOTO RUSTIC MOSAIC -->
        <section id="galeri" class="py-16 px-4 bg-[#f1e6da] border-t border-[#dfd1c3]">
            <div class="max-w-sm mx-auto text-center">
                <span class="text-[10px] uppercase tracking-[0.35em] text-[#ba5338] block mb-1">Momen Terindah</span>
                <h3 class="font-script text-5xl text-[#78301f] mb-2">Galeri Kenangan</h3>
                <div class="w-12 h-0.5 bg-[#ba5338] mx-auto mb-8"></div>

                <div class="grid grid-cols-2 gap-3">
                    <% const g3Photos = (galleryPhotos && galleryPhotos.length) ? galleryPhotos : ['/images/templates/template-3.jpg', '/images/templates/template-1.jpg', '/images/templates/template-2.jpg', '/images/templates/template-4.jpg']; %>
                    <% g3Photos.forEach(function(imgUrl, idx) { %>
                    <div class="rounded-2xl overflow-hidden border border-[#dfd1c3] shadow-sm aspect-[3/4] bg-white group">
                        <img src="<%= imgUrl %>" alt="Momen <%= idx + 1 %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                    </div>
                    <% }); %>
                </div>
            </div>
        </section>

        <!-- 7. TANDA KASIH / AMPLOP TERRACOTTA -->
        <section id="hadiah" class="py-16 px-4 bg-[#F7F2EC] border-t border-[#dfd1c3]">
            <div class="max-w-sm mx-auto text-center">
                <span class="text-[10px] uppercase tracking-[0.35em] text-[#ba5338] block mb-1">Tanda Kasih</span>
                <h3 class="font-script text-5xl text-[#78301f] mb-2">Amplop Digital</h3>
                <div class="w-12 h-0.5 bg-[#ba5338] mx-auto mb-6"></div>
                
                <p class="text-xs text-[#6e5347] leading-relaxed mb-8">
                    Doa dan restu Anda adalah anugerah terbesar bagi kami. Bagi yang ingin berbagi tanda kasih secara digital, dapat melalui rekening berikut:
                </p>

                <!-- Terracotta Card BCA -->
                <div class="p-6 rounded-3xl bg-white border border-[#dfd1c3] shadow-md mb-5 text-left relative overflow-hidden">
                    <div class="flex items-center justify-between mb-4">
                        <span class="font-serif-earth font-bold tracking-widest text-[#78301f] text-sm">BANK BCA</span>
                        <span class="text-[10px] uppercase font-mono text-[#ba5338]">Transfer Digital</span>
                    </div>
                    <p class="text-[11px] text-[#7e6255] uppercase tracking-widest mb-1">Nomor Rekening</p>
                    <p id="t3-bca-acc" class="font-mono text-xl font-bold text-[#78301f] tracking-wider mb-2">1234567890</p>
                    <p class="text-xs text-[#6e5347] mb-4">a.n. <%= fv(event?.groom_name, 'David Anderson') %></p>
                    <button type="button" onclick="copyT3('t3-bca-acc', this)" class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-[#f1ded6] hover:bg-[#eacbc1] border border-[#dfd1c3] text-[#ba5338] rounded-xl text-xs font-semibold active:scale-95 transition-all">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>Salin Nomor Rekening</span>
                    </button>
                </div>

                <!-- Terracotta Card Mandiri -->
                <div class="p-6 rounded-3xl bg-white border border-[#dfd1c3] shadow-md mb-6 text-left relative overflow-hidden">
                    <div class="flex items-center justify-between mb-4">
                        <span class="font-serif-earth font-bold tracking-widest text-[#78301f] text-sm">BANK MANDIRI</span>
                        <span class="text-[10px] uppercase font-mono text-[#ba5338]">Transfer Digital</span>
                    </div>
                    <p class="text-[11px] text-[#7e6255] uppercase tracking-widest mb-1">Nomor Rekening</p>
                    <p id="t3-mandiri-acc" class="font-mono text-xl font-bold text-[#78301f] tracking-wider mb-2">9876543210</p>
                    <p class="text-xs text-[#6e5347] mb-4">a.n. <%= fv(event?.bride_name, 'Sarah Johnson') %></p>
                    <button type="button" onclick="copyT3('t3-mandiri-acc', this)" class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-[#f1ded6] hover:bg-[#eacbc1] border border-[#dfd1c3] text-[#ba5338] rounded-xl text-xs font-semibold active:scale-95 transition-all">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>Salin Nomor Rekening</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- 8. RSVP & BUKU DOA RUSTIC -->
        <section id="doa" class="py-16 px-4 bg-[#f1e6da] border-t border-[#dfd1c3]">
            <div class="max-w-sm mx-auto">
                <div class="text-center mb-8">
                    <span class="text-[10px] uppercase tracking-[0.35em] text-[#ba5338] block mb-1">Kehadiran & Doa</span>
                    <h3 class="font-script text-5xl text-[#78301f] mb-2">RSVP & Doa Restu</h3>
                    <div class="w-12 h-0.5 bg-[#ba5338] mx-auto mb-4"></div>
                    <p class="text-xs text-[#6e5347]">Konfirmasi kehadiran Anda sangat berarti bagi kelancaran acara kami.</p>
                </div>

                <!-- RSVP Form -->
                <form id="t3-rsvp-form" class="p-6 rounded-3xl bg-white border border-[#dfd1c3] shadow-md mb-8 space-y-4">
                    <div>
                        <label class="block text-[11px] font-serif-earth font-bold uppercase tracking-wider text-[#78301f] mb-1.5">Nama Tamu</label>
                        <input type="text" id="t3-rsvp-name" required placeholder="Contoh: Bpk. Haryono & Rekan" class="w-full px-4 py-2.5 rounded-xl bg-[#F7F2EC] border border-[#dfd1c3] text-[#33221b] text-xs placeholder:text-[#ab9285] focus:outline-none focus:border-[#ba5338]">
                    </div>

                    <div>
                        <label class="block text-[11px] font-serif-earth font-bold uppercase tracking-wider text-[#78301f] mb-1.5">Konfirmasi Kehadiran</label>
                        <select id="t3-rsvp-attendance" class="w-full px-4 py-2.5 rounded-xl bg-[#F7F2EC] border border-[#dfd1c3] text-[#33221b] text-xs focus:outline-none focus:border-[#ba5338]">
                            <option value="hadir">Pasti Hadir</option>
                            <option value="ragu">Masih Ragu</option>
                            <option value="tidak_hadir">Berhalangan Hadir</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-[11px] font-serif-earth font-bold uppercase tracking-wider text-[#78301f] mb-1.5">Jumlah Tamu</label>
                        <select id="t3-rsvp-count" class="w-full px-4 py-2.5 rounded-xl bg-[#F7F2EC] border border-[#dfd1c3] text-[#33221b] text-xs focus:outline-none focus:border-[#ba5338]">
                            <option value="1">1 Orang</option>
                            <option value="2">2 Orang</option>
                            <option value="3">3 Orang</option>
                            <option value="4">4 Orang</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-[11px] font-serif-earth font-bold uppercase tracking-wider text-[#78301f] mb-1.5">Doa & Harapan</label>
                        <textarea id="t3-rsvp-message" rows="3" required placeholder="Tuliskan ucapan dan doa tulus Anda..." class="w-full px-4 py-2.5 rounded-xl bg-[#F7F2EC] border border-[#dfd1c3] text-[#33221b] text-xs placeholder:text-[#ab9285] focus:outline-none focus:border-[#ba5338]"></textarea>
                    </div>

                    <button type="submit" id="t3-submit-btn" class="w-full py-3 bg-gradient-to-r from-[#ba5338] to-[#993b23] text-white font-bold text-xs uppercase tracking-wider rounded-xl shadow-md hover:brightness-105 active:scale-95 transition-all">
                        Kirim Konfirmasi & Doa
                    </button>
                    <p id="t3-rsvp-alert" class="text-xs text-center hidden font-semibold"></p>
                </form>

                <!-- List of Wishes -->
                <div class="space-y-3">
                    <h4 class="font-serif-earth font-bold text-sm text-[#78301f] tracking-wider uppercase mb-2">Buku Doa (<span id="t3-wishes-count"><%= totalWishes %></span>)</h4>
                    <div id="t3-wishes-list" class="space-y-3 max-h-80 overflow-y-auto pr-1">
                        <% if (wishes && wishes.length) { %>
                            <% wishes.forEach(function(w) { %>
                            <div class="p-4 rounded-2xl bg-white border border-[#dfd1c3] text-left shadow-xs">
                                <div class="flex items-center justify-between mb-1">
                                    <strong class="font-serif-earth text-xs text-[#78301f]"><%= w.name %></strong>
                                    <span class="text-[9px] px-2 py-0.5 rounded-full bg-[#f1ded6] text-[#ba5338] uppercase font-mono font-bold"><%= w.attendance %></span>
                                </div>
                                <p class="text-xs text-[#6e5347] leading-relaxed"><%= w.message %></p>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-xs text-[#7e6255] text-center py-4 bg-white rounded-2xl border border-[#dfd1c3]">Jadilah yang pertama mengirimkan untaian doa.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </section>

        <!-- 9. FOOTER -->
        <footer class="py-14 px-4 bg-[#241712] text-center pb-28 text-white">
            <div class="max-w-sm mx-auto">
                <span class="font-script text-5xl text-[#e5a28f] block mb-2 leading-none">
                    <%= fv(event?.groom_name, 'David') %> & <%= fv(event?.bride_name, 'Sarah') %>
                </span>
                <p class="text-xs text-[#dfd1c3] font-serif-earth mb-4">Terima kasih atas doa & restu Anda.</p>
                <div class="w-8 h-px bg-[#ba5338]/60 mx-auto mb-4"></div>
                <p class="text-[10px] text-[#b39b8a] font-sans tracking-wide">
                    Dibuat dengan cinta via <a href="/" class="text-[#e5a28f] hover:underline font-semibold">KalaBahagia.com</a>
                </p>
            </div>
        </footer>

    </div>

    <!-- FLOATING MUSIC TOGGLE -->
    <button id="t3-music-toggle" aria-label="Toggle Musik" class="fixed bottom-24 right-4 z-40 w-11 h-11 rounded-full bg-white/95 border-2 border-[#ba5338] shadow-xl flex items-center justify-center text-[#ba5338] transition-all opacity-0 pointer-events-none hover:scale-105 active:scale-95">
        <svg id="t3-disc-icon" class="w-5 h-5 animate-spin-slow" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5zm0-5.5c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z"/>
        </svg>
    </button>

    <!-- BOTTOM DOCK NAVIGATION -->
    <nav id="t3-bottom-dock" class="fixed bottom-3 left-1/2 -translate-x-1/2 z-40 w-[92%] max-w-sm rounded-2xl bg-white/90 border border-[#dfd1c3] backdrop-blur-xl shadow-2xl py-2 px-3 transition-all duration-500 translate-y-24 opacity-0">
        <div class="flex items-center justify-around text-[10px] font-semibold text-[#7e6255]">
            <a href="#hero" class="flex flex-col items-center py-1 px-1.5 hover:text-[#ba5338] transition-colors">
                <svg class="w-4 h-4 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                <span>Home</span>
            </a>
            <a href="#pasangan" class="flex flex-col items-center py-1 px-1.5 hover:text-[#ba5338] transition-colors">
                <svg class="w-4 h-4 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                <span>Mempelai</span>
            </a>
            <a href="#acara" class="flex flex-col items-center py-1 px-1.5 hover:text-[#ba5338] transition-colors">
                <svg class="w-4 h-4 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <span>Acara</span>
            </a>
            <a href="#galeri" class="flex flex-col items-center py-1 px-1.5 hover:text-[#ba5338] transition-colors">
                <svg class="w-4 h-4 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <span>Galeri</span>
            </a>
            <a href="#hadiah" class="flex flex-col items-center py-1 px-1.5 hover:text-[#ba5338] transition-colors">
                <svg class="w-4 h-4 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 00-2 2v6a2 2 0 002 2h14a2 2 0 002-2v-6a2 2 0 00-2-2H5z"/></svg>
                <span>Kado</span>
            </a>
            <a href="#doa" class="flex flex-col items-center py-1 px-1.5 hover:text-[#ba5338] transition-colors">
                <svg class="w-4 h-4 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                <span>RSVP</span>
            </a>
        </div>
    </nav>

</div>

<!-- SCRIPT LOGIC INTERAKTIF -->
<script>
(function() {
    // 1. Ambil nama tamu dari URL param (?to= atau ?tamu=)
    const params = new URLSearchParams(window.location.search);
    const guestParam = params.get('to') || params.get('tamu') || params.get('u');
    if (guestParam) {
        const el = document.getElementById('t3-recipient-name');
        if (el) el.textContent = guestParam;
        const nameInput = document.getElementById('t3-rsvp-name');
        if (nameInput) nameInput.value = guestParam;
    }

    // 2. Audio & Buka Undangan
    const audio = document.getElementById('t3-audio');
    const openBtn = document.getElementById('t3-open-btn');
    const cover = document.getElementById('t3-opening-cover');
    const mainContent = document.getElementById('t3-main-content');
    const musicToggle = document.getElementById('t3-music-toggle');
    const bottomDock = document.getElementById('t3-bottom-dock');
    const discIcon = document.getElementById('t3-disc-icon');

    let isPlaying = false;

    function playAudioSafe() {
        if (!audio) return;
        audio.play().then(() => {
            isPlaying = true;
            if (discIcon) discIcon.classList.add('animate-spin-slow');
        }).catch(err => {
            console.warn('Audio auto-play prevented:', err);
        });
    }

    if (openBtn) {
        openBtn.addEventListener('click', function() {
            playAudioSafe();
            if (cover) {
                cover.style.transform = 'translateY(-100%)';
                cover.style.opacity = '0';
                setTimeout(() => cover.style.display = 'none', 1000);
            }
            if (mainContent) {
                mainContent.classList.remove('opacity-0', 'pointer-events-none');
            }
            if (musicToggle) {
                musicToggle.classList.remove('opacity-0', 'pointer-events-none');
            }
            if (bottomDock) {
                bottomDock.classList.remove('translate-y-24', 'opacity-0');
            }
        });
    }

    if (musicToggle) {
        musicToggle.addEventListener('click', function() {
            if (!audio) return;
            if (isPlaying) {
                audio.pause();
                isPlaying = false;
                if (discIcon) discIcon.classList.remove('animate-spin-slow');
            } else {
                audio.play();
                isPlaying = true;
                if (discIcon) discIcon.classList.add('animate-spin-slow');
            }
        });
    }

    // 3. Countdown Timer
    const cdWrap = document.getElementById('t3-countdown');
    if (cdWrap) {
        const targetDate = new Date(cdWrap.dataset.date || '2026-12-31T09:00:00').getTime();
        function updateCd() {
            const now = Date.now();
            const diff = targetDate - now;
            if (diff <= 0) return;
            const d = Math.floor(diff / (1000 * 60 * 60 * 24));
            const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const s = Math.floor((diff % (1000 * 60)) / 1000);
            document.getElementById('t3-cd-days').textContent = String(d).padStart(2, '0');
            document.getElementById('t3-cd-hours').textContent = String(h).padStart(2, '0');
            document.getElementById('t3-cd-minutes').textContent = String(m).padStart(2, '0');
            document.getElementById('t3-cd-seconds').textContent = String(s).padStart(2, '0');
        }
        updateCd();
        setInterval(updateCd, 1000);
    }

    // 4. Salin Rekening
    window.copyT3 = function(id, btn) {
        const text = document.getElementById(id).textContent.trim();
        navigator.clipboard.writeText(text).then(() => {
            const original = btn.innerHTML;
            btn.innerHTML = '<span>Tersalin ✓</span>';
            btn.classList.add('bg-[#ba5338]', 'text-white');
            setTimeout(() => {
                btn.innerHTML = original;
                btn.classList.remove('bg-[#ba5338]', 'text-white');
            }, 2000);
        });
    };

    // 5. RSVP AJAX Submit
    const form = document.getElementById('t3-rsvp-form');
    if (form) {
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = document.getElementById('t3-submit-btn');
            const alert = document.getElementById('t3-rsvp-alert');
            const name = document.getElementById('t3-rsvp-name').value;
            const attendance = document.getElementById('t3-rsvp-attendance').value;
            const count = parseInt(document.getElementById('t3-rsvp-count').value, 10);
            const message = document.getElementById('t3-rsvp-message').value;

            btn.disabled = true;
            btn.textContent = 'Mengirimkan...';

            try {
                const res = await fetch('<%= rsvpPath %>', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': '<%= csrfToken %>'
                    },
                    body: JSON.stringify({ name, attendance, number_of_guests: count, message })
                });
                const data = await res.json();
                alert.classList.remove('hidden', 'text-red-600');
                alert.classList.add('text-[#ba5338]');
                alert.textContent = 'Terima kasih, konfirmasi & doa Anda telah tersimpan!';

                // Append new wish
                const list = document.getElementById('t3-wishes-list');
                const card = document.createElement('div');
                card.className = 'p-4 rounded-2xl bg-white border border-[#dfd1c3] text-left shadow-xs';
                card.innerHTML = `<div class="flex items-center justify-between mb-1"><strong class="font-serif-earth text-xs text-[#78301f]">${name}</strong><span class="text-[9px] px-2 py-0.5 rounded-full bg-[#f1ded6] text-[#ba5338] uppercase font-mono font-bold">${attendance}</span></div><p class="text-xs text-[#6e5347] leading-relaxed">${message}</p>`;
                if (list) list.prepend(card);

                form.reset();
            } catch (err) {
                alert.classList.remove('hidden', 'text-[#ba5338]');
                alert.classList.add('text-red-600');
                alert.textContent = 'Gagal mengirimkan konfirmasi. Silakan coba lagi.';
            } finally {
                btn.disabled = false;
                btn.textContent = 'Kirim Konfirmasi & Doa';
            }
        });
    }
})();
</script>

</body>
</html>
