<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title || 'The Wedding of ' + fv(event?.groom_name, 'Pria') + ' & ' + fv(event?.bride_name, 'Wanita') %></title>
    <link rel="stylesheet" href="/css/app.css">
    <style>
        .font-serif { font-family: 'Lora', 'Playfair Display', Georgia, serif; }
        .font-script { font-family: 'Allura', 'Dancing Script', cursive; }
    </style>
</head>
<body class="bg-cream-50 text-stone-800 font-sans antialiased overflow-x-hidden selection:bg-nature-200 selection:text-nature-900">

<!-- Audio Element -->
<audio id="t3-audio" loop preload="auto">
    <source src="/music/wedding-song.mp3" type="audio/mpeg">
</audio>

<!-- Opening Cover / Envelope -->
<div id="t3-opening-cover" class="fixed inset-0 z-50 flex items-center justify-center bg-gradient-to-b from-stone-200/90 via-cream-100 to-stone-200/90 transition-all duration-1000 px-4">
    <div class="relative z-10 text-center max-w-lg mx-auto py-12 px-6 rounded-3xl bg-white/95 border border-stone-300 shadow-2xl backdrop-blur-xl">
        <!-- Laurel Wreath Monogram -->
        <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-nature-50 border-2 border-nature-600/60 flex items-center justify-center shadow-md">
            <span class="font-script text-3xl font-bold text-nature-800">
                <%= (fv(event?.groom_name, 'D')[0]) %>&<%= (fv(event?.bride_name, 'S')[0]) %>
            </span>
        </div>

        <p class="text-xs uppercase tracking-[0.3em] text-nature-700 font-bold mb-2">The Wedding Celebration Of</p>

        <h1 class="font-script text-5xl sm:text-6xl text-stone-900 mb-6 leading-tight">
            <span data-demo="groom_name"><%= fv(event?.groom_name, 'David') %></span>
            <span class="text-nature-600 font-serif text-3xl mx-1">&</span>
            <span data-demo="bride_name"><%= fv(event?.bride_name, 'Sarah') %></span>
        </h1>

        <div class="w-12 h-0.5 bg-gradient-to-r from-transparent via-nature-500 to-transparent mx-auto mb-6"></div>

        <p class="text-xs text-stone-500 uppercase tracking-widest mb-1 font-medium">Kepada Yth. Bapak/Ibu/Saudara/i</p>
        <p id="t3-recipient-name" class="text-lg sm:text-xl font-serif font-bold text-nature-900 mb-8 px-4 py-2 bg-stone-100 rounded-xl border border-stone-200 inline-block">
            Tamu Undangan
        </p>

        <div>
            <button id="t3-open-btn" class="inline-flex items-center justify-center px-8 py-3.5 text-sm sm:text-base font-bold text-white bg-nature-700 hover:bg-nature-800 rounded-full shadow-lg hover:shadow-nature-700/30 transition-all duration-300 transform hover:scale-105 active:scale-95">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19v-8.93a2 2 0 01.89-1.664l7-4.666a2 2 0 012.22 0l7 4.666A2 2 0 0121 10.07V19M3 19a2 2 0 002 2h14a2 2 0 002-2M3 19l6.75-4.5M21 19l-6.75-4.5M3 10l6.75 4.5M21 10l-6.75 4.5m0 0l-1.14.76a2 2 0 01-2.22 0l-1.14-.76"></path>
                </svg>
                <span>Buka Undangan</span>
            </button>
        </div>
    </div>
</div>

<!-- Main Content -->
<div id="t3-main-content" class="opacity-0 pointer-events-none transition-opacity duration-1000">
    <%- include('./sections/hero') %>
    <%- include('./sections/couple') %>
    <%- include('./sections/story') %>
    <%- include('./sections/event') %>
    <%- include('./sections/gallery') %>
    <%- include('./sections/gift') %>
    <%- include('./sections/rsvp') %>

    <!-- Footer -->
    <footer class="py-12 bg-stone-900 text-center text-stone-400 text-xs pb-28 border-t border-stone-800">
        <p class="font-script text-3xl text-nature-300 mb-2">Terima Kasih</p>
        <p class="text-stone-300 max-w-md mx-auto px-4">Merupakan kehormatan dan kebahagiaan bagi kami atas kehadiran dan doa restu Anda.</p>
        <p class="mt-4 text-stone-500">&copy; <%= new Date().getFullYear() %> Wedding Invitation &bull; Elegant Nature</p>
    </footer>
</div>

<!-- Floating Music Button -->
<button id="t3-music-toggle" aria-label="Toggle Musik" class="fixed bottom-20 right-4 z-40 w-12 h-12 rounded-full bg-white/95 border border-nature-600/40 shadow-xl flex items-center justify-center text-nature-800 transition-all duration-300 opacity-0 pointer-events-none hover:scale-105 active:scale-95">
    <div id="t3-music-disc" class="w-7 h-7 rounded-full border-2 border-nature-600 flex items-center justify-center">
        <div class="w-2 h-2 rounded-full bg-nature-700"></div>
    </div>
</button>

<!-- Bottom Navigation Dock -->
<nav id="t3-bottom-nav" class="fixed bottom-3 left-1/2 -translate-x-1/2 z-40 w-[92%] max-w-md rounded-2xl bg-white/90 border border-stone-300/80 backdrop-blur-lg shadow-xl py-2 px-3 transition-all duration-500 translate-y-24 opacity-0">
    <div class="flex items-center justify-around text-[10px] sm:text-xs font-semibold text-stone-500">
        <a href="#opening" class="t3-nav-link flex flex-col items-center py-1 px-2 hover:text-nature-700 transition-colors">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            <span>Home</span>
        </a>
        <a href="#couple" class="t3-nav-link flex flex-col items-center py-1 px-2 hover:text-nature-700 transition-colors">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
            <span>Pasangan</span>
        </a>
        <a href="#story" class="t3-nav-link flex flex-col items-center py-1 px-2 hover:text-nature-700 transition-colors">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            <span>Kisah</span>
        </a>
        <a href="#event" class="t3-nav-link flex flex-col items-center py-1 px-2 hover:text-nature-700 transition-colors">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <span>Acara</span>
        </a>
        <a href="#gallery" class="t3-nav-link flex flex-col items-center py-1 px-2 hover:text-nature-700 transition-colors">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <span>Galeri</span>
        </a>
        <a href="#gift" class="t3-nav-link flex flex-col items-center py-1 px-2 hover:text-nature-700 transition-colors">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"></path></svg>
            <span>Hadiah</span>
        </a>
        <a href="#rsvp" class="t3-nav-link flex flex-col items-center py-1 px-2 hover:text-nature-700 transition-colors">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            <span>RSVP</span>
        </a>
    </div>
</nav>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 1. Recipient Query
    const params = new URLSearchParams(window.location.search);
    const to = params.get('to');
    if (to) {
        const el = document.getElementById('t3-recipient-name');
        if (el) el.textContent = to;
    }

    // 2. Audio Control with Web Audio API Fallback
    const audio = document.getElementById('t3-audio');
    const toggle = document.getElementById('t3-music-toggle');
    const disc = document.getElementById('t3-music-disc');
    let isPlaying = false;
    let synthCtx = null;
    let synthInterval = null;

    function playNatureSynth() {
        try {
            const AC = window.AudioContext || window.webkitAudioContext;
            if (!AC) return;
            if (!synthCtx) synthCtx = new AC();
            if (synthCtx.state === 'suspended') synthCtx.resume();

            const notes = [261.63, 329.63, 392.00, 523.25, 392.00, 329.63, 293.66, 329.63];
            let nIdx = 0;
            if (synthInterval) clearInterval(synthInterval);

            synthInterval = setInterval(function() {
                if (!isPlaying || !synthCtx) return;
                const osc = synthCtx.createOscillator();
                const gain = synthCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(notes[nIdx % notes.length], synthCtx.currentTime);
                gain.gain.setValueAtTime(0.035, synthCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, synthCtx.currentTime + 1.5);
                osc.connect(gain);
                gain.connect(synthCtx.destination);
                osc.start();
                osc.stop(synthCtx.currentTime + 1.5);
                nIdx++;
            }, 650);
        } catch(e) {}
    }

    function stopNatureSynth() {
        if (synthInterval) clearInterval(synthInterval);
        if (synthCtx && synthCtx.state === 'running') synthCtx.suspend();
    }

    function toggleAudio(start) {
        if (start === undefined) start = !isPlaying;
        isPlaying = start;
        if (isPlaying) {
            if (audio) {
                audio.play().catch(function() { playNatureSynth(); });
            } else {
                playNatureSynth();
            }
            if (disc) disc.classList.add('animate-spin-slow');
        } else {
            if (audio) audio.pause();
            stopNatureSynth();
            if (disc) disc.classList.remove('animate-spin-slow');
        }
    }

    if (toggle) {
        toggle.addEventListener('click', function() { toggleAudio(); });
    }

    // 3. Open Button Action
    const openBtn = document.getElementById('t3-open-btn');
    const cover = document.getElementById('t3-opening-cover');
    const main = document.getElementById('t3-main-content');
    const nav = document.getElementById('t3-bottom-nav');

    if (openBtn) {
        openBtn.addEventListener('click', function() {
            toggleAudio(true);
            cover.classList.add('opacity-0', '-translate-y-8');
            setTimeout(function() {
                cover.style.display = 'none';
                main.classList.remove('opacity-0', 'pointer-events-none');
                main.classList.add('opacity-100');
                if (nav) {
                    nav.classList.remove('translate-y-24', 'opacity-0');
                    nav.classList.add('translate-y-0', 'opacity-100');
                }
                if (toggle) {
                    toggle.classList.remove('opacity-0', 'pointer-events-none');
                    toggle.classList.add('opacity-100');
                }
            }, 800);
        });
    }

    // 4. Countdown Timer
    const evtDateStr = "<%= event?.event_date || eventDate || '2025-12-31 19:00:00' %>";
    const target = new Date(evtDateStr).getTime();

    function updateT3Countdown() {
        const now = new Date().getTime();
        const diff = target - now;
        const dEl = document.getElementById('t3-days');
        const hEl = document.getElementById('t3-hours');
        const mEl = document.getElementById('t3-minutes');
        const sEl = document.getElementById('t3-seconds');

        if (diff <= 0) {
            if (dEl) dEl.textContent = '00';
            if (hEl) hEl.textContent = '00';
            if (mEl) mEl.textContent = '00';
            if (sEl) sEl.textContent = '00';
            return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        if (dEl) dEl.textContent = String(days).padStart(2, '0');
        if (hEl) hEl.textContent = String(hours).padStart(2, '0');
        if (mEl) mEl.textContent = String(minutes).padStart(2, '0');
        if (sEl) sEl.textContent = String(seconds).padStart(2, '0');
    }
    setInterval(updateT3Countdown, 1000);
    updateT3Countdown();

    // 5. Scroll spy for nav
    const sections = document.querySelectorAll('section');
    const links = document.querySelectorAll('.t3-nav-link');

    window.addEventListener('scroll', function() {
        let cur = '';
        sections.forEach(function(s) {
            const top = s.offsetTop - 120;
            if (window.pageYOffset >= top) {
                cur = s.getAttribute('id');
            }
        });
        links.forEach(function(l) {
            l.classList.remove('text-nature-700');
            l.classList.add('text-stone-500');
            if (l.getAttribute('href') === '#' + cur) {
                l.classList.add('text-nature-700');
                l.classList.remove('text-stone-500');
            }
        });
    });
});
</script>
</body>
</html>
