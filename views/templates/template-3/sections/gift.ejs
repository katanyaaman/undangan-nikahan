<!-- Wedding Gift Section - Elegant Nature -->
<section id="gift" class="py-20 bg-cream-50 relative overflow-hidden">
    <div class="relative z-10 container mx-auto px-4 max-w-4xl">
        <div class="text-center mb-16">
            <span class="inline-block text-xs uppercase tracking-[0.25em] text-nature-700 font-bold mb-2">Tanda Kasih</span>
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-stone-900 mb-4">
                Amplop Digital
            </h2>
            <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-nature-500 to-transparent mx-auto mb-4"></div>
            <p class="text-stone-600 max-w-xl mx-auto text-sm sm:text-base leading-relaxed">
                Doa restu Anda adalah karunia yang paling kami harapkan. Bagi yang berkenan memberikan tanda kasih secara cashless:
            </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto mb-10">
            <!-- Account BCA -->
            <div class="rounded-3xl bg-white p-6 sm:p-7 border border-stone-200 shadow-md">
                <div class="flex items-center justify-between mb-5">
                    <span class="text-xs font-bold uppercase tracking-wider text-nature-800">Bank Transfer</span>
                    <span class="text-xl font-black text-stone-900 tracking-wider">BCA</span>
                </div>
                <div class="mb-4">
                    <span class="text-xs text-stone-500 uppercase tracking-wide block mb-1">Nomor Rekening</span>
                    <div class="flex items-center justify-between bg-stone-50 rounded-xl px-4 py-3 border border-stone-200 shadow-sm">
                        <span id="t3-bca-acc" class="font-mono text-lg font-bold text-stone-800">1234567890</span>
                        <button type="button" onclick="copyT3Text('t3-bca-acc', this)" class="px-3 py-1.5 rounded-lg bg-nature-700 text-white text-xs font-bold hover:bg-nature-800 active:scale-95 transition-all">
                            Salin
                        </button>
                    </div>
                </div>
                <div class="pt-2 border-t border-stone-100 flex items-center justify-between text-xs text-stone-600">
                    <span>Atas Nama:</span>
                    <span class="font-semibold text-stone-800"><%= fv(event?.groom_name, 'Nama Mempelai Pria') %></span>
                </div>
            </div>

            <!-- Account Mandiri -->
            <div class="rounded-3xl bg-white p-6 sm:p-7 border border-stone-200 shadow-md">
                <div class="flex items-center justify-between mb-5">
                    <span class="text-xs font-bold uppercase tracking-wider text-nature-800">Bank Transfer</span>
                    <span class="text-xl font-black text-stone-900 tracking-wider">MANDIRI</span>
                </div>
                <div class="mb-4">
                    <span class="text-xs text-stone-500 uppercase tracking-wide block mb-1">Nomor Rekening</span>
                    <div class="flex items-center justify-between bg-stone-50 rounded-xl px-4 py-3 border border-stone-200 shadow-sm">
                        <span id="t3-mandiri-acc" class="font-mono text-lg font-bold text-stone-800">0987654321</span>
                        <button type="button" onclick="copyT3Text('t3-mandiri-acc', this)" class="px-3 py-1.5 rounded-lg bg-nature-700 text-white text-xs font-bold hover:bg-nature-800 active:scale-95 transition-all">
                            Salin
                        </button>
                    </div>
                </div>
                <div class="pt-2 border-t border-stone-100 flex items-center justify-between text-xs text-stone-600">
                    <span>Atas Nama:</span>
                    <span class="font-semibold text-stone-800"><%= fv(event?.bride_name, 'Nama Mempelai Wanita') %></span>
                </div>
            </div>
        </div>

        <!-- Physical Gift Address -->
        <div class="rounded-2xl bg-white border border-stone-200 p-6 text-center max-w-xl mx-auto shadow-sm">
            <h3 class="text-sm font-bold text-stone-900 mb-1">Kirim Kado Fisik</h3>
            <p id="t3-gift-address" class="text-xs sm:text-sm text-stone-600 mb-3 leading-relaxed">
                <%= fv(venueAddress, 'Jl. Sudirman No. 123, Jakarta') %>
            </p>
            <button type="button" onclick="copyT3Text('t3-gift-address', this)" class="inline-flex items-center px-4 py-2 rounded-xl bg-stone-50 text-nature-800 text-xs font-semibold border border-stone-300 hover:bg-stone-100 transition-colors">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                </svg>
                <span>Salin Alamat Kirim</span>
            </button>
        </div>
    </div>
</section>

<!-- Toast alert -->
<div id="t3-toast" class="fixed top-6 left-1/2 -translate-x-1/2 z-50 px-5 py-3 rounded-full bg-nature-800 text-white font-bold text-xs shadow-2xl transition-all duration-300 opacity-0 pointer-events-none -translate-y-4">
    Tersalin ke clipboard!
</div>

<script>
function copyT3Text(elId, btn) {
    const el = document.getElementById(elId);
    if (!el) return;
    const text = el.textContent.trim();
    navigator.clipboard.writeText(text).then(function() {
        const toast = document.getElementById('t3-toast');
        if (toast) {
            toast.textContent = 'Berhasil disalin: ' + text;
            toast.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-4');
            toast.classList.add('opacity-100', 'translate-y-0');
            setTimeout(function() {
                toast.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4');
                toast.classList.remove('opacity-100', 'translate-y-0');
            }, 2500);
        }
        if (btn) {
            const original = btn.innerHTML;
            btn.innerHTML = '✓ Tersalin';
            setTimeout(function() { btn.innerHTML = original; }, 2000);
        }
    });
}
</script>
