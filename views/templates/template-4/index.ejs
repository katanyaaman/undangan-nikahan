<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title || 'The Wedding of ' + fv(event?.groom_name, 'David') + ' & ' + fv(event?.bride_name, 'Sarah') %></title>
    <link rel="stylesheet" href="/css/app.css">
    
    <!-- Google Fonts: Cormorant Garamond, Playfair Display & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Lenis Smooth Scroll Library -->
    <script src="https://unpkg.com/lenis@1.1.20/dist/lenis.min.js"></script>

    <style>
        :root {
            --color-onyx: #0D0D0F;
            --color-surface: #141418;
            --color-gold: #D4AF37;
            --color-gold-light: #FFF4D0;
            --color-cream: #F5F2EB;
            --color-muted: #9E9B93;
            --color-glass: rgba(255, 255, 255, 0.06);
            --border-gold-hairline: 1px solid rgba(212, 175, 55, 0.28);
        }

        /* Standar Phone Container Kotak Seukuran Hape (Seperti Template Lain) */
        .phone-container {
            width: 100% !important;
            max-width: 430px !important;
            margin-left: auto !important;
            margin-right: auto !important;
        }

        /* Lenis smooth scrolling base */
        html.lenis, html.lenis body {
            height: auto;
        }
        .lenis.lenis-smooth {
            scroll-behavior: auto !important;
        }
        .lenis.lenis-smooth [data-lenis-prevent] {
            overscroll-behavior: contain;
        }
        .lenis.lenis-stopped {
            overflow: hidden;
        }

        body {
            background-color: #06080d;
            color: var(--color-cream);
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        .font-editorial {
            font-family: 'Cormorant Garamond', Georgia, serif;
        }

        .font-playfair {
            font-family: 'Playfair Display', Georgia, serif;
        }

        /* 3D Perspective Canvas for Gyroscope & Card Tilt */
        .tilt-card-wrapper {
            perspective: 1200px;
            transform-style: preserve-3d;
        }
        .tilt-card {
            transition: transform 0.15s cubic-bezier(0.2, 0, 0.2, 1), box-shadow 0.3s ease;
            transform-style: preserve-3d;
            will-change: transform;
            position: relative;
        }
        .tilt-card .glare-overlay {
            position: absolute;
            inset: 0;
            border-radius: inherit;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.3s ease;
            background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.25) 0%, rgba(212, 175, 55, 0.1) 40%, transparent 70%);
            mix-blend-mode: overlay;
            z-index: 20;
        }

        /* Analog 35mm Film Grain Texture Overlay */
        .film-grain {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            z-index: 99;
            opacity: 0.04;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        }

        /* Metallic Champagne Gold Foil Gradient */
        .gold-foil-text {
            background: linear-gradient(135deg, #FFF8DB 0%, #D4AF37 45%, #F5D77F 70%, #9B7825 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Frosted Glass Translucent Card */
        .frosted-glass-card {
            background: linear-gradient(145deg, rgba(255, 255, 255, 0.07) 0%, rgba(13, 13, 15, 0.8) 100%);
            backdrop-filter: blur(24px) saturate(190%);
            -webkit-backdrop-filter: blur(24px) saturate(190%);
            border: 1px solid rgba(212, 175, 55, 0.25);
            border-top: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.85), inset 0 1px 0 rgba(255, 255, 255, 0.12);
            position: relative;
            overflow: hidden;
        }

        /* Golden Light Sweep Animation */
        @keyframes golden-sweep {
            0% { transform: translateX(-160%) rotate(25deg); }
            45%, 100% { transform: translateX(260%) rotate(25deg); }
        }
        .gold-shimmer-btn {
            position: relative;
            overflow: hidden;
        }
        .gold-shimmer-btn::after {
            content: '';
            position: absolute;
            top: -50%; left: -50%;
            width: 200%; height: 200%;
            background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.38) 50%, transparent 100%);
            animation: golden-sweep 4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
            pointer-events: none;
        }

        /* Cinematic Staggered Blur-to-Clear Reveal */
        .cinematic-reveal {
            opacity: 0;
            transform: translateY(32px);
            filter: blur(8px);
            transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1), filter 1s ease-out;
            will-change: opacity, transform, filter;
        }
        .cinematic-reveal.revealed {
            opacity: 1;
            transform: translateY(0);
            filter: blur(0);
        }

        /* Vinyl Spin */
        @keyframes spin-vinyl {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .animate-vinyl {
            animation: spin-vinyl 10s linear infinite;
        }

        /* 35mm Film Strip */
        .film-strip {
            background-color: #121215;
            border-top: 2px dashed rgba(212, 175, 55, 0.4);
            border-bottom: 2px dashed rgba(212, 175, 55, 0.4);
            position: relative;
        }
        .film-strip::before, .film-strip::after {
            content: '';
            position: absolute;
            left: 0; right: 0;
            height: 10px;
            background-image: repeating-linear-gradient(90deg, #D4AF37 0px, #D4AF37 6px, transparent 6px, transparent 16px);
            opacity: 0.4;
        }
        .film-strip::before { top: 4px; }
        .film-strip::after { bottom: 4px; }

        /* Black-Gold Credit Card Shimmer */
        .luxury-card-black {
            background: radial-gradient(circle at 85% 15%, #2c2820 0%, #121215 55%, #08080a 100%);
            border: 1px solid rgba(212, 175, 55, 0.45);
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.95), inset 0 1px 1px rgba(255, 255, 255, 0.25);
        }

        /* Hide scrollbars */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="selection:bg-[#D4AF37] selection:text-[#0D0D0F]">

<!-- 35mm Analog Film Grain Overlay -->
<div class="film-grain"></div>

<!-- Ambient Desktop Background (Kontras Mewah di Luar Kotak Handphone) -->
<div class="fixed inset-0 pointer-events-none opacity-50 z-0 bg-[radial-gradient(ellipse_at_center,rgba(212,175,55,0.08)_0%,transparent_75%)]"></div>

<!-- ======================================================== -->
<!-- KOTAK SEUKURAN HAPE (PHONE-CONTAINER SEPERTI TEMPLATE LAIN) -->
<!-- ======================================================== -->
<div class="phone-container min-h-screen bg-[#0D0D0F] shadow-[0_0_60px_rgba(0,0,0,0.92),0_0_25px_rgba(212,175,55,0.06)] relative border-x border-[#D4AF37]/25 z-10 overflow-x-hidden">

    <!-- Background Audio Element -->
    <audio id="t4-audio" loop preload="auto" crossorigin="anonymous">
        <source src="<%= event?.background_music || '/music/wedding-song.mp3' %>" type="audio/mpeg">
    </audio>

    <!-- ========================================== -->
    <!-- 1. EDITORIAL OPENING COVER / AMPLOP MODAL  -->
    <!-- ========================================== -->
    <div id="t4-opening-cover" class="fixed inset-0 z-50 flex items-center justify-center bg-black/85 px-4 backdrop-blur-xl transition-all duration-1000 ease-out">
        <div class="tilt-card-wrapper max-w-[390px] w-full mx-auto">
            <div class="tilt-card relative z-10 text-center py-10 px-6 rounded-3xl frosted-glass-card border border-[#D4AF37]/40 shadow-2xl">
                <div class="glare-overlay"></div>

                <!-- Monogram Seal -->
                <div class="w-16 h-16 mx-auto mb-5 rounded-full border border-[#D4AF37]/50 flex items-center justify-center bg-[#0D0D0F]/90 shadow-[0_0_20px_rgba(212,175,55,0.25)]">
                    <span class="font-editorial text-2xl font-bold gold-foil-text tracking-widest">
                        <%= (fv(event?.groom_name, 'D')[0]) %>&<%= (fv(event?.bride_name, 'S')[0]) %>
                    </span>
                </div>

                <p class="text-[10px] uppercase tracking-[0.35em] text-[#D4AF37] font-semibold mb-2">
                    A Sacred Union &bull; Editorial Invitation
                </p>

                <h1 class="font-editorial text-4xl sm:text-5xl text-white mb-2 leading-none font-bold tracking-tight">
                    <span data-demo="groom_name"><%= fv(event?.groom_name, 'David') %></span>
                    <span class="block text-2xl font-editorial italic text-[#D4AF37] my-1">&</span>
                    <span data-demo="bride_name"><%= fv(event?.bride_name, 'Sarah') %></span>
                </h1>

                <p class="text-xs text-[#E5D3B3] font-editorial italic tracking-wider mb-6">
                    <%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %>
                </p>

                <div class="w-16 h-px bg-gradient-to-r from-transparent via-[#D4AF37] to-transparent mx-auto mb-6"></div>

                <p class="text-[10px] text-[#A39F93] uppercase tracking-widest mb-1">Kepada Yth. Tamu Kehormatan</p>
                <p id="t4-recipient-name" class="text-sm font-editorial font-bold text-[#D4AF37] mb-7 px-4 py-2 bg-black/60 rounded-xl border border-[#D4AF37]/30 inline-block shadow-inner max-w-full truncate">
                    Tamu Undangan
                </p>

                <!-- Buka Undangan CTA Button with Shimmer Sweep -->
                <button id="t4-open-btn" class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 text-xs font-bold text-[#0D0D0F] bg-gradient-to-r from-[#FFF6D1] via-[#D4AF37] to-[#B8922C] rounded-full shadow-[0_8px_25px_rgba(212,175,55,0.4)] hover:brightness-110 active:scale-95 transition-all duration-300 gold-shimmer-btn cursor-pointer uppercase tracking-wider">
                    <svg class="w-4 h-4 text-[#0D0D0F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19v-8.93a2 2 0 01.89-1.664l7-4.666a2 2 0 012.22 0l7 4.666A2 2 0 0121 10.07V19M3 19a2 2 0 002 2h14a2 2 0 002-2M3 19l6.75-4.5M21 19l-6.75-4.5M3 10l6.75 4.5M21 10l-6.75 4.5m0 0l-1.14.76a2 2 0 01-2.22 0l-1.14-.76"></path>
                    </svg>
                    <span>Buka Undangan</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- MAIN INTERACTIVE CONTENT                   -->
    <!-- ========================================== -->
    <main id="t4-main-content" class="opacity-0 pointer-events-none transition-all duration-1000 transform scale-98 pb-28">

        <!-- ========================================== -->
        <!-- 2. HERO / COVER SECTION (Full-Bleed Frame) -->
        <!-- ========================================== -->
        <section id="hero" class="relative min-h-[96vh] flex flex-col justify-end text-center px-4 pb-16 pt-24 overflow-hidden">
            <!-- Full-Bleed High Fashion Couple Photo with Parallax Support -->
            <div class="absolute inset-0 z-0">
                <img id="t4-hero-image" src="https://images.unsplash.com/photo-1583939003579-730e3918a45a?auto=format&fit=crop&w=1200&q=80" alt="The Couple" class="w-full h-full object-cover object-center filter brightness-[0.62] contrast-110 transform transition-transform duration-700 scale-105">
                <div class="absolute inset-0 bg-gradient-to-t from-[#0D0D0F] via-[#0D0D0F]/45 to-black/30"></div>
                <div class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-b from-[#0D0D0F]/80 to-transparent"></div>
            </div>

            <!-- Top Tagline -->
            <div class="relative z-10 mb-auto cinematic-reveal">
                <span class="inline-block text-[10px] uppercase tracking-[0.35em] text-[#D4AF37] font-semibold px-3 py-1 rounded-full border border-[#D4AF37]/35 bg-black/60 backdrop-blur-md">
                    The Wedding Celebration
                </span>
            </div>

            <!-- Hero Names & Editorial Title -->
            <div class="relative z-10 cinematic-reveal">
                <p class="font-editorial italic text-base text-[#E5D3B3] mb-1">Untaian Kasih & Janji Suci</p>
                <h1 class="font-editorial text-4xl sm:text-5xl text-white mb-3 leading-none font-bold tracking-tight drop-shadow-lg">
                    <span data-demo="groom_name"><%= fv(event?.groom_name, 'David') %></span>
                    <span class="block text-2xl font-editorial italic gold-foil-text my-1">&</span>
                    <span data-demo="bride_name"><%= fv(event?.bride_name, 'Sarah') %></span>
                </h1>

                <p class="text-xs text-[#E5D3B3] font-editorial tracking-widest mt-3">
                    <span data-demo="event_date"><%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %></span>
                </p>
                <p class="text-[11px] text-[#A39F93] font-mono tracking-wider mt-0.5">
                    <%= fv(eventTimeStart, 'Pukul 09.00 WITA') %> &bull; <%= fv(event?.venue_name, 'The Glasshouse Ballroom') %>
                </p>

                <!-- Scroll Down Hint -->
                <div class="mt-8">
                    <a href="#countdown-cal" class="t4-nav-link inline-flex flex-col items-center text-[#D4AF37] opacity-80 hover:opacity-100 transition-opacity">
                        <span class="text-[9px] uppercase tracking-widest mb-1">Gulir ke bawah</span>
                        <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 3. COUNTDOWN & 1-TAP KALENDER              -->
        <!-- ========================================== -->
        <section id="countdown-cal" class="py-14 px-4 bg-gradient-to-b from-[#0D0D0F] via-[#121217] to-[#0D0D0F] border-t border-[#D4AF37]/20">
            <div class="max-w-sm mx-auto text-center cinematic-reveal">
                <span class="text-[10px] uppercase tracking-[0.35em] text-[#D4AF37] block mb-1 font-semibold">Menghitung Hari</span>
                <h2 class="font-editorial text-2xl text-white tracking-wider mb-6">Waktu Menuju Bahagia</h2>

                <!-- Minimalist Digital Countdown Box -->
                <div id="t4-countdown" class="grid grid-cols-4 gap-2.5 mb-8" data-date="<%= eventDate || '2026-12-31T09:00:00' %>">
                    <div class="frosted-glass-card rounded-2xl p-3 text-center">
                        <span id="t4-cd-days" class="block font-mono font-bold text-xl gold-foil-text">00</span>
                        <span class="text-[9px] uppercase tracking-wider text-[#A39F93]">Hari</span>
                    </div>
                    <div class="frosted-glass-card rounded-2xl p-3 text-center">
                        <span id="t4-cd-hours" class="block font-mono font-bold text-xl gold-foil-text">00</span>
                        <span class="text-[9px] uppercase tracking-wider text-[#A39F93]">Jam</span>
                    </div>
                    <div class="frosted-glass-card rounded-2xl p-3 text-center">
                        <span id="t4-cd-minutes" class="block font-mono font-bold text-xl gold-foil-text">00</span>
                        <span class="text-[9px] uppercase tracking-wider text-[#A39F93]">Menit</span>
                    </div>
                    <div class="frosted-glass-card rounded-2xl p-3 text-center">
                        <span id="t4-cd-seconds" class="block font-mono font-bold text-xl gold-foil-text">00</span>
                        <span class="text-[9px] uppercase tracking-wider text-[#A39F93]">Detik</span>
                    </div>
                </div>

                <!-- 1-Tap Calendar Sync Button -->
                <div class="flex items-center justify-center gap-2">
                    <a id="t4-gcal-link" href="#" target="_blank" class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3 bg-[#D4AF37]/15 hover:bg-[#D4AF37]/25 border border-[#D4AF37]/40 text-[#D4AF37] rounded-xl text-xs font-semibold active:scale-95 transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        <span>Simpan ke Google Calendar</span>
                    </a>
                    <button type="button" onclick="downloadICS()" class="px-3.5 py-3 bg-[#D4AF37]/15 hover:bg-[#D4AF37]/25 border border-[#D4AF37]/40 text-[#D4AF37] rounded-xl text-xs font-semibold active:scale-95 transition-all" title="Unduh Kalender Apple / iCal (.ics)">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                    </button>
                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 4. KEDUA MEMPELAI (3D TILT PROFILES)       -->
        <!-- ========================================== -->
        <section id="pasangan" class="py-16 px-4 bg-[#0D0D0F] border-t border-[#D4AF37]/20">
            <div class="max-w-sm mx-auto text-center cinematic-reveal">
                <!-- Ayat Suci -->
                <div class="tilt-card-wrapper mb-10">
                    <div class="tilt-card p-6 rounded-3xl frosted-glass-card shadow-2xl">
                        <div class="glare-overlay"></div>
                        <p class="font-editorial italic text-base text-[#E5D3B3] mb-3 leading-relaxed">
                            "Dan di antara tanda-tanda kebesaran-Nya ialah Dia menciptakan pasangan-pasangan untukmu dari jenismu sendiri, agar kamu cenderung dan merasa tenteram kepadanya, dan Dia menjadikan di antaramu rasa kasih dan sayang."
                        </p>
                        <span class="text-[10px] uppercase tracking-widest text-[#D4AF37] font-semibold">
                            — QS. Ar-Rum: 21
                        </span>
                    </div>
                </div>

                <span class="text-[10px] uppercase tracking-[0.35em] text-[#D4AF37] block mb-1 font-semibold">Kedua Mempelai</span>
                <h2 class="font-editorial text-3xl text-white tracking-wider mb-2">Mempelai Mulia</h2>
                <div class="w-12 h-0.5 bg-[#D4AF37] mx-auto mb-8"></div>

                <!-- Mempelai Pria (3D Tilt Card) -->
                <div class="tilt-card-wrapper mb-8">
                    <div class="tilt-card p-6 rounded-3xl frosted-glass-card shadow-2xl relative overflow-hidden cinematic-reveal">
                        <div class="glare-overlay"></div>
                        <div class="w-28 h-28 mx-auto mb-4 rounded-full p-1 bg-gradient-to-tr from-[#FFF6D1] via-[#D4AF37] to-[#9B7825] shadow-xl">
                            <div class="w-full h-full rounded-full overflow-hidden bg-black">
                                <img src="<%= groomPhoto || 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=600&q=80' %>" alt="Mempelai Pria" class="w-full h-full object-cover">
                            </div>
                        </div>
                        <h3 class="font-editorial text-2xl font-bold text-white mb-1 tracking-wide">
                            <span data-demo="groom_name"><%= fv(event?.groom_name, 'David Anderson') %></span>
                        </h3>
                        <p class="text-[11px] text-[#D4AF37] font-editorial uppercase tracking-wider mb-3">Mempelai Pria</p>
                        <p class="text-xs text-[#E5D3B3]/90 leading-relaxed">
                            Putra dari<br>
                            <span class="font-semibold text-white"><%= fv(event?.groom_father, 'Bpk. Michael Anderson') %></span> &<br>
                            <span class="font-semibold text-white"><%= fv(event?.groom_mother, 'Ibu Emily Anderson') %></span>
                        </p>
                        <% if (event?.instagram_groom) { %>
                        <div class="mt-4">
                            <a href="https://instagram.com/<%= event.instagram_groom.replace('@', '') %>" target="_blank" class="inline-flex items-center gap-1.5 text-xs text-[#D4AF37] hover:underline">
                                <span>@<%= event.instagram_groom.replace('@', '') %></span>
                            </a>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- Ampersand Divider -->
                <div class="my-4">
                    <span class="font-editorial italic text-4xl gold-foil-text">&</span>
                </div>

                <!-- Mempelai Wanita (3D Tilt Card) -->
                <div class="tilt-card-wrapper">
                    <div class="tilt-card p-6 rounded-3xl frosted-glass-card shadow-2xl relative overflow-hidden cinematic-reveal">
                        <div class="glare-overlay"></div>
                        <div class="w-28 h-28 mx-auto mb-4 rounded-full p-1 bg-gradient-to-tr from-[#FFF6D1] via-[#D4AF37] to-[#9B7825] shadow-xl">
                            <div class="w-full h-full rounded-full overflow-hidden bg-black">
                                <img src="<%= bridePhoto || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80' %>" alt="Mempelai Wanita" class="w-full h-full object-cover">
                            </div>
                        </div>
                        <h3 class="font-editorial text-2xl font-bold text-white mb-1 tracking-wide">
                            <span data-demo="bride_name"><%= fv(event?.bride_name, 'Sarah Johnson') %></span>
                        </h3>
                        <p class="text-[11px] text-[#D4AF37] font-editorial uppercase tracking-wider mb-3">Mempelai Wanita</p>
                        <p class="text-xs text-[#E5D3B3]/90 leading-relaxed">
                            Putri dari<br>
                            <span class="font-semibold text-white"><%= fv(event?.bride_father, 'Bpk. Robert Johnson') %></span> &<br>
                            <span class="font-semibold text-white"><%= fv(event?.bride_mother, 'Ibu Linda Johnson') %></span>
                        </p>
                        <% if (event?.instagram_bride) { %>
                        <div class="mt-4">
