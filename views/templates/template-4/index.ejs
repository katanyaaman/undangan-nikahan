<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title || 'The Wedding of ' + fv(event?.groom_name, 'David') + ' & ' + fv(event?.bride_name, 'Sarah') %></title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800;900&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .font-royal { font-family: 'Cinzel', serif; }
        .font-serif-luxury { font-family: 'Cormorant Garamond', Georgia, serif; }
        
        .phone-container {
            width: 100% !important;
            max-width: 440px !important;
            margin-left: auto !important;
            margin-right: auto !important;
        }

        .gold-metallic-text {
            background: linear-gradient(135deg, #fef08a 0%, #dfc573 50%, #b78a3a 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .emerald-grain {
            background-color: #022319;
            background-image: 
                linear-gradient(45deg, rgba(223, 197, 115, 0.04) 25%, transparent 25%, transparent 75%, rgba(223, 197, 115, 0.04) 75%),
                linear-gradient(45deg, rgba(223, 197, 115, 0.04) 25%, transparent 25%, transparent 75%, rgba(223, 197, 115, 0.04) 75%);
            background-size: 32px 32px;
            background-position: 0 0, 16px 16px;
        }

        .corner-gold-filigree {
            position: relative;
        }
        .corner-gold-filigree::before {
            content: '';
            position: absolute;
            top: 0; left: 0;
            width: 16px; height: 16px;
            border-top: 2px solid #dfc573;
            border-left: 2px solid #dfc573;
        }
        .corner-gold-filigree::after {
            content: '';
            position: absolute;
            bottom: 0; right: 0;
            width: 16px; height: 16px;
            border-bottom: 2px solid #dfc573;
            border-right: 2px solid #dfc573;
        }

        @keyframes spin-slow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .animate-spin-slow {
            animation: spin-slow 10s linear infinite;
        }
    </style>
</head>
<body class="bg-[#011710] text-[#e8f3ee] font-sans antialiased overflow-x-hidden selection:bg-[#dfc573] selection:text-[#022319] min-h-screen">

<!-- Ambient Desktop Background -->
<div class="fixed inset-0 pointer-events-none opacity-40 z-0 emerald-grain"></div>

<!-- Outer Frame Container -->
<div class="phone-container min-h-screen bg-[#022b1e] shadow-2xl relative border-x border-[#dfc573]/30 z-10">

    <!-- Audio Element -->
    <audio id="t4-audio" loop preload="auto">
        <source src="<%= event?.background_music || '/music/wedding-song.mp3' %>" type="audio/mpeg">
    </audio>

    <!-- 1. OPENING COVER / AMPLOP EMERALD ROYAL SULAPA EPPA -->
    <div id="t4-opening-cover" class="fixed inset-0 z-50 flex items-center justify-center bg-gradient-to-b from-[#011c14] via-[#022b1e] to-[#011c14] px-4 transition-all duration-1000">
        <!-- Floating Royal Gold Glow -->
        <div class="absolute w-72 h-72 rounded-full bg-[#dfc573]/15 blur-3xl pointer-events-none"></div>

        <div class="relative z-10 text-center max-w-[380px] w-full mx-auto py-12 px-6 rounded-3xl bg-[#043b2a]/95 border-2 border-[#dfc573]/50 shadow-2xl backdrop-blur-xl corner-gold-filigree">
            <!-- Sulapa Eppa Diamond Emblem -->
            <div class="w-20 h-20 mx-auto mb-6 flex items-center justify-center rotate-45 border-2 border-[#dfc573] bg-[#022319] shadow-lg shadow-[#dfc573]/15">
                <span class="-rotate-45 font-royal text-2xl font-black gold-metallic-text tracking-widest">
                    <%= (fv(event?.groom_name, 'D')[0]) %>&<%= (fv(event?.bride_name, 'S')[0]) %>
                </span>
            </div>

            <p class="font-serif-luxury text-base text-[#dfc573] mb-1">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
            <p class="text-[11px] uppercase tracking-[0.35em] text-[#dfc573] font-royal font-bold mb-3">
                Undangan Perhelatan Agung Adat
            </p>

            <h1 class="font-royal text-3xl sm:text-4xl text-white mb-2 leading-tight tracking-wider font-extrabold">
                <span data-demo="groom_name"><%= fv(event?.groom_name, 'David') %></span>
                <span class="text-[#dfc573] font-serif-luxury text-2xl mx-1.5">&</span>
                <span data-demo="bride_name"><%= fv(event?.bride_name, 'Sarah') %></span>
            </h1>

            <p class="text-xs text-[#a2cebe] font-serif-luxury tracking-widest mb-6">
                <%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %>
            </p>

            <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-[#dfc573] to-transparent mx-auto mb-6"></div>

            <p class="text-[11px] text-[#a2cebe] uppercase tracking-widest mb-1.5 font-medium">Kepada Yth. Bapak/Ibu/Saudara/i</p>
            <p id="t4-recipient-name" class="text-base font-serif-luxury font-bold text-[#dfc573] mb-8 px-5 py-2.5 bg-[#011c14]/90 rounded-xl border border-[#dfc573]/40 inline-block shadow-inner max-w-full truncate">
                Tamu Undangan
            </p>

            <div>
                <button id="t4-open-btn" class="w-full inline-flex items-center justify-center gap-2.5 px-8 py-3.5 text-sm font-bold text-[#022319] bg-gradient-to-r from-[#fef08a] via-[#dfc573] to-[#b78a3a] hover:brightness-110 rounded-full shadow-lg shadow-[#dfc573]/25 transition-all duration-300 transform hover:scale-[1.02] active:scale-95">
                    <svg class="w-4 h-4 text-[#022319]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19v-8.93a2 2 0 01.89-1.664l7-4.666a2 2 0 012.22 0l7 4.666A2 2 0 0121 10.07V19M3 19a2 2 0 002 2h14a2 2 0 002-2M3 19l6.75-4.5M21 19l-6.75-4.5M3 10l6.75 4.5M21 10l-6.75 4.5m0 0l-1.14.76a2 2 0 01-2.22 0l-1.14-.76"></path>
                    </svg>
                    <span>Buka Undangan</span>
                </button>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT WRAPPER -->
    <div id="t4-main-content" class="opacity-0 pointer-events-none transition-opacity duration-1000">

        <!-- 2. HERO SECTION / ROYAL CANOPY -->
        <section id="hero" class="relative min-h-[92vh] flex items-center justify-center text-center px-4 py-20 overflow-hidden bg-gradient-to-b from-[#011c14] via-[#022b1e] to-[#033626]">
            <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-80 h-80 bg-[#dfc573]/15 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10 max-w-sm mx-auto">
                <span class="inline-block text-[10px] uppercase tracking-[0.35em] text-[#dfc573] font-royal font-bold mb-4 px-3.5 py-1 rounded-full border border-[#dfc573]/40 bg-[#043b2a]/90 shadow-sm">
                    Walimatul 'Ursy
                </span>

                <h2 class="font-royal text-3xl sm:text-4xl text-white mb-3 leading-tight tracking-wider font-extrabold drop-shadow-md">
                    <span data-demo="groom_name"><%= fv(event?.groom_name, 'David') %></span>
                    <span class="block text-xl font-serif-luxury gold-metallic-text my-1">&</span>
                    <span data-demo="bride_name"><%= fv(event?.bride_name, 'Sarah') %></span>
                </h2>

                <p class="text-xs text-[#c0decb] font-royal tracking-widest mt-4">
                    <span data-demo="event_date"><%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %></span>
                </p>
                <p class="text-xs text-[#dfc573] font-mono tracking-wider mt-1">
                    <%= fv(eventTimeStart, 'Pukul 09.00 WITA') %>
                </p>

                <!-- Countdown Timer 4 Royal Medallions -->
                <div id="t4-countdown" class="grid grid-cols-4 gap-2.5 mt-10" data-date="<%= eventDate || '2026-12-31T09:00:00' %>">
                    <div class="bg-[#011c14]/80 border border-[#dfc573]/40 rounded-2xl p-2.5 shadow-md">
                        <span id="t4-cd-days" class="block font-royal font-bold text-lg text-[#dfc573]">00</span>
                        <span class="text-[9px] uppercase tracking-wider text-[#a2cebe]">Hari</span>
                    </div>
                    <div class="bg-[#011c14]/80 border border-[#dfc573]/40 rounded-2xl p-2.5 shadow-md">
                        <span id="t4-cd-hours" class="block font-royal font-bold text-lg text-[#dfc573]">00</span>
                        <span class="text-[9px] uppercase tracking-wider text-[#a2cebe]">Jam</span>
                    </div>
                    <div class="bg-[#011c14]/80 border border-[#dfc573]/40 rounded-2xl p-2.5 shadow-md">
                        <span id="t4-cd-minutes" class="block font-royal font-bold text-lg text-[#dfc573]">00</span>
                        <span class="text-[9px] uppercase tracking-wider text-[#a2cebe]">Menit</span>
                    </div>
                    <div class="bg-[#011c14]/80 border border-[#dfc573]/40 rounded-2xl p-2.5 shadow-md">
                        <span id="t4-cd-seconds" class="block font-royal font-bold text-lg text-[#dfc573]">00</span>
                        <span class="text-[9px] uppercase tracking-wider text-[#a2cebe]">Detik</span>
                    </div>
                </div>

                <div class="mt-10 animate-bounce">
                    <a href="#pasangan" class="inline-flex items-center text-[#dfc573] hover:text-white transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </section>

        <!-- 3. PETUAH ADAT & PASANGAN (THE ROYAL COUPLE) -->
        <section id="pasangan" class="py-16 px-4 bg-[#022b1e] border-t border-[#dfc573]/20">
            <div class="max-w-sm mx-auto text-center">
                <!-- Petuah Luhur Adat Bugis / Nusantara -->
                <div class="mb-12 p-6 rounded-3xl bg-[#043b2a] border border-[#dfc573]/40 shadow-lg corner-gold-filigree">
                    <p class="font-serif-luxury italic text-base text-[#dfc573] mb-3 leading-relaxed">
                        "Taro Ada Taro Gau. Naiyya siri’e, sunge’ taranrena. Dua hati yang dipersatukan dalam ikrar suci, memegang teguh marwah, kehormatan, dan cinta sejati."
                    </p>
                    <span class="text-[10px] uppercase tracking-widest text-[#a2cebe] font-royal font-semibold">
                        — Falsafah Keteguhan Janji & Marwah
                    </span>
                </div>

                <span class="text-[10px] uppercase tracking-[0.35em] text-[#dfc573] block mb-1">Mempelai Mulia</span>
                <h3 class="font-royal text-2xl text-white tracking-widest uppercase mb-2">Kedua Mempelai</h3>
                <div class="w-12 h-0.5 bg-[#dfc573] mx-auto mb-8"></div>

                <!-- Groom -->
                <div class="mb-10 p-6 rounded-3xl bg-[#043b2a] border border-[#dfc573]/40 shadow-xl relative overflow-hidden group">
                    <div class="w-32 h-32 mx-auto mb-4 rounded-full p-1 bg-gradient-to-tr from-[#dfc573] via-[#b78a3a] to-[#fef08a] shadow-lg">
                        <div class="w-full h-full rounded-full overflow-hidden bg-[#011c14]">
                            <img src="<%= groomPhoto || '/images/demo/groom.svg' %>" alt="Mempelai Pria" class="w-full h-full object-cover">
                        </div>
                    </div>
                    <h4 class="font-royal text-xl font-bold text-white mb-1 tracking-wider">
                        <span data-demo="groom_name"><%= fv(event?.groom_name, 'David Anderson') %></span>
                    </h4>
                    <p class="text-xs text-[#dfc573] font-royal uppercase tracking-wider mb-3">Mempelai Pria</p>
                    <p class="text-xs text-[#d2eae0] leading-relaxed">
                        Putra tercinta dari<br>
                        <span class="font-semibold text-white"><%= fv(event?.groom_father, 'Bpk. Michael Anderson') %></span> &<br>
                        <span class="font-semibold text-white"><%= fv(event?.groom_mother, 'Ibu Emily Anderson') %></span>
                    </p>
                    <% if (event?.instagram_groom) { %>
                    <div class="mt-4">
                        <a href="https://instagram.com/<%= event.instagram_groom.replace('@', '') %>" target="_blank" class="inline-flex items-center gap-1.5 text-xs text-[#dfc573] hover:underline">
                            <span>@<%= event.instagram_groom.replace('@', '') %></span>
                        </a>
                    </div>
                    <% } %>
                </div>

                <!-- Royal Gold Ampersand -->
                <div class="my-6">
                    <span class="font-serif-luxury text-4xl gold-metallic-text">&</span>
                </div>

                <!-- Bride -->
                <div class="p-6 rounded-3xl bg-[#043b2a] border border-[#dfc573]/40 shadow-xl relative overflow-hidden group">
                    <div class="w-32 h-32 mx-auto mb-4 rounded-full p-1 bg-gradient-to-tr from-[#dfc573] via-[#b78a3a] to-[#fef08a] shadow-lg">
                        <div class="w-full h-full rounded-full overflow-hidden bg-[#011c14]">
                            <img src="<%= bridePhoto || '/images/demo/bride.svg' %>" alt="Mempelai Wanita" class="w-full h-full object-cover">
                        </div>
                    </div>
                    <h4 class="font-royal text-xl font-bold text-white mb-1 tracking-wider">
                        <span data-demo="bride_name"><%= fv(event?.bride_name, 'Sarah Johnson') %></span>
                    </h4>
                    <p class="text-xs text-[#dfc573] font-royal uppercase tracking-wider mb-3">Mempelai Wanita</p>
                    <p class="text-xs text-[#d2eae0] leading-relaxed">
                        Putri tercinta dari<br>
                        <span class="font-semibold text-white"><%= fv(event?.bride_father, 'Bpk. Robert Johnson') %></span> &<br>
                        <span class="font-semibold text-white"><%= fv(event?.bride_mother, 'Ibu Linda Johnson') %></span>
                    </p>
                    <% if (event?.instagram_bride) { %>
                    <div class="mt-4">
                        <a href="https://instagram.com/<%= event.instagram_bride.replace('@', '') %>" target="_blank" class="inline-flex items-center gap-1.5 text-xs text-[#dfc573] hover:underline">
                            <span>@<%= event.instagram_bride.replace('@', '') %></span>
                        </a>
                    </div>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- 4. RANGKAIAN PERHELATAN (EVENT AGENDA) -->
        <section id="acara" class="py-16 px-4 bg-[#011c14] border-t border-[#dfc573]/20">
            <div class="max-w-sm mx-auto text-center">
                <span class="text-[10px] uppercase tracking-[0.35em] text-[#dfc573] font-royal block mb-1">Perhelatan Sakral</span>
                <h3 class="font-royal text-2xl text-white tracking-wider mb-2">Rangkaian Acara</h3>
                <div class="w-12 h-0.5 bg-[#dfc573] mx-auto mb-8"></div>

                <!-- Akad Nikah Card -->
                <div class="p-6 rounded-3xl bg-[#043b2a] border border-[#dfc573]/40 shadow-xl mb-6 text-left">
                    <div class="flex items-center justify-between mb-4 border-b border-[#dfc573]/25 pb-3">
                        <h4 class="font-royal font-bold text-base text-white">Akad Nikah / Ijab Qabul</h4>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-[#dfc573]/20 text-[#dfc573] border border-[#dfc573]/40">Sakral</span>
                    </div>
                    <div class="space-y-2.5 text-xs text-[#d2eae0]">
                        <div class="flex items-center gap-2.5">
                            <svg class="w-4 h-4 text-[#dfc573]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            <span data-demo="event_date"><%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %></span>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <svg class="w-4 h-4 text-[#dfc573]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span><%= fv(eventTimeStart, '08.00 - 10.00 WITA') %></span>
                        </div>
                        <div class="flex items-start gap-2.5">
                            <svg class="w-4 h-4 text-[#dfc573] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            <div>
                                <strong class="text-white block" data-demo="venue_name"><%= fv(event?.venue_name, 'Istana Datu Luwu / Ballroom') %></strong>
                                <span class="text-[#a2cebe]" data-demo="venue_address"><%= fv(event?.venue_address, 'Jl. Sultan Hasanuddin No. 7, Makassar') %></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Resepsi Card -->
                <div class="p-6 rounded-3xl bg-[#043b2a] border border-[#dfc573]/40 shadow-xl mb-6 text-left">
                    <div class="flex items-center justify-between mb-4 border-b border-[#dfc573]/25 pb-3">
                        <h4 class="font-royal font-bold text-base text-white">Resepsi & Jamuan Adat</h4>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-[#dfc573]/20 text-[#dfc573] border border-[#dfc573]/40">Perayaan</span>
                    </div>
                    <div class="space-y-2.5 text-xs text-[#d2eae0]">
                        <div class="flex items-center gap-2.5">
                            <svg class="w-4 h-4 text-[#dfc573]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            <span data-demo="event_date"><%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %></span>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <svg class="w-4 h-4 text-[#dfc573]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span><%= fv(eventTimeRange, '11.00 WITA - Selesai') %></span>
                        </div>
                        <div class="flex items-start gap-2.5">
                            <svg class="w-4 h-4 text-[#dfc573] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            <div>
                                <strong class="text-white block" data-demo="venue_name"><%= fv(event?.venue_name, 'Istana Datu Luwu / Ballroom') %></strong>
                                <span class="text-[#a2cebe]" data-demo="venue_address"><%= fv(event?.venue_address, 'Jl. Sultan Hasanuddin No. 7, Makassar') %></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Google Maps Link Button -->
                <a href="<%= event?.venue_maps_url || 'https://maps.google.com' %>" target="_blank" class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-gradient-to-r from-[#dfc573] to-[#b78a3a] text-[#022319] font-bold text-xs uppercase tracking-wider rounded-xl shadow-lg hover:brightness-110 active:scale-95 transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    <span>Petunjuk Lokasi Google Maps</span>
                </a>
            </div>
        </section>

        <!-- 5. KISAH CINTA (ROYAL MILESTONES) -->
        <section id="cerita" class="py-16 px-4 bg-[#022b1e] border-t border-[#dfc573]/20">
            <div class="max-w-sm mx-auto">
                <div class="text-center mb-10">
                    <span class="text-[10px] uppercase tracking-[0.35em] text-[#dfc573] font-royal block mb-1">Untaian Hikayat</span>
                    <h3 class="font-royal text-2xl text-white tracking-wider mb-2">Kisah Perjalanan</h3>
                    <div class="w-12 h-0.5 bg-[#dfc573] mx-auto"></div>
                </div>

                <div class="relative border-l-2 border-[#dfc573]/50 ml-4 space-y-8 pl-6">
                    <!-- Chapter 1 -->
                    <div class="relative">
                        <div class="absolute -left-[31px] top-1 w-4 h-4 rounded-full bg-[#022b1e] border-2 border-[#dfc573]"></div>
                        <span class="text-[10px] font-mono text-[#dfc573] uppercase tracking-wider">Awal Bertemu &bull; 2021</span>
                        <h4 class="font-serif-luxury text-base font-bold text-white mt-0.5">Pertemuan yang Diridhoi</h4>
                        <p class="text-xs text-[#d2eae0] mt-1 leading-relaxed">
                            Dipertemukan melalui silaturahmi keluarga yang mulia, niat tulus saling mengenal mulai terjalin dengan penuh adab.
                        </p>
                    </div>

                    <!-- Chapter 2 -->
                    <div class="relative">
                        <div class="absolute -left-[31px] top-1 w-4 h-4 rounded-full bg-[#022b1e] border-2 border-[#dfc573]"></div>
                        <span class="text-[10px] font-mono text-[#dfc573] uppercase tracking-wider">Mappatabe' &bull; 2023</span>
                        <h4 class="font-serif-luxury text-base font-bold text-white mt-0.5">Merapatkan Hati & Niat</h4>
                        <p class="text-xs text-[#d2eae0] mt-1 leading-relaxed">
                            Membangun keselarasan budi pekerti dan saling menguatkan dalam memegang teguh amanah leluhur untuk bersatu.
                        </p>
                    </div>

                    <!-- Chapter 3 -->
                    <div class="relative">
                        <div class="absolute -left-[31px] top-1 w-4 h-4 rounded-full bg-[#dfc573] shadow-[0_0_8px_#dfc573]"></div>
                        <span class="text-[10px] font-mono text-[#dfc573] uppercase tracking-wider">Mappenre Dui &bull; 2025</span>
                        <h4 class="font-serif-luxury text-base font-bold text-white mt-0.5">Ikatan Lamaran & Hari Mulia</h4>
                        <p class="text-xs text-[#d2eae0] mt-1 leading-relaxed">
                            Prosesi adat lamaran terlaksana khidmat, mengantarkan kami menuju gerbang mahligai rumah tangga yang sakinah.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 6. GALERI FOTO PUSAKA ADAT -->
        <section id="galeri" class="py-16 px-4 bg-[#011c14] border-t border-[#dfc573]/20">
            <div class="max-w-sm mx-auto text-center">
                <span class="text-[10px] uppercase tracking-[0.35em] text-[#dfc573] font-royal block mb-1">Momen Agung</span>
                <h3 class="font-royal text-2xl text-white tracking-wider mb-2">Galeri Kenangan</h3>
                <div class="w-12 h-0.5 bg-[#dfc573] mx-auto mb-8"></div>

                <div class="grid grid-cols-2 gap-3">
                    <% const g4Photos = (galleryPhotos && galleryPhotos.length) ? galleryPhotos : ['/images/templates/template-4.jpg', '/images/templates/template-1.jpg', '/images/templates/template-2.jpg', '/images/templates/template-3.jpg']; %>
                    <% g4Photos.forEach(function(imgUrl, idx) { %>
                    <div class="rounded-2xl overflow-hidden border border-[#dfc573]/40 shadow-md aspect-[3/4] bg-[#022b1e] group">
                        <img src="<%= imgUrl %>" alt="Momen <%= idx + 1 %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                    </div>
                    <% }); %>
                </div>
            </div>
        </section>

        <!-- 7. TANDA KASIH (SOMPA & AMPLOP EMERALD) -->
        <section id="hadiah" class="py-16 px-4 bg-[#022b1e] border-t border-[#dfc573]/20">
            <div class="max-w-sm mx-auto text-center">
                <span class="text-[10px] uppercase tracking-[0.35em] text-[#dfc573] font-royal block mb-1">Tanda Kasih & Sompa</span>
                <h3 class="font-royal text-2xl text-white tracking-wider mb-2">Amplop Digital</h3>
                <div class="w-12 h-0.5 bg-[#dfc573] mx-auto mb-6"></div>
                
                <p class="text-xs text-[#d2eae0] leading-relaxed mb-8">
                    Kehadiran dan doa restu para tetua serta kerabat adalah kemuliaan bagi kami. Bagi yang berkenan memberikan tanda kasih secara digital:
                </p>

                <!-- Emerald Card BCA -->
                <div class="p-6 rounded-3xl bg-gradient-to-br from-[#043b2a] via-[#022b1e] to-[#011c14] border border-[#dfc573]/40 shadow-xl mb-5 text-left relative overflow-hidden">
                    <div class="flex items-center justify-between mb-4">
                        <span class="font-royal font-bold tracking-widest text-[#dfc573] text-sm">BANK BCA</span>
                        <span class="text-[10px] uppercase font-mono text-[#a2cebe]">Royal Platinum</span>
                    </div>
                    <p class="text-[11px] text-[#a2cebe] uppercase tracking-widest mb-1">Nomor Rekening</p>
                    <p id="t4-bca-acc" class="font-mono text-xl font-bold text-white tracking-wider mb-2">1234567890</p>
                    <p class="text-xs text-[#d2eae0] mb-4">a.n. <%= fv(event?.groom_name, 'David Anderson') %></p>
                    <button type="button" onclick="copyT4('t4-bca-acc', this)" class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-[#dfc573]/20 hover:bg-[#dfc573]/30 border border-[#dfc573]/50 text-[#dfc573] rounded-xl text-xs font-semibold active:scale-95 transition-all">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>Salin Nomor Rekening</span>
                    </button>
                </div>

                <!-- Emerald Card Mandiri -->
                <div class="p-6 rounded-3xl bg-gradient-to-br from-[#043b2a] via-[#022b1e] to-[#011c14] border border-[#dfc573]/40 shadow-xl mb-6 text-left relative overflow-hidden">
                    <div class="flex items-center justify-between mb-4">
                        <span class="font-royal font-bold tracking-widest text-[#dfc573] text-sm">BANK MANDIRI</span>
                        <span class="text-[10px] uppercase font-mono text-[#a2cebe]">Royal Platinum</span>
                    </div>
                    <p class="text-[11px] text-[#a2cebe] uppercase tracking-widest mb-1">Nomor Rekening</p>
                    <p id="t4-mandiri-acc" class="font-mono text-xl font-bold text-white tracking-wider mb-2">9876543210</p>
                    <p class="text-xs text-[#d2eae0] mb-4">a.n. <%= fv(event?.bride_name, 'Sarah Johnson') %></p>
                    <button type="button" onclick="copyT4('t4-mandiri-acc', this)" class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-[#dfc573]/20 hover:bg-[#dfc573]/30 border border-[#dfc573]/50 text-[#dfc573] rounded-xl text-xs font-semibold active:scale-95 transition-all">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>Salin Nomor Rekening</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- 8. RSVP & BUKU DOA EMERALD -->
        <section id="doa" class="py-16 px-4 bg-[#011c14] border-t border-[#dfc573]/20">
            <div class="max-w-sm mx-auto">
                <div class="text-center mb-8">
                    <span class="text-[10px] uppercase tracking-[0.35em] text-[#dfc573] font-royal block mb-1">Konfirmasi & Restu</span>
                    <h3 class="font-royal text-2xl text-white tracking-wider mb-2">RSVP & Doa Mulia</h3>
                    <div class="w-12 h-0.5 bg-[#dfc573] mx-auto mb-4"></div>
                    <p class="text-xs text-[#d2eae0]">Konfirmasi kehadiran Bapak/Ibu/Saudara/i sangat kami harapkan.</p>
                </div>

                <!-- RSVP Form -->
                <form id="t4-rsvp-form" class="p-6 rounded-3xl bg-[#043b2a] border border-[#dfc573]/40 shadow-xl mb-8 space-y-4">
                    <div>
                        <label class="block text-[11px] font-royal uppercase tracking-wider text-[#dfc573] mb-1.5">Nama Tamu Kehormatan</label>
                        <input type="text" id="t4-rsvp-name" required placeholder="Contoh: Daeng Marzuki & Keluarga" class="w-full px-4 py-2.5 rounded-xl bg-[#011c14]/80 border border-[#dfc573]/40 text-white text-xs placeholder:text-neutral-500 focus:outline-none focus:border-[#dfc573]">
                    </div>

                    <div>
                        <label class="block text-[11px] font-royal uppercase tracking-wider text-[#dfc573] mb-1.5">Konfirmasi Kehadiran</label>
                        <select id="t4-rsvp-attendance" class="w-full px-4 py-2.5 rounded-xl bg-[#011c14]/80 border border-[#dfc573]/40 text-white text-xs focus:outline-none focus:border-[#dfc573]">
                            <option value="hadir">Insya Allah Hadir</option>
                            <option value="ragu">Masih Ragu</option>
                            <option value="tidak_hadir">Berhalangan Hadir</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-[11px] font-royal uppercase tracking-wider text-[#dfc573] mb-1.5">Jumlah Tamu</label>
                        <select id="t4-rsvp-count" class="w-full px-4 py-2.5 rounded-xl bg-[#011c14]/80 border border-[#dfc573]/40 text-white text-xs focus:outline-none focus:border-[#dfc573]">
                            <option value="1">1 Orang</option>
                            <option value="2">2 Orang</option>
                            <option value="3">3 Orang</option>
                            <option value="4">4 Orang</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-[11px] font-royal uppercase tracking-wider text-[#dfc573] mb-1.5">Untaian Doa & Harapan Barakah</label>
                        <textarea id="t4-rsvp-message" rows="3" required placeholder="Tuliskan doa kebaikan untuk kedua mempelai..." class="w-full px-4 py-2.5 rounded-xl bg-[#011c14]/80 border border-[#dfc573]/40 text-white text-xs placeholder:text-neutral-500 focus:outline-none focus:border-[#dfc573]"></textarea>
                    </div>

                    <button type="submit" id="t4-submit-btn" class="w-full py-3 bg-gradient-to-r from-[#dfc573] to-[#b78a3a] text-[#022319] font-bold text-xs uppercase tracking-wider rounded-xl shadow-lg hover:brightness-110 active:scale-95 transition-all">
                        Kirim Konfirmasi & Doa
                    </button>
                    <p id="t4-rsvp-alert" class="text-xs text-center hidden font-semibold"></p>
                </form>

                <!-- List of Wishes -->
                <div class="space-y-3">
                    <h4 class="font-royal text-sm text-[#dfc573] tracking-wider uppercase mb-2">Buku Doa (<span id="t4-wishes-count"><%= totalWishes %></span>)</h4>
                    <div id="t4-wishes-list" class="space-y-3 max-h-80 overflow-y-auto pr-1">
                        <% if (wishes && wishes.length) { %>
                            <% wishes.forEach(function(w) { %>
                            <div class="p-4 rounded-2xl bg-[#043b2a] border border-[#dfc573]/25 text-left">
                                <div class="flex items-center justify-between mb-1">
                                    <strong class="font-royal text-xs text-white"><%= w.name %></strong>
                                    <span class="text-[9px] px-2 py-0.5 rounded-full bg-[#dfc573]/20 text-[#dfc573] uppercase font-mono font-bold"><%= w.attendance %></span>
                                </div>
                                <p class="text-xs text-[#d2eae0] leading-relaxed"><%= w.message %></p>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-xs text-[#a2cebe] text-center py-4 bg-[#043b2a] rounded-2xl border border-white/5">Jadilah yang pertama mengirimkan untaian doa restu.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </section>

        <!-- 9. FOOTER -->
        <footer class="py-14 px-4 bg-[#01140e] text-center pb-28 text-white border-t border-[#dfc573]/25">
            <div class="max-w-sm mx-auto">
                <span class="font-royal text-2xl gold-metallic-text font-bold block mb-2 tracking-wider">
                    <%= fv(event?.groom_name, 'David') %> & <%= fv(event?.bride_name, 'Sarah') %>
                </span>
                <p class="text-xs text-[#a2cebe] font-serif-luxury mb-4">Terima kasih atas doa, restu, dan kehadiran mulia Anda.</p>
                <div class="w-8 h-px bg-[#dfc573]/50 mx-auto mb-4"></div>
                <p class="text-[10px] text-emerald-300/60 font-sans tracking-wide">
                    Dibuat dengan cinta via <a href="/" class="text-[#dfc573] hover:underline font-semibold">KalaBahagia.com</a>
                </p>
            </div>
        </footer>

    </div>

    <!-- FLOATING MUSIC TOGGLE -->
    <button id="t4-music-toggle" aria-label="Toggle Musik" class="fixed bottom-24 right-4 z-40 w-11 h-11 rounded-full bg-[#043b2a]/95 border-2 border-[#dfc573] shadow-xl flex items-center justify-center text-[#dfc573] transition-all opacity-0 pointer-events-none hover:scale-105 active:scale-95">
        <svg id="t4-disc-icon" class="w-5 h-5 animate-spin-slow" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5zm0-5.5c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z"/>
        </svg>
    </button>

    <!-- BOTTOM DOCK NAVIGATION -->
    <nav id="t4-bottom-dock" class="fixed bottom-3 left-1/2 -translate-x-1/2 z-40 w-[92%] max-w-sm rounded-2xl bg-[#043b2a]/90 border border-[#dfc573]/40 backdrop-blur-xl shadow-2xl py-2 px-3 transition-all duration-500 translate-y-24 opacity-0">
        <div class="flex items-center justify-around text-[10px] font-semibold text-[#a2cebe]">
            <a href="#hero" class="flex flex-col items-center py-1 px-1.5 hover:text-[#dfc573] transition-colors">
                <svg class="w-4 h-4 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                <span>Home</span>
            </a>
            <a href="#pasangan" class="flex flex-col items-center py-1 px-1.5 hover:text-[#dfc573] transition-colors">
                <svg class="w-4 h-4 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                <span>Mempelai</span>
            </a>
            <a href="#acara" class="flex flex-col items-center py-1 px-1.5 hover:text-[#dfc573] transition-colors">
                <svg class="w-4 h-4 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <span>Acara</span>
            </a>
            <a href="#galeri" class="flex flex-col items-center py-1 px-1.5 hover:text-[#dfc573] transition-colors">
                <svg class="w-4 h-4 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <span>Galeri</span>
            </a>
            <a href="#hadiah" class="flex flex-col items-center py-1 px-1.5 hover:text-[#dfc573] transition-colors">
                <svg class="w-4 h-4 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 00-2 2v6a2 2 0 002 2h14a2 2 0 002-2v-6a2 2 0 00-2-2H5z"/></svg>
                <span>Kado</span>
            </a>
            <a href="#doa" class="flex flex-col items-center py-1 px-1.5 hover:text-[#dfc573] transition-colors">
                <svg class="w-4 h-4 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                <span>RSVP</span>
            </a>
        </div>
    </nav>

</div>

<!-- SCRIPT LOGIC INTERAKTIF -->
<script>
(function() {
    // 1. Ambil nama tamu dari URL param (?to= atau ?tamu=)
    const params = new URLSearchParams(window.location.search);
    const guestParam = params.get('to') || params.get('tamu') || params.get('u');
    if (guestParam) {
        const el = document.getElementById('t4-recipient-name');
        if (el) el.textContent = guestParam;
        const nameInput = document.getElementById('t4-rsvp-name');
        if (nameInput) nameInput.value = guestParam;
    }

    // 2. Audio & Buka Undangan
    const audio = document.getElementById('t4-audio');
    const openBtn = document.getElementById('t4-open-btn');
    const cover = document.getElementById('t4-opening-cover');
    const mainContent = document.getElementById('t4-main-content');
    const musicToggle = document.getElementById('t4-music-toggle');
    const bottomDock = document.getElementById('t4-bottom-dock');
    const discIcon = document.getElementById('t4-disc-icon');

    let isPlaying = false;

    function playAudioSafe() {
        if (!audio) return;
        audio.play().then(() => {
            isPlaying = true;
            if (discIcon) discIcon.classList.add('animate-spin-slow');
        }).catch(err => {
            console.warn('Audio auto-play prevented:', err);
        });
    }

    if (openBtn) {
        openBtn.addEventListener('click', function() {
            playAudioSafe();
            if (cover) {
                cover.style.transform = 'translateY(-100%)';
                cover.style.opacity = '0';
                setTimeout(() => cover.style.display = 'none', 1000);
            }
            if (mainContent) {
                mainContent.classList.remove('opacity-0', 'pointer-events-none');
            }
            if (musicToggle) {
                musicToggle.classList.remove('opacity-0', 'pointer-events-none');
            }
            if (bottomDock) {
                bottomDock.classList.remove('translate-y-24', 'opacity-0');
            }
        });
    }

    if (musicToggle) {
        musicToggle.addEventListener('click', function() {
            if (!audio) return;
            if (isPlaying) {
                audio.pause();
                isPlaying = false;
                if (discIcon) discIcon.classList.remove('animate-spin-slow');
            } else {
                audio.play();
                isPlaying = true;
                if (discIcon) discIcon.classList.add('animate-spin-slow');
            }
        });
    }

    // 3. Countdown Timer
    const cdWrap = document.getElementById('t4-countdown');
    if (cdWrap) {
        const targetDate = new Date(cdWrap.dataset.date || '2026-12-31T09:00:00').getTime();
        function updateCd() {
            const now = Date.now();
            const diff = targetDate - now;
            if (diff <= 0) return;
            const d = Math.floor(diff / (1000 * 60 * 60 * 24));
            const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const s = Math.floor((diff % (1000 * 60)) / 1000);
            document.getElementById('t4-cd-days').textContent = String(d).padStart(2, '0');
            document.getElementById('t4-cd-hours').textContent = String(h).padStart(2, '0');
            document.getElementById('t4-cd-minutes').textContent = String(m).padStart(2, '0');
            document.getElementById('t4-cd-seconds').textContent = String(s).padStart(2, '0');
        }
        updateCd();
        setInterval(updateCd, 1000);
    }

    // 4. Salin Rekening
    window.copyT4 = function(id, btn) {
        const text = document.getElementById(id).textContent.trim();
        navigator.clipboard.writeText(text).then(() => {
            const original = btn.innerHTML;
            btn.innerHTML = '<span>Tersalin ✓</span>';
            btn.classList.add('bg-[#dfc573]', 'text-[#022319]');
            setTimeout(() => {
                btn.innerHTML = original;
                btn.classList.remove('bg-[#dfc573]', 'text-[#022319]');
            }, 2000);
        });
    };

    // 5. RSVP AJAX Submit
    const form = document.getElementById('t4-rsvp-form');
    if (form) {
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = document.getElementById('t4-submit-btn');
            const alert = document.getElementById('t4-rsvp-alert');
            const name = document.getElementById('t4-rsvp-name').value;
            const attendance = document.getElementById('t4-rsvp-attendance').value;
            const count = parseInt(document.getElementById('t4-rsvp-count').value, 10);
            const message = document.getElementById('t4-rsvp-message').value;

            btn.disabled = true;
            btn.textContent = 'Mengirimkan...';

            try {
                const res = await fetch('<%= rsvpPath %>', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': '<%= csrfToken %>'
                    },
                    body: JSON.stringify({ name, attendance, number_of_guests: count, message })
                });
                const data = await res.json();
                alert.classList.remove('hidden', 'text-red-400');
                alert.classList.add('text-[#dfc573]');
                alert.textContent = 'Terima kasih, konfirmasi & doa Anda telah tersimpan!';

                // Append new wish
                const list = document.getElementById('t4-wishes-list');
                const card = document.createElement('div');
                card.className = 'p-4 rounded-2xl bg-[#043b2a] border border-[#dfc573]/25 text-left';
                card.innerHTML = `<div class="flex items-center justify-between mb-1"><strong class="font-royal text-xs text-white">${name}</strong><span class="text-[9px] px-2 py-0.5 rounded-full bg-[#dfc573]/20 text-[#dfc573] uppercase font-mono font-bold">${attendance}</span></div><p class="text-xs text-[#d2eae0] leading-relaxed">${message}</p>`;
                if (list) list.prepend(card);

                form.reset();
            } catch (err) {
                alert.classList.remove('hidden', 'text-[#dfc573]');
                alert.classList.add('text-red-400');
                alert.textContent = 'Gagal mengirimkan konfirmasi. Silakan coba lagi.';
            } finally {
                btn.disabled = false;
                btn.textContent = 'Kirim Konfirmasi & Doa';
            }
        });
    }
})();
</script>

</body>
</html>
