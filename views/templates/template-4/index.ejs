<!-- ======================================================== -->
<!-- INTERACTIVE JAVASCRIPT: LENIS, WEB AUDIO, 3D TILT ENGINE -->
<!-- ======================================================== -->
<script>
(function() {
    // ----------------------------------------------------
    // 1. LENIS CINEMATIC SMOOTH SCROLL INITIALIZATION
    // ----------------------------------------------------
    let lenis = null;
    if (typeof Lenis !== 'undefined') {
        lenis = new Lenis({
            duration: 1.25,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            orientation: 'vertical',
            gestureOrientation: 'vertical',
            smoothWheel: true,
            wheelMultiplier: 1.1,
            touchMultiplier: 1.4,
            infinite: false
        });

        function raf(time) {
            lenis.raf(time);
            requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // Smooth glide for internal navigation anchor links
        document.querySelectorAll('.t4-nav-link').forEach((link) => {
            link.addEventListener('click', (e) => {
                const href = link.getAttribute('href');
                if (href && href.startsWith('#')) {
                    e.preventDefault();
                    const targetEl = document.querySelector(href);
                    if (targetEl) {
                        lenis.scrollTo(targetEl, { offset: -24, duration: 1.5 });
                    }
                }
            });
        });
    }

    // ----------------------------------------------------
    // 2. AMBIL NAMA TAMU DARI URL PARAMETER
    // ----------------------------------------------------
    const params = new URLSearchParams(window.location.search);
    const guestParam = params.get('to') || params.get('tamu') || params.get('u');
    if (guestParam) {
        const el = document.getElementById('t4-recipient-name');
        if (el) el.textContent = guestParam;
        const nameInput = document.getElementById('t4-rsvp-name');
        if (nameInput) nameInput.value = guestParam;
    }

    // ----------------------------------------------------
    // 3. GOOGLE CALENDAR SYNC LINK GENERATOR
    // ----------------------------------------------------
    const gcalLink = document.getElementById('t4-gcal-link');
    if (gcalLink) {
        const title = encodeURIComponent('The Wedding of <%= fv(event?.groom_name, "David") %> & <%= fv(event?.bride_name, "Sarah") %>');
        const details = encodeURIComponent('Pernikahan <%= fv(event?.groom_name, "David") %> & <%= fv(event?.bride_name, "Sarah") %>. Lokasi: <%= fv(event?.venue_name, "The Glasshouse") %>');
        const location = encodeURIComponent('<%= fv(event?.venue_address, "Jakarta") %>');
        const dates = '20261231T010000Z/20261231T070000Z';
        gcalLink.href = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&details=${details}&location=${location}&dates=${dates}`;
    }

    // ----------------------------------------------------
    // 4. WEB AUDIO API DYNAMIC SOUNDWAVE SPECTRUM
    // ----------------------------------------------------
    const audio = document.getElementById('t4-audio');
    const openBtn = document.getElementById('t4-open-btn');
    const cover = document.getElementById('t4-opening-cover');
    const mainContent = document.getElementById('t4-main-content');
    const floatingAudio = document.getElementById('t4-floating-audio');
    const audioBtn = document.getElementById('t4-audio-btn');
    const bottomDock = document.getElementById('t4-bottom-dock');
    const vinylDisc = document.getElementById('t4-vinyl-disc');
    const spectrumCanvas = document.getElementById('t4-spectrum-canvas');
    const ctx = spectrumCanvas ? spectrumCanvas.getContext('2d') : null;

    let isPlaying = false;
    let audioContext = null;
    let analyser = null;
    let audioSource = null;
    let dataArray = null;
    let animationFrameId = null;

    function initWebAudio() {
        if (audioContext || !audio) return;
        try {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            audioContext = new AudioCtx();
            analyser = audioContext.createAnalyser();
            analyser.fftSize = 32;
            audioSource = audioContext.createMediaElementSource(audio);
            audioSource.connect(analyser);
            analyser.connect(audioContext.destination);
            const bufferLength = analyser.frequencyBinCount;
            dataArray = new Uint8Array(bufferLength);
        } catch (e) {
            console.warn('Web Audio API fallback active:', e);
        }
    }

    function renderSpectrum() {
        if (!ctx || !spectrumCanvas) return;
        ctx.clearRect(0, 0, spectrumCanvas.width, spectrumCanvas.height);

        const barCount = 5;
        const barWidth = 4;
        const gap = 4;
        const startX = 4;

        if (isPlaying && analyser && dataArray) {
            analyser.getByteFrequencyData(dataArray);
            for (let i = 0; i < barCount; i++) {
                const freq = dataArray[i * 2] || 60;
                const percent = Math.min(1, Math.max(0.15, freq / 255));
                const barHeight = Math.max(3, percent * (spectrumCanvas.height - 2));
                const x = startX + i * (barWidth + gap);
                const y = spectrumCanvas.height - barHeight;

                const grad = ctx.createLinearGradient(0, y, 0, spectrumCanvas.height);
                grad.addColorStop(0, '#FFF6D1');
                grad.addColorStop(1, '#D4AF37');

                ctx.fillStyle = grad;
                ctx.beginPath();
                ctx.roundRect(x, y, barWidth, barHeight, 2);
                ctx.fill();
            }
        } else if (isPlaying) {
            const time = Date.now() * 0.005;
            for (let i = 0; i < barCount; i++) {
                const sine = Math.sin(time + i * 1.2) * 0.5 + 0.5;
                const barHeight = Math.max(4, sine * (spectrumCanvas.height - 3));
                const x = startX + i * (barWidth + gap);
                const y = spectrumCanvas.height - barHeight;

                ctx.fillStyle = '#D4AF37';
                ctx.beginPath();
                ctx.roundRect(x, y, barWidth, barHeight, 2);
                ctx.fill();
            }
        } else {
            for (let i = 0; i < barCount; i++) {
                const x = startX + i * (barWidth + gap);
                ctx.fillStyle = 'rgba(212, 175, 55, 0.4)';
                ctx.beginPath();
                ctx.roundRect(x, spectrumCanvas.height - 3, barWidth, 3, 2);
                ctx.fill();
            }
        }

        animationFrameId = requestAnimationFrame(renderSpectrum);
    }

    function playAudioSafe() {
        if (!audio) return;
        initWebAudio();
        if (audioContext && audioContext.state === 'suspended') {
            audioContext.resume();
        }
        audio.play().then(() => {
            isPlaying = true;
            if (vinylDisc) vinylDisc.classList.add('animate-vinyl');
        }).catch((err) => {
            console.warn('Audio play restricted:', err);
        });
    }

    // ----------------------------------------------------
    // 5. 3D CARD TILT & HOLOGRAPHIC GLARE ENGINE
    // ----------------------------------------------------
    function initTiltCards() {
        const tiltCards = document.querySelectorAll('.tilt-card');
        tiltCards.forEach((card) => {
            const glare = card.querySelector('.glare-overlay');

            function handleMove(e) {
                const rect = card.getBoundingClientRect();
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;

                const x = clientX - rect.left;
                const y = clientY - rect.top;

                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                const rotateX = ((y - centerY) / centerY) * -10;
                const rotateY = ((x - centerX) / centerX) * 10;

                card.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale3d(1.02, 1.02, 1.02)`;

                if (glare) {
                    const glareX = (x / rect.width) * 100;
                    const glareY = (y / rect.height) * 100;
                    glare.style.background = `radial-gradient(circle at ${glareX}% ${glareY}%, rgba(255, 255, 255, 0.3) 0%, rgba(212, 175, 55, 0.15) 35%, transparent 70%)`;
                    glare.style.opacity = '1';
                }
            }

            function handleLeave() {
                card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
                if (glare) glare.style.opacity = '0';
            }

            card.addEventListener('mousemove', handleMove);
            card.addEventListener('mouseleave', handleLeave);
            card.addEventListener('touchmove', handleMove, { passive: true });
            card.addEventListener('touchend', handleLeave);
        });

        if (window.DeviceOrientationEvent && typeof window.DeviceOrientationEvent.requestPermission !== 'function') {
            window.addEventListener('deviceorientation', (e) => {
                if (e.gamma === null || e.beta === null) return;
                const gamma = Math.min(15, Math.max(-15, e.gamma));
                const beta = Math.min(15, Math.max(-15, e.beta - 45));

                document.querySelectorAll('.luxury-card-black').forEach((c) => {
                    c.style.transform = `perspective(1000px) rotateX(${(beta * 0.4).toFixed(1)}deg) rotateY(${(gamma * 0.4).toFixed(1)}deg)`;
                });
            }, { passive: true });
        }
    }

    // ----------------------------------------------------
    // 6. CINEMATIC SCROLL REVEAL OBSERVER
    // ----------------------------------------------------
    function initScrollReveal() {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('revealed');
                }
            });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

        document.querySelectorAll('.cinematic-reveal').forEach((el) => {
            observer.observe(el);
        });
    }

    // ----------------------------------------------------
    // 7. OPEN INVITATION BUTTON TRIGGER
    // ----------------------------------------------------
    if (openBtn) {
        openBtn.addEventListener('click', function() {
            playAudioSafe();
            renderSpectrum();

            if (cover) {
                cover.style.transform = 'scale(1.08)';
                cover.style.opacity = '0';
                cover.style.filter = 'blur(16px)';
                setTimeout(() => cover.style.display = 'none', 1000);
            }
            if (mainContent) {
                mainContent.classList.remove('opacity-0', 'pointer-events-none', 'scale-98');
                mainContent.classList.add('opacity-100', 'scale-100');
            }
            if (floatingAudio) {
                floatingAudio.classList.remove('opacity-0', 'pointer-events-none');
            }
            if (bottomDock) {
                bottomDock.classList.remove('translate-y-24', 'opacity-0');
            }

            initScrollReveal();
            initTiltCards();
        });
    }

    if (audioBtn) {
        audioBtn.addEventListener('click', function() {
            if (!audio) return;
            if (isPlaying) {
                audio.pause();
                isPlaying = false;
                if (vinylDisc) vinylDisc.classList.remove('animate-vinyl');
            } else {
                playAudioSafe();
            }
        });
    }

    // Parallax on Scroll for Hero Image
    window.addEventListener('scroll', function() {
        const heroImg = document.getElementById('t4-hero-image');
        if (heroImg) {
            const scrollPos = window.scrollY;
            heroImg.style.transform = `translateY(${scrollPos * 0.22}px) scale(1.05)`;
        }
    }, { passive: true });

    // ----------------------------------------------------
    // 8. COUNTDOWN TIMER ENGINE
    // ----------------------------------------------------
    const cdWrap = document.getElementById('t4-countdown');
    if (cdWrap) {
        const targetDate = new Date(cdWrap.dataset.date || '2026-12-31T09:00:00').getTime();
        function updateCd() {
            const now = Date.now();
            const diff = targetDate - now;
            if (diff <= 0) return;
            const d = Math.floor(diff / (1000 * 60 * 60 * 24));
            const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const s = Math.floor((diff % (1000 * 60)) / 1000);
            const dEl = document.getElementById('t4-cd-days');
            const hEl = document.getElementById('t4-cd-hours');
            const mEl = document.getElementById('t4-cd-minutes');
            const sEl = document.getElementById('t4-cd-seconds');
            if (dEl) dEl.textContent = String(d).padStart(2, '0');
            if (hEl) hEl.textContent = String(h).padStart(2, '0');
            if (mEl) mEl.textContent = String(m).padStart(2, '0');
            if (sEl) sEl.textContent = String(s).padStart(2, '0');
        }
        updateCd();
        setInterval(updateCd, 1000);
    }

    // ----------------------------------------------------
    // 9. REKENING & TEXT COPY
    // ----------------------------------------------------
    window.copyText = function(id, btn) {
        const text = document.getElementById(id).textContent.trim();
        navigator.clipboard.writeText(text).then(() => {
            const original = btn.innerHTML;
            btn.innerHTML = '<span>Tersalin ✓</span>';
            btn.classList.add('bg-[#D4AF37]', 'text-[#0D0D0F]');
            setTimeout(() => {
                btn.innerHTML = original;
                btn.classList.remove('bg-[#D4AF37]', 'text-[#0D0D0F]');
            }, 2000);
        });
    };

    // ----------------------------------------------------
    // 10. DRESS CODE SWATCH SELECTOR
    // ----------------------------------------------------
    window.selectSwatch = function(title, desc) {
        const info = document.getElementById('swatch-info');
        if (info) {
            info.innerHTML = `<strong>${title}:</strong> ${desc}`;
            info.classList.add('border-[#D4AF37]');
        }
    };

    // ----------------------------------------------------
    // 11. QRIS LIGHTBOX MODAL
    // ----------------------------------------------------
    window.openQRModal = function() {
        const m = document.getElementById('t4-qr-modal');
        if (m) m.classList.remove('hidden');
    };
    window.closeQRModal = function() {
        const m = document.getElementById('t4-qr-modal');
        if (m) m.classList.add('hidden');
    };

    // ----------------------------------------------------
    // 12. iCal (.ics) GENERATOR
    // ----------------------------------------------------
    window.downloadICS = function() {
        const icsContent = `BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//KalaBahagia//Wedding Invitation//ID
BEGIN:VEVENT
SUMMARY:The Wedding of <%= fv(event?.groom_name, "David") %> & <%= fv(event?.bride_name, "Sarah") %>
DESCRIPTION:Pernikahan <%= fv(event?.groom_name, "David") %> & <%= fv(event?.bride_name, "Sarah") %>
LOCATION:<%= fv(event?.venue_name, "The Glasshouse Ballroom") %>
DTSTART:20261231T090000
DTEND:20261231T150000
END:VEVENT
END:VCALENDAR`;
        const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
        const link = document.createElement('a');
        link.href = window.URL.createObjectURL(blob);
        link.setAttribute('download', 'wedding-invitation.ics');
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };

    // ----------------------------------------------------
    // 13. RSVP AJAX SUBMISSION
    // ----------------------------------------------------
    const form = document.getElementById('t4-rsvp-form');
    if (form) {
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = document.getElementById('t4-submit-btn');
            const alert = document.getElementById('t4-rsvp-alert');
            const name = document.getElementById('t4-rsvp-name').value;
            const attendance = document.querySelector('input[name="attendance"]:checked')?.value || 'hadir';
            const count = parseInt(document.getElementById('t4-rsvp-count').value, 10);
            const message = document.getElementById('t4-rsvp-message').value;

            btn.disabled = true;
            btn.textContent = 'Mengirimkan...';

            try {
                const res = await fetch('<%= rsvpPath %>', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': '<%= csrfToken %>'
                    },
                    body: JSON.stringify({ name, attendance, number_of_guests: count, message })
                });
                const data = await res.json();
                alert.classList.remove('hidden', 'text-red-400');
                alert.classList.add('text-[#D4AF37]');
                alert.textContent = 'Terima kasih, konfirmasi & doa Anda telah tersimpan!';

                const list = document.getElementById('t4-wishes-list');
                const card = document.createElement('div');
                card.className = 'p-4 rounded-2xl frosted-glass-card text-left';
                card.innerHTML = `<div class="flex items-center justify-between mb-1"><strong class="font-editorial text-sm text-white">${name}</strong><span class="text-[9px] px-2 py-0.5 rounded-full bg-[#D4AF37]/20 text-[#D4AF37] uppercase font-mono font-bold">${attendance}</span></div><p class="text-xs text-[#E5D3B3] leading-relaxed">${message}</p>`;
                if (list) list.prepend(card);

                form.reset();
            } catch (err) {
                alert.classList.remove('hidden', 'text-[#D4AF37]');
                alert.classList.add('text-red-400');
                alert.textContent = 'Gagal mengirimkan konfirmasi. Silakan coba lagi.';
            } finally {
                btn.disabled = false;
                btn.textContent = 'Kirim Konfirmasi & Doa';
            }
        });
    }

    initTiltCards();
})();
</script>

</body>
</html>
