<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title || 'The Wedding of ' + fv(event?.groom_name, 'Pria') + ' & ' + fv(event?.bride_name, 'Wanita') %></title>
    <link rel="stylesheet" href="/css/app.css">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Italianno&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        .font-script { font-family: 'Italianno', cursive; }
        .font-serif { font-family: 'Cormorant Garamond', Georgia, serif; }
        .font-royal { font-family: 'Cinzel', serif; }

        /* Walasoji / Sulapa Eppa subtle background lattice */
        .bg-walasoji {
            background-color: #033a2a;
            background-image: 
                linear-gradient(45deg, rgba(212, 175, 55, 0.05) 25%, transparent 25%, transparent 75%, rgba(212, 175, 55, 0.05) 75%),
                linear-gradient(45deg, rgba(212, 175, 55, 0.05) 25%, transparent 25%, transparent 75%, rgba(212, 175, 55, 0.05) 75%);
            background-size: 32px 32px;
            background-position: 0 0, 16px 16px;
        }

        .gold-border-corner {
            position: relative;
        }
        .gold-border-corner::before {
            content: '';
            position: absolute;
            top: 0; left: 0;
            width: 20px; height: 20px;
            border-top: 2px solid #d4af37;
            border-left: 2px solid #d4af37;
        }
        .gold-border-corner::after {
            content: '';
            position: absolute;
            bottom: 0; right: 0;
            width: 20px; height: 20px;
            border-bottom: 2px solid #d4af37;
            border-right: 2px solid #d4af37;
        }
    </style>
</head>
<body class="bg-[#022c20] text-amber-50 font-sans antialiased overflow-x-hidden selection:bg-amber-400 selection:text-emerald-950">

<!-- Audio Element -->
<audio id="t4-audio" loop preload="auto">
    <source src="/music/wedding-song.mp3" type="audio/mpeg">
</audio>

<!-- Opening Cover / Amplop Digital Adat Bugis -->
<div id="t4-opening-cover" class="fixed inset-0 z-50 flex items-center justify-center bg-walasoji transition-all duration-1000 px-4">
    <div class="relative z-10 text-center max-w-lg mx-auto py-12 px-6 sm:px-8 rounded-3xl bg-[#044432]/95 border-2 border-amber-400/50 shadow-2xl backdrop-blur-xl gold-border-corner">
        <!-- Sulapa Eppa Diamond Crest -->
        <div class="w-20 h-20 mx-auto mb-6 flex items-center justify-center rotate-45 border-2 border-amber-400 bg-emerald-950/80 shadow-lg shadow-amber-500/10">
            <span class="-rotate-45 font-royal text-xl font-bold text-amber-300 tracking-wider">
                <%= (fv(event?.groom_name, 'D')[0]) %>&<%= (fv(event?.bride_name, 'S')[0]) %>
            </span>
        </div>

        <p class="font-serif text-lg text-amber-300 mb-1">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
        <p class="text-[11px] uppercase tracking-[0.3em] text-amber-400/90 font-bold mb-3">Undangan Pernikahan Adat Bugis</p>

        <h1 class="font-script text-6xl sm:text-7xl text-amber-200 mb-4 leading-tight drop-shadow-md">
            <span data-demo="groom_name"><%= fv(event?.groom_name, 'David') %></span>
            <span class="text-amber-400 font-serif text-3xl mx-2">&</span>
            <span data-demo="bride_name"><%= fv(event?.bride_name, 'Sarah') %></span>
        </h1>

        <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-amber-400 to-transparent mx-auto mb-6"></div>

        <p class="text-xs text-emerald-200/90 uppercase tracking-widest mb-1 font-medium">Kepada Yth. Bapak/Ibu/Saudara/i</p>
        <p id="t4-recipient-name" class="text-base sm:text-lg font-serif font-bold text-amber-200 mb-8 px-5 py-2.5 bg-[#022c20]/90 rounded-xl border border-amber-400/40 inline-block shadow-inner">
            Tamu Undangan
        </p>

        <div>
            <button id="t4-open-btn" class="inline-flex items-center justify-center px-8 py-3.5 text-sm sm:text-base font-bold text-emerald-950 bg-gradient-to-r from-amber-400 via-yellow-300 to-amber-400 hover:from-amber-300 hover:to-amber-500 rounded-full shadow-lg shadow-amber-500/20 hover:shadow-amber-500/40 transition-all duration-300 transform hover:scale-105 active:scale-95">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19v-8.93a2 2 0 01.89-1.664l7-4.666a2 2 0 012.22 0l7 4.666A2 2 0 0121 10.07V19M3 19a2 2 0 002 2h14a2 2 0 002-2M3 19l6.75-4.5M21 19l-6.75-4.5M3 10l6.75 4.5M21 10l-6.75 4.5m0 0l-1.14.76a2 2 0 01-2.22 0l-1.14-.76"></path>
                </svg>
                <span>Buka Undangan</span>
            </button>
        </div>
    </div>
</div>

<!-- Main Content -->
<div id="t4-main-content" class="opacity-0 pointer-events-none transition-opacity duration-1000 bg-walasoji min-h-screen">
    <!-- Hero Section -->
    <section id="opening" class="min-h-[92vh] flex items-center justify-center text-center px-4 relative overflow-hidden py-16">
        <div class="relative z-10 max-w-3xl mx-auto">
            <p class="font-serif text-2xl sm:text-3xl text-amber-300 mb-2">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
            <p class="text-xs uppercase tracking-[0.3em] text-amber-400 font-bold mb-4">Mappabotting (Pernikahan Adat Bugis)</p>

            <h1 class="font-script text-6xl sm:text-7xl md:text-8xl text-amber-100 mb-4 leading-tight">
                <span data-demo="groom_name"><%= fv(event?.groom_name, 'David') %></span>
                <span class="block text-2xl sm:text-3xl font-serif text-amber-400 my-2">&</span>
                <span data-demo="bride_name"><%= fv(event?.bride_name, 'Sarah') %></span>
            </h1>

            <div class="w-20 h-0.5 bg-gradient-to-r from-transparent via-amber-400 to-transparent mx-auto my-5"></div>

            <p class="text-sm sm:text-base text-emerald-100 font-serif tracking-widest">
                <span data-demo="event_date" data-fmt="long" data-raw="<%= event?.event_date || '' %>"><%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %></span>
            </p>
            <p class="text-xs text-amber-300 font-mono tracking-wider mt-1">
                <%= fv(eventTimeStart, 'Pukul 09.00 WITA') %>
            </p>

            <div class="mt-10 animate-bounce">
                <a href="#salam" class="inline-flex items-center text-amber-400 hover:text-amber-300 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Salam & Pasangan Section -->
    <section id="salam" class="py-20 bg-[#02281d] relative">
        <div class="container mx-auto px-4 max-w-4xl text-center">
            <div class="mb-14">
                <h2 class="text-2xl sm:text-3xl font-serif text-amber-300 mb-3">
                    Assalamu'alaikum Warahmatullahi Wabarakatuh
                </h2>
                <div class="w-16 h-0.5 bg-amber-400/50 mx-auto mb-6"></div>
                <p class="text-xs sm:text-sm text-emerald-100/90 leading-relaxed max-w-2xl mx-auto italic font-serif">
                    "Sipakatau, Sipakalebbi, Sipakainge" &mdash; Saling menghargai, saling memuliakan, dan saling mengingatkan dalam bingkai ibadah suci pernikahan.
                </p>
            </div>

            <!-- Couple Cards -->
            <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
                <!-- Groom Card -->
                <div class="bg-[#fcfbf7] text-slate-850 rounded-3xl p-8 border-2 border-amber-400/40 shadow-xl text-center">
                    <div class="w-36 h-36 mx-auto mb-6 rounded-full p-1.5 bg-gradient-to-tr from-emerald-800 to-amber-500 shadow-md">
                        <div class="w-full h-full rounded-full overflow-hidden bg-emerald-900">
                            <img src="<%= groomPhoto || '/images/demo/groom.svg' %>" alt="Mempelai Pria" class="w-full h-full object-cover">
                        </div>
                    </div>
                    <h3 class="font-script text-4xl text-[#043b2c] mb-1 font-bold">
                        <span data-demo="groom_name"><%= fv(event?.groom_name, 'Nama Lengkap Pria') %></span>
                    </h3>
                    <p class="text-xs text-slate-500 uppercase tracking-wider mb-2 font-semibold">Putra Tercinta Dari</p>
                    <p class="text-sm font-bold text-slate-800 mb-4 leading-snug">
                        <span data-demo="groom_father"><%= fv(event?.groom_father, 'Bapak [Nama]') %></span> & <span data-demo="groom_mother"><%= fv(event?.groom_mother, 'Ibu [Nama]') %></span>
                    </p>
                    <% if (event?.instagram_groom) { %>
                    <a href="https://instagram.com/<%= (event.instagram_groom).replace('@', '') %>" target="_blank"
                       class="inline-flex items-center px-4 py-1.5 bg-emerald-50 text-emerald-900 rounded-full text-xs font-bold border border-emerald-200 hover:bg-emerald-100 transition-colors">
                        <span>@<%= (event.instagram_groom).replace('@', '') %></span>
                    </a>
                    <% } %>
                </div>

                <!-- Bride Card -->
                <div class="bg-[#fcfbf7] text-slate-850 rounded-3xl p-8 border-2 border-amber-400/40 shadow-xl text-center">
                    <div class="w-36 h-36 mx-auto mb-6 rounded-full p-1.5 bg-gradient-to-tr from-emerald-800 to-amber-500 shadow-md">
                        <div class="w-full h-full rounded-full overflow-hidden bg-emerald-900">
                            <img src="<%= bridePhoto || '/images/demo/bride.svg' %>" alt="Mempelai Wanita" class="w-full h-full object-cover">
                        </div>
                    </div>
                    <h3 class="font-script text-4xl text-[#043b2c] mb-1 font-bold">
                        <span data-demo="bride_name"><%= fv(event?.bride_name, 'Nama Lengkap Wanita') %></span>
                    </h3>
                    <p class="text-xs text-slate-500 uppercase tracking-wider mb-2 font-semibold">Putri Tercinta Dari</p>
                    <p class="text-sm font-bold text-slate-800 mb-4 leading-snug">
                        <span data-demo="bride_father"><%= fv(event?.bride_father, 'Bapak [Nama]') %></span> & <span data-demo="bride_mother"><%= fv(event?.bride_mother, 'Ibu [Nama]') %></span>
                    </p>
                    <% if (event?.instagram_bride) { %>
                    <a href="https://instagram.com/<%= (event.instagram_bride).replace('@', '') %>" target="_blank"
                       class="inline-flex items-center px-4 py-1.5 bg-emerald-50 text-emerald-900 rounded-full text-xs font-bold border border-emerald-200 hover:bg-emerald-100 transition-colors">
                        <span>@<%= (event.instagram_bride).replace('@', '') %></span>
                    </a>
                    <% } %>
                </div>
            </div>
        </div>
    </section>

    <!-- Event & Countdown Section -->
    <section id="event" class="py-20 bg-walasoji relative">
        <div class="container mx-auto px-4 max-w-5xl">
            <div class="text-center mb-14">
                <span class="inline-block text-xs uppercase tracking-[0.25em] text-amber-400 font-bold mb-2">Waktu & Tempat</span>
                <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-amber-200 mb-4">
                    Rangkaian Acara
                </h2>
                <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-amber-400 to-transparent mx-auto mb-6"></div>
            </div>

            <!-- Countdown Timer Card -->
            <div class="max-w-xl mx-auto mb-14 bg-[#044432] rounded-3xl p-6 sm:p-8 border border-amber-400/40 text-center shadow-xl">
                <h3 class="text-xs uppercase tracking-widest text-amber-300 mb-6 font-bold">Hitung Mundur Hari Bahagia</h3>
                <div id="t4-countdown" class="grid grid-cols-4 gap-3 sm:gap-4">
                    <div class="bg-[#022c20] rounded-2xl p-3 sm:p-4 border border-amber-400/30">
                        <div id="t4-days" class="text-2xl sm:text-4xl font-mono font-bold text-amber-200">00</div>
                        <div class="text-[11px] text-emerald-200 uppercase tracking-wider mt-1">Hari</div>
                    </div>
                    <div class="bg-[#022c20] rounded-2xl p-3 sm:p-4 border border-amber-400/30">
                        <div id="t4-hours" class="text-2xl sm:text-4xl font-mono font-bold text-amber-200">00</div>
                        <div class="text-[11px] text-emerald-200 uppercase tracking-wider mt-1">Jam</div>
                    </div>
                    <div class="bg-[#022c20] rounded-2xl p-3 sm:p-4 border border-amber-400/30">
                        <div id="t4-minutes" class="text-2xl sm:text-4xl font-mono font-bold text-amber-200">00</div>
                        <div class="text-[11px] text-emerald-200 uppercase tracking-wider mt-1">Menit</div>
                    </div>
                    <div class="bg-[#022c20] rounded-2xl p-3 sm:p-4 border border-amber-400/30">
                        <div id="t4-seconds" class="text-2xl sm:text-4xl font-mono font-bold text-amber-200">00</div>
                        <div class="text-[11px] text-emerald-200 uppercase tracking-wider mt-1">Detik</div>
                    </div>
                </div>
            </div>

            <!-- Akad & Resepsi Cards -->
            <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
                <!-- Card 1: Akad Nikah -->
                <div class="bg-[#fcfbf7] text-slate-850 rounded-3xl p-8 border-2 border-amber-400/40 shadow-xl text-center">
                    <div class="w-12 h-12 rounded-full bg-emerald-900 text-amber-300 font-serif font-bold text-lg mx-auto mb-4 flex items-center justify-center">
                        I
                    </div>
                    <h3 class="text-2xl font-serif font-bold text-[#043b2c] mb-2">Akad Nikah</h3>
                    <div class="space-y-2 text-sm text-slate-700 mb-6">
                        <p class="font-bold text-amber-700">
                            <span data-demo="event_date" data-fmt="long" data-raw="<%= event?.event_date || '' %>"><%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %></span>
                        </p>
                        <p class="font-mono text-xs text-slate-600">Pukul 09.00 - 11.00 WITA</p>
                        <p class="font-bold text-slate-900 pt-2"><span data-demo="venue_name"><%= fv(venueName, 'Grand Ballroom Hotel') %></span></p>
                        <p class="text-xs text-slate-600 leading-relaxed"><span data-demo="venue_address"><%= fv(venueAddress, 'Jl. Sudirman No. 123, Makassar') %></span></p>
                    </div>
                    <div class="flex flex-col sm:flex-row items-center justify-center gap-2 pt-2">
                        <a href="https://maps.google.com/?q=<%= encodeURIComponent(venueAddress || venueName || 'Lokasi Acara') %>" target="_blank"
                           class="w-full sm:w-auto inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-[#043b2c] text-amber-200 text-xs font-bold hover:bg-[#032a1f] transition-colors shadow">
                            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            Google Maps
                        </a>
                        <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Akad+Nikah+<%= encodeURIComponent(fv(event?.groom_name, 'Pria') + '+%26+' + fv(event?.bride_name, 'Wanita')) %>&location=<%= encodeURIComponent(fv(venueName, '') + ', ' + fv(venueAddress, '')) %>" target="_blank"
                           class="w-full sm:w-auto inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-amber-100 text-amber-900 border border-amber-300 text-xs font-bold hover:bg-amber-200 transition-colors">
                            + Kalender
                        </a>
                    </div>
                </div>

                <!-- Card 2: Resepsi Pernikahan -->
                <div class="bg-[#fcfbf7] text-slate-850 rounded-3xl p-8 border-2 border-amber-400/40 shadow-xl text-center">
                    <div class="w-12 h-12 rounded-full bg-emerald-900 text-amber-300 font-serif font-bold text-lg mx-auto mb-4 flex items-center justify-center">
                        II
                    </div>
                    <h3 class="text-2xl font-serif font-bold text-[#043b2c] mb-2">Resepsi Adat Bugis</h3>
                    <div class="space-y-2 text-sm text-slate-700 mb-6">
                        <p class="font-bold text-amber-700">
                            <span data-demo="event_date" data-fmt="long" data-raw="<%= event?.event_date || '' %>"><%= fv(eventDateLong, 'Minggu, 31 Desember 2025') %></span>
                        </p>
                        <p class="font-mono text-xs text-slate-600"><%= fv(eventTimeRange, '19.00 WITA - Selesai') %></p>
                        <p class="font-bold text-slate-900 pt-2"><span data-demo="venue_name"><%= fv(venueName, 'Grand Ballroom Hotel') %></span></p>
                        <p class="text-xs text-slate-600 leading-relaxed"><span data-demo="venue_address"><%= fv(venueAddress, 'Jl. Sudirman No. 123, Makassar') %></span></p>
                    </div>
                    <div class="flex flex-col sm:flex-row items-center justify-center gap-2 pt-2">
                        <a href="https://maps.google.com/?q=<%= encodeURIComponent(venueAddress || venueName || 'Lokasi Acara') %>" target="_blank"
                           class="w-full sm:w-auto inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-[#043b2c] text-amber-200 text-xs font-bold hover:bg-[#032a1f] transition-colors shadow">
                            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            Google Maps
                        </a>
                        <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Resepsi+Pernikahan+<%= encodeURIComponent(fv(event?.groom_name, 'Pria') + '+%26+' + fv(event?.bride_name, 'Wanita')) %>&location=<%= encodeURIComponent(fv(venueName, '') + ', ' + fv(venueAddress, '')) %>" target="_blank"
                           class="w-full sm:w-auto inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-amber-100 text-amber-900 border border-amber-300 text-xs font-bold hover:bg-amber-200 transition-colors">
                            + Kalender
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Gallery Section -->
    <section id="gallery" class="py-20 bg-[#02281d] relative">
        <div class="container mx-auto px-4 max-w-6xl">
            <div class="text-center mb-16">
                <span class="inline-block text-xs uppercase tracking-[0.25em] text-amber-400 font-bold mb-2">Galeri Momen</span>
                <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-amber-200 mb-4">
                    Dokumentasi Kebahagiaan
                </h2>
                <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-amber-400 to-transparent mx-auto mb-4"></div>
            </div>

            <% const _t4DemoTiles = ['/images/demo/g-mosque.svg', '/images/demo/g-rings.svg', '/images/demo/g-couple.svg', '/images/demo/g-lantern.svg', '/images/demo/g-bouquet.svg', '/images/demo/g-pattern.svg']; %>
            <% const _t4Tiles = (galleryPhotos && galleryPhotos.length) ? galleryPhotos : _t4DemoTiles; %>

            <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-5">
                <% _t4Tiles.forEach(function(_tile, _idx) { %>
                <div class="group relative overflow-hidden rounded-2xl bg-[#044432] p-1.5 shadow-md hover:shadow-2xl transition-all duration-300 cursor-pointer aspect-square border border-amber-400/40"
                     onclick="openT4Lightbox(<%= _idx %>)">
                    <div class="w-full h-full overflow-hidden rounded-xl bg-emerald-950 relative">
                        <img src="<%= _tile %>" alt="Foto Galeri <%= _idx + 1 %>" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500" loading="lazy">
                        <div class="absolute inset-0 bg-emerald-950/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                            <div class="w-10 h-10 rounded-full bg-amber-400 text-emerald-950 flex items-center justify-center shadow">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Gift Section -->
    <section id="gift" class="py-20 bg-walasoji relative">
        <div class="container mx-auto px-4 max-w-4xl">
            <div class="text-center mb-16">
                <span class="inline-block text-xs uppercase tracking-[0.25em] text-amber-400 font-bold mb-2">Tanda Kasih</span>
                <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-amber-200 mb-4">
                    Amplop Digital
                </h2>
                <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-amber-400 to-transparent mx-auto mb-4"></div>
                <p class="text-emerald-100/90 max-w-xl mx-auto text-sm leading-relaxed">
                    Doa restu Anda merupakan karunia yang sangat berarti bagi kami. Bagi yang berkenan memberikan tanda kasih secara cashless:
                </p>
            </div>

            <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto mb-10">
                <!-- Account BCA -->
                <div class="rounded-3xl bg-[#fcfbf7] text-slate-850 p-6 sm:p-7 border-2 border-amber-400/50 shadow-xl">
                    <div class="flex items-center justify-between mb-5">
                        <span class="text-xs font-bold uppercase tracking-wider text-[#043b2c]">Bank Transfer</span>
                        <span class="text-xl font-black text-[#043b2c] tracking-wider">BCA</span>
                    </div>
                    <div class="mb-4">
                        <span class="text-xs text-slate-500 uppercase tracking-wide block mb-1">Nomor Rekening</span>
