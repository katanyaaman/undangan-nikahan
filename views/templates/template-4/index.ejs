<!-- Toast -->
<div id="t4-toast" class="fixed top-6 left-1/2 -translate-x-1/2 z-50 px-5 py-3 rounded-full bg-amber-400 text-emerald-950 font-bold text-xs shadow-2xl transition-all duration-300 opacity-0 pointer-events-none -translate-y-4">
    Tersalin ke clipboard!
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 1. Recipient Query
    const params = new URLSearchParams(window.location.search);
    const to = params.get('to');
    if (to) {
        const el = document.getElementById('t4-recipient-name');
        if (el) el.textContent = to;
    }

    // 2. Audio Control with Web Audio Synth Fallback
    const audio = document.getElementById('t4-audio');
    const toggle = document.getElementById('t4-music-toggle');
    const disc = document.getElementById('t4-music-disc');
    let isPlaying = false;
    let synthCtx = null;
    let synthInterval = null;

    function playBugisSynth() {
        try {
            const AC = window.AudioContext || window.webkitAudioContext;
            if (!AC) return;
            if (!synthCtx) synthCtx = new AC();
            if (synthCtx.state === 'suspended') synthCtx.resume();

            const notes = [293.66, 329.63, 392.00, 440.00, 523.25, 440.00, 392.00, 329.63];
            let nIdx = 0;
            if (synthInterval) clearInterval(synthInterval);

            synthInterval = setInterval(function() {
                if (!isPlaying || !synthCtx) return;
                const osc = synthCtx.createOscillator();
                const gain = synthCtx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(notes[nIdx % notes.length], synthCtx.currentTime);
                gain.gain.setValueAtTime(0.04, synthCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, synthCtx.currentTime + 1.4);
                osc.connect(gain);
                gain.connect(synthCtx.destination);
                osc.start();
                osc.stop(synthCtx.currentTime + 1.4);
                nIdx++;
            }, 650);
        } catch(e) {}
    }

    function stopBugisSynth() {
        if (synthInterval) clearInterval(synthInterval);
        if (synthCtx && synthCtx.state === 'running') synthCtx.suspend();
    }

    function toggleAudio(start) {
        if (start === undefined) start = !isPlaying;
        isPlaying = start;
        if (isPlaying) {
            if (audio) {
                audio.play().catch(function() { playBugisSynth(); });
            } else {
                playBugisSynth();
            }
            if (disc) disc.classList.add('animate-spin-slow');
        } else {
            if (audio) audio.pause();
            stopBugisSynth();
            if (disc) disc.classList.remove('animate-spin-slow');
        }
    }

    if (toggle) {
        toggle.addEventListener('click', function() { toggleAudio(); });
    }

    // 3. Open Button
    const openBtn = document.getElementById('t4-open-btn');
    const cover = document.getElementById('t4-opening-cover');
    const main = document.getElementById('t4-main-content');
    const nav = document.getElementById('t4-bottom-nav');

    if (openBtn) {
        openBtn.addEventListener('click', function() {
            toggleAudio(true);
            cover.classList.add('opacity-0', '-translate-y-8');
            setTimeout(function() {
                cover.style.display = 'none';
                main.classList.remove('opacity-0', 'pointer-events-none');
                main.classList.add('opacity-100');
                if (nav) {
                    nav.classList.remove('translate-y-24', 'opacity-0');
                    nav.classList.add('translate-y-0', 'opacity-100');
                }
                if (toggle) {
                    toggle.classList.remove('opacity-0', 'pointer-events-none');
                    toggle.classList.add('opacity-100');
                }
            }, 800);
        });
    }

    // 4. Countdown Timer
    const evtDateStr = "<%= event?.event_date || eventDate || '2025-12-31 19:00:00' %>";
    const target = new Date(evtDateStr).getTime();

    function updateT4Countdown() {
        const now = new Date().getTime();
        const diff = target - now;
        const dEl = document.getElementById('t4-days');
        const hEl = document.getElementById('t4-hours');
        const mEl = document.getElementById('t4-minutes');
        const sEl = document.getElementById('t4-seconds');

        if (diff <= 0) {
            if (dEl) dEl.textContent = '00';
            if (hEl) hEl.textContent = '00';
            if (mEl) mEl.textContent = '00';
            if (sEl) sEl.textContent = '00';
            return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        if (dEl) dEl.textContent = String(days).padStart(2, '0');
        if (hEl) hEl.textContent = String(hours).padStart(2, '0');
        if (mEl) mEl.textContent = String(minutes).padStart(2, '0');
        if (sEl) sEl.textContent = String(seconds).padStart(2, '0');
    }
    setInterval(updateT4Countdown, 1000);
    updateT4Countdown();

    // 5. RSVP & Wishes
    const attSelect = document.getElementById('t4-attendance');
    const gField = document.getElementById('t4-guests-field');
    const rsvpForm = document.getElementById('t4-rsvp-form');
    const submitBtn = document.getElementById('t4-submit-btn');
    const alertBox = document.getElementById('t4-alert-container');
    const wishesList = document.getElementById('t4-wishes-list');

    if (attSelect && gField) {
        attSelect.addEventListener('change', function() {
            if (this.value === 'hadir') {
                gField.classList.remove('hidden');
            } else {
                gField.classList.add('hidden');
            }
        });
    }

    if (rsvpForm) {
        rsvpForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = 'Mengirimkan...';
            }

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            try {
                const res = await fetch('<%= rsvpPath %>', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || ''
                    },
                    body: JSON.stringify(data)
                });
                const result = await res.json();

                if (res.ok) {
                    if (alertBox) {
                        alertBox.innerHTML = '<div class="p-3.5 rounded-xl bg-emerald-100 border border-emerald-400 text-emerald-950 text-xs font-bold mb-3">✓ ' + (result.message || 'Konfirmasi kehadiran berhasil dikirim.') + '</div>';
                    }
                    if (data.message && wishesList) {
                        const emptyN = document.getElementById('t4-empty-wishes');
                        if (emptyN) emptyN.remove();

                        const card = document.createElement('div');
                        card.className = 'bg-[#fcfbf7] text-slate-850 rounded-2xl p-5 border border-amber-400/40 shadow-sm animate-fade-in-up';
                        card.innerHTML = `
                            <div class="flex items-start space-x-3.5">
                                <div class="w-9 h-9 rounded-full bg-[#043b2c] text-amber-200 font-bold flex items-center justify-center text-xs flex-shrink-0">
                                    ${(data.name || 'G').substring(0, 1).toUpperCase()}
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between gap-1 mb-1">
                                        <h4 class="text-sm font-bold text-slate-900 truncate">${data.name}</h4>
                                        <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold ${data.attendance === 'hadir' ? 'bg-emerald-100 text-emerald-900 border border-emerald-300' : 'bg-slate-100 text-slate-600'}">
                                            ${data.attendance === 'hadir' ? 'Hadir' : 'Berhalangan'}
                                        </span>
                                    </div>
                                    <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">${data.message}</p>
                                    <div class="mt-1.5 text-[10px] text-slate-400 font-mono">Baru saja</div>
                                </div>
                            </div>
                        `;
                        wishesList.prepend(card);
                    }
                    rsvpForm.reset();
                    if (gField) gField.classList.add('hidden');
                } else {
                    const err = result.errors ? Object.values(result.errors).flat().join('<br>') : (result.message || 'Gagal mengirim.');
                    if (alertBox) {
                        alertBox.innerHTML = '<div class="p-3.5 rounded-xl bg-red-100 border border-red-300 text-red-950 text-xs font-bold mb-3">✕ ' + err + '</div>';
                    }
                }
            } catch(e) {
                if (alertBox) {
                    alertBox.innerHTML = '<div class="p-3.5 rounded-xl bg-red-100 border border-red-300 text-red-950 text-xs font-bold mb-3">✕ Terjadi masalah jaringan.</div>';
                }
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Kirim Konfirmasi & Doa';
                }
            }
        });
    }

    // 6. Scroll spy for nav
    const sections = document.querySelectorAll('section');
    const links = document.querySelectorAll('.t4-nav-link');

    window.addEventListener('scroll', function() {
        let cur = '';
        sections.forEach(function(s) {
            const top = s.offsetTop - 120;
            if (window.pageYOffset >= top) {
                cur = s.getAttribute('id');
            }
        });
        links.forEach(function(l) {
            l.classList.remove('text-amber-300');
            l.classList.add('text-emerald-200');
            if (l.getAttribute('href') === '#' + cur) {
                l.classList.add('text-amber-300');
                l.classList.remove('text-emerald-200');
            }
        });
    });
});

// Copy Text
function copyT4Text(elId, btn) {
    const el = document.getElementById(elId);
    if (!el) return;
    const text = el.textContent.trim();
    navigator.clipboard.writeText(text).then(function() {
        const toast = document.getElementById('t4-toast');
        if (toast) {
            toast.textContent = 'Berhasil disalin: ' + text;
            toast.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-4');
            toast.classList.add('opacity-100', 'translate-y-0');
            setTimeout(function() {
                toast.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4');
                toast.classList.remove('opacity-100', 'translate-y-0');
            }, 2500);
        }
        if (btn) {
            const original = btn.innerHTML;
            btn.innerHTML = '✓ Tersalin';
            setTimeout(function() { btn.innerHTML = original; }, 2000);
        }
    });
}

// Lightbox
const t4Images = <%- JSON.stringify(_t4Tiles) %>;
let t4Idx = 0;

function openT4Lightbox(i) {
    t4Idx = i;
    const box = document.getElementById('t4-lightbox');
    const img = document.getElementById('t4-lightbox-img');
    const cap = document.getElementById('t4-lightbox-cap');
    if (box && img) {
        img.src = t4Images[t4Idx];
        if (cap) cap.textContent = (t4Idx + 1) + ' / ' + t4Images.length;
        box.classList.remove('hidden');
        box.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }
}

function closeT4Lightbox() {
    const box = document.getElementById('t4-lightbox');
    if (box) {
        box.classList.add('hidden');
        box.classList.remove('flex');
        document.body.style.overflow = '';
    }
}

function prevT4Img() {
    t4Idx = (t4Idx - 1 + t4Images.length) % t4Images.length;
    const img = document.getElementById('t4-lightbox-img');
    const cap = document.getElementById('t4-lightbox-cap');
    if (img) img.src = t4Images[t4Idx];
    if (cap) cap.textContent = (t4Idx + 1) + ' / ' + t4Images.length;
}

function nextT4Img() {
    t4Idx = (t4Idx + 1) % t4Images.length;
    const img = document.getElementById('t4-lightbox-img');
    const cap = document.getElementById('t4-lightbox-cap');
    if (img) img.src = t4Images[t4Idx];
    if (cap) cap.textContent = (t4Idx + 1) + ' / ' + t4Images.length;
}
</script>
</body>
</html>
