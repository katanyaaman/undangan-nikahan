    <!-- 8. JAVASCRIPT: SHOWCASE CROSSFADE & THREE.JS RINGS                    -->
    <!-- ===================================================================== -->
    <script>
    (function() {
        // -------------------------------------------------------------
        // 1. Interactive 3D Wedding Bands (Three.js on Subtle Pedestal)
        // -------------------------------------------------------------
        const canvas = document.getElementById('hero-3d-canvas');
        if (canvas && window.THREE) {
            const parent = canvas.parentElement;
            const w = parent.clientWidth || 400;
            const h = parent.clientHeight || 110;

            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(38, w / h, 0.1, 100);
            camera.position.set(0, 0, 8.5);

            const renderer = new THREE.WebGLRenderer({
                canvas: canvas,
                alpha: true,
                antialias: true
            });
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.setSize(w, h);

            // Lighting
            const ambient = new THREE.AmbientLight(0xfffaed, 1.2);
            scene.add(ambient);

            const key = new THREE.DirectionalLight(0xffdf80, 1.8);
            key.position.set(5, 5, 5);
            scene.add(key);

            // Gold Material
            const goldMat = new THREE.MeshStandardMaterial({
                color: 0xc99c42,
                roughness: 0.22,
                metalness: 0.88
            });

            const ringGroup = new THREE.Group();

            // Band 1
            const r1 = new THREE.Mesh(new THREE.TorusGeometry(1.4, 0.12, 24, 72), goldMat);
            r1.rotation.x = Math.PI / 3;
            r1.rotation.y = Math.PI / 6;
            ringGroup.add(r1);

            // Band 2
            const r2 = new THREE.Mesh(new THREE.TorusGeometry(1.25, 0.10, 24, 72), goldMat);
            r2.rotation.x = -Math.PI / 4;
            r2.rotation.y = -Math.PI / 6;
            r2.position.set(0.65, 0.2, 0);
            ringGroup.add(r2);

            scene.add(ringGroup);

            // Mouse & touch interaction
            let isDragging = false;
            let startX = 0;
            let targetRot = 0;
            let currentRot = 0;

            parent.addEventListener('pointerdown', (e) => {
                isDragging = true;
                startX = e.clientX;
            });
            window.addEventListener('pointermove', (e) => {
                if (isDragging) {
                    const dx = e.clientX - startX;
                    startX = e.clientX;
                    targetRot += dx * 0.02;
                }
            });
            window.addEventListener('pointerup', () => { isDragging = false; });

            window.addEventListener('resize', () => {
                if (!parent) return;
                const nw = parent.clientWidth;
                const nh = parent.clientHeight;
                camera.aspect = nw / nh;
                camera.updateProjectionMatrix();
                renderer.setSize(nw, nh);
            });

            function renderLoop() {
                requestAnimationFrame(renderLoop);
                if (!isDragging) {
                    targetRot += 0.006;
                }
                currentRot += (targetRot - currentRot) * 0.08;
                ringGroup.rotation.y = currentRot;
                ringGroup.rotation.x = Math.sin(Date.now() * 0.0015) * 0.1;
                renderer.render(scene, camera);
            }
            renderLoop();
        }

        // -------------------------------------------------------------
        // 2. Showcase Auto-Crossfade Gallery
        // -------------------------------------------------------------
        const slides = document.querySelectorAll('.hero-img');
        const captionEl = document.getElementById('showcase-caption');
        const counterEl = document.getElementById('showcase-counter');
        const subEl = document.getElementById('showcase-sub');
        const descEl = document.getElementById('showcase-desc');
        const linkEl = document.getElementById('showcase-link');

        const showcaseData = [
            { name: 'Stardew Valley Quest (RPG)', sub: 'Tema Interaktif', desc: 'Eksplorasi Desa & 5 Misi Cinta', link: '/template-1' },
            { name: 'Classic Romantic Floral', sub: 'Tema Romantis', desc: 'Sentuhan Pastel Bunga & Tipografi Halus', link: '/template-2' },
            { name: 'Elegant Nature Botanica', sub: 'Tema Editorial', desc: 'Nuansa Alam Earthy & Nuansa Tenang', link: '/template-3' },
            { name: 'Cinematic Noir & Gold', sub: 'Tema Sinematik', desc: 'Kemewahan Hitam Emas & Aksen Modern', link: '/template-4' },
            { name: 'WhatsApp Group (Bestie)', sub: 'Tema Kekinian', desc: 'Format Obrolan Akrab & Menyenangkan', link: '/template-7' }
        ];

        let activeIdx = 0;
        function updateSlide(idx) {
            slides.forEach((s, i) => {
                if (i === idx) s.classList.add('active');
                else s.classList.remove('active');
            });
            if (showcaseData[idx]) {
                const item = showcaseData[idx];
                if (captionEl) captionEl.textContent = item.name;
                if (counterEl) counterEl.textContent = (idx + 1) + ' / ' + slides.length;
                if (subEl) subEl.textContent = item.sub;
                if (descEl) descEl.textContent = item.desc;
                if (linkEl) linkEl.href = item.link;
            }
            activeIdx = idx;
        }

        if (slides.length > 1) {
            setInterval(() => {
                const next = (activeIdx + 1) % slides.length;
                updateSlide(next);
            }, 4000);
        }
    })();
    </script>

