<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title || 'KalaBahagia.com — Undangan Pernikahan Digital Eksklusif' %></title>
    <meta name="description" content="KalaBahagia.com — Undangan pernikahan digital berkelas editorial dengan musik pilihan, RSVP real-time, navigasi Google Maps, dan amplop digital langsung ke rekening Anda.">
    <link rel="stylesheet" href="/css/app.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <style>
        :root {
            --ivory-bg: #FAF7F2;
            --ivory-surface: #FFFFFF;
            --ivory-subtle: #F3ECE1;
            --charcoal: #1C1714;
            --charcoal-muted: #6B5E55;
            --charcoal-soft: #94877D;
            --gold-accent: #B08237;
            --gold-light: #E8D5B5;
            --gold-border: rgba(176, 130, 55, 0.28);
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0 !important;
            padding: 0 !important;
            width: 100%;
            min-height: 100%;
            background-color: var(--ivory-bg) !important;
            color: var(--charcoal) !important;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif !important;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        .font-serif {
            font-family: 'Playfair Display', Georgia, serif;
        }
        .font-cormorant {
            font-family: 'Cormorant Garamond', Georgia, serif;
        }

        /* Subtle luxury paper texture */
        .paper-grain {
            background-image: radial-gradient(rgba(176, 130, 55, 0.08) 1px, transparent 0);
            background-size: 24px 24px;
        }

        /* Fixed Navigation Header */
        .site-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 80px;
            z-index: 50;
            background: rgba(250, 247, 242, 0.94);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(28, 23, 20, 0.08);
            display: flex;
            align-items: center;
        }

        .nav-link {
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.04em;
            color: var(--charcoal-muted);
            text-decoration: none;
            transition: color 0.2s ease;
        }
        .nav-link:hover {
            color: var(--charcoal);
        }

        /* Clean Luxury Buttons */
        .btn-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 14px 28px;
            background: var(--charcoal);
            color: #FAF7F2;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.04em;
            border-radius: 9999px;
            text-decoration: none;
            border: 1px solid var(--charcoal);
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(28, 23, 20, 0.15);
            transition: all 0.25s ease;
        }
        .btn-primary:hover {
            background: #2D2520;
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(28, 23, 20, 0.22);
        }

        .btn-outline {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 14px 26px;
            background: transparent;
            color: var(--charcoal);
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.04em;
            border-radius: 9999px;
            text-decoration: none;
            border: 1px solid rgba(28, 23, 20, 0.25);
            cursor: pointer;
            transition: all 0.25s ease;
        }
        .btn-outline:hover {
            border-color: var(--charcoal);
            background: rgba(28, 23, 20, 0.04);
            transform: translateY(-2px);
        }

        /* Editorial Hero Showcase */
        .hero-showcase {
            position: relative;
            width: 100%;
            max-width: 480px;
            margin: 0 auto;
            border-radius: 24px;
            background: #FFFFFF;
            padding: 16px;
            box-shadow: 0 20px 50px rgba(45, 37, 34, 0.08), 0 1px 3px rgba(45, 37, 34, 0.04);
            border: 1px solid #EBE5DB;
        }

        .hero-screen {
            position: relative;
            width: 100%;
            height: 480px;
            border-radius: 16px;
            overflow: hidden;
            background: #1C1714;
        }

        .hero-img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0;
            transform: scale(1.04);
            transition: opacity 1s cubic-bezier(0.4, 0, 0.2, 1), transform 5s ease-out;
        }
        .hero-img.active {
            opacity: 1;
            transform: scale(1);
        }

        /* Ambient 3D Canvas Box */
        .ambient-3d-pedestal {
            width: 100%;
            height: 110px;
            position: relative;
            border-radius: 12px;
            overflow: hidden;
            background: #FAF7F2;
            border: 1px solid #EBE5DB;
            margin-top: 14px;
        }

        /* Template Card in Catalog */
        .template-card {
            background: #FFFFFF;
            border-radius: 20px;
            border: 1px solid #EAE3D9;
            box-shadow: 0 6px 20px rgba(45, 37, 34, 0.04);
            overflow: hidden;
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .template-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 40px rgba(45, 37, 34, 0.09);
            border-color: #D6C8B5;
        }

        .card-thumb-wrap {
            position: relative;
            width: 100%;
            height: 250px;
            overflow: hidden;
            background: #F3ECE1;
        }
        .card-thumb {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }
        .template-card:hover .card-thumb {
            transform: scale(1.05);
        }

        /* FAQ details */
        details summary::-webkit-details-marker {
            display: none;
        }
    </style>
</head>
<body class="paper-grain">

    <!-- ===================================================================== -->
    <!-- 1. EDITORIAL HEADER & NAVIGATION                                      -->
    <!-- ===================================================================== -->
    <header class="site-header">
        <div class="container mx-auto px-4 sm:px-8 max-w-7xl flex items-center justify-between">
            <!-- Brand Mark -->
            <a href="/" class="flex items-center gap-3.5" style="text-decoration: none;">
                <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0"
                     style="background: #1C1714; color: #FAF7F2;">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
                    </svg>
                </div>
                <div>
                    <span class="font-serif text-xl font-bold tracking-tight text-[#1C1714] block leading-none">
                        Kala Bahagia
                    </span>
                    <span class="text-[10px] tracking-widest uppercase font-semibold text-[#94877D] block mt-1">
                        Undangan Digital Pernikahan
                    </span>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="hidden lg:flex items-center gap-9">
                <a href="#katalog" class="nav-link">Koleksi Desain</a>
                <a href="#fitur" class="nav-link">Keunggulan</a>
                <a href="#cara-order" class="nav-link">Cara Kerja</a>
                <a href="#faq" class="nav-link">Bantuan</a>
            </nav>

            <!-- Actions -->
            <div class="flex items-center gap-4">
                <a href="/login" class="hidden sm:inline-block text-xs font-semibold uppercase tracking-wider text-[#6B5E55] hover:text-[#1C1714] transition-colors" style="text-decoration: none;">
                    Masuk
                </a>
                <a href="#katalog" class="btn-primary" style="padding: 10px 22px; font-size: 12px;">
                    <span>PILIH DESAIN</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                </a>
            </div>
        </div>
    </header>

    <!-- ===================================================================== -->
    <!-- 2. HERO SECTION: WARM EDITORIAL ELEGANCE & INTERACTIVE SHOWCASE        -->
    <!-- ===================================================================== -->
    <section class="pt-36 pb-20 lg:pt-48 lg:pb-28">
        <div class="container mx-auto px-4 sm:px-8 max-w-7xl">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
                
                <!-- Left Column: Editorial Headline & Narrative Copy -->
                <div class="lg:col-span-7 text-center lg:text-left space-y-7">
                    
                    <span class="inline-block text-xs font-semibold tracking-widest uppercase text-[#B08237]">
                        Koleksi Eksklusif Pernikahan
                    </span>

                    <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-normal leading-[1.12] text-[#1C1714]">
                        Undangan Pernikahan <br>
                        yang Dirancang <br class="hidden sm:inline">
                        <span class="italic font-normal">dengan Sepenuh Jiwa.</span>
                    </h1>

                    <p class="font-cormorant italic text-xl sm:text-2xl text-[#6B5E55] max-w-2xl leading-relaxed">
                        "Setiap cinta memiliki ceritanya sendiri. Hadirkan kesan pertama yang hangat bagi keluarga dan sahabat melalui tipografi anggun, alunan musik syahdu, serta kemudahan navigasi lokasi dan amplop digital."
                    </p>

                    <!-- Concrete Proof Points (No empty AI claims) -->
                    <div class="pt-2 flex flex-wrap items-center justify-center lg:justify-start gap-3 text-xs font-medium text-[#6B5E55]">
                        <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#F3ECE1]">
                            <svg class="w-3.5 h-3.5 text-[#B08237]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                            <span>Trial 7 Hari Gratis</span>
                        </span>
                        <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#F3ECE1]">
                            <svg class="w-3.5 h-3.5 text-[#B08237]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                            <span>Amplop Digital 100% Utuh ke Rekening</span>
                        </span>
                        <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#F3ECE1]">
                            <svg class="w-3.5 h-3.5 text-[#B08237]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                            <span>Bebas Kirim Tanpa Batas Tamu</span>
                        </span>
                    </div>

                    <!-- Call to Actions -->
                    <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-3">
                        <a href="#katalog" class="btn-primary w-full sm:w-auto">
                            <span>Eksplorasi Koleksi Desain</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                            </svg>
                        </a>
                        <a href="/login" class="btn-outline w-full sm:w-auto">
                            <span>Masuk ke Dashboard</span>
                        </a>
                    </div>
                </div>

                <!-- Right Column: Tactile Invitation Showcase & Seamless Crossfade -->
                <div class="lg:col-span-5 flex flex-col items-center">
                    
                    <div class="hero-showcase">
                        
                        <!-- Top Bar with Active Template Name -->
                        <div class="flex items-center justify-between pb-3 mb-2 px-1 border-b border-[#EBE5DB]">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-[#B08237]"></span>
                                <span class="text-xs font-semibold text-[#1C1714]" id="showcase-caption">
                                    Stardew Valley Quest (RPG)
                                </span>
                            </div>
                            <span class="text-xs font-mono text-[#94877D]" id="showcase-counter">1 / 5</span>
                        </div>

                        <!-- Crossfade Image Screen -->
                        <div class="hero-screen">
                            <img src="/images/templates/template-1.jpg" alt="Template 1" class="hero-img active" data-index="0">
                            <img src="/images/templates/template-2.jpg" alt="Template 2" class="hero-img" data-index="1">
                            <img src="/images/templates/template-3.jpg" alt="Template 3" class="hero-img" data-index="2">
                            <img src="/images/templates/template-4.jpg" alt="Template 4" class="hero-img" data-index="3">
                            <img src="/images/templates/template-7.jpg" alt="Template 7" class="hero-img" data-index="4">

                            <!-- Subtle Bottom Gradient -->
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>

                            <!-- Bottom Floating Action -->
                            <div class="absolute bottom-4 inset-x-4 flex items-center justify-between z-20">
                                <div>
                                    <span class="text-[10px] tracking-wider uppercase font-bold text-white/80 block" id="showcase-sub">
                                        Tema Undangan Interaktif
                                    </span>
                                    <span class="text-xs font-serif font-bold text-white block mt-0.5" id="showcase-desc">
                                        Eksplorasi Desa &amp; 5 Misi Cinta
                                    </span>
                                </div>
                                <a id="showcase-link" href="/template-1" target="_blank"
                                   class="px-3.5 py-1.5 bg-white text-[#1C1714] text-xs font-semibold rounded-full shadow hover:bg-[#FAF7F2] transition-colors" style="text-decoration: none;">
                                    Buka Demo
                                </a>
                            </div>
                        </div>

                        <!-- Tasteful 3D Wedding Bands Ambient Pedestal -->
                        <div class="ambient-3d-pedestal">
                            <canvas id="hero-3d-canvas"></canvas>
                            <div class="absolute bottom-1 inset-x-0 text-center pointer-events-none">
                                <span class="text-[9.5px] uppercase tracking-widest font-semibold text-[#94877D]">
                                    Sentuh dan geser untuk memutar cincin
                                </span>
                            </div>
                        </div>

                    </div>

                </div>

            </div>
        </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 3. KATALOG TEMPLATE EKSKLUSIF (CLEAN EDITORIAL CARD GRID)              -->
    <!-- ===================================================================== -->
    <main id="katalog" class="py-24 sm:py-32 container mx-auto px-4 sm:px-8 max-w-7xl scroll-mt-20">
        
        <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
            <span class="text-xs font-semibold tracking-widest uppercase text-[#B08237] block">
                Koleksi Desain Pilihan
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#1C1714] font-normal tracking-tight">
                Pilihan Tema Eksklusif
            </h2>
            <p class="font-cormorant italic text-lg sm:text-xl text-[#6B5E55] leading-relaxed max-w-2xl mx-auto">
                Setiap desain dirancang dengan ketelitian artistik tinggi, memastikan tampilan yang memukau dan nyaman dibuka pada ponsel setiap tamu Anda.
            </p>
        </div>

        <% if (templates.length) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
            <% templates.forEach(function(t, i) { 
                const theme = (typeof templateThemes !== 'undefined' && templateThemes[t.slug]) ? templateThemes[t.slug] : {
                    monogram: t.name.split(' ').map(w => w[0]).slice(0, 2).join(''),
                    displayTitle: t.name.replace(/\s*\(.*?\)/, ''),
                    code: t.slug.toUpperCase(),
                };
            %>
            <article class="template-card">
                <div>
                    <!-- Photo Thumbnail -->
                    <div class="card-thumb-wrap">
                        <img src="/images/templates/<%= t.slug %>.jpg" 
                             alt="<%= t.name %>" 
                             onerror="this.style.display='none';"
                             class="card-thumb">

                        <!-- Top Right Price Badge -->
                        <div class="absolute top-3.5 right-3.5 z-20">
                            <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-semibold bg-white/95 text-[#1C1714] shadow-sm border border-[#EAE3D9]">
                                <%= formatIDR(t.price) %>
                            </span>
                        </div>

                        <!-- Top Left Code -->
                        <div class="absolute top-3.5 left-3.5 z-20">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[10px] font-mono tracking-widest uppercase bg-[#1C1714]/80 text-white backdrop-blur-sm">
                                <%= t.slug.toUpperCase() %>
                            </span>
                        </div>

                        <!-- Bottom Vignette with Monogram & Name -->
                        <div class="absolute inset-x-0 bottom-0 pt-16 pb-3.5 px-4 flex items-end justify-between gap-3 z-10"
                             style="background: linear-gradient(to top, rgba(28,23,20,0.92) 0%, rgba(28,23,20,0.5) 60%, transparent 100%);">
                            <div class="flex items-center gap-2.5 min-w-0 flex-1">
                                <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 bg-white/15 border border-white/20">
                                    <span class="font-serif italic font-bold text-xs text-white leading-none">
                                        <%= theme.monogram %>
                                    </span>
                                </div>
                                <h3 class="font-serif font-bold text-white text-base leading-tight truncate">
                                    <%= theme.displayTitle %>
                                </h3>
                            </div>
                        </div>
                    </div>

                    <!-- Details -->
                    <div class="p-6 space-y-2">
                        <div class="flex items-baseline justify-between">
                            <h4 class="font-serif text-lg font-bold text-[#1C1714]"><%= t.name %></h4>
                            <span class="text-[10px] font-semibold tracking-wider text-[#B08237] uppercase">Tersedia</span>
                        </div>
                        <p class="text-xs sm:text-sm text-[#6B5E55] line-clamp-2 leading-relaxed min-h-[38px]">
                            <%= t.description || 'Desain undangan digital elegan dengan kelengkapan musik, galeri, dan buku doa.' %>
                        </p>
                    </div>
                </div>

                <!-- Action Buttons: Preview & Pesan -->
                <div class="p-6 pt-0 grid grid-cols-2 gap-3">
                    <a href="/<%= t.slug %>" target="_blank"
                       class="btn-outline" style="padding: 10px 14px; font-size: 12px; border-radius: 10px;">
                        <svg class="w-3.5 h-3.5 text-[#B08237]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                        <span>Demo Live</span>
                    </a>
                    <a href="/order/<%= t.slug %>"
                       class="btn-primary" style="padding: 10px 14px; font-size: 12px; border-radius: 10px;">
                        <span>Pilih Desain</span>
                    </a>
                </div>
            </article>
            <% }); %>
        </div>
        <% } else { %>
        <div class="text-center py-16 bg-white rounded-2xl border border-[#EAE3D9]">
            <p class="text-[#6B5E55] text-base">Koleksi desain sedang diperbarui. Silakan kembali beberapa saat lagi.</p>
        </div>
        <% } %>
    </main>

    <!-- ===================================================================== -->
    <!-- 4. KEUNGGULAN UTAMA (CLEAN EDITORIAL BENEFITS)                        -->
    <!-- ===================================================================== -->
    <section id="fitur" class="py-24 sm:py-32 bg-[#F3ECE1] border-y border-[#EBE3D7]">
        <div class="container mx-auto px-4 sm:px-8 max-w-7xl">
            
            <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
                <span class="text-xs font-semibold tracking-widest uppercase text-[#B08237] block">
                    Keunggulan Layanan
                </span>
                <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#1C1714] font-normal tracking-tight">
                    Fitur Lengkap untuk Momen Sempurna
                </h2>
                <p class="font-cormorant italic text-lg sm:text-xl text-[#6B5E55] leading-relaxed">
                    Dirancang dengan teliti untuk memberikan kemudahan bagi calon mempelai dan kenyamanan maksimal bagi para tamu.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Feature 1 -->
                <div class="bg-white rounded-2xl p-7 border border-[#EAE3D9] shadow-sm flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-[#FAF7F2] border border-[#EBE3D7] flex items-center justify-center text-[#B08237] mb-5">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/></svg>
                        </div>
                        <h3 class="font-serif text-lg font-bold text-[#1C1714] mb-2">Musik &amp; Buka Amplop</h3>
                        <p class="text-xs sm:text-sm text-[#6B5E55] leading-relaxed">
                            Sambut tamu dengan alunan melodi romantis pilihan dan efek buka amplop virtual yang menyentuh hati.
                        </p>
                    </div>
                </div>

                <!-- Feature 2 -->
