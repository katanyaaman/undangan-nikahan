<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title || 'KalaBahagia.com — Undangan Pernikahan Digital Sinematik & Elegan' %></title>
    <meta name="description" content="KalaBahagia.com — Hadirkan undangan pernikahan digital bernuansa sinematik, musik romantis, RSVP real-time, navigasi Google Maps akurat, dan amplop digital langsung ke rekening Anda.">
    <link rel="stylesheet" href="/css/app.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .font-serif-luxury {
            font-family: 'Playfair Display', 'Cormorant Garamond', Georgia, serif;
        }
        .hero-grain {
            background-image: radial-gradient(rgba(197, 160, 89, 0.12) 1px, transparent 0);
            background-size: 28px 28px;
        }
        .gold-gradient-text {
            background: linear-gradient(135deg, #fef08a 0%, #dfc573 50%, #b78a3a 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>
<body class="bg-[#FAF7F2] text-[#29221D] font-sans antialiased selection:bg-[#B78A3A] selection:text-white">

    <!-- Header / Navbar Sinematik -->
    <header class="sticky top-0 z-50 bg-[#FAF7F2]/90 backdrop-blur-md border-b border-[#EAE3D9] transition-all">
        <div class="container mx-auto px-4 sm:px-6 max-w-7xl flex items-center justify-between h-20">
            <!-- Brand Logo KalaBahagia.com -->
            <a href="/" class="flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#1C1613] to-[#2B231E] border border-[#B78A3A]/40 flex items-center justify-center shadow-sm group-hover:border-[#B78A3A] transition-colors">
                    <svg class="w-5 h-5 text-[#dfc573]" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
                    </svg>
                </div>
                <div>
                    <span class="font-serif-luxury text-xl sm:text-2xl font-bold tracking-tight text-[#1C1613] block leading-none">
                        Kala Bahagia<span class="text-[#B78A3A]">.com</span>
                    </span>
                    <span class="text-[10px] tracking-widest uppercase font-semibold text-[#8C7D73] block mt-0.5">
                        Sinematik Wedding Platform
                    </span>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center gap-8">
                <a href="#katalog" class="text-sm font-medium text-[#574D46] hover:text-[#B78A3A] transition-colors">Koleksi Desain</a>
                <a href="#fitur" class="text-sm font-medium text-[#574D46] hover:text-[#B78A3A] transition-colors">Fitur Unggulan</a>
                <a href="#cara-order" class="text-sm font-medium text-[#574D46] hover:text-[#B78A3A] transition-colors">Cara Order</a>
                <a href="#faq" class="text-sm font-medium text-[#574D46] hover:text-[#B78A3A] transition-colors">Tanya Jawab</a>
            </nav>

            <!-- Actions -->
            <div class="flex items-center gap-3">
                <a href="/login" class="hidden sm:inline-flex items-center px-4 py-2.5 text-xs sm:text-sm font-semibold text-[#574D46] hover:text-[#1C1613] transition-colors">
                    Masuk
                </a>
                <a href="#katalog" class="inline-flex items-center gap-2 px-5 py-2.5 text-xs sm:text-sm font-semibold text-white bg-gradient-to-r from-[#B78A3A] via-[#C5A059] to-[#A1742B] hover:brightness-105 rounded-xl shadow-sm hover:shadow-md transition-all">
                    <span>Pilih Template</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                </a>
            </div>
        </div>
    </header>

    <!-- HERO SECTION: Atmospheric, Cinematic & Evocative -->
    <section class="relative overflow-hidden bg-[#161210] text-white py-20 sm:py-28 lg:py-36 hero-grain">
        <!-- Ambient Warm Cinematic Glows -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-5xl h-96 bg-gradient-to-b from-[#B78A3A]/20 via-[#dfc573]/10 to-transparent blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-[#dfc573]/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="container mx-auto px-4 sm:px-6 max-w-5xl relative z-10 text-center">
            
            <!-- Cinematic Badge -->
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-[#B78A3A]/40 backdrop-blur-md mb-8 shadow-sm">
                <span class="w-2 h-2 rounded-full bg-[#dfc573] shadow-[0_0_8px_#dfc573]"></span>
                <span class="text-xs font-medium text-amber-100 tracking-wide">
                    Platform Undangan Pernikahan Digital Eksklusif
                </span>
            </div>

            <!-- Majestic Cinematic Headline -->
            <h1 class="font-serif-luxury text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-normal leading-[1.12] mb-6 tracking-tight">
                Cerita Cinta Anda, <br class="hidden sm:inline">
                <span class="italic font-light gold-gradient-text">Terpahat Indah</span> dalam Satu Sentuhan.
            </h1>

            <!-- Emotional & Value-driven Subtitle -->
            <p class="text-base sm:text-lg md:text-xl text-neutral-300 max-w-2xl mx-auto mb-10 font-light leading-relaxed">
                Hadirkan getaran bahagia yang tak terlupakan bagi setiap tamu. Undangan digital eksklusif dengan alunan musik syahdu, navigasi Google Maps presisi, RSVP instan, dan amplop digital langsung ke rekening Anda.
            </p>

            <!-- Dual Action Buttons -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
                <a href="#katalog" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 bg-gradient-to-r from-[#B78A3A] via-[#C5A059] to-[#A1742B] text-white font-semibold text-sm rounded-xl shadow-lg hover:shadow-[#B78A3A]/30 hover:scale-[1.02] transition-all">
                    <span>Eksplorasi Koleksi Desain</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                    </svg>
                </a>
                <a href="/login" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/15 text-white font-semibold text-sm rounded-xl border border-white/20 backdrop-blur-md transition-all">
                    <span>Masuk ke Dashboard</span>
                </a>
            </div>

            <!-- Value Proof Points (No empty claims, concrete utility) -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-8 border-t border-white/10 max-w-4xl mx-auto text-left sm:text-center">
                <div class="flex items-center sm:justify-center gap-2 text-xs sm:text-sm text-neutral-300">
                    <svg class="w-4 h-4 text-[#dfc573] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                    <span>Trial 7 Hari Aktif</span>
                </div>
                <div class="flex items-center sm:justify-center gap-2 text-xs sm:text-sm text-neutral-300">
                    <svg class="w-4 h-4 text-[#dfc573] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                    <span>Navigasi Maps Presisi</span>
                </div>
                <div class="flex items-center sm:justify-center gap-2 text-xs sm:text-sm text-neutral-300">
                    <svg class="w-4 h-4 text-[#dfc573] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                    <span>Amplop Digital 100% Utuh</span>
                </div>
                <div class="flex items-center sm:justify-center gap-2 text-xs sm:text-sm text-neutral-300">
                    <svg class="w-4 h-4 text-[#dfc573] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                    <span>Kirim Tanpa Batas Tamu</span>
                </div>
            </div>

        </div>
    </section>

    <!-- SECTION 2: KATALOG TEMPLATE EKSKLUSIF -->
    <main id="katalog" class="py-20 sm:py-28 container mx-auto px-4 sm:px-6 max-w-7xl scroll-mt-20">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="text-xs font-bold tracking-widest uppercase text-[#B78A3A] block mb-2.5">
                KOLEKSI KARYA SINEMATIK
            </span>
            <h2 class="font-serif-luxury text-3xl sm:text-4xl md:text-5xl text-[#1C1613] font-normal tracking-tight mb-4">
                Pilihan Tema Eksklusif
            </h2>
            <p class="text-sm sm:text-base text-[#6E6157] leading-relaxed">
                Setiap desain dirancang dengan sentuhan editorial, tipografi berkelas, dan kesempurnaan tampilan pada setiap perangkat smartphone tamu Anda.
            </p>
        </div>

        <% if (templates.length) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
            <% templates.forEach(function(t, i) { 
                const theme = (typeof templateThemes !== 'undefined' && templateThemes[t.slug]) ? templateThemes[t.slug] : {
                    monogram: t.name.split(' ').map(w => w[0]).slice(0, 2).join(''),
                    displayTitle: t.name.replace(/\s*\(.*?\)/, ''),
                    code: t.slug.toUpperCase(),
                    bgGradient: 'background: linear-gradient(135deg, #111827 0%, #1f2937 60%, #111827 100%);',
                    monogramColor: '#fde047',
                };
            %>
            <article class="group bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1.5 border border-[#EAE3D9] flex flex-col justify-between overflow-hidden">
                <div>
                    <!-- Photo Thumbnail Flatlay with Overlays (Matching Exact 240px Ratio) -->
                    <div class="relative w-full overflow-hidden bg-slate-900 group flex-shrink-0" style="height: 240px; min-height: 240px; max-height: 240px; position: relative;">
                        <img src="/images/templates/<%= t.slug %>.jpg" 
                             alt="<%= t.name %>" 
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                             class="transform group-hover:scale-105 transition-transform duration-500"
                             style="width: 100%; height: 100%; min-height: 240px; max-height: 240px; object-fit: cover; object-position: center; display: block;">
                        
                        <!-- Fallback gradient -->
                        <div class="w-full h-full hidden absolute inset-0" style="<%= theme.style || 'background: #1e293b' %>; width: 100%; height: 100%;"></div>

                        <!-- Price Pill Badge -->
                        <div class="absolute top-3.5 right-3.5 z-20">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-[#1C1613]/80 border border-white/20 text-[#fde047] backdrop-blur-md shadow-sm">
                                <%= formatIDR(t.price) %>
                            </span>
                        </div>

                        <!-- Bottom Vignette with Monogram & Code -->
                        <div class="absolute inset-x-0 bottom-0 pt-16 pb-3.5 px-4 bg-gradient-to-t from-black/90 via-black/55 to-transparent flex items-end justify-between gap-3 z-10" style="background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.55) 55%, transparent 100%);">
                            <div class="flex items-center gap-2.5 min-w-0 flex-1">
                                <div class="w-8 h-8 rounded-lg bg-white/20 backdrop-blur-md border border-white/25 flex items-center justify-center flex-shrink-0 shadow-sm" style="width: 32px; height: 32px; border-radius: 8px;">
                                    <span class="font-serif-luxury italic font-bold text-sm text-white select-none leading-none">
                                        <%= theme.monogram %>
                                    </span>
                                </div>
                                <h3 class="font-serif-luxury font-bold text-white text-base leading-tight truncate drop-shadow-sm">
                                    <%= theme.displayTitle %>
                                </h3>
                            </div>

                            <span class="px-2.5 py-1 bg-black/60 border border-white/15 text-gray-200 text-[10px] font-mono font-bold tracking-widest rounded-md uppercase backdrop-blur-md flex-shrink-0">
                                <%= t.slug.toUpperCase() %>
                            </span>
                        </div>
                    </div>

                    <!-- Content Details -->
                    <div class="p-6">
                        <div class="flex items-baseline justify-between mb-2">
                            <h4 class="font-serif-luxury text-lg font-bold text-[#1C1613]"><%= t.name %></h4>
                            <span class="text-xs font-semibold text-[#B78A3A] uppercase tracking-wider">Tersedia</span>
                        </div>
                        <p class="text-xs sm:text-sm text-[#6E6157] line-clamp-2 leading-relaxed min-h-[40px] mb-2"><%= t.description || 'Desain undangan digital elegan dengan kelengkapan fitur interaktif.' %></p>
                    </div>
                </div>

                <!-- Action Buttons: Preview & Pesan -->
                <div class="p-6 pt-0 grid grid-cols-2 gap-3">
                    <a href="/<%= t.slug %>" target="_blank"
                       class="h-11 inline-flex items-center justify-center gap-1.5 px-3.5 bg-white border border-[#DED7CE] hover:border-[#B78A3A] text-[#4A3E36] rounded-xl text-xs sm:text-sm font-semibold transition-colors">
                        <svg class="w-4 h-4 text-[#8C7D73]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                        <span>Demo</span>
                    </a>
                    <a href="/order/<%= t.slug %>"
                       class="h-11 inline-flex items-center justify-center gap-1 px-3.5 bg-gradient-to-r from-[#B78A3A] via-[#C5A059] to-[#A1742B] hover:brightness-105 text-white rounded-xl text-xs sm:text-sm font-semibold transition-all shadow-sm">
                        <span>Pesan Desain</span>
                    </a>
                </div>
            </article>
            <% }); %>
        </div>
        <% } else { %>
        <div class="text-center py-16 bg-white rounded-3xl border border-[#EAE3D9] shadow-sm">
            <p class="text-[#8C7D73] text-base">Katalog sedang diperbarui. Silakan kembali beberapa saat lagi.</p>
        </div>
        <% } %>
    </main>

    <!-- SECTION 3: FITUR EKSKLUSIF YANG MENJUAL (TANGIBLE BENEFITS) -->
    <section id="fitur" class="py-20 sm:py-28 bg-[#F4EFEA] border-y border-[#EAE3D9]">
        <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-xs font-bold tracking-widest uppercase text-[#B78A3A] block mb-2.5">
                    MENGAPA MEMILIH KALABAHAGIA.COM
                </span>
                <h2 class="font-serif-luxury text-3xl sm:text-4xl md:text-5xl text-[#1C1613] font-normal tracking-tight mb-4">
                    Fitur Lengkap untuk Momen Sempurna
                </h2>
                <p class="text-sm sm:text-base text-[#6E6157] leading-relaxed">
                    Dirancang dengan cermat untuk memberikan kemudahan bagi calon pengantin dan kenyamanan maksimal bagi para tamu undangan.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Feature 1 -->
                <div class="bg-white rounded-2xl p-7 border border-[#EAE3D9] shadow-xs hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-xl bg-[#FAF7F2] border border-[#B78A3A]/30 flex items-center justify-center text-[#B78A3A] mb-5">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/></svg>
                    </div>
                    <h3 class="font-serif-luxury text-lg font-bold text-[#1C1613] mb-2.5">Alunan Musik & Buka Amplop</h3>
                    <p class="text-xs sm:text-sm text-[#6E6157] leading-relaxed">
                        Sambut tamu dengan melodi romantis pilihan Anda dan efek buka amplop virtual yang menyentuh hati sejak klik pertama.
                    </p>
                </div>

                <!-- Feature 2 -->
                <div class="bg-white rounded-2xl p-7 border border-[#EAE3D9] shadow-xs hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-xl bg-[#FAF7F2] border border-[#B78A3A]/30 flex items-center justify-center text-[#B78A3A] mb-5">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    </div>
                    <h3 class="font-serif-luxury text-lg font-bold text-[#1C1613] mb-2.5">Navigasi Google Maps Presisi</h3>
                    <p class="text-xs sm:text-sm text-[#6E6157] leading-relaxed">
                        Tamu dipandu langsung ke titik lokasi akad dan resepsi dengan 1 kali klik, mencegah risiko tersesat di hari pernikahan.
                    </p>
                </div>

                <!-- Feature 3 -->
                <div class="bg-white rounded-2xl p-7 border border-[#EAE3D9] shadow-xs hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-xl bg-[#FAF7F2] border border-[#B78A3A]/30 flex items-center justify-center text-[#B78A3A] mb-5">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                    </div>
                    <h3 class="font-serif-luxury text-lg font-bold text-[#1C1613] mb-2.5">Amplop Digital & QRIS</h3>
                    <p class="text-xs sm:text-sm text-[#6E6157] leading-relaxed">
                        Memudahkan tamu yang berhalangan hadir untuk mengirim tanda kasih langsung ke rekening bank atau dompet digital Anda secara aman.
                    </p>
                </div>

                <!-- Feature 4 -->
                <div class="bg-white rounded-2xl p-7 border border-[#EAE3D9] shadow-xs hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-xl bg-[#FAF7F2] border border-[#B78A3A]/30 flex items-center justify-center text-[#B78A3A] mb-5">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                    </div>
                    <h3 class="font-serif-luxury text-lg font-bold text-[#1C1613] mb-2.5">RSVP & Buku Doa Abadi</h3>
                    <p class="text-xs sm:text-sm text-[#6E6157] leading-relaxed">
                        Ketahui kepastian kehadiran tamu secara real-time dan abadikan ucapan doa hangat sahabat di dashboard pribadi Anda selamanya.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION 4: CARA ORDER (3 LANGKAH JELAS & TANPA RIBET) -->
    <section id="cara-order" class="py-20 sm:py-28 container mx-auto px-4 sm:px-6 max-w-5xl scroll-mt-20">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="text-xs font-bold tracking-widest uppercase text-[#B78A3A] block mb-2.5">
                LANGKAH PRAKTIS
            </span>
            <h2 class="font-serif-luxury text-3xl sm:text-4xl md:text-5xl text-[#1C1613] font-normal tracking-tight mb-4">
                Siap Kirim Hanya dalam 3 Langkah
            </h2>
            <p class="text-sm sm:text-base text-[#6E6157]">
                Tidak perlu menunggu berhari-hari. Kelola semua kebutuhan undangan Anda sendiri dengan mudah dan cepat.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
            <!-- Step 1 -->
            <div class="bg-white rounded-2xl p-8 border border-[#EAE3D9] shadow-sm relative flex flex-col justify-between">
                <div>
                    <span class="font-serif-luxury text-3xl font-bold text-[#dfc573] block mb-3">01</span>
                    <h3 class="font-serif-luxury text-xl font-bold text-[#1C1613] mb-2">Pilih Tema Favorit</h3>
                    <p class="text-xs sm:text-sm text-[#6E6157] leading-relaxed">
                        Lihat preview demo setiap tema dan pilih gaya visual yang paling mencerminkan karakter pernikahan Anda.
                    </p>
