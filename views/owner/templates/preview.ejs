<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title || 'Edit Demo' %></title>
    <link rel="stylesheet" href="/css/app.css">
</head>
<body class="bg-gray-900 min-h-screen flex flex-col">
    <header class="bg-white border-b border-gray-200 px-4 py-3 flex items-center justify-between gap-3 sticky top-0 z-50">
        <div class="flex items-center gap-3">
            <a href="/owner/templates" class="inline-flex items-center text-sm text-gray-600 hover:text-gold-700 transition-colors">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Templates
            </a>
            <h1 class="text-base md:text-lg font-bold text-gray-800">Edit Demo: <%= template.name %></h1>
            <span id="demo-dirty" class="hidden px-2 py-1 bg-gold-100 text-gold-700 text-xs font-medium rounded-full">Belum disimpan</span>
        </div>
        <div class="flex items-center gap-2">
            <button id="demo-rotate" title="Putar tampilan vertikal / horizontal" class="inline-flex items-center gap-1.5 px-4 py-2 text-sm border border-gray-200 hover:border-gold-400 text-gray-700 rounded-xl transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h5M20 20v-5h-5M5 9a8 8 0 0114-3M19 15a8 8 0 01-14 3"></path>
                </svg>
                <span id="demo-rotate-label">Vertikal</span>
            </button>
            <a href="<%= demoSrc %>" target="_blank" class="px-4 py-2 text-sm border border-gray-200 hover:border-gold-400 text-gray-700 rounded-xl transition-colors">Buka Demo</a>
            <button id="demo-reset" class="px-4 py-2 text-sm border border-gray-200 hover:border-gray-400 text-gray-700 rounded-xl transition-colors">Reset</button>
            <button id="demo-save" disabled class="px-5 py-2 text-sm bg-gold-600 hover:bg-gold-700 disabled:opacity-40 text-white rounded-xl transition-colors">Simpan</button>
        </div>
    </header>

    <p id="demo-hint" class="text-center text-xs text-gray-400 py-2">Klik teks di HP untuk ubah. Klik foto untuk ganti.</p>

    <main class="flex-1 flex items-start justify-center p-4 md:p-6 overflow-auto">
        <div id="demo-device" class="w-[393px] max-w-full shrink-0 bg-white border border-gray-700 shadow-2xl">
            <div id="demo-screen" class="relative bg-white overflow-hidden" style="height: calc(100vh - 180px); min-height: 560px;">
                <iframe id="demo-frame" src="<%= demoSrc %>" title="Preview demo" class="w-full h-full border-0"></iframe>
            </div>
        </div>
    </main>

    <input type="file" id="demo-photo-input" accept="image/jpeg,image/png,image/webp" class="hidden">

    <script>
        window.__DEMO_EDITOR__ = {
            csrf: document.querySelector('meta[name="csrf-token"]').content,
            saveUrl: '/owner/templates/<%= template.slug %>/demo',
            photoUrl: '/owner/templates/<%= template.slug %>/demo-photo'
        };
    </script>
    <script>
        // Putar preview: vertikal 393px <-> horizontal 852px (standar layar HP saat ini).
        (function () {
            var device = document.getElementById('demo-device');
            var screen = document.getElementById('demo-screen');
            var btn = document.getElementById('demo-rotate');
            var label = document.getElementById('demo-rotate-label');
            var landscape = false;
            btn.addEventListener('click', function () {
                landscape = !landscape;
                if (landscape) {
                    device.classList.remove('w-[393px]');
                    device.classList.add('w-[852px]');
                    screen.style.height = '393px';
                    screen.style.minHeight = '0';
                    label.textContent = 'Horizontal';
                } else {
                    device.classList.remove('w-[852px]');
                    device.classList.add('w-[393px]');
                    screen.style.height = 'calc(100vh - 180px)';
                    screen.style.minHeight = '560px';
                    label.textContent = 'Vertikal';
                }
            });
        })();
    </script>
    <script src="/js/demo-editor.js"></script>
</body>
</html>
