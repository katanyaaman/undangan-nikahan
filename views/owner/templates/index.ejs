<%
const templateThemeConfig = {
    'template-1': {
        monogram: 'Em',
        displayTitle: 'Elegant Modern',
        style: 'background: linear-gradient(135deg, #09192f 0%, #172d4c 60%, #0d1e34 100%);',
        monogramColor: '#a5b4fc',
    },
    'template-2': {
        monogram: 'Cr',
        displayTitle: 'Classic Romantic',
        style: 'background: linear-gradient(135deg, #2c0b1a 0%, #581432 60%, #350c20 100%);',
        monogramColor: '#fbcfe8',
    },
    'template-3': {
        monogram: 'En',
        displayTitle: 'Elegant Nature',
        style: 'background: linear-gradient(135deg, #261706 0%, #542d0c 60%, #331a07 100%);',
        monogramColor: '#fde047',
    },
    'template-4': {
        monogram: 'Be',
        displayTitle: 'Bugis Emerald',
        style: 'background: linear-gradient(135deg, #04241a 0%, #0b4534 60%, #052c20 100%);',
        monogramColor: '#6ee7b7',
    },
    'template-7': {
        monogram: 'Wa',
        displayTitle: 'WhatsApp Group',
        style: 'background: linear-gradient(135deg, #062820 0%, #0e4c3a 60%, #073428 100%);',
        monogramColor: '#86efac',
    },
    'template-8': {
        monogram: 'Tg',
        displayTitle: 'Telegram Group',
        style: 'background: linear-gradient(135deg, #071c2b 0%, #0d3b5d 60%, #09263a 100%);',
        monogramColor: '#7dd3fc',
    },
};
%>

<div class="mb-6 bg-white rounded-2xl shadow-sm p-4 sm:p-5 border border-gray-100 flex items-center justify-between">
    <p class="text-xs sm:text-sm text-gray-600 flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block flex-shrink-0 shadow-[0_0_6px_#10b981]"></span>
        <span>Nonaktifkan untuk menarik dari katalog. Event yang sudah jalan tidak terganggu. Tombol <strong>Preview</strong> membuka demo template.</span>
    </p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 items-stretch">
    <% templates.forEach(function(t) { 
        const theme = templateThemeConfig[t.slug] || {
            monogram: t.name.split(' ').map(w => w[0]).slice(0, 2).join(''),
            displayTitle: t.name.replace(/\s*\(.*?\)/, ''),
            style: 'background: linear-gradient(135deg, #111827 0%, #1f2937 60%, #111827 100%);',
            monogramColor: '#fde047',
        };
        const templateCode = t.slug.toUpperCase();
    %>
    <article class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow overflow-hidden border border-gray-100 flex flex-col h-full" style="height: 100%; display: flex; flex-direction: column;">
        <!-- Photo Thumbnail Flatlay with Overlays (Strict Fixed 240px Height) -->
        <div class="relative w-full overflow-hidden bg-slate-900 group flex-shrink-0" style="height: 240px; min-height: 240px; max-height: 240px; position: relative;">
            <img src="/images/templates/<%= t.slug %>.jpg" 
                 alt="<%= t.name %>" 
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                 class="transform group-hover:scale-105 transition-transform duration-500"
                 style="width: 100%; height: 100%; min-height: 240px; max-height: 240px; object-fit: cover; object-position: center; display: block;">
            
            <!-- Fallback gradient if image not loaded -->
            <div class="w-full h-full hidden absolute inset-0" style="<%= theme.style %>; width: 100%; height: 100%; min-height: 240px; max-height: 240px;"></div>

            <!-- Top Right: Status Pill Badge (Semi-transparent Green) -->
            <% if (t.active) { %>
            <div class="absolute top-3.5 right-3.5 z-20">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-400/90 text-emerald-950 backdrop-blur-md shadow-sm whitespace-nowrap">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-800"></span>
                    Aktif
                </span>
            </div>
            <% } else { %>
            <div class="absolute top-3.5 right-3.5 z-20">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-gray-900/70 text-gray-300 backdrop-blur-md shadow-sm whitespace-nowrap">
                    <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
                    Nonaktif
                </span>
            </div>
            <% } %>

            <!-- Bottom Overlay: Dark Gradient Vignette with Monogram, Full Title & Code -->
            <div class="absolute inset-x-0 bottom-0 pt-16 pb-3.5 px-4 bg-gradient-to-t from-black/90 via-black/55 to-transparent flex items-end justify-between gap-3 z-10" style="background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.55) 55%, transparent 100%);">
                <div class="flex items-center gap-2.5 min-w-0 flex-1">
                    <!-- Squircle Monogram Box -->
                    <div class="w-8 h-8 rounded-lg bg-white/20 backdrop-blur-md border border-white/25 flex items-center justify-center flex-shrink-0 shadow-sm" style="width: 32px; height: 32px; border-radius: 8px;">
                        <span class="font-serif italic font-bold text-sm text-white select-none leading-none">
                            <%= theme.monogram %>
                        </span>
                    </div>
                    <!-- Title (Clean and unclipped) -->
                    <h3 class="font-serif font-bold text-white text-base leading-tight drop-shadow-sm break-words">
                        <%= theme.displayTitle %>
                    </h3>
                </div>

                <!-- Template Code Pill (Fixed Badge) -->
                <span class="px-2.5 py-1 bg-black/60 border border-white/15 text-gray-200 text-[10px] font-mono font-bold tracking-widest rounded-md uppercase backdrop-blur-md flex-shrink-0 whitespace-nowrap">
                    <%= templateCode %>
                </span>
            </div>
        </div>

        <form method="POST" action="/owner/templates/<%= t.slug %>" class="p-5 flex-1 flex flex-col justify-between space-y-4" style="flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            
            <div class="space-y-3.5 flex-1">
                <div>
                    <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">NAMA TAMPILAN</label>
                    <input type="text" name="name" value="<%= t.name %>" required maxlength="255"
                        class="block w-full px-3.5 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-gold-500 focus:border-gold-500 text-sm text-gray-800 transition-colors"
                        style="height: 44px;">
                </div>

                <div>
                    <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">DESKRIPSI SINGKAT</label>
                    <textarea name="description" rows="2" maxlength="1000"
                        class="block w-full px-3.5 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-gold-500 focus:border-gold-500 text-xs sm:text-sm text-gray-600 leading-relaxed transition-colors"
                        style="height: 72px; min-height: 72px; max-height: 72px; resize: none;"><%= t.description || '' %></textarea>
                </div>

                <div class="flex items-center gap-4">
                    <div class="flex-1">
                        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">HARGA (RP)</label>
                        <div class="relative rounded-xl border border-gray-200 overflow-hidden focus-within:ring-2 focus-within:ring-gold-500 focus-within:border-gold-500 bg-white flex items-center" style="height: 44px;">
                            <span class="pl-3.5 pr-1 text-xs font-semibold text-gray-400 select-none">Rp</span>
                            <input type="number" name="price" value="<%= t.price %>" min="0" step="1000"
                                class="block w-full pl-1 pr-3.5 py-2 border-0 focus:ring-0 text-sm font-semibold text-gray-800" style="height: 100%;">
                        </div>
                    </div>
                    <label class="inline-flex items-center gap-2 text-xs font-medium text-gray-700 pt-5 cursor-pointer select-none whitespace-nowrap">
                        <input type="checkbox" name="active" value="1" <%= t.active ? 'checked' : '' %> class="h-4 w-4 text-amber-700 rounded border-gray-300 focus:ring-amber-600 accent-amber-700">
                        Tampil
                    </label>
                </div>
            </div>

            <div class="flex gap-2.5 pt-3 border-t border-gray-100 mt-4">
                <button type="submit" class="flex-1 px-3.5 bg-[#b58838] hover:bg-[#9e752d] text-white rounded-xl text-xs sm:text-sm font-semibold transition-colors shadow-sm flex items-center justify-center whitespace-nowrap" style="height: 44px;">
                    Simpan
                </button>
                <a href="/<%= t.slug %>" target="_blank" class="flex-1 inline-flex items-center justify-center gap-1.5 px-3.5 bg-white border border-gray-200 hover:border-gold-400 text-gray-700 rounded-xl text-xs sm:text-sm font-semibold transition-colors whitespace-nowrap" style="height: 44px;">
                    <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    Preview
                </a>
                <a href="/owner/templates/<%= t.slug %>/preview" class="flex-1 px-3.5 bg-[#181f33] hover:bg-[#0f1422] text-white rounded-xl text-xs sm:text-sm font-semibold transition-colors shadow-sm flex items-center justify-center whitespace-nowrap" style="height: 44px;">
                    Edit Demo
                </a>
            </div>
        </form>
    </article>
    <% }); %>
</div>
