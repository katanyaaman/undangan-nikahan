<div class="bg-white rounded-2xl shadow-lg p-6 mb-6 border border-gray-100">
    <form method="GET" action="/owner/events">
        <div class="flex flex-col md:flex-row gap-4">
            <select
                name="status"
                onchange="this.form.submit()"
                class="block w-full md:w-48 px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-gold-500 focus:border-gold-500"
            >
                <option value="">Semua Status</option>
                <option value="trial" <%= filters.status === 'trial' ? 'selected' : '' %>>Trial</option>
                <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
                <option value="expired" <%= filters.status === 'expired' ? 'selected' : '' %>>Expired</option>
                <option value="suspended" <%= filters.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
            </select>
        </div>
    </form>
</div>

<div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-100">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Slug</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Template</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tamu</th>
                    <th class="px-6 py-4 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Aksi</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100">
                <% if (events.length) { %>
                <% events.forEach(function(ev) { %>
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= ev.slug || ('#' + ev.id) %></td>
                    <td class="px-6 py-4 text-sm text-gray-500"><%= ev.customer_name || '-' %></td>
                    <td class="px-6 py-4 text-sm text-gray-500"><%= ev.template_slug %></td>
                    <td class="px-6 py-4 text-sm text-gray-500"><%= ev.status %></td>
                    <td class="px-6 py-4 text-sm text-gray-500"><%= ev.guest_count %></td>
                    <td class="px-6 py-4 text-right text-sm font-medium">
                        <div class="flex items-center justify-end gap-2">
                            <a href="/u/<%= ev.slug %>" target="_blank" class="text-gold-700 hover:text-gold-800 font-medium">Buka</a>
                            <form method="POST" action="/owner/events/<%= ev.id %>/extend" class="inline">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="text-green-700 hover:text-green-800 font-medium" title="Perpanjang 30 hari">+30 hari</button>
                            </form>
                            <% if (ev.status !== 'suspended') { %>
                            <form method="POST" action="/owner/events/<%= ev.id %>/status" class="inline">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="status" value="suspended">
                                <button type="submit" class="text-red-600 hover:text-red-800 font-medium">Suspend</button>
                            </form>
                            <% } else { %>
                            <form method="POST" action="/owner/events/<%= ev.id %>/status" class="inline">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="status" value="active">
                                <button type="submit" class="text-green-700 hover:text-green-800 font-medium">Aktifkan</button>
                            </form>
                            <% } %>
                        </div>
                    </td>
                </tr>
                <% }); %>
                <% } else { %>
                <tr>
                    <td colspan="6" class="px-6 py-12 text-center text-gray-500">Belum ada event</td>
                </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <% if (pagination && pagination.hasPages) { %>
    <div class="px-6 py-4 border-t border-gray-100">
        <%- include('../../partials/pagination', { pagination: pagination }) %>
    </div>
    <% } %>
</div>
