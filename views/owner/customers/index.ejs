<div class="bg-white rounded-2xl shadow-lg p-6 mb-6 border border-gray-100">
    <form method="GET" action="/owner/customers" class="flex-1">
        <input
            type="text"
            name="search"
            value="<%= filters.search ?? '' %>"
            placeholder="Cari nama atau email..."
            class="block w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-gold-500 focus:border-gold-500"
        >
    </form>
</div>

<div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-100">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nama</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-4 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Aksi</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100">
                <% if (customers.length) { %>
                <% customers.forEach(function(c) { %>
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= c.name %></td>
                    <td class="px-6 py-4 text-sm text-gray-500"><%= c.email %></td>
                    <td class="px-6 py-4 text-sm text-gray-500"><%= c.event_count %></td>
                    <td class="px-6 py-4 text-sm text-gray-500"><%= c.status ?? 'active' %></td>
                    <td class="px-6 py-4 text-right text-sm font-medium">
                        <a href="/owner/customers/<%= c.id %>" class="text-gold-700 hover:text-gold-800 font-medium">Detail</a>
                    </td>
                </tr>
                <% }); %>
                <% } else { %>
                <tr>
                    <td colspan="5" class="px-6 py-12 text-center text-gray-500">Belum ada customer</td>
                </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <% if (pagination && pagination.hasPages) { %>
    <div class="px-6 py-4 border-t border-gray-100">
        <%- include('../../partials/pagination', { pagination: pagination }) %>
    </div>
    <% } %>
</div>
