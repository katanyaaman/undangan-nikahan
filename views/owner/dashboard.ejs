<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100">
        <p class="text-sm text-gray-600 mb-1">Customers</p>
        <p class="text-3xl font-bold text-gray-800"><%= customers %></p>
    </div>
    <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100">
        <p class="text-sm text-gray-600 mb-1">Event Aktif</p>
        <p class="text-3xl font-bold text-green-600"><%= activeCount %></p>
        <p class="text-xs text-gray-500 mt-1">Trial: <%= trialCount %> | Expired: <%= expiredCount %></p>
    </div>
    <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100">
        <p class="text-sm text-gray-600 mb-1">Pemasukan Bulan Ini</p>
        <p class="text-3xl font-bold text-gray-800">Rp <%= Number(revenueMonth).toLocaleString('id-ID') %></p>
    </div>
    <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100">
        <p class="text-sm text-gray-600 mb-1">Pembayaran Pending</p>
        <p class="text-3xl font-bold text-yellow-600"><%= pendingPayments %></p>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
        <div class="p-6 border-b border-gray-100">
            <h3 class="text-lg font-semibold text-gray-800">Event Terbaru</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 border-b border-gray-100">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Slug</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Template</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-100">
                    <% if (recentEvents.length) { %>
                    <% recentEvents.forEach(function(ev) { %>
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= ev.slug || ('#' + ev.id) %></td>
                        <td class="px-6 py-4 text-sm text-gray-500"><%= ev.template_slug %></td>
                        <td class="px-6 py-4 text-sm text-gray-500"><%= ev.status %></td>
                    </tr>
                    <% }); %>
                    <% } else { %>
                    <tr>
                        <td colspan="3" class="px-6 py-12 text-center text-gray-500">Belum ada event</td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
        <div class="p-6 border-b border-gray-100">
            <h3 class="text-lg font-semibold text-gray-800">Segera Kadaluarsa (7 hari)</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 border-b border-gray-100">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Slug</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Berakhir</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-100">
                    <% if (expiringSoon.length) { %>
                    <% expiringSoon.forEach(function(ev) { %>
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= ev.slug || ('#' + ev.id) %></td>
                        <td class="px-6 py-4 text-sm text-gray-500"><%= formatDate(ev.expired_at, 'd M Y, H:i') %></td>
                    </tr>
                    <% }); %>
                    <% } else { %>
                    <tr>
                        <td colspan="2" class="px-6 py-12 text-center text-gray-500">Tidak ada yang segera berakhir</td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
