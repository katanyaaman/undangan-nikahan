<div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
    <div class="p-6 border-b border-gray-100 flex items-center justify-between">
        <h3 class="text-lg font-semibold text-gray-800">Acara Saya (<%= events.length %>)</h3>
        <a href="/" class="inline-flex items-center px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-xl text-sm font-medium transition-colors">
            + Order Baru
        </a>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-100">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Undangan</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Template</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Berakhir</th>
                    <th class="px-6 py-4 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Aksi</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100">
                <% if (events.length) { %>
                <% events.forEach(function(ev) { %>
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4">
                        <div class="text-sm font-medium text-gray-900"><%= ev.event_title || ev.slug || ('#' + ev.id) %></div>
                        <div class="text-xs text-gray-500">/u/<%= ev.slug %></div>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-500"><%= ev.template_slug %></td>
                    <td class="px-6 py-4 text-sm text-gray-500"><%= ev.status %></td>
                    <td class="px-6 py-4 text-sm text-gray-500"><%= ev.expired_at ? formatDate(ev.expired_at, 'd M Y, H:i') : '-' %></td>
                    <td class="px-6 py-4 text-right text-sm font-medium">
                        <div class="flex items-center justify-end gap-3">
                            <a href="/u/<%= ev.slug %>" target="_blank" class="text-gray-500 hover:text-gray-700">Lihat</a>
                            <a href="/admin/events/<%= ev.id %>" class="text-primary-600 hover:text-primary-700 font-medium">Kelola</a>
                        </div>
                    </td>
                </tr>
                <% }); %>
                <% } else { %>
                <tr>
                    <td colspan="5" class="px-6 py-12 text-center">
                        <p class="text-gray-500 text-lg mb-2">Belum ada undangan</p>
                        <p class="text-gray-400 text-sm mb-4">Pilih template dan buat undangan pertamamu</p>
                        <a href="/" class="inline-flex items-center px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-medium transition-colors">Lihat Katalog</a>
                    </td>
                </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
