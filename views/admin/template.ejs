<div class="mb-6 bg-white rounded-2xl shadow-lg p-6 border border-gray-100">
    <p class="text-sm text-gray-600">Template aktif: <span class="font-medium text-gray-900"><%= event.template_slug %></span>. Yang tampil di sini hanya template yang kamu punya aksesnya.</p>
</div>

<% if (allowed.length) { %>
<form method="POST" action="<%= base + '/template' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <% allowed.forEach(function(t) { 
            const theme = (typeof templateThemes !== 'undefined' && templateThemes[t.slug]) ? templateThemes[t.slug] : {
                monogram: t.name.split(' ').map(w => w[0]).slice(0, 2).join(''),
                displayTitle: t.name.replace(/\s*\(.*?\)/, ''),
                code: t.slug.toUpperCase().replace('-', ' - '),
                bgGradient: 'background: linear-gradient(135deg, #111827 0%, #1f2937 55%, #111827 100%);',
                monogramColor: '#fde047',
            };
            const isSelected = t.slug === event.template_slug;
        %>
        <article class="bg-white rounded-2xl shadow-sm overflow-hidden border-2 <%= isSelected ? 'border-primary-500 ring-2 ring-primary-200' : 'border-gray-100' %> transition-all flex flex-col justify-between">
            <div class="relative h-48 w-full overflow-hidden bg-slate-900">
                <img src="/images/templates/<%= t.slug %>.jpg" 
                     alt="<%= t.name %>" 
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                     class="w-full h-full object-cover object-center">
                
                <div class="w-full h-full hidden absolute inset-0" style="<%= theme.bgGradient %>"></div>

                <% if (isSelected) { %>
                <span class="absolute top-3.5 right-3.5 z-20 px-2.5 py-1 bg-emerald-500/90 text-white text-[11px] font-semibold rounded-full flex items-center gap-1 backdrop-blur-sm shadow-sm">
                    <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                    Dipakai
                </span>
                <% } %>

                <div class="absolute inset-x-0 bottom-0 pt-16 pb-3.5 px-4 bg-gradient-to-t from-black/90 via-black/50 to-transparent flex items-end justify-between gap-3 z-10">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <div class="w-8 h-8 rounded-lg bg-white/20 backdrop-blur-md border border-white/25 flex items-center justify-center flex-shrink-0 shadow-sm">
                            <span class="font-serif italic font-bold text-sm text-white select-none leading-none">
                                <%= theme.monogram %>
                            </span>
                        </div>
                        <h3 class="font-serif font-bold text-white text-base leading-tight truncate drop-shadow-sm"><%= theme.displayTitle %></h3>
                    </div>
                    <span class="px-2 py-0.5 bg-black/60 border border-white/15 text-gray-200 text-[10px] font-mono font-bold tracking-widest rounded-md uppercase backdrop-blur-md flex-shrink-0"><%= t.slug.toUpperCase() %></span>
                </div>
            </div>
            <div class="p-5">
                <label class="flex items-center gap-3 cursor-pointer">
                    <input type="radio" name="template_slug" value="<%= t.slug %>" <%= isSelected ? 'checked' : '' %> class="h-4 w-4 text-primary-600 focus:ring-primary-500">
                    <span class="text-sm font-semibold text-gray-800"><%= t.name %></span>
                </label>
                <a href="/template-<%= t.slug.replace('template-', '') %>" target="_blank" class="mt-3 block text-center px-4 py-2.5 bg-white border border-gray-200 hover:border-gold-400 text-gray-700 rounded-xl text-xs font-semibold transition-colors">
                    Preview Demo
                </a>
            </div>
        </article>
        <% }); %>
    </div>
    <button type="submit" class="inline-flex items-center px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-medium transition-colors">
        Simpan Template
    </button>
</form>
<% } else { %>
<div class="bg-white rounded-2xl shadow-lg p-12 border border-gray-100 text-center">
    <p class="text-gray-500 text-lg">Belum ada template yang bisa dipilih. Hubungi admin.</p>
</div>
<% } %>
