<div class="mb-6 bg-white rounded-2xl shadow-lg p-6 border border-gray-100">
    <p class="text-sm text-gray-600">Template aktif: <span class="font-medium text-gray-900"><%= event.template_slug %></span>. Yang tampil di sini hanya template yang kamu punya aksesnya.</p>
</div>

<% if (allowed.length) { %>
<form method="POST" action="<%= base + '/template' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <% allowed.forEach(function(t) { %>
        <article class="bg-white rounded-3xl shadow-lg overflow-hidden border-2 <%= t.slug === event.template_slug ? 'border-primary-500' : 'border-gray-100' %> transition-all">
            <div class="relative h-20 bg-gradient-to-br <%= previews[t.slug] || 'from-gray-500 to-gray-400' %> overflow-hidden">
                <div class="absolute inset-0 opacity-20">
                    <div class="absolute top-0 -left-4 w-48 h-48 bg-white rounded-full mix-blend-multiply filter blur-xl"></div>
                    <div class="absolute top-0 -right-4 w-48 h-48 bg-gold-300 rounded-full mix-blend-multiply filter blur-xl"></div>
                </div>
                <div class="relative z-10 h-full flex flex-col items-center justify-center text-white p-6">
                    <h3 class="font-script text-2xl truncate"><%= t.name %></h3>
                </div>
                <% if (t.slug === event.template_slug) { %>
                <span class="absolute top-3 right-3 px-3 py-1 bg-primary-600 text-white text-xs font-medium rounded-full">Dipakai</span>
                <% } %>
            </div>
            <div class="p-6">
                <label class="flex items-center gap-3 cursor-pointer">
                    <input type="radio" name="template_slug" value="<%= t.slug %>" <%= t.slug === event.template_slug ? 'checked' : '' %> class="h-4 w-4 text-primary-600">
                    <span class="text-sm font-medium text-gray-800"><%= t.name %></span>
                </label>
                <a href="/template-<%= t.slug.replace('template-', '') %>" target="_blank" class="mt-3 block text-center px-4 py-2.5 border border-gray-200 hover:border-primary-400 text-gray-700 rounded-xl text-sm font-medium transition-colors">Preview Demo</a>
            </div>
        </article>
        <% }); %>
    </div>
    <button type="submit" class="inline-flex items-center px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-medium transition-colors">
        Simpan Template
    </button>
</form>
<% } else { %>
<div class="bg-white rounded-2xl shadow-lg p-12 border border-gray-100 text-center">
    <p class="text-gray-500 text-lg">Belum ada template yang bisa dipilih. Hubungi admin.</p>
</div>
<% } %>
