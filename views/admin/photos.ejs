<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Foto Mempelai Wanita</h3>
        <% if (bride) { %>
        <img src="<%= bride.url %>" alt="Mempelai wanita" class="w-32 h-32 object-cover rounded-full mx-auto mb-4">
        <% } else { %>
        <p class="text-sm text-gray-500 mb-4">Belum ada foto. Ikon bawaan template yang tampil.</p>
        <% } %>
        <form method="POST" action="<%= base + '/photos/couple' %>" enctype="multipart/form-data" class="space-y-3">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="kind" value="bride">
            <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" required
                class="block w-full text-sm text-gray-600 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100">
            <button type="submit" class="w-full px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white rounded-xl text-sm font-medium transition-colors">Upload</button>
        </form>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Foto Mempelai Pria</h3>
        <% if (groom) { %>
        <img src="<%= groom.url %>" alt="Mempelai pria" class="w-32 h-32 object-cover rounded-full mx-auto mb-4">
        <% } else { %>
        <p class="text-sm text-gray-500 mb-4">Belum ada foto. Ikon bawaan template yang tampil.</p>
        <% } %>
        <form method="POST" action="<%= base + '/photos/couple' %>" enctype="multipart/form-data" class="space-y-3">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="kind" value="groom">
            <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" required
                class="block w-full text-sm text-gray-600 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100">
            <button type="submit" class="w-full px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white rounded-xl text-sm font-medium transition-colors">Upload</button>
        </form>
    </div>
</div>

<div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100 mb-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-4">
        <div>
            <h3 class="text-lg font-semibold text-gray-800">Galeri (<%= galleryCount %>/<%= galleryMax %>)</h3>
            <p class="text-xs text-gray-500 mt-1">Bila kosong, galeri bawaan template yang tampil.</p>
        </div>
    </div>
    <form method="POST" action="<%= base + '/photos/gallery' %>" enctype="multipart/form-data" class="flex flex-col md:flex-row gap-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple required
            class="block w-full text-sm text-gray-600 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100">
        <button type="submit" class="px-6 py-2.5 bg-primary-600 hover:bg-primary-700 text-white rounded-xl text-sm font-medium transition-colors whitespace-nowrap">Tambah Foto</button>
    </form>
</div>

<div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
    <div class="p-6 grid grid-cols-2 md:grid-cols-4 gap-4">
        <% if (gallery.length) { %>
        <% gallery.forEach(function(g) { %>
        <div class="relative group rounded-xl overflow-hidden border border-gray-100">
            <img src="<%= g.url %>" alt="Galeri" class="w-full aspect-square object-cover">
            <form method="POST" action="<%= base + '/photos/' + g.id + '/delete' %>" class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity" onsubmit="return confirm('Hapus foto ini?')">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white text-xs font-medium rounded-lg">Hapus</button>
            </form>
        </div>
        <% }); %>
        <% } else { %>
        <p class="col-span-full text-center text-gray-500 py-8">Belum ada foto galeri</p>
        <% } %>
    </div>
</div>
